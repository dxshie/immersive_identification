// ============================================================
//  Immersive Identification -- "bodycam" dead-body head effect
// ------------------------------------------------------------
//  Screen-space post pass that alters the real scene colour inside a LIST of
//  rectangles (each a visible dead NPC's head box), for the Bodycam style.
//  Runs over a FULLSCREEN quad (phase_glitch copies the whole target back into
//  the scene RT, so no scissor): samples the scene via s_image + smp_base,
//  tests each pixel against every active head box, and applies the selected
//  effect inside the first one it hits; the scene passes through untouched
//  outside all boxes (the region restriction lives HERE, not in a scissor).
//
//  Three effect variants, chosen by glitch_count.y (set from C++):
//    0  glitch    -- animated digital tear / RGB-split / dropout (default)
//    1  pixelate  -- blocky mosaic "censor" of the head
//    2  black     -- solid black-out box
//
//  Shaders load at RUNTIME, so this file can be swapped/re-tuned without an exe
//  rebuild. Effect strength is hardcoded here. From C++ we take:
//    glitch_params.x  intensity     0..1 master strength
//    glitch_params.y  time          seconds, animation
//    glitch_count.x   active rects  0..II_GLITCH_MAX (16)
//    glitch_count.y   mode          0 glitch / 1 pixelate / 2 black
//    glitch_rects[i]  (u0,v0,u1,v1) head box i, scene UV space
// ============================================================

#include "common.h"

#define II_GLITCH_MAX 16   // keep in sync with xr_ioc_cmd.cpp / bodycam_script.cpp

float4 glitch_params;
float4 glitch_count;
float4 glitch_rects[II_GLITCH_MAX];

// cheap hash -> [0,1)
float ii_hash(float2 p)
{
	return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

// ---- mode 0: animated glitch (returns raw effect colour; main feathers it) ----
float3 ii_glitch(float2 uv, float2 luv, float2 span, float intensity, float t)
{
	const float BANDS      = 14.0;
	const float TEAR       = 0.45;
	const float VJIT       = 0.06;
	const float CHROMA     = 0.010;
	const float NOISE      = 0.30;
	const float SCANDARK   = 0.45;
	const float DROP_RATE  = 0.80;

	float band   = floor(luv.y * BANDS);
	float bucket = floor(t * 15.0);
	float r      = ii_hash(float2(band, bucket));
	float active = step(0.45, ii_hash(float2(bucket, band)));

	float shove = (r - 0.5) * 2.0 * TEAR * intensity * active;
	float vjit  = (ii_hash(float2(bucket, 3.0)) - 0.5) * VJIT * intensity;

	float2 duv = clamp(float2(uv.x + shove * span.x, uv.y + vjit * span.y), 0.0, 1.0);

	float ca = CHROMA * span.x * (1.0 + abs(shove) * 4.0) * intensity;
	float3 col;
	col.r = s_image.Sample(smp_base, clamp(duv + float2(ca, 0.0), 0.0, 1.0)).r;
	col.g = s_image.Sample(smp_base, duv).g;
	col.b = s_image.Sample(smp_base, clamp(duv - float2(ca, 0.0), 0.0, 1.0)).b;

	float drop = step(DROP_RATE, ii_hash(float2(band + 5.0, bucket)));
	col = lerp(col, 1.0 - col, drop * 0.6 * intensity);
	col *= lerp(1.0, 0.2, drop * intensity);

	float scan  = 1.0 - SCANDARK * intensity * (0.5 + 0.5 * sin(luv.y * BANDS * 6.2831 + t * 40.0));
	float noise = ii_hash(uv * float2(1920.0, 1080.0) + frac(t) * 100.0);
	col *= scan;
	col += (noise - 0.5) * NOISE * intensity;

	return lerp(col, col * float3(0.75, 1.05, 1.15), 0.35 * intensity);
}

// ---- mode 1: pixelate (mosaic censor of the head region) ----
float3 ii_pixelate(float2 rect_xy, float2 span, float2 luv)
{
	const float CELLS = 10.0;   // blocks across the box, each axis
	float2 cell = (floor(luv * CELLS) + 0.5) / CELLS;      // cell centre, 0..1 box space
	float2 suv  = clamp(rect_xy + cell * span, 0.0, 1.0);  // -> scene UV
	return s_image.Sample(smp_base, suv).rgb;
}

float4 main(p_screen I, float4 pos2d : SV_POSITION) : SV_Target
{
	float2 uv = I.tc0;
	float intensity = saturate(glitch_params.x);
	float t         = glitch_params.y;
	int   n         = (int)(glitch_count.x + 0.5);
	int   mode      = (int)(glitch_count.y + 0.5);
	if (n > II_GLITCH_MAX) n = II_GLITCH_MAX;

	float3 scene = s_image.Sample(smp_base, uv).rgb;
	if (intensity <= 0.0)
		return float4(scene, 1.0);

	[loop]
	for (int i = 0; i < n; ++i)
	{
		float4 rect = glitch_rects[i];
		float2 span = max(rect.zw - rect.xy, float2(1e-4, 1e-4));
		float2 luv  = (uv - rect.xy) / span;
		if (luv.x >= 0.0 && luv.x <= 1.0 && luv.y >= 0.0 && luv.y <= 1.0)
		{
			// Feather the box edges so it isn't a hard rectangle.
			float edge = smoothstep(0.0, 0.08, luv.x) * smoothstep(0.0, 0.08, 1.0 - luv.x)
			           * smoothstep(0.0, 0.08, luv.y) * smoothstep(0.0, 0.08, 1.0 - luv.y);

			float3 effect;
			float  blend;
			if (mode == 2)        { effect = float3(0.0, 0.0, 0.0);              blend = edge * intensity; }
			else if (mode == 1)   { effect = ii_pixelate(rect.xy, span, luv);   blend = edge * intensity; }
			else                  { effect = ii_glitch(uv, luv, span, intensity, t); blend = edge; }

			return float4(lerp(scene, effect, blend), 1.0);
		}
	}

	return float4(scene, 1.0);
}
