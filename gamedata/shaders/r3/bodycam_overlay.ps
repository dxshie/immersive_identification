// ============================================================
//  Bodycam -- depth-aware UI overlay (bodycam_overlay.ps)
// ------------------------------------------------------------
//  Flat-colour fill for the world-anchored bodycam UI rectangles, occluded
//  per-pixel by the scene. The depth test is done HERE in the pixel shader
//  (not via the hardware depth test) -- exactly like bodycam_redaction.ps --
//  because the stub_screen_space VS forces the vertex z, so a hardware depth
//  test would be a no-op. We sample the scene view-space position g-buffer
//  (s_position / r2_RT_P, includes the viewmodel) at the real pixel coord
//  (SV_Position) and discard where the scene surface is NEARER than the
//  target's view-space depth (overlay_params.x) -- i.e. a wall or the gun is
//  in front. s_position + screen_res come from common.h.
// ============================================================

#include "common.h"

float4 overlay_color;    // rgb + alpha
float4 overlay_params;   // .x = target view-space depth (m); <=0 = no depth test

float4 main(p_screen I, float4 pos2d : SV_Position) : SV_Target
{
	float d = overlay_params.x;
	if (d > 0.0)
	{
		float sceneZ = s_position.Load(int3(pos2d.xy, 0), 0).z;
		// small bias so the box on the target's own surface isn't self-occluded
		if (sceneZ > 0.001 && sceneZ < d - 0.15)
			discard;
	}
	return overlay_color;
}
