<w>
	<!-- Soft glow halo behind the relation-coloured dot (revealed state only). -->
	<tag_glow width="40" height="40" stretch="1">
		<texture r="255" g="255" b="255" a="140">ii_dot</texture>
	</tag_glow>

	<!-- Relation-coloured dot at the identify anchor point: friend/enemy/neutral
	     at a glance. Only shown once revealed (steady, no pulsing). -->
	<tag_dot width="10" height="10" stretch="1">
		<texture r="255" g="255" b="255" a="255">ii_dot</texture>
	</tag_dot>

	<!-- "Scanning" spinner shown on the body before the tag reveals, rotated
	     continuously via SetHeading -- replaces a plain pulsing dot. -->
	<tag_spinner width="20" height="20" stretch="1">
		<texture r="255" g="255" b="255" a="230">ii_spinner</texture>
	</tag_spinner>

	<!-- Faction patch. Texture is swapped at runtime to "<community_id>_icon"
	     via InitTexture -- the same convention the game's own character/
	     relations UI uses for faction emblems -- so this placeholder texture
	     is never actually shown; shown at native colour (no tint). -->
	<tag_icon width="20" height="20" stretch="1">
		<texture r="255" g="255" b="255" a="255">ii_white</texture>
	</tag_icon>

	<!-- Stalker's name. No background plate by design: just a 1px black
	     shadow copy behind the relation-coloured face for legibility. -->
	<tag_name_sh>
		<text font="letterica16" align="l" width="300" height="18" />
	</tag_name_sh>
	<tag_name>
		<text font="letterica16" align="l" width="300" height="18" />
	</tag_name>
</w>
