; Immersive Identification -- MCM presets.
;
; Each [section] is a preset id (listed in ii_mcm.script's `presets` field and
; named by a ui_mcm_prst_<id> string). Keys are the option STORAGE PATHS
; (ii/<page>/<option_id>, i.e. what ui_mcm.get reads); values are read by option
; type (check -> bool, track/list -> number). A preset only changes the options it
; lists; everything else keeps its current value.
;
; NOTE: the menu is split into per-section leaf pages, so a path is ii/<page>/<opt>
; (NOT ii/main/*): general, uistyle, targeting, binoc, ads, pip, faceredact,
; scantime, debug, colors. Keep these in sync with the page an option lives on in
; ii_mcm.script, or the preset writes a dead path and silently does nothing.

[ii_card]
ii/uistyle/ui_style           = 1
ii/uistyle/show_name          = true
ii/uistyle/show_faction       = true
ii/uistyle/show_weapon        = true
ii/uistyle/color_by_relation  = true
ii/general/instant_identify   = false
ii/general/scan_time          = 0.35
ii/general/hold_time          = 4.0
ii/targeting/auto_identify    = false
ii/faceredact/redact_face     = false

[ii_minimal]
ii/uistyle/ui_style           = 2
ii/general/instant_identify   = false
ii/targeting/auto_identify    = false
ii/faceredact/redact_face     = false

[ii_bodycam]
ii/uistyle/ui_style           = 3
ii/uistyle/box_area           = 2
ii/uistyle/box_thickness      = 2
ii/uistyle/box_padding        = 0.2
ii/uistyle/box_opacity        = 0.85
ii/uistyle/show_name          = true
ii/uistyle/show_faction       = true
ii/uistyle/show_weapon        = true
ii/general/instant_identify   = true
ii/general/hide_unseen        = true
ii/targeting/auto_identify    = true
ii/faceredact/redact_face     = true
ii/faceredact/redact_strength = 1.0

[ii_crooks]
ii/uistyle/ui_style           = 6
ii/targeting/fov_assist       = true
ii/targeting/freeaim_assist   = true
ii/targeting/fov_radius       = 22
ii/targeting/hipfire_mode     = true
ii/targeting/hipfire_hold_time = 0
ii/ads/ads_mode               = true
ii/ads/ads_hold_time          = 0
ii/binoc/binocular_mode       = true
ii/binoc/steady_time          = 0

[ii_immersive]
ii/uistyle/ui_style           = 1
ii/general/instant_identify   = false
ii/general/scan_time          = 0.6
ii/general/hold_time          = 3.0
ii/targeting/fov_assist       = false
