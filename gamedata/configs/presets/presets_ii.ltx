; Immersive Identification -- MCM presets.
;
; Each [section] is a preset id (listed in ii_mcm.script's `presets` field and
; named by a ui_mcm_prst_<id> string). Keys are the option STORAGE PATHS
; (ii/<page>/<option_id>, i.e. what ui_mcm.get reads); values are read by option
; type (check -> bool, track/list -> number). A preset only changes the options it
; lists; everything else keeps its current value.
;
; NOTE: a path is ii/<page>/<opt>, or ii/uistyle/<sub>/<opt> for the nested UI Style
; sub-pages (general / bodycam / crooks). Pages: general, uistyle/general, uistyle/bodycam,
; uistyle/crooks, targeting, hipfire, binoc, ads, pip, faceredact, scantime, debug, colors.
; Keep in sync with the page an option lives on in ii_mcm.script (+ MCM_PAGES in
; ii_identify.script), or the preset writes a dead path and silently does nothing.

[ii_card]
ii/uistyle/general/ui_style           = 1
ii/uistyle/general/show_name          = true
ii/uistyle/general/show_faction       = true
ii/uistyle/general/show_weapon        = true
ii/uistyle/general/color_by_relation  = true
ii/general/instant_identify   = false
ii/general/scan_time          = 0.35
ii/general/hold_time          = 4.0
ii/targeting/auto_identify    = false
ii/faceredact/redact_face     = false

[ii_minimal]
ii/uistyle/general/ui_style           = 2
ii/general/instant_identify   = false
ii/targeting/auto_identify    = false
ii/faceredact/redact_face     = false

[ii_bodycam]
ii/uistyle/general/ui_style           = 3
ii/uistyle/bodycam/box_area           = 2
ii/uistyle/bodycam/box_thickness      = 2
ii/uistyle/bodycam/box_padding        = 0.2
ii/uistyle/bodycam/box_opacity        = 0.85
ii/uistyle/general/show_name          = true
ii/uistyle/general/show_faction       = true
ii/uistyle/general/show_weapon        = true
ii/general/instant_identify   = true
ii/general/hide_unseen        = true
ii/targeting/auto_identify    = true
ii/faceredact/redact_face     = true
ii/faceredact/redact_strength = 1.0

[ii_crooks]
ii/uistyle/general/ui_style           = 6
ii/targeting/fov_assist       = true
ii/targeting/freeaim_assist   = true
ii/targeting/fov_radius       = 22
ii/hipfire/hipfire_mode       = true
ii/hipfire/hipfire_hold_time  = 0
ii/ads/ads_mode               = true
ii/ads/ads_hold_time          = 0
ii/binoc/binocular_mode       = true
ii/binoc/steady_time          = 0

[ii_immersive]
ii/uistyle/general/ui_style           = 1
ii/general/instant_identify   = false
ii/general/scan_time          = 0.6
ii/general/hold_time          = 3.0
ii/targeting/fov_assist       = false
ii/targeting/freeaim_assist   = false
ii/targeting/require_los      = true
ii/targeting/auto_identify    = false
ii/scantime/dist_penalty      = true
ii/scantime/rank_penalty      = true
ii/scantime/night_penalty     = true
ii/faceredact/redact_face     = false
