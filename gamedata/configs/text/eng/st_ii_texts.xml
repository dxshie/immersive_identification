<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_ii"><text>Immersive Identification</text></string>
	<string id="ui_mcm_menu_main"><text>Main</text></string>

	<string id="ui_mcm_ii_title"><text>Immersive Identification</text></string>

	<string id="ui_mcm_ii_enabled"><text>Enable identification</text></string>
	<string id="ui_mcm_ii_enabled_desc"><text>Master on/off switch.</text></string>

	<string id="ui_mcm_ii_key"><text>Identify key</text></string>
	<string id="ui_mcm_ii_key_desc"><text>Click, then press a key to bind it.</text></string>

	<string id="ui_mcm_ii_modifier"><text>Modifier</text></string>
	<string id="ui_mcm_ii_modifier_desc"><text>Optional modifier held with the identify key.</text></string>

	<string id="ui_mcm_ii_ui_style"><text>UI style</text></string>
	<string id="ui_mcm_ii_ui_style_desc"><text>Card (full details) or Minimal (a faction-coloured dot with a relation sign).</text></string>

	<string id="ui_mcm_ii_color_by_relation"><text>Colour by relation</text></string>
	<string id="ui_mcm_ii_color_by_relation_desc"><text>Red enemy, green friend, tan neutral.</text></string>

	<string id="ui_mcm_ii_show_weapon"><text>Show held weapon</text></string>
	<string id="ui_mcm_ii_show_weapon_desc"><text>Also show the target's currently-wielded weapon as a line on the card (Card style only).</text></string>

	<string id="ui_mcm_ii_scan_time"><text>Scan delay (s)</text></string>
	<string id="ui_mcm_ii_scan_time_desc"><text>How long the scan pulses before the tag reveals.</text></string>

	<string id="ui_mcm_ii_fade_time"><text>Fade time (s)</text></string>
	<string id="ui_mcm_ii_fade_time_desc"><text>Fade in/out duration.</text></string>

	<string id="ui_mcm_ii_hold_time"><text>Hold time (s)</text></string>
	<string id="ui_mcm_ii_hold_time_desc"><text>How long the tag stays fully visible.</text></string>

	<string id="ui_mcm_ii_max_dist"><text>Max range (m)</text></string>
	<string id="ui_mcm_ii_max_dist_desc"><text>Max range identification works at.</text></string>

	<string id="ui_mcm_ii_fade_dist"><text>Fade start range (m)</text></string>
	<string id="ui_mcm_ii_fade_dist_desc"><text>Range at which the tag starts fading out.</text></string>

	<string id="ui_mcm_ii_fov_assist"><text>FOV target assist</text></string>
	<string id="ui_mcm_ii_fov_assist_desc"><text>When you don't land a direct hit, identify the nearest target within the on-screen assist circle. Turn off to require aiming directly at the target.</text></string>

	<string id="ui_mcm_ii_freeaim_assist"><text>Free-aim target assist</text></string>
	<string id="ui_mcm_ii_freeaim_assist_desc"><text>For bodycam / free-aim engines: center the assist circle on where the weapon actually points instead of the screen center. Leave off on a normal engine.</text></string>

	<string id="ui_mcm_ii_fov_radius"><text>Target-assist radius (px)</text></string>
	<string id="ui_mcm_ii_fov_radius_desc"><text>Aim tolerance for picking a target without a direct hit.</text></string>

	<string id="ui_mcm_ii_require_los"><text>Require line of sight</text></string>
	<string id="ui_mcm_ii_require_los_desc"><text>Only pick targets you can actually see.</text></string>

	<string id="ui_mcm_ii_binocular_mode"><text>Binocular mode</text></string>
	<string id="ui_mcm_ii_binocular_mode_desc"><text>Also auto-identify on a steady aim through raised binoculars, alongside the normal key.</text></string>

	<string id="ui_mcm_ii_require_binoculars"><text>Require binoculars</text></string>
	<string id="ui_mcm_ii_require_binoculars_desc"><text>Identification only works while actively looking through raised binoculars.</text></string>

	<string id="ui_mcm_ii_steady_time"><text>Steady-aim time (s)</text></string>
	<string id="ui_mcm_ii_steady_time_desc"><text>How long to hold aim steady before auto-identifying.</text></string>

	<string id="ui_mcm_ii_fov_assist_binoc"><text>FOV assist with binoculars</text></string>
	<string id="ui_mcm_ii_fov_assist_binoc_desc"><text>Whether FOV target assist also applies while looking through raised binoculars. Turn off to require a direct hit when using binoculars.</text></string>

	<string id="ui_mcm_ii_binoc_boost"><text>Binoculars boost identification</text></string>
	<string id="ui_mcm_ii_binoc_boost_desc"><text>Faster reveal and longer range with binoculars raised, any mode.</text></string>

	<string id="ui_mcm_ii_binoc_scan_mult"><text>Binoculars scan speed multiplier</text></string>
	<string id="ui_mcm_ii_binoc_scan_mult_desc"><text>Scan speed multiplier while binoculars are raised.</text></string>

	<string id="ui_mcm_ii_binoc_range_mult"><text>Binoculars range multiplier</text></string>
	<string id="ui_mcm_ii_binoc_range_mult_desc"><text>Range multiplier while binoculars are raised.</text></string>

	<string id="ui_mcm_ii_distance_scaling_title"><text>Card Size</text></string>

	<string id="ui_mcm_ii_card_scale"><text>Card scale</text></string>
	<string id="ui_mcm_ii_card_scale_desc"><text>Flat size multiplier for the whole card. Not distance-based.</text></string>

	<string id="ui_mcm_ii_mini_scale_cutoff"><text>Mini mode cutoff</text></string>
	<string id="ui_mcm_ii_mini_scale_cutoff_desc"><text>Below this scale, show just the relation dot instead of the full card.</text></string>

	<string id="ui_mcm_ii_binoc_title"><text>Binoculars</text></string>
	<string id="ui_mcm_ii_dist_penalty_title"><text>Distance Penalty</text></string>

	<string id="ui_mcm_ii_dist_penalty"><text>Distance slows identification</text></string>
	<string id="ui_mcm_ii_dist_penalty_desc"><text>Further targets take longer to scan.</text></string>

	<string id="ui_mcm_ii_dist_penalty_max"><text>Max distance slowdown</text></string>
	<string id="ui_mcm_ii_dist_penalty_max_desc"><text>Scan time multiplier at max range. Binoculars mitigate this for free by extending max range itself.</text></string>

	<string id="ui_mcm_ii_rank_penalty_title"><text>Rank Penalty</text></string>

	<string id="ui_mcm_ii_rank_penalty"><text>Rank slows identification</text></string>
	<string id="ui_mcm_ii_rank_penalty_desc"><text>Higher-ranked stalkers take longer to identify than a rookie.</text></string>

	<string id="ui_mcm_ii_rank_penalty_max"><text>Max rank slowdown</text></string>
	<string id="ui_mcm_ii_rank_penalty_max_desc"><text>Scan time multiplier for the highest rank (legend), vs. a rookie.</text></string>

	<string id="ui_mcm_ii_night_penalty_title"><text>Night Penalty</text></string>

	<string id="ui_mcm_ii_night_penalty"><text>Darkness slows identification</text></string>
	<string id="ui_mcm_ii_night_penalty_desc"><text>Targets are harder to make out in the dark; the slowdown ramps up over dusk and peaks in the dead of night (around 0:00).</text></string>

	<string id="ui_mcm_ii_night_penalty_max"><text>Max darkness slowdown</text></string>
	<string id="ui_mcm_ii_night_penalty_max_desc"><text>Scan time multiplier at the darkest point of the night, vs. broad daylight.</text></string>

	<string id="ui_mcm_ii_familiarity_title"><text>Familiarity</text></string>

	<string id="ui_mcm_ii_familiarity_boost"><text>Remember identified stalkers</text></string>
	<string id="ui_mcm_ii_familiarity_boost_desc"><text>Re-identifying someone you've identified before is faster.</text></string>

	<string id="ui_mcm_ii_familiarity_scan_mult"><text>Familiar target speed multiplier</text></string>
	<string id="ui_mcm_ii_familiarity_scan_mult_desc"><text>Scan time multiplier for a previously-identified target.</text></string>

	<string id="ui_mcm_ii_perception_title"><text>Skill System (Perception)</text></string>

	<string id="ui_mcm_ii_perception_compat"><text>Perception skill integration</text></string>
	<string id="ui_mcm_ii_perception_compat_desc"><text>Identifying gets faster with a higher Skill System perception level (needs the optional FOMOD component).</text></string>

	<string id="ui_mcm_ii_perception_scan_mult"><text>Speed bonus per level</text></string>
	<string id="ui_mcm_ii_perception_scan_mult_desc"><text>Scan time reduction per perception level.</text></string>

	<string id="ui_mcm_ii_perception_xp"><text>Perception XP per identify</text></string>
	<string id="ui_mcm_ii_perception_xp_desc"><text>Perception experience granted on a successful identify.</text></string>

	<string id="ui_mcm_ii_perception_loot_xp"><text>Perception XP per loot</text></string>
	<string id="ui_mcm_ii_perception_loot_xp_desc"><text>Bonus perception experience granted the first time you loot a corpse you'd already identified.</text></string>

	<string id="ui_mcm_ii_debug_title"><text>Debug</text></string>
	<string id="ui_mcm_ii_debug_log"><text>Log aim debug</text></string>
	<string id="ui_mcm_ii_debug_log_desc"><text>Write aim/trace diagnostics to the game log (xray_*.log) on each identify attempt. For troubleshooting free-aim target acquisition. Leave off normally.</text></string>

