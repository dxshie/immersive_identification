UI_STYLE_LIST = {
	{ label = "card" },
	{ label = "minimal" },
	{ label = "bodycam" },
	{ label = "simple2" },
	{ label = "simple" },
	{ label = "crooks" },
	{ label = "minimal2" },
}

-- Where the tag/marker anchors on the target's body (anchor_basis). Index order IS the stored
