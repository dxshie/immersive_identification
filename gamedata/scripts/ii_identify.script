-- ======================================================================
--  Immersive Identification
--  Aim at an NPC, press the identify key: after a brief "scan" pulse, a
--  floating tag naming their faction appears anchored to their body in
--  world space (not a HUD element), fades to full, holds, then fades out.
-- ======================================================================

local MAX_TAGS = 12 -- most identifications tracked/drawn at once (raised from 5
-- so the auto-identify option, which reveals every visible
-- target at once, isn't constantly evicting the oldest tag)

local DBG_DOTS = 96 -- debug-draw dot pool (FOV ring segments + in-ring entity bones)
local DBG_RING_SEG = 32 -- dots forming the FOV ring outline
local DBG_TEXTS = 16 -- per-candidate distance labels

-- render()'s per-frame scratch list of on-screen cards, reused instead of
-- allocated fresh every call -- tracked is capped at MAX_TAGS (see
-- try_identify), so this pool never needs to grow past it.
local active_pool = {}
for i = 1, MAX_TAGS do
	active_pool[i] = {}
end

-- Defaults, also the fallback when MCM is absent. Keys match the MCM option
-- ids under the "ii" menu (see ii_mcm.script). Declared non-local so the menu
-- file can read it as ii_identify.DEFAULTS (single source of truth).
DEFAULTS = {
	enabled = true,
	key_dik = 0, -- captured DIK code; 0/nil means "unset, use DEFAULT_KEY_NAME"
	modifier_index = 1, -- index into MODIFIER_LIST (1 = none)
	ui_style = 1, -- index into UI_STYLE_LIST (1 = card, 2 = minimal, 3 = bodycam)
	box_area = 1, -- bodycam style: index into REDACT_AREA_LIST (1 = head/face box,
	-- 2 = full-body box) for the outline rectangle
	box_color_source = 1, -- bodycam box colour: index into BOX_COLOR_SOURCE_LIST
	-- (1 = faction colour, 2 = relationship colour red/green/grey)
	box_thickness = 2, -- bodycam outline edge thickness in virtual px (not distance-scaled)
	box_padding = 0.2, -- bodycam outline: extra margin around the model as a fraction of the
	-- box size (0 = tight, 0.2 = 20% larger each side), distance-independent
	box_opacity = 1.0, -- bodycam outline rectangle opacity 0..1 (multiplies the fade alpha;
	-- the name/faction/weapon text is unaffected)
	auto_identify = false, -- continuously identify every visible target in range without a
	-- keypress (LOS-gated). Off by default; pairs well with the
	-- bodycam head-box style but works with any style
	-- Face redaction: an engine post-process drawn over the FACE of every visible
	-- humanoid in range (alive or dead). Independent of identification -- no need to
	-- aim at or identify anyone. Needs the custom bodycam exe's multi-rect redaction
	-- binding; fully inert on a stock exe.
	redact_range = 100, -- metres: redaction reach, independent of the identify max_dist --
	-- redaction is passive, so it reaches as far as a face is visible
	redact_strength = 1.0, -- master intensity 0..1 of the redaction effect
	redact_face = false, -- FACE redaction master toggle: redact the FACE of humanoids in range,
	-- ALIVE or dead (only the face, nudged to the face front)
	redact_face_style = 1, -- face redaction style, index into REDACT_STYLE_LIST (1 = pixelate, 2 = black)
	redact_face_padding = 0.15, -- face redaction: margin fraction around the face box
	color_by_relation = true, -- tint the tag by relation to the actor instead of a flat colour
	show_name = true, -- show the target's name line (all text styles: card + bodycam)
	show_faction = true, -- show the target's faction line (all text styles: card + bodycam)
	instant_identify = false, -- skip the scan wait/spinner entirely: the tag reveals immediately on
	-- identify (bypasses scan_time and all the scan-time multipliers)
	scan_time = 0.35, -- seconds: "scanning" pulse before the tag reveals
	fade_time = 0.45, -- seconds: fade in / fade out
	hold_time = 4.0, -- seconds: tag stays fully visible
	max_dist = 50, -- metres: identify only works within this range
	fade_dist = 40, -- metres: tag starts fading with distance beyond this
	fov_assist = true, -- master target-assist: when you don't land a direct hit, identify the
	-- nearest eligible target within the on-screen FOV circle. Off = you must
	-- aim directly at the target (direct raycast hit only), no circle fallback
	fov_assist_binoc = true, -- whether FOV target-assist also applies while looking through raised
	-- binoculars; independent of the master toggle for the binocular case
	freeaim_assist = false, -- bodycam / free-aim engines: centre the FOV target-assist on where the
	-- weapon actually points instead of the fixed screen centre. Needs an
	-- aim source that reflects free aim -- either level.ETraceTarget.Weapon
	-- (absent on the tested bodycam build) or a bodycam.get_fire_ray() engine
	-- binding (see SPEC "Free-aim support"). Inert / harmless without either
	fov_radius = 90, -- virtual-space px (1024-wide): target-assist size (MCM range 0-90). Calibrated at the
	-- unzoomed FOV into an angular cone (aim_cone_rad), so the assist is magnification-
	-- invariant -- works the same hip-firing or scoped at high zoom (see aim_angle_to_body)
	require_los = true, -- target-assist fallback only picks targets with clear line of sight
	hide_unseen = true, -- hide an active tag/card/box while its target is out of sight (occluded
	-- or off-screen), instead of leaving it floating until its timer expires;
	-- it reappears if the target comes back into view within the reveal window
	pip_markers = true, -- draw identification markers INSIDE a PiP scope (needs a PiP engine); off =
	-- behave as if there were no PiP support (normal HUD, no in-scope markers)
	pip_redact = true, -- draw the dead-body redaction INSIDE a PiP scope (independent of pip_markers;
	-- the main-view redaction is unaffected either way)
	pip_hide_main = false, -- while a PiP scope is up, suppress ALL main-view drawing (HUD tags +
	-- main-pass redaction), leaving only the in-scope UI
	ads_hide_main = false, -- while aiming down sight, suppress ALL main-view drawing (HUD tags +
	-- main-pass redaction) -- e.g. a clean sight picture; in-scope UI (if any) still draws
	binocular_mode = false, -- auto-trigger identify on a steady aim through raised binoculars,
	-- in addition to (not instead of) the normal key
	require_binoculars = false, -- the key (and auto-trigger) only work while actively looking
	-- through raised binoculars -- independent of binocular_mode
	steady_time = 0.6, -- seconds: how long the aim must hold still (binocular mode) before auto-identifying
	card_scale = 1.0, -- flat size multiplier for the whole card (manual, not distance-based)
	mini_scale_cutoff = 0.4, -- below this scale, show just the relation dot instead of the full card
	ui_offset_x = 0, -- virtual-px (1024-wide) horizontal nudge for the on-screen UI elements
	ui_offset_y = 0, -- virtual-px (768-tall) vertical nudge for the on-screen UI elements
	mini_dist_scale = true, -- Minimal (dot) style: scale the dot with distance so a far target's dot
	-- isn't oversized (near = bigger, far = smaller); off = flat card_scale like the other styles
	binoc_boost = true, -- binoculars speed up + extend identify range, independent of binocular_mode
	binoc_scan_mult = 0.4, -- scan_time multiplier while binoculars are raised (lower = faster reveal)
	binoc_range_mult = 4.4, -- max_dist/fade_dist multiplier while binoculars are raised (flat, OR the
	-- x1 base when binoc_zoom_scaling is on)
	binoc_zoom_scaling = false, -- scale the binocular range multiplier by the binocular's magnification
	-- (like ads_zoom_scaling): off = flat binoc_range_mult; on = binoc_range_mult * magnification
	ads_mode = false, -- auto-trigger identify while aiming down sight, once a target has been held
	-- under the aim (or inside the FOV assist range when that's on) for ads_hold_time seconds
	ads_hold_time = 0.6, -- seconds: how long a target must stay on-aim / in FOV-assist range while
	-- ADS before auto-identifying (ADS mode). Dwell-on-target, distinct from binocular steady_time
	ads_boost = true, -- aiming down sight speeds up + extends identify range, independent of ads_mode
	ads_scan_mult = 0.6, -- scan_time multiplier while aiming down sight (gentler than binoculars)
	ads_range_mult = 1.6, -- max_dist/fade_dist multiplier while aiming down sight (the x1 base)
	ads_zoom_scaling = true, -- scale the ADS range multiplier by the scope's magnification (x2/x4/...),
	-- so a higher-power optic reaches further. Works on PiP (engine magnification binding) and
	-- non-PiP engines (recovered from the main-camera FOV) -- see scope_magnification()
	dist_penalty = true, -- further targets take longer to scan/identify (binoc_range_mult mitigates
	-- this for free -- see distance_scan_mult()'s comment)
	dist_penalty_max = 5.0, -- scan time multiplier right at the (current, possibly boosted) max range
	perception_compat = true, -- soft-integrate with the Skill System mod's "perception" skill, if present
	perception_scan_mult = 0.04, -- scan time reduction per perception level (0.04 = 4% faster per level)
	perception_xp = 20, -- perception XP granted per successful identify (skill-system side)
	perception_loot_xp = 20, -- bonus perception XP granted the first time you loot a corpse you'd
	-- already identified (skill-system side)
	rank_penalty = true, -- higher-ranked stalkers take longer to identify (novice = baseline, legend = slowest)
	rank_penalty_max = 3.0, -- scan time multiplier for the highest rank (legend), relative to a rookie
	familiarity_boost = true, -- once you've identified a stalker before, re-identifying them later is faster
	familiarity_scan_mult = 0.6, -- scan time multiplier for a previously-identified target
	night_penalty = true, -- identification is slower in the dark, ramping up over dusk and peaking across midnight (0:00)
	night_penalty_max = 2.0, -- scan time multiplier at the darkest point of the night
	show_weapon = true, -- show the target's currently-wielded weapon + caliber line (card + bodycam)
	debug_log = false, -- write aim/trace diagnostics to the game log on each identify attempt
	debug_draw = false, -- on-screen target-assist visualiser: aim dot, FOV ring, in-ring bone dots
}

-- Section name of the stock binoculars item (confirmed from this engine's
-- own bundled gamedata/scripts/axr_main.script:355:
-- `binoc_is_zoomed = wpn and (wpn:section() == "wpn_binoc_inv")`). Matched
-- as a substring too, not just exact-equal, in case a modpack ships a
-- differently-sectioned binoculars variant that still follows this naming.
local BINOC_SECTION = "wpn_binoc_inv"

-- --------------------------------------------------------------------------
-- PiP (picture-in-picture scope) compatibility gate
-- --------------------------------------------------------------------------
-- is_svp_active()/svp_ui_markers_begin/add/commit() only exist when the
-- engine build itself has the True PiP feature (xray-monolith-pip, or a
-- fork built on it) -- stock xray-monolith and vanilla Anomaly builds don't
-- register them at all. Checked once via rawget(_G, ...), the same
-- existence-check idiom this engine's own PiP-aware scripts use (e.g.
-- zzz_extra_scope_features.script's svp_optic_api_* lookups), so referencing
-- a name that doesn't exist never errors -- it's just nil, same as any other
-- undefined global. Checked once at load rather than per-call: unlike
-- haru_skills (a separate Lua script whose load order isn't guaranteed
-- relative to this one), these are C++-registered engine globals, already
-- present before any Lua runs at all.
local PIP_AVAILABLE = rawget(_G, "is_svp_active") ~= nil
	and rawget(_G, "svp_ui_markers_begin") ~= nil
	and rawget(_G, "svp_ui_markers_add") ~= nil
	and rawget(_G, "svp_ui_markers_commit") ~= nil

-- Marker size in the shader's lens-UV space (0..1 of the disc radius, see
-- svp_ui_markers_add()'s C++-side comment) -- a flat constant rather than an
-- MCM slider for now, since this whole feature is still an in-progress
-- engine patch. PIP_MARKER.lift floats the marker above the head instead of
-- sitting on it (metres, on top of anchor_pos()'s own ANCHOR_LIFT), separate
-- from the main HUD's anchor so the normal card/dot isn't affected by it.
-- PIP_MARKER_RADIUS is the size AT the reference distance below.
-- Bundled into one local (radius/lift/ref-dist/scale floor+ceiling) to spare top-level
-- locals (Lua 5.1's 200-per-chunk limit).
local PIP_MARKER = { radius = 0.03, lift = 0.22, ref = 15, smin = 0.25, smax = 1.3 }

-- Distance scaling for the PiP marker. The radius is a fixed fraction of the lens
-- (screen space), so without this a far target -- whose head is small on screen --
-- gets the same big dot and it overlaps the head. The world LIFT already scales
-- correctly (it's a world offset, its screen gap shrinks with distance), so only the
-- radius needs it. Scale ~ REF_DIST/dist (like apparent size), clamped so a very close
-- target doesn't balloon and a distant one doesn't vanish. PIP_MARKER_RADIUS is the
-- size at PIP_MARKER_REF_DIST metres (tuned so nearby targets look right).
local function pip_marker_radius(dist)
	if not dist or dist <= 0 then
		return PIP_MARKER.radius
	end
	local s = PIP_MARKER.ref / dist
	if s < PIP_MARKER.smin then
		s = PIP_MARKER.smin
	elseif s > PIP_MARKER.smax then
		s = PIP_MARKER.smax
	end
	return PIP_MARKER.radius * s
end

-- Fallback key when key_dik hasn't been captured yet (fresh install, or MCM
-- absent). Resolved lazily via DIK_keys (not ready when this file is
-- parsed). Declared non-local so ii_mcm.script can read it as
-- ii_identify.DEFAULT_KEY_NAME to seed the key-capture widget's default.
DEFAULT_KEY_NAME = "DIK_X"

-- Single-select modifier for the identify key (replaces three independent
-- Ctrl/Shift/Alt checkboxes with one choice, since combining them added
-- little and cluttered the menu). Referenced as ii_identify.MODIFIER_LIST
-- from ii_mcm.script. `label` is the bare suffix MCM appends to
-- "<page>_<option>_lst_" for each dropdown entry when it resolves the
-- display string (confirmed in-game: a full string-table id here shows up
-- literally, doubled with that prefix, instead of resolving).
MODIFIER_LIST = {
	{ label = "none" },
	{ dik = "DIK_LCONTROL", alt_dik = "DIK_RCONTROL", label = "ctrl" },
	{ dik = "DIK_LSHIFT", alt_dik = "DIK_RSHIFT", label = "shift" },
	{ dik = "DIK_LMENU", alt_dik = "DIK_RMENU", label = "alt" },
}

-- Which visual language the tag uses. Referenced as ii_identify.UI_STYLE_LIST
-- from ii_mcm.script, same cross-file pattern as MODIFIER_LIST above.
UI_STYLE_LIST = {
	{ label = "card" },
	{ label = "minimal" },
	{ label = "bodycam" },
	{ label = "simple2" },
}

-- Which distortion the redaction draws. Index order IS the engine mode passed to
-- the redaction shader (list index - 1): 0 pixelate, 1 black. (Glitch was removed.)
-- Referenced as ii_identify.REDACT_STYLE_LIST from ii_mcm.script, same cross-file
-- pattern as MODIFIER_LIST / UI_STYLE_LIST.
REDACT_STYLE_LIST = {
	{ label = "pixelate" },
	{ label = "black" },
}

-- Which region of a dead body the redaction covers. Referenced as
-- ii_identify.REDACT_AREA_LIST from ii_mcm.script.
REDACT_AREA_LIST = {
	{ label = "head" },
	{ label = "body" },
}

-- What the bodycam outline box's colour represents. 1 = faction colour (who they
-- are), 2 = relationship colour (red enemy / green friendly / grey neutral).
-- Referenced as ii_identify.BOX_COLOR_SOURCE_LIST from ii_mcm.script.
BOX_COLOR_SOURCE_LIST = {
	{ label = "faction" },
	{ label = "relation" },
}

-- Community id -> display-name string id. Anything not listed here falls
-- back to a prettified version of the raw community id, so unknown/modded
-- factions still show something reasonable instead of nothing.
local FACTION_NAMES = {
	stalker = "st_ii_faction_stalker",
	bandit = "st_ii_faction_bandit",
	dolg = "st_ii_faction_dolg",
	freedom = "st_ii_faction_freedom",
	csky = "st_ii_faction_csky",
	ecolog = "st_ii_faction_ecolog",
	killer = "st_ii_faction_killer",
	military = "st_ii_faction_military",
	monolith = "st_ii_faction_monolith",
	renegade = "st_ii_faction_renegade",
	zombied = "st_ii_faction_zombied",
	greh = "st_ii_faction_greh",
	trader = "st_ii_faction_trader",
	monster = "st_ii_faction_monster",
	isg = "st_ii_faction_isg",
	arena = "st_ii_faction_arena",
}

local COL_ENEMY = { 224, 76, 64 }
local COL_FRIEND = { 118, 206, 128 }
local COL_NEUTRAL = { 214, 194, 140 }

-- Minimal-style dot colour: distinct per faction (unlike the card's node,
-- which is relation-coloured -- see relation_color() below) so the dot alone
-- identifies WHO, leaving the sign (see relation_sign() below) to convey the
-- relation. Anything not listed here falls back to COL_NEUTRAL, same
-- "unknown/modded faction" fallback spirit as FACTION_NAMES above.
-- Explicit colours below (stalker/bandit/dolg/freedom/killer/isg/greh/
-- monolith) are per user request; the rest fill in the remaining factions
-- distinctly enough to stay readable alongside them.
local FACTION_COLOR = {
	stalker = { 220, 130, 40 }, -- loner orange
	bandit = { 150, 150, 150 }, -- bandit grey
	dolg = { 195, 45, 45 }, -- duty red
	freedom = { 90, 170, 70 }, -- freedom green
	csky = { 120, 190, 230 }, -- clear sky pale blue
	ecolog = { 200, 220, 90 }, -- ecologist yellow-green
	killer = { 60, 110, 200 }, -- mercenary blue
	military = { 120, 120, 70 }, -- military olive/grey
	monolith = { 235, 235, 235 }, -- monolith near-white
	renegade = { 170, 70, 50 }, -- renegade rust/copper
	zombied = { 150, 190, 60 }, -- zombified sickly green
	greh = { 185, 95, 35 }, -- sin burnt orange
	trader = { 220, 190, 60 }, -- trader gold
	monster = { 130, 100, 90 }, -- mutant muted grey-brown
	isg = { 60, 200, 190 }, -- UNISG turquoise
	arena = { 170, 70, 190 }, -- arena purple
}

-- Minimal-style sign colour, keyed by the glyph relation_sign() below
-- returns -- always the true relation colour regardless of
-- C.color_by_relation (that toggle only affects the card's own accent tint;
-- the sign's whole purpose is showing relation clearly).
local SIGN_COLOR = {
	["-"] = COL_ENEMY,
	["+"] = COL_FRIEND,
	["o"] = COL_NEUTRAL,
}

-- Bones to anchor the tag to, best first (humanoid skeleton; monsters that
-- lack all of these fall back to position()+offset in anchor_pos).
local ANCHOR_BONES = { "bip01_head", "bip01_spine2", "bip01_spine1", "bip01_spine" }
local ANCHOR_LIFT = 0.12 -- metres above the matched bone

local C = {} -- live config (DEFAULTS overlaid with MCM values)
local tracked = {} -- [obj_id] = { id, t0, col, name, icon }
---@type IiTags|nil
local TAGS = nil -- the IiTags dialog instance
local SCAN_MS, FADE_MS, HOLD_MS = 350, 450, 4000

-- Aspect-correction factor the engine applies to rotated (SetHeading) statics:
-- the 4:3 virtual UI (1024x768) is stretched onto the real (usually wider)
-- screen, so a strip rotated to an angle in that virtual space needs its X
-- pre-divided by this to still point at the right screen pixel. Recomputed in
-- read_config() (device() isn't ready when this file is first parsed).
local UI_KX = 1

local _prev_on_key_press = nil

-- Shared scratch vectors bundled into ONE local (not nine) to stay well under Lua 5.1's
-- 200-local-per-chunk limit. Each field is a single reusable scratch used in exactly one
-- place (P/S, project_world, the box/aim/body helpers); reused, never per-call allocated.
local _v = {
	p = vector2(),
	s = vector2(),
	scratch = vector(),
	box_c = vector(),
	body_pt = vector(),
	aim_pos = vector(),
	aim_dir = vector(),
	bb_pt = vector(),
	face_c = vector(),
}
local function P(x, y)
	return _v.p:set(x, y)
end
local function S(x, y)
	return _v.s:set(x, y)
end

-- --------------------------------------------------------------------------
-- Config
-- --------------------------------------------------------------------------
-- Every MCM leaf-page id in ii_mcm.script, in tab order. read_config tries each to
-- resolve an option's storage path ("ii/<page>/<key>"). MUST list every page ii_mcm
-- defines -- a page missing here means that page's options silently never load. Global
-- (not local) so it costs no top-level-local slot (Lua 5.1's 200-per-chunk limit).
MCM_PAGES = { "general", "uistyle", "targeting", "binoc", "ads", "pip", "faceredact", "scantime", "debug", "colors" }

local function read_config()
	for key, default in pairs(DEFAULTS) do
		local v = default
		if ui_mcm and ui_mcm.get then
			-- The menu is split into per-section leaf PAGES (ii_mcm.script), so each option
			-- stores under "ii/<page>/<key>". Rather than track which page owns which key,
			-- try each page and take the first hit: every option id is unique and lives on
			-- exactly one page, and get() returns nil for a path with no option there. Only
			-- runs on load / option-change, so the extra lookups cost nothing per frame.
			for _, pg in ipairs(MCM_PAGES) do
				local got = ui_mcm.get("ii/" .. pg .. "/" .. key)
				if got ~= nil then
					v = got
					break
				end
			end
		end
		C[key] = v
	end
	SCAN_MS = math.floor((C.scan_time or 0.35) * 1000)
	FADE_MS = math.floor((C.fade_time or 0.45) * 1000)
	HOLD_MS = math.floor((C.hold_time or 4.0) * 1000)

	-- kx = (h/w) / (UI_BASE_HEIGHT/UI_BASE_WIDTH) = (h/w) / (768/1024). See UI_KX's
	-- declaration for why the leader line needs this.
	local dev = device and device()
	local w = dev and dev.width or 0
	local h = dev and dev.height or 0
	UI_KX = (w > 0 and h > 0) and ((h / w) / (768 / 1024)) or 1

	-- Apply the "Colors" section: mutate each live colour table IN PLACE (never
	-- reassign -- SIGN_COLOR and tracked tags alias these refs). custom_colors off
	-- restores the built-in default so toggling it needs no relaunch. Global lookup,
	-- so it works regardless of this file's source order (COLOR_DEFS is defined below).
	if COLOR_DEFS then
		local on = C.custom_colors
		for _, cd in ipairs(COLOR_DEFS) do
			local d = cd.def
			if on then
				cd.tbl[1] = C["col_" .. cd.id .. "_r"] or d[1]
				cd.tbl[2] = C["col_" .. cd.id .. "_g"] or d[2]
				cd.tbl[3] = C["col_" .. cd.id .. "_b"] or d[3]
			else
				cd.tbl[1], cd.tbl[2], cd.tbl[3] = d[1], d[2], d[3]
			end
		end
	end
end

-- C.key_dik comes straight from MCM's key-capture widget (whatever DIK/mouse
-- code the player last clicked into the box); 0/nil means "never captured
-- one", so fall back to the compiled-in default key.
local function active_dik()
	if C.key_dik and C.key_dik ~= 0 then
		return C.key_dik
	end
	return DIK_keys and DIK_keys[DEFAULT_KEY_NAME]
end

-- key_state() returns a raw C BOOL (marshalled as a Lua number, not a real
-- boolean), so 0 is truthy under plain Lua "if" semantics -- compare
-- explicitly rather than trusting truthiness.
local function key_down(dik)
	if not dik or not key_state then
		return false
	end
	local v = key_state(dik)
	return v ~= nil and v ~= false and v ~= 0
end

local function modifiers_ok()
	local e = MODIFIER_LIST[C.modifier_index] or MODIFIER_LIST[1]
	if not e or not e.dik or not DIK_keys then
		return true
	end
	return key_down(DIK_keys[e.dik]) or (e.alt_dik and key_down(DIK_keys[e.alt_dik])) or false
end

-- Calls fn(...) through pcall and returns its result, or nil on error --
-- collapses the `local ok, v = pcall(...); if not ok then ...` idiom used
-- throughout this file down to a single expression at each call site.
local function safe_call(fn, ...)
	local ok, v = pcall(fn, ...)
	if ok then
		return v
	end
	return nil
end

-- --------------------------------------------------------------------------
-- Faction label / relation colour
-- --------------------------------------------------------------------------
local function faction_label(comm)
	local sid = FACTION_NAMES[comm]
	if sid then
		local txt = safe_call(game.translate_string, sid)
		if txt and txt ~= sid then
			return txt
		end
	end
	local pretty = comm:gsub("_", " ")
	pretty = pretty:gsub("(%a)([%w']*)", function(a, b)
		return a:upper() .. b:lower()
	end)
	return pretty
end

local function faction_color(comm)
	return FACTION_COLOR[comm] or COL_NEUTRAL
end

-- The name shown on the tag: the NPC's own name where they have one (most
-- humanoid stalkers), falling back to the faction label for generic mobs/
-- monsters that carry no personal name.
local function display_name(obj, comm)
	local name = safe_call(obj.character_name, obj)
	if name and name ~= "" then
		local txt = safe_call(game.translate_string, name)
		if txt and txt ~= "" and txt ~= name then
			return txt
		end
		return name
	end
	return faction_label(comm)
end

-- Rank shown under the name: obj:rank_name() (src/xrGame/script_game_object3.cpp:597,
-- SAFE_WRAP-bound at script_game_object_script2.cpp:147) returns a raw id
-- ("novice", "experienced", "veteran", "master", "expert") for CAI_Stalker
-- objects, empty string (logged, not thrown, since it's SAFE_WRAP) for
-- anything else -- monsters/mutants included, which is why this returns nil
-- for them rather than a fallback: no rank line makes more sense than a
-- fabricated one. Localised via "st_rank_" + id, the same convention this
-- engine's own Discord Rich Presence integration uses (Actor.cpp:1442-1449),
-- so it matches the game's own terminology instead of inventing new labels.
-- Rank -> colour for the Simple 2 style's rank bar. A rarity-style gradient from grey
-- (novice) through green/blue/purple/orange/red up to gold (legend). Keyed by the
-- engine rank id (obj:rank_name); anything unknown / rankless falls back to grey.
local RANK_COLOR = {
	novice = { 165, 165, 165 }, -- grey
	trainee = { 205, 205, 205 }, -- light grey
	experienced = { 120, 200, 120 }, -- green
	professional = { 90, 165, 235 }, -- blue
	veteran = { 175, 120, 225 }, -- purple
	expert = { 235, 165, 70 }, -- orange
	master = { 225, 80, 70 }, -- red
	legend = { 240, 205, 90 }, -- gold
}
local function rank_color(obj)
	local rid = safe_call(obj.rank_name, obj)
	return (rid and RANK_COLOR[rid]) or { 150, 150, 150 }
end

-- User-configurable colours (MCM "Colors" section). MCM has no colour-picker
-- widget, so each colour is exposed as three 0-255 R/G/B tracks. This registry is
-- the single source of truth for BOTH the runtime apply (read_config) and the menu
-- generation (ii_mcm.script reads ii_identify.COLOR_DEFS): each entry points `tbl`
-- at a LIVE colour table above, so applying overrides mutates it IN PLACE -- the
-- faction/rank/relation tables are shared by reference (SIGN_COLOR aliases COL_*,
-- tracked tags hold the same refs), so one in-place update recolours everything,
-- including in-flight tags. Global (not local) so it costs no top-level-local slot.
COLOR_DEFS = {
	{ id = "rel_enemy", group = "rel", tbl = COL_ENEMY },
	{ id = "rel_friend", group = "rel", tbl = COL_FRIEND },
	{ id = "rel_neutral", group = "rel", tbl = COL_NEUTRAL },
	{ id = "fac_stalker", group = "fac", tbl = FACTION_COLOR.stalker },
	{ id = "fac_bandit", group = "fac", tbl = FACTION_COLOR.bandit },
	{ id = "fac_dolg", group = "fac", tbl = FACTION_COLOR.dolg },
	{ id = "fac_freedom", group = "fac", tbl = FACTION_COLOR.freedom },
	{ id = "fac_csky", group = "fac", tbl = FACTION_COLOR.csky },
	{ id = "fac_ecolog", group = "fac", tbl = FACTION_COLOR.ecolog },
	{ id = "fac_killer", group = "fac", tbl = FACTION_COLOR.killer },
	{ id = "fac_military", group = "fac", tbl = FACTION_COLOR.military },
	{ id = "fac_monolith", group = "fac", tbl = FACTION_COLOR.monolith },
	{ id = "fac_renegade", group = "fac", tbl = FACTION_COLOR.renegade },
	{ id = "fac_zombied", group = "fac", tbl = FACTION_COLOR.zombied },
	{ id = "fac_greh", group = "fac", tbl = FACTION_COLOR.greh },
	{ id = "fac_trader", group = "fac", tbl = FACTION_COLOR.trader },
	{ id = "fac_monster", group = "fac", tbl = FACTION_COLOR.monster },
	{ id = "fac_isg", group = "fac", tbl = FACTION_COLOR.isg },
	{ id = "fac_arena", group = "fac", tbl = FACTION_COLOR.arena },
	{ id = "rank_novice", group = "rank", tbl = RANK_COLOR.novice },
	{ id = "rank_trainee", group = "rank", tbl = RANK_COLOR.trainee },
	{ id = "rank_experienced", group = "rank", tbl = RANK_COLOR.experienced },
	{ id = "rank_professional", group = "rank", tbl = RANK_COLOR.professional },
	{ id = "rank_veteran", group = "rank", tbl = RANK_COLOR.veteran },
	{ id = "rank_expert", group = "rank", tbl = RANK_COLOR.expert },
	{ id = "rank_master", group = "rank", tbl = RANK_COLOR.master },
	{ id = "rank_legend", group = "rank", tbl = RANK_COLOR.legend },
}

-- Capture each colour's built-in default (for the custom_colors=off restore) and
-- register its three MCM-backed keys so read_config picks them up generically.
DEFAULTS.custom_colors = false -- master toggle: off = built-in colours, on = the overrides below
for _, cd in ipairs(COLOR_DEFS) do
	cd.def = { cd.tbl[1], cd.tbl[2], cd.tbl[3] }
	DEFAULTS["col_" .. cd.id .. "_r"] = cd.tbl[1]
	DEFAULTS["col_" .. cd.id .. "_g"] = cd.tbl[2]
	DEFAULTS["col_" .. cd.id .. "_b"] = cd.tbl[3]
end

local function rank_label(obj)
	local rid = safe_call(obj.rank_name, obj)
	if not rid or rid == "" then
		return nil
	end
	local txt = safe_call(game.translate_string, "st_rank_" .. rid)
	if txt and txt ~= "" and txt ~= ("st_rank_" .. rid) then
		return txt
	end
	local pretty = rid:gsub("_", " ")
	pretty = pretty:gsub("(%a)([%w']*)", function(a, b)
		return a:upper() .. b:lower()
	end)
	return pretty
end

-- Caliber string for a weapon section, e.g. "5.45x39", "9x18", "12x70".
-- Weapon sections carry no explicit caliber field, but ammo_class points at
-- the ammo section(s) the gun chambers (a comma-separated list, e.g.
-- "ammo_5.45x39_fmj, ammo_5.45x39_ap"); the caliber is the NxM token baked
-- into that ammo id. Best-effort: returns nil (no caliber shown) when there's
-- no ammo_class or the token doesn't match the standard cartridge pattern
-- (gauss/energy/grenade ammo, exotic naming), rather than guessing wrong.
local function weapon_caliber(sec)
	if not ini_sys or not sec then
		return nil
	end
	local ac = safe_call(ini_sys.r_string, ini_sys, sec, "ammo_class")
	if not ac or ac == "" then
		return nil
	end
	local first = ac:match("^%s*([^,]+)") -- first ammo section if it's a list
	local cal = first and first:match("[%d%.]+x[%d%.]+") -- e.g. 5.45x39 / 9x18 / 12x70
	if cal and cal ~= "" then
		return cal
	end
	return nil
end

-- The target's currently-wielded weapon name (with caliber appended when it
-- can be derived), shown as an extra line on the card when C.show_weapon is on.
-- obj:best_weapon() (src/xrGame/script_game_object_script2.cpp:217, SAFE_WRAP-
-- bound to CObjectHandler::best_weapon) returns the NPC's equipped weapon
-- game_object, or nil for the unarmed / monsters / mutants -- the same call the
-- engine's own trade and stalker-combat code use to find "the gun this NPC is
-- actually holding" (see this repo's axr_main-adjacent aaaa_script_fixes_mp
-- best_weapon() calls). Its section's "inv_name", run through translate_string,
-- is the exact readable name the inventory UI shows; if that lookup fails
-- (throws on a missing field -- swallowed by safe_call), a prettified section
-- id is the fallback. Returns nil (no line) rather than a placeholder when
-- there's no weapon to show.
local function held_weapon_label(obj)
	if not C.show_weapon then
		return nil
	end
	local wpn = safe_call(obj.best_weapon, obj)
	if not wpn then
		return nil
	end
	local sec = safe_call(wpn.section, wpn)
	if not sec or sec == "" then
		return nil
	end

	local label
	if ini_sys then
		local inv = safe_call(ini_sys.r_string, ini_sys, sec, "inv_name")
		if inv and inv ~= "" then
			local txt = safe_call(game.translate_string, inv)
			if txt and txt ~= "" and txt ~= inv then
				label = txt
			end
		end
	end
	if not label then
		label = sec:gsub("^wpn_", ""):gsub("_", " ")
		label = label:gsub("(%a)([%w']*)", function(a, b)
			return a:upper() .. b:lower()
		end)
	end

	local cal = weapon_caliber(sec)
	if cal then
		return label .. "  (" .. cal .. ")"
	end
	return label
end

-- Faction patch texture id: the same "<community_id>_icon" convention the
-- game's own character/relations UI uses (src/xrGame/ui/UICharacterInfo.cpp),
-- so this reuses whatever emblem art already ships with the game/modpack
-- instead of needing bundled icons for every faction.
local function faction_icon_id(comm)
	return comm .. "_icon"
end

local function relation_color(obj)
	if not C.color_by_relation then
		return COL_NEUTRAL
	end
	local rel = safe_call(obj.relation, obj, db.actor)
	if rel == game_object.enemy then
		return COL_ENEMY
	end
	if rel == game_object.friend then
		return COL_FRIEND
	end
	return COL_NEUTRAL
end

-- Minimal-style relation sign -- unlike relation_color() above, always
-- distinguishes hostile/friendly/neutral regardless of C.color_by_relation
-- (that toggle only affects the card's own accent tint; the whole point of
-- the sign in minimal style is showing relation clearly).
local function relation_sign(obj)
	local rel = safe_call(obj.relation, obj, db.actor)
	if rel == game_object.enemy then
		return "-"
	end
	if rel == game_object.friend then
		return "+"
	end
	return "o"
end

-- --------------------------------------------------------------------------
-- World anchor / projection
-- --------------------------------------------------------------------------
local function anchor_pos(obj)
	local base = obj:position()
	for _, bone in ipairs(ANCHOR_BONES) do
		local p = safe_call(obj.bone_position, obj, bone)
		if p and p:distance_to_sqr(base) < 9 then
			p.y = p.y + ANCHOR_LIFT
			return p
		end
	end
	base.y = base.y + 1.3
	return base
end

local function project_world(pos)
	local w2u = (game and game.world2ui) or (level and level.world2ui)
	if not w2u then
		return nil
	end
	local ui = w2u(_v.scratch:set(pos), false, false)
	if not ui or ui.x < -9000 then
		return nil
	end
	return ui.x, ui.y
end

-- View-space depth (metres along the view axis) of a world point: the projection
-- of (pos - cam_pos) onto the camera forward. Matches the engine's s_position.z,
-- so the redaction shader can skip anything nearer than this (the viewmodel /
-- foreground) -- see redaction_submit + bodycam_redaction.ps. 0 (no test) if unavailable.
local function view_depth(pos)
	local dev = device and device()
	local cp = dev and dev.cam_pos
	local cd = dev and dev.cam_dir
	if not cp or not cd then
		return 0
	end
	local d = (pos.x - cp.x) * cd.x + (pos.y - cp.y) * cd.y + (pos.z - cp.z) * cd.z
	return d > 0 and d or 0
end

-- world2ui returns coordinates in the engine's fixed 1024x768 "virtual UI"
-- space regardless of actual resolution/aspect, so the screen centre (where the
-- crosshair normally sits) is always exactly (512, 384) here.
local UI_CX, UI_CY = 512, 384

-- --------------------------------------------------------------------------
-- Bodycam style: a faction-coloured outline box locked to the head bone.
-- --------------------------------------------------------------------------
-- Head anchor. bip01_head sits at the SKULL BASE (top of the neck), not the
-- face centre -- a box centred straight on it rides low over the neck/chest, so
-- lift it up to the middle of the head. Returns nil for monsters/rigs without a
-- bip01_head bone -- caller falls back to anchor_pos() for those.
local HEAD_LIFT = 0.09 -- metres of world-up from bip01_head to the face centre
local function head_center(obj)
	local base = obj:position()
	local p = safe_call(obj.bone_position, obj, "bip01_head")
	if p and p:distance_to_sqr(base) < 9 then
		p.y = p.y + HEAD_LIFT
		return p
	end
	return nil
end

-- Half-extents (metres) of the HEAD box, padding included. Head is taller than
-- wide, so H > W. Tunable constants, not MCM sliders (the box auto-scales with
-- distance, nothing resolution-specific). The full-body box is computed
-- differently -- from projected ragdoll bone bounds, see body_box_for.
local BOX_HALF_W = 0.17
local BOX_HALF_H = 0.22

-- Screen bounding box (1024x768 virtual space) of a box of metric half-extents
-- hw_m/hh_m centred at world `center`, as cx,cy,hw,hh.
--
-- Projects all FOUR corners (center +/- cam_right*hw_m +/- cam_top*hh_m) and
-- bounds them, rather than offsetting along one axis and reading a single screen
-- delta. The single-axis shortcut is only correct at screen centre: under
-- perspective, an off-centre world offset projects DIAGONALLY (mixed x and y)
-- and with non-uniform scale, so near the screen edges the old method mis-sized
-- and mis-centred the box -- the "slips off the head at the corners" bug. The
-- 4-corner bound is perspective-correct everywhere. nil if the camera vectors or
-- any corner projection aren't available this frame.
local function screen_box(center, hw_m, hh_m)
	local dev = device and device()
	local cr = dev and dev.cam_right
	local ct = dev and dev.cam_top
	if not cr or not ct then
		return nil
	end
	local minx, miny, maxx, maxy
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			local px, py = project_world(
				_v.box_c:set(
					center.x + cr.x * hw_m * sx + ct.x * hh_m * sy,
					center.y + cr.y * hw_m * sx + ct.y * hh_m * sy,
					center.z + cr.z * hw_m * sx + ct.z * hh_m * sy
				)
			)
			if not px then
				return nil
			end
			if not minx then
				minx, miny, maxx, maxy = px, py, px, py
			else
				if px < minx then
					minx = px
				elseif px > maxx then
					maxx = px
				end
				if py < miny then
					miny = py
				elseif py > maxy then
					maxy = py
				end
			end
		end
	end
	local hw, hh = (maxx - minx) * 0.5, (maxy - miny) * 0.5
	if hw < 1 or hh < 1 then
		return nil
	end
	return (minx + maxx) * 0.5, (miny + maxy) * 0.5, hw, hh, view_depth(center)
end

-- Engine redaction post-process binding: distorts the real scene inside a LIST of
-- screen-space rectangles (one per visible dead body's head), added by the
-- custom bodycam exe (bodycam.redaction_begin/add/commit). Same guarded existence
-- pattern as bodycam.get_fire_ray -- fully inert on a stock exe, so the box
-- still draws, just without distortion. Rects are NORMALISED [0,1] screen space
-- (top-left origin); the engine passes them straight to the shader as box UVs.
-- Our box extents are in world2ui's fixed 1024x768 virtual space, which maps
-- across the whole screen, so dividing by 1024/768 gives [0,1].
local REDACTION_MAX = 16 -- must match BODYCAM_REDACTION_MAX in the engine + shader

local function redaction_binding()
	local bc = rawget(_G, "bodycam")
	if bc and bc.redaction_begin and bc.redaction_add and bc.redaction_commit then
		return bc
	end
	return nil
end

-- Submit a list of head boxes (each {cx,cy,hw,hh,depth} in 1024x768 virtual
-- space + metres) as one atomic frame. intensity 0 (or an empty list) clears the
-- effect. depth is the box's view-space depth; the engine skips pixels nearer
-- than it (the viewmodel / foreground) so the effect never covers the gun/hands.
-- main_off: suppress the MAIN-pass redaction (but keep the in-scope pass) by
-- submitting each box's main-camera rect off-screen -- the main redaction shader
-- finds no pixels in a rect outside [0,1], while the engine still reprojects the
-- WORLD box for the scope pass. Used by pip_hide_main / ads_hide_main.
local function redaction_submit(boxes, n, intensity, main_off, style)
	local bc = redaction_binding()
	if not bc then
		return
	end
	-- Redaction style (pixelate/black) -> 0-based engine mode. `style` is the face
	-- style from feed_redaction; guarded so an older exe without this binding just
	-- keeps mode 0 (pixelate).
	if bc.redaction_set_mode then
		pcall(bc.redaction_set_mode, ((style or C.redact_face_style or 1) - 1))
	end
	-- pip_redact (MCM) gates the in-scope redaction: when off, zero the world
	-- extents so the engine's SVP pass skips it (main-pass redaction still uses
	-- the screen rect above, unaffected).
	local in_scope = C.pip_redact ~= false
	pcall(bc.redaction_begin)
	for i = 1, n do
		local b = boxes[i]
		-- Main-camera normalised rect + view depth (main pass), then the box's
		-- WORLD centre + world half-extents (metres) which the engine reprojects
		-- through the scope camera for the in-scope pass. redaction_add ignores the
		-- world args on an older exe (5-arg binding) -- pcall + arg drop.
		local mx0, my0, mx1, my1
		if main_off then
			mx0, my0, mx1, my1 = 2.0, 2.0, 2.001, 2.001 -- off-screen: no main-pass draw
		else
			mx0, my0 = (b.cx - b.hw) / 1024, (b.cy - b.hh) / 768
			mx1, my1 = (b.cx + b.hw) / 1024, (b.cy + b.hh) / 768
		end
		pcall(
			bc.redaction_add,
			mx0,
			my0,
			mx1,
			my1,
			b.depth or 0,
			in_scope and (b.wcx or 0) or 0,
			in_scope and (b.wcy or 0) or 0,
			in_scope and (b.wcz or 0) or 0,
			in_scope and (b.whw or 0) or 0,
			in_scope and (b.whh or 0) or 0
		)
	end
	pcall(bc.redaction_commit, (n > 0) and intensity or 0.0)
end

local function redaction_clear()
	local bc = redaction_binding()
	if bc then
		pcall(bc.redaction_begin)
		pcall(bc.redaction_commit, 0.0)
	end
end

-- Tracks the redaction on/off edge so the debug log only fires on the transition
-- (not every frame) when debug_log is on. See feed_redaction().
local _redaction_dbg_active = false

-- Free-aim target-assist centre. On a normal engine the weapon points at the
-- screen centre, so the FOV assist circle is centred on (512,384). On a bodycam
-- / free-aim engine the barrel points OFF-centre, so the assist has to follow
-- it. Two possible sources, in order of preference:
--
--   1. level.get_target_pos(ETraceTarget.Weapon) -- a world point along the
--      rendered weapon barrel. Clean, but requires the ETraceTarget binding AND
--      for that binding to actually reflect free aim. On the tested bodycam
--      build NEITHER held: ETraceTarget is entirely absent, and even where it
--      exists it traces screen centre (free aim is applied in the render /
--      ballistic layer, not the logical weapon pick that Lua sees).
--
--   2. bodycam.get_fire_ray() -- the gameplay aim ray {pos,dir} from the actor's
--      first-eye camera. Under bodycam the render camera (which world2ui and the
--      screen-centre pick use) is a swayed OVERRIDE of the first-eye camera, so
--      only the first-eye ray reflects where the player is actually aiming. This
--      needs a small engine binding added to the bodycam module (see SPEC.md
--      "Free-aim support"); it does NOT exist in the stock bodycam engine, so
--      this path stays inert until it's compiled in. When present, we project a
--      far point along the ray and world2ui it to get the reticle screen point.
--
-- Returns nil when neither source is available (caller falls back to centre).
local FREEAIM_PROJECT_DIST = 100 -- metres along the fire ray to project for the reticle screen point

-- source "bar" -> the weapon BARREL/sight ray (used under ADS, where you aim DOWN the
-- sight, so the on-screen aim point is the aligned weapon model, not the crosshair);
-- anything else -> the first-eye / bullet ray (the hip-fire crosshair). Falls back to
-- the eye ray if the barrel fields are absent (no weapon / knife / stock exe).
local function freeaim_ray(source)
	local bc = rawget(_G, "bodycam")
	if not (bc and bc.get_fire_ray) then
		return nil
	end
	local ok, r = pcall(bc.get_fire_ray)
	if not ok or type(r) ~= "table" or r.valid == false or not r.dir_x then
		return nil
	end
	if source == "bar" and r.bar_dir_x then
		return r.bar_pos_x, r.bar_pos_y, r.bar_pos_z, r.bar_dir_x, r.bar_dir_y, r.bar_dir_z
	end
	return r.pos_x, r.pos_y, r.pos_z, r.dir_x, r.dir_y, r.dir_z
end

-- Lightweight ADS check for the aim SOURCE (the full is_ads_active is defined later).
-- Reads the bodycam engine's authoritative ADS flag; false on a stock exe.
local function freeaim_is_ads()
	local bc = rawget(_G, "bodycam")
	if bc and bc.get_state then
		local ok, st = pcall(bc.get_state)
		if ok and type(st) == "table" and st.ads ~= nil then
			return st.ads and true or false
		end
	end
	return false
end

local function weapon_aim_ui()
	if level and level.get_target_pos and level.ETraceTarget then
		local wpos = safe_call(level.get_target_pos, level.ETraceTarget.Weapon)
		if wpos and not (wpos.x == 0 and wpos.y == 0 and wpos.z == 0) then
			local sx, sy = project_world(wpos)
			if sx then
				return sx, sy
			end
		end
	end
	-- Under ADS, aim down the SIGHT: the on-screen aim point is the aligned weapon
	-- barrel, not the first-eye crosshair. Hip-fire keeps the eye/bullet ray (which is
	-- why hip-fire matched but ADS didn't). The barrel ray falls back to the eye ray
	-- when unavailable.
	local source = freeaim_is_ads() and "bar" or nil
	local px, py, pz, dx, dy, dz = freeaim_ray(source)
	if px then
		local far =
			vector():set(px + dx * FREEAIM_PROJECT_DIST, py + dy * FREEAIM_PROJECT_DIST, pz + dz * FREEAIM_PROJECT_DIST)
		return project_world(far)
	end
	return nil
end

-- The point the FOV target-assist circle is measured from this frame: the
-- weapon's real aim point when free-aim assist is enabled and available,
-- otherwise the fixed screen centre. NOTE: the live assist is now angular
-- (aim_angle_to_body / aim_cone_rad) -- this and weapon_aim_ui above only feed the
-- debug visualiser (draw_debug) and the aim-debug dump now, not target selection.
local function aim_center()
	if C.freeaim_assist then
		local sx, sy = weapon_aim_ui()
		if sx then
			return sx, sy
		end
	end
	return UI_CX, UI_CY
end

-- Bones sampled across the whole body so the FOV target-assist matches wherever
-- you aim on an NPC, not just one anchor point (aiming at the legs/torso used to
-- miss when only the head/chest anchor was tested). Humanoid bip01 rig; monsters
-- and anything without these bones fall back to a vertical span at the origin.
local BODY_BONES = {
	"bip01_head",
	"bip01_neck",
	"bip01_spine2",
	"bip01_spine1",
	"bip01_spine",
	"bip01_pelvis",
	"bip01_l_forearm",
	"bip01_r_forearm",
	"bip01_l_calf",
	"bip01_r_calf",
}

-- --------------------------------------------------------------------------
-- Debug (MCM "Log aim debug"): on every identify attempt, dump the trace/aim
-- state to the mod's own log file (appdata/logs/immersive_identification.log via
-- dbg() -> ii_log_file(); falls back to xray_*.log) so free-aim problems can be
-- diagnosed from real numbers instead of guessed at. Off by default; the whole
-- block is skipped when C.debug_log is false, so it costs nothing in normal
-- play. Key comparison: whether the WEAPON trace differs from the CAMERA trace,
-- and whether the bodycam module exposes the free-aim offset.
-- --------------------------------------------------------------------------
-- Dedicated log file so the mod's debug output doesn't get buried in the shared
-- xray_*.log. Opened lazily (append) under the game's logs directory
-- (appdata/logs/immersive_identification.log) on the first dbg() call, with a
-- timestamped session header. Falls back to printf (the game log) if io / the FS
-- alias isn't available on this build. Only ever touched while debug_log is on.
-- State bundled into one table to stay under Lua 5.1's 200-local-per-chunk limit.
local _iilog = { f = nil, tried = false }
local function ii_log_file()
	if _iilog.tried then
		return _iilog.f
	end
	_iilog.tried = true
	local lio = rawget(_G, "io")
	local gfs = rawget(_G, "getFS")
	if not (lio and lio.open and gfs) then
		return nil
	end
	local ok, path = pcall(function()
		return gfs():update_path("$logs$", "immersive_identification.log")
	end)
	if not ok or type(path) ~= "string" then
		return nil
	end
	local f = lio.open(path, "a")
	_iilog.f = f
	if f then
		local osl = rawget(_G, "os")
		local stamp = (osl and osl.date) and osl.date("%Y-%m-%d %H:%M:%S") or "?"
		f:write("\n==== immersive-identification session " .. stamp .. " ====\n")
		f:flush()
	end
	return f
end

local function dbg(msg)
	if not C.debug_log then
		return
	end
	local line = "[ii] " .. tostring(msg)
	local f = ii_log_file()
	if f then
		local osl = rawget(_G, "os")
		local t = (osl and osl.date) and osl.date("%H:%M:%S ") or ""
		f:write(t, line, "\n")
		f:flush()
	elseif printf then
		printf("%s", line) -- fallback to the shared game log when the dedicated file can't open
	end
end

local function fv(v)
	if not v then
		return "nil"
	end
	return string.format("(%.2f, %.2f, %.2f)", v.x or 0, v.y or 0, v.z or 0)
end

local function obj_desc(o)
	if not o then
		return "nil"
	end
	local nm = safe_call(o.character_name, o) or safe_call(o.name, o) or "?"
	return tostring(nm) .. "#" .. tostring(o:id())
end

local function ui_of(pos)
	if not pos then
		return "nil"
	end
	local sx, sy = project_world(pos)
	if not sx then
		return "offscreen"
	end
	return string.format("(%.0f, %.0f)", sx, sy)
end

local function debug_dump_aim()
	if not C.debug_log then
		return
	end
	dbg("---- identify ----")
	local dev = device and device()
	if dev then
		dbg(string.format("cam_pos=%s cam_dir=%s fov=%.1f", fv(dev.cam_pos), fv(dev.cam_dir), dev.fov or -1))
	end

	local ET = level and level.ETraceTarget
	if not ET then
		dbg("level.ETraceTarget MISSING (no weapon-trace binding on this engine)")
	else
		dbg(
			string.format(
				"obj  camera=%s  weapon=%s",
				obj_desc(safe_call(level.get_target_obj, ET.Camera)),
				obj_desc(safe_call(level.get_target_obj, ET.Weapon))
			)
		)
		if level.get_target_pos then
			local cpos = safe_call(level.get_target_pos, ET.Camera)
			local wpos = safe_call(level.get_target_pos, ET.Weapon)
			dbg(string.format("pos  camera=%s ui=%s", fv(cpos), ui_of(cpos)))
			dbg(string.format("pos  weapon=%s ui=%s", fv(wpos), ui_of(wpos)))
		else
			dbg("level.get_target_pos MISSING")
		end
	end

	local cx, cy = aim_center()
	dbg(string.format("aim_center=(%.0f, %.0f)  screen_center=(%d, %d)", cx, cy, UI_CX, UI_CY))

	local bc = rawget(_G, "bodycam")
	if not (bc and bc.get_state) then
		dbg("bodycam module not present")
	else
		local ok, st = pcall(bc.get_state)
		if not ok or type(st) ~= "table" then
			dbg("bodycam.get_state() failed")
		else
			dbg(
				string.format(
					"bodycam active=%s ads=%s mstate=%s",
					tostring(st.active),
					tostring(st.ads),
					tostring(st.mstate)
				)
			)
			dbg(
				string.format(
					"bodycam yaw=%s pitch=%s roll=%s",
					tostring(st.camera_yaw),
					tostring(st.camera_pitch),
					tostring(st.camera_roll)
				)
			)
			dbg(
				string.format(
					"bodycam vm_pos=(%s,%s,%s) vm_rot=(%s,%s,%s)",
					tostring(st.vm_pos_x),
					tostring(st.vm_pos_y),
					tostring(st.vm_pos_z),
					tostring(st.vm_rot_x),
					tostring(st.vm_rot_y),
					tostring(st.vm_rot_z)
				)
			)
		end
	end

	local bc2 = rawget(_G, "bodycam")
	if bc2 and bc2.get_fire_ray then
		local ok3, r = pcall(bc2.get_fire_ray)
		if ok3 and type(r) == "table" and r.valid ~= false and r.dir_x then
			local eye = vector():set(
				r.pos_x + r.dir_x * FREEAIM_PROJECT_DIST,
				r.pos_y + r.dir_y * FREEAIM_PROJECT_DIST,
				r.pos_z + r.dir_z * FREEAIM_PROJECT_DIST
			)
			dbg(string.format("aim(eye)    dir=(%.2f,%.2f,%.2f) ui=%s", r.dir_x, r.dir_y, r.dir_z, ui_of(eye)))
			if r.bar_dir_x then
				local bar = vector():set(
					r.bar_pos_x + r.bar_dir_x * FREEAIM_PROJECT_DIST,
					r.bar_pos_y + r.bar_dir_y * FREEAIM_PROJECT_DIST,
					r.bar_pos_z + r.bar_dir_z * FREEAIM_PROJECT_DIST
				)
				dbg(
					string.format(
						"aim(barrel) dir=(%.2f,%.2f,%.2f) ui=%s",
						r.bar_dir_x,
						r.bar_dir_y,
						r.bar_dir_z,
						ui_of(bar)
					)
				)
			end
		else
			dbg("bodycam.get_fire_ray returned invalid (no controlled actor?)")
		end
	else
		dbg("bodycam.get_fire_ray absent -- recompile engine with the binding (see SPEC 'Free-aim support')")
	end
end

-- Geometric occlusion test.
--
-- db.actor:see() below is smoothed/cached with a short grace window on losing
-- sight -- so an NPC that just stepped behind a wall (or one the AI still
-- "remembers") keeps reading visible for a beat, which is exactly how occluded
-- targets were still getting identified. A fresh, instantaneous raycast against
-- STATIC world geometry closes that gap. ray_pick / rq_target confirmed in
-- xray-monolith src/xrGame/level_script.cpp (class_<CRayPick>("ray_pick"),
-- enum rq_target).
--
-- Cast from the target's anchor point (chest/head, already lifted clear of the
-- floor) toward the active camera, stopping RAY_LOS_TOL short so near-eye
-- geometry can't false-trigger. rqtStatic only, so other NPCs / the actor never
-- self-block -- the trade-off is that anything with solid static collision
-- blocks even when you can see through it (chain-link fences, some foliage);
-- acceptable for the far more common "behind a building/wall" case. query()
-- returns true when the ray HIT something (i.e. occluded), so a clear line of
-- sight is `not query()`.
local RAY_LOS_TOL = 0.3 -- metres: stop short of the camera
local RQT_STATIC = (rq_target and rq_target.rqtStatic) or 2 -- collide::rqtStatic
local RQT_BOTH = (rq_target and rq_target.rqtBoth) or 3 -- collide::rqtStatic|rqtObject
-- LOS scratch bundled into one local (ray handle + scratch vectors) to stay under Lua
-- 5.1's 200-local-per-chunk limit.
local _los = { ray = nil, dir = vector(), pt = vector() }

-- Body bones sampled for the multi-point LOS backstop (below), spread head-to-toe so
-- ANY exposed part counts as visible. The head anchor is tested separately first (the
-- common fully-visible early-out), so this list is the rest of the body -- a target is
-- only "occluded" when the head AND every one of these is blocked by static geometry.
local LOS_BONES = { "bip01_spine2", "bip01_spine", "bip01_pelvis", "bip01_l_calf", "bip01_r_calf" }

-- Cast one static-geometry ray from `origin` toward the camera, stopping RAY_LOS_TOL
-- short so near-eye geometry can't false-trigger. Returns: true = clear (unblocked),
-- false = blocked, nil = point-blank / API absent (caller treats nil as "clear"/fail-open).
local function _los_point_clear(origin, cam_pos)
	local dir = _los.dir:set(cam_pos):sub(origin) -- cam - origin
	local dist = dir:magnitude()
	if dist <= RAY_LOS_TOL then
		return nil -- essentially point-blank -> fail open
	end
	dir:normalize()
	local ok, blocked = pcall(function()
		if not _los.ray then
			if not rawget(_G, "ray_pick") then
				return nil
			end
			_los.ray = ray_pick()
		end
		_los.ray:set_flags(RQT_STATIC)
		_los.ray:set_position(origin)
		_los.ray:set_direction(dir)
		_los.ray:set_range(dist - RAY_LOS_TOL)
		return _los.ray:query()
	end)
	if not ok or blocked == nil then
		return nil -- API absent / errored -> fail open
	end
	return not blocked
end

-- Multi-point line-of-sight backstop: clear if the head anchor OR any sampled body
-- bone has an unobstructed ray to the camera. So a target whose head is behind cover
-- but whose torso/legs are exposed still counts as visible (was head-anchor only,
-- which vetoed any target with just its head occluded). A target FULLY behind static
-- geometry has every point blocked -> occluded, preserving the "behind a wall" guard.
-- Head first so the common fully-visible case early-outs on the first ray.
local function has_clear_ray(target_obj)
	local dev = device and device()
	if not dev or not dev.cam_pos then
		return true
	end -- fail open
	local cam = dev.cam_pos

	-- 1) Head anchor (lifted): the usual case, and the cheapest to pass on.
	local origin = anchor_pos(target_obj)
	if origin then
		local clear = _los_point_clear(origin, cam)
		if clear ~= false then
			return true -- clear, or nil (point-blank / API absent -> fail open)
		end
	end

	-- 2) Head occluded: try a spread of body bones; any clear one = visible.
	local base = safe_call(target_obj.position, target_obj)
	if base then
		for _, bone in ipairs(LOS_BONES) do
			local p = safe_call(target_obj.bone_position, target_obj, bone)
			if p and p:distance_to_sqr(base) < 25 then -- sane bone (within 5 m of origin)
				local clear = _los_point_clear(_los.pt:set(p), cam)
				if clear ~= false then
					return true -- a body part is exposed (or fail-open)
				end
			end
		end
	end

	return false -- head and every sampled body point blocked -> occluded
end

-- Line-of-sight check: screen-space proximity alone doesn't prove visibility
-- (an NPC behind a building can still project near the crosshair), and
-- neither does a raw raycast hit (see get_target_obj() below) -- so every
-- candidate is gated through this instead. Two layers, both must pass: the
-- engine's own visibility primitive `obj:see(other)`
-- (src/xrGame/script_game_object_script2.cpp:138 -> CheckObjectVisibility ->
-- CActorMemory::visible_now(), a real camera-driven per-triangle occlusion
-- raycast, the same one autoaim and PDA marker gating use) for "can the player
-- actually perceive this" (darkness, stealth), AND has_clear_ray() as a hard
-- geometric backstop for see()'s grace-window leak through solid geometry.
local function has_los(target_obj)
	if not db.actor then
		return true
	end
	local ok, visible = pcall(db.actor.see, db.actor, target_obj)
	if not ok then
		return true
	end -- fail open: don't block selection if the check itself errors
	if not visible then
		return false
	end
	return has_clear_ray(target_obj)
end

-- Per-frame visibility for the hide_unseen drop. db.actor:see alone is too
-- laggy here: its grace/memory window keeps a target flagged visible for a
-- while after it steps behind a wall, so the tag would linger and fade on its
-- normal timer instead of dropping. So this ALSO requires has_clear_ray -- a
-- fresh geometric raycast against static geometry that goes false the instant a
-- wall interposes, giving the near-instant drop the option promises. Fails open
-- (never blanks a tag on a check error). Per-frame across tracked targets, but
-- there are only ever a handful.
local function tag_visible(obj)
	if not db.actor then
		return true
	end
	local ok, visible = pcall(db.actor.see, db.actor, obj)
	if not ok then
		return true
	end
	if not visible then
		return false
	end
	return has_clear_ray(obj)
end

-- Fallback target search: the nearest identifiable, visible NPC/creature to
-- the aim point on screen (not the nearest to the actor in world space) within
-- fov_radius, so an approximate aim still finds someone -- you don't have to
-- land a pixel-perfect hit on them. The aim point is the screen centre on a
-- normal engine, or the weapon's real (off-centre) barrel point on a bodycam /
-- free-aim engine -- see aim_center().
--
-- Candidates already mid-identification (tracked[id] set) are kept in a
-- separate "busy" runner-up rather than competing on screen distance: a
-- target you've already triggered shouldn't out-rank some other eligible
-- target just for sitting closer to the aim point, since re-hitting it does
-- nothing new (see try_identify()'s tracked[id] branch) -- the busy one is
-- only ever returned when nothing else in the FOV circle qualifies at all.
-- Forward declarations, defined after _fov_baseline + the aim-ray helpers below:
--   aim_angle_to_body(obj) -> smallest ANGLE (radians) from the true aim ray to any
--     sampled body point, or nil (the angular measure the assist selects on).
--   aim_cone_rad() -> the assist tolerance as an angle (fov_radius calibrated at the
--     unzoomed FOV), so it's a CONSTANT real angle -- magnification-invariant.
-- The assist is measured angularly (from where the scope/gun actually points) rather
-- than as a main-camera screen ring: under a PiP scope the main camera is the swayed,
-- un-zoomed render camera, so a screen ring both shrinks wrongly with magnification and
-- misses by the sway offset. Angles from the aim ray have neither problem.
local aim_angle_to_body
local aim_cone_rad

local function find_nearest_in_fov(max_dist)
	if not db.actor or not level.iterate_nearest then
		return nil
	end
	local apos = db.actor:position()
	local actor_id = db.actor:id()
	local cone = aim_cone_rad()
	local best_obj, best_a = nil, cone
	local best_busy_obj, best_busy_a = nil, cone

	pcall(level.iterate_nearest, apos, max_dist, function(obj)
		if obj and obj:id() ~= actor_id and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			local alive = safe_call(obj.alive, obj)
			if alive then
				local comm = safe_call(obj.character_community, obj)
				if comm and comm ~= "" then
					-- Angle to the NEAREST point on the whole body (head, torso,
					-- pelvis, limbs), not a single anchor -- so aiming anywhere on the
					-- entity counts. Measured from the aim ray, so it's the same at any
					-- zoom and immune to the bodycam sway.
					local a = aim_angle_to_body(obj)
					if a and (not C.require_los or has_los(obj)) then
						if tracked[obj:id()] then
							if a < best_busy_a then
								best_busy_a, best_busy_obj = a, obj
							end
						elseif a < best_a then
							best_a, best_obj = a, obj
						end
					end
				end
			end
		end
		return false -- keep scanning the full set within max_dist
	end)

	return best_obj or best_busy_obj
end

-- Debug: dump why find_nearest_in_fov accepts/rejects each nearby NPC. Mirrors
-- its exact filter so the log shows, per candidate, screen position, distance
-- from the aim point, LOS, and whether it falls inside fov_radius -- plus the
-- gating flags. Defined here (after has_los / find_nearest_in_fov) so it can
-- reuse them. Only runs when C.debug_log is on.
local function debug_dump_candidates()
	if not C.debug_log then
		return
	end
	if not (db.actor and level.iterate_nearest) then
		return
	end
	dbg(
		string.format(
			"flags enabled=%s fov_assist=%s freeaim_assist=%s require_los=%s require_binoc=%s cone=%.2fdeg max_dist=%.0f",
			tostring(C.enabled),
			tostring(C.fov_assist),
			tostring(C.freeaim_assist),
			tostring(C.require_los),
			tostring(C.require_binoculars),
			aim_cone_rad() * 180 / math.pi,
			C.max_dist
		)
	)
	local apos = db.actor:position()
	local aid = db.actor:id()
	local n = 0
	pcall(level.iterate_nearest, apos, C.max_dist, function(obj)
		if n >= 8 then
			return true
		end
		if obj and obj:id() ~= aid and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			local alive = safe_call(obj.alive, obj)
			local comm = safe_call(obj.character_community, obj)
			local sx, sy = project_world(anchor_pos(obj))
			local a = aim_angle_to_body(obj)
			local within = (a ~= nil and a <= aim_cone_rad())
			local los = has_los(obj)
			dbg(
				string.format(
					"cand %s alive=%s comm=%s ui=%s ang=%s within=%s los=%s",
					obj_desc(obj),
					tostring(alive),
					tostring(comm),
					sx and string.format("(%.0f,%.0f)", sx, sy) or "offscreen",
					a and string.format("%.2fdeg", a * 180 / math.pi) or "n/a",
					within and "YES" or "no",
					tostring(los)
				)
			)
			n = n + 1
		end
		return false
	end)
	if n == 0 then
		dbg("cand (none nearby)")
	end
end

-- Free-aim direct hit: cast a ray along the actual aim ray (bodycam.get_fire_ray
-- via freeaim_ray) and return the stalker/monster it strikes. This is the "point
-- at it and identify" path that doesn't depend on FOV target-assist -- needed
-- because on a bodycam engine there's no weapon-trace binding and the camera
-- trace uses the swayed render centre, not where you aim. rqtBoth so static
-- geometry blocks the ray (no identifying through walls); returns nil (letting
-- the caller fall through to the camera trace / FOV assist) when the aim ray or
-- ray_pick is unavailable, the ray hits geometry first, or it hits a non-NPC.
local _aim_ray = nil
local function freeaim_target(max_dist)
	local px, py, pz, dx, dy, dz = freeaim_ray()
	if not (px and py and pz and dx and dy and dz) then
		return nil
	end
	if not rawget(_G, "ray_pick") then
		dbg("freeaim_target: ray_pick binding absent on this engine")
		return nil
	end
	local ok, obj = pcall(function()
		if not _aim_ray then
			_aim_ray = ray_pick()
		end
		_aim_ray:set_flags(RQT_BOTH)
		-- The ray starts at the eye, INSIDE the actor's own collision capsule,
		-- so without this it hits the player (dashie#0) first. Ignore the actor
		-- so the trace passes through to the real target behind it.
		if db.actor then
			_aim_ray:set_ignore_object(db.actor)
		end
		_aim_ray:set_position(_v.aim_pos:set(px, py, pz))
		_aim_ray:set_direction(_v.aim_dir:set(dx, dy, dz))
		_aim_ray:set_range(max_dist)
		if _aim_ray:query() then
			return _aim_ray:get_object()
		end
		return nil
	end)
	if not ok or not obj then
		dbg("freeaim_target: ray hit no object (geometry/miss) ok=" .. tostring(ok))
		return nil
	end
	-- Belt-and-suspenders: if set_ignore_object didn't take, drop the actor so
	-- get_target_obj falls through to the FOV assist instead of self-selecting.
	if db.actor and obj:id() == db.actor:id() then
		dbg("freeaim_target: hit the actor (ignored)")
		return nil
	end
	local is_npc = safe_call(IsStalker, obj) or safe_call(IsMonster, obj)
	dbg(string.format("freeaim_target: hit %s npc=%s", obj_desc(obj), tostring(is_npc)))
	if not is_npc then
		return nil
	end
	return obj
end

-- --------------------------------------------------------------------------
-- Identify trigger
-- --------------------------------------------------------------------------
-- Traces from the equipped weapon's own hit-test first (level.ETraceTarget.Weapon
-- reads the attached hud item's pick result -- the same barrel-aligned trace
-- the engine uses for firing, not the camera centre), falls back to the
-- camera trace, and if neither hit anything, falls back to the nearest
-- identifiable target within the on-screen FOV circle.
--
-- Both direct-raycast results are also LOS-checked, not just the FOV
-- fallback: the engine's own crosshair pick (src/xrGame/HUDManager.cpp,
-- pick_trace_callback) doesn't stop at the first static-geometry hit --
-- for each static hit it multiplies a running "power" by that triangle's
-- material fVisTransparencyFactor, and if the *cumulative* result is still
-- above 0.34 it keeps tracing past it, only stopping for good once it hits
-- an actual object or a material opaque enough to drop under that
-- threshold. Fences, glass, foliage and similar semi-transparent materials
-- routinely have a high enough fVisTransparencyFactor for this to return an
-- object behind them directly, bypassing find_nearest_in_fov() (and its LOS
-- check) entirely -- so a direct hit is not on its own proof of visibility
-- and needs the same has_los() gate applied to it.
local function get_target_obj(max_dist, allow_fov)
	local function accept(obj)
		if not obj then
			return nil
		end
		if C.require_los and not has_los(obj) then
			return nil
		end
		return obj
	end

	-- Free-aim direct hit: raycast along the real aim ray. Tried FIRST when
	-- free-aim assist is on, because under bodycam the camera trace below uses
	-- the swayed render centre (not where you point), so it must not win over an
	-- actual aim-ray hit. Independent of allow_fov -- directly aiming at a target
	-- identifies it even with FOV target-assist turned off.
	if C.freeaim_assist then
		local fa = accept(freeaim_target(max_dist))
		if fa and not tracked[fa:id()] then
			return fa
		end
	end

	local direct = nil
	if level.ETraceTarget then
		direct = accept(safe_call(level.get_target_obj, level.ETraceTarget.Weapon))
	end
	if not direct then
		direct = accept(safe_call(level.get_target_obj))
	end

	-- A direct hit that's already mid-identification shouldn't just restart
	-- itself -- try the FOV fallback first, which prefers any other eligible
	-- target in the ballpark over one already tracked (see
	-- find_nearest_in_fov above), and only fall back to the busy direct hit
	-- if nothing else is actually available.
	if direct and not tracked[direct:id()] then
		return direct
	end

	-- FOV target-assist (fov_assist / fov_assist_binoc, decided per-context by
	-- the caller). When disabled, identification is direct-hit only: you must
	-- actually aim at the target, with no nearest-in-circle fallback.
	if allow_fov then
		local nearby = find_nearest_in_fov(max_dist)
		if nearby then
			return nearby
		end
	end
	return direct
end

-- Is the binoculars item currently equipped/held? `active_item()`/`section()`
-- confirmed via src/xrGame/script_game_object_script2.cpp:99,102,156 and the
-- section name via this repo's own axr_main.script:355. On its own this only
-- means "in hand", not "raised to the eye" -- see is_binoc_active() below.
local function is_binoc_held()
	if not db.actor then
		return false
	end
	local item = safe_call(db.actor.active_item, db.actor)
	if not item then
		return false
	end
	local sec = safe_call(item.section, item)
	if not sec then
		return false
	end
	return sec == BINOC_SECTION or sec:find("binoc") ~= nil
end

-- Is the actor actually looking through raised binoculars right now (not
-- just holding them)? There's no usable Lua-side zoom-state getter: the
-- native IsZoomed is on a class hierarchy Lua can't reach, and the zoom
-- callback slot (obj:set_callback(callback.weapon_zoom_in/out, ...)) is a
-- single last-writer-wins slot already claimed by this repo's own
-- axr_main.script -- registering our own would break its `binoc_is_zoomed`
-- global, and reading that global instead proved unreliable in practice.
--
-- So this polls device().fov directly instead: any optic narrows the
-- camera's FOV, so it self-calibrates a "normal" baseline from the widest
-- FOV seen while binoculars are NOT held, then treats a shrunk FOV while
-- they ARE held as "looking through them". Calibration runs every frame
-- from actor_on_update() regardless of feature state, so the baseline is
-- already warm whenever is_binoc_active() is actually called.
local FOV_ZOOM_RATIO = 0.7 -- current fov must drop below this fraction of baseline to count as zoomed
local _fov_baseline = 60 -- self-corrects within moments of normal (unzoomed) play either way

-- ADS (aim-down-sight) state, tracked from STOCK engine callbacks so it works on ANY
-- exe -- same idea as detecting binoculars from active_item(). The engine fires
-- actor_on_weapon_zoom_in/out (WeaponMagazined -> eOnWeaponZoomIn/Out) the instant the
-- sight is raised/lowered, for EVERY weapon including 1x optics that change no FOV. Set
-- by the handlers registered in on_game_start; read by is_ads_active below.
local _ads = { zoomed = false }

local function update_fov_baseline()
	if is_binoc_held() then
		return
	end
	local dev = device and device()
	local fov = dev and dev.fov
	if fov and fov > _fov_baseline then
		_fov_baseline = fov -- only ever raised, and only while not holding binoculars
	end
end

local function is_binoc_active()
	if not is_binoc_held() then
		return false
	end
	local dev = device and device()
	local fov = dev and dev.fov
	if not fov or fov <= 0 then
		return true
	end -- can't read fov: fail open to "held" behaviour
	return fov < _fov_baseline * FOV_ZOOM_RATIO
end

-- Is the actor aiming down sight (ADS) with a weapon right now? Prefers the
-- bodycam engine's real aim flag (bodycam.get_state().ads) -- which catches even
-- low-zoom iron sights -- and falls back to the same FOV-zoom heuristic
-- is_binoc_active() uses, with a gentler ratio because ADS narrows the FOV less
-- than a scope or binoculars. Binoculars are excluded (that's binocular mode's
-- job), so ADS and binocular boosts never both fire.
local ADS_ZOOM_RATIO = 0.85 -- fov must drop below this fraction of baseline to count as ADS (fallback only)
local function is_ads_active()
	if is_binoc_held() then
		return false
	end
	-- PRIMARY: the weapon-zoom flag driven by the stock actor_on_weapon_zoom_in/out
	-- callbacks (see _ads above). Works on ANY exe and for 1x optics that change no FOV
	-- -- the case the heuristics below can't detect. When true we are aiming, period.
	if _ads.zoomed then
		-- Self-heal a stuck flag: zoom_out normally clears it, but a build that skips that
		-- callback on holster/weapon-switch could leave it set at hipfire. An empty hand
		-- (no active item) is never ADS, so reset and treat as lowered.
		if db.actor and not safe_call(db.actor.active_item, db.actor) then
			_ads.zoomed = false
			return false
		end
		return true
	end
	-- Fallbacks, in case a given build doesn't dispatch the zoom callbacks:
	-- Bodycam camera ADS flag, ONLY when its logic is ACTIVE (when disabled the
	-- get_state() ads field is stale/false and would wrongly report "hip").
	local bc = rawget(_G, "bodycam")
	if bc and bc.get_state then
		local ok, st = pcall(bc.get_state)
		if ok and type(st) == "table" and st.active and st.ads ~= nil then
			return st.ads and true or false
		end
	end
	-- A live PiP scope means we're aiming down a sight: it doesn't narrow the MAIN
	-- camera FOV (the zoom lives in the second viewport), so the FOV heuristic can't
	-- see it -- detect it directly.
	if PIP_AVAILABLE then
		local ok, a = pcall(is_svp_active)
		if ok and a then
			return true
		end
	end
	-- Non-PiP magnifying optic: the main camera FOV narrows when aiming down sight.
	local dev = device and device()
	local fov = dev and dev.fov
	if not fov or fov <= 0 then
		return false
	end
	return fov < _fov_baseline * ADS_ZOOM_RATIO
end

-- Current effective aiming magnification (1.0 = 1x), or nil when not meaningfully
-- zoomed. Hybrid, so it works with OR without a PiP engine, and tracks variable/
-- dynamic (x2/x4/...) zoom live in both cases:
--   1. PiP engine: the zoom lives in the SECOND viewport, so the main camera FOV
--      does NOT change -- only the engine binding svp_scope_magnification() (added
--      alongside is_svp_active) can report it accurately.
--   2. No PiP (stock engine), or the binding reports nothing (iron sights, a
--      non-PiP-rendered scope): a non-PiP optic narrows the MAIN camera FOV, so
--      the zoom is recoverable from device().fov against the self-calibrating
--      unzoomed baseline (_fov_baseline, see update_fov_baseline).
local SVP_MAG_AVAILABLE = rawget(_G, "svp_scope_magnification") ~= nil
local MAG_FOV_MIN = 1.05 -- below this the FOV barely narrowed: treat as un-magnified (x1)
local function scope_magnification()
	if SVP_MAG_AVAILABLE then
		-- Only trust the PiP binding while a scope is ACTIVELY rendering. The engine's
		-- svp_mag is set while the SVP optics pass runs but is NOT reset on unscope, so
		-- it holds the last scope's value (e.g. 3x) at hipfire / on a scopeless weapon
		-- otherwise -- the "stuck at 3x" bug. is_svp_active() gates that out. (The
		-- engine binding was also fixed to gate on IsSVPActive; this guard makes it
		-- correct without needing that rebuild.)
		local scoped = true
		if PIP_AVAILABLE then
			local ok, a = pcall(is_svp_active)
			scoped = ok and a and true or false
		end
		if scoped then
			local ok, m = pcall(svp_scope_magnification)
			if ok and m and m > 0 then
				return m
			end
		end
	end
	local dev = device and device()
	local fov = dev and dev.fov
	if fov and fov > 0 and _fov_baseline > 0 then
		local m = _fov_baseline / fov
		if m > MAG_FOV_MIN then
			return m
		end
	end
	return nil
end

-- Angular FOV target-assist. Instead of a main-camera screen ring, the assist is a
-- cone measured from the true AIM RAY (where the scope/gun points). This is the fix for
-- PiP scopes: the main camera (world2ui) is the swayed, UN-zoomed bodycam render camera,
-- so a screen ring both (a) shrank wrongly with magnification and (b) missed by the
-- fixed sway offset between the render camera and the real aim. An angle from the aim
-- ray has neither problem -- it's magnification-invariant (a scope zooms the view, not
-- the target's real angular size) and sway-immune. Assigns the forward-declared upvalues.

-- The assist tolerance as an ANGLE (radians): fov_radius converted at the UNZOOMED
-- baseline FOV, so it's a constant real angle (independent of any live zoom). 768 = the
-- virtual UI height that spans the vertical FOV, so px/768 * fov = the subtended angle.
-- At 1x this matches the old screen ring exactly, so hip-fire feel is unchanged.
function aim_cone_rad()
	local base = C.fov_radius or 90
	local fov_deg = (_fov_baseline and _fov_baseline > 0) and _fov_baseline or 60
	return (base / 768) * (fov_deg * math.pi / 180)
end

-- Aim ray in world space: the fire ray (barrel under ADS, eye otherwise) so we measure
-- from where the SCOPE actually points, not the swayed render camera. Falls back to the
-- render camera (cam_pos/dir) on a stock engine. Returns origin, unit dir, or nil.
-- Scratch vectors bundled (one local) to stay under Lua 5.1's 200-local chunk limit.
local _aim = { o = vector(), d = vector() }
local function aim_ray_world()
	local source = freeaim_is_ads() and "bar" or nil
	local px, py, pz, dx, dy, dz = freeaim_ray(source)
	if px and dx then
		_aim.o:set(px, py or 0, pz or 0)
		_aim.d:set(dx, dy or 0, dz or 0)
	else
		local dev = device and device()
		if not (dev and dev.cam_pos and dev.cam_dir) then
			return nil
		end
		_aim.o:set(dev.cam_pos)
		_aim.d:set(dev.cam_dir)
	end
	local m = _aim.d:magnitude()
	if m < 1e-5 then
		return nil
	end
	_aim.d:set(_aim.d.x / m, _aim.d.y / m, _aim.d.z / m)
	return _aim.o, _aim.d
end

-- Vertical lift samples (metres) for backing up a non-bip01 rig (monster) with a span
-- at its origin, shared by aim_angle_to_body and body_box_for.
local MONSTER_SPAN = { 0.3, 0.9, 1.5 }

-- Angle (radians) between a ray (origin ox,oy,oz + UNIT dir dx,dy,dz) and a world point.
-- 0 when the point is essentially on the origin (dead-centre). Module-level so the
-- per-candidate sweeps don't allocate a fresh closure each call (hot path).
local function ray_point_angle(ox, oy, oz, dx, dy, dz, px, py, pz)
	local bx, by, bz = px - ox, py - oy, pz - oz
	local m = math.sqrt(bx * bx + by * by + bz * bz)
	if m < 0.01 then
		return 0
	end
	local dot = (bx * dx + by * dy + bz * dz) / m
	if dot > 1 then
		dot = 1
	elseif dot < -1 then
		dot = -1
	end
	return math.acos(dot)
end

-- Smallest angle (radians) from the aim ray to any sampled body point (head, torso,
-- pelvis, limbs -- so aiming anywhere on the entity counts), or nil. Angular analogue of
-- the old screen-distance test; a vertical span at the origin backs up monsters without bip01.
function aim_angle_to_body(obj)
	local o, dir = aim_ray_world()
	if not o or not dir then
		return nil
	end
	local ox, oy, oz = o.x, o.y, o.z
	local dx, dy, dz = dir.x, dir.y, dir.z
	local base = obj:position()
	local best = nil
	local found = false
	for _, bone in ipairs(BODY_BONES) do
		local p = safe_call(obj.bone_position, obj, bone)
		if p and p:distance_to_sqr(base) < 16 then -- sane bone (within 4 m of origin)
			found = true
			local a = ray_point_angle(ox, oy, oz, dx, dy, dz, p.x, p.y, p.z)
			if not best or a < best then
				best = a
			end
		end
	end
	if not found then -- monster / non-bip01 rig: sample a vertical span at the origin
		for _, lift in ipairs(MONSTER_SPAN) do
			local a = ray_point_angle(ox, oy, oz, dx, dy, dz, base.x, base.y + lift, base.z)
			if not best or a < best then
				best = a
			end
		end
	end
	return best
end

-- The further away a target is (as a fraction of the CURRENT effective max
-- range), the longer the "scanning" phase takes: 1x at point-blank, ramping
-- up to dist_penalty_max right at the cutoff. Passing eff_max_dist (already
-- widened by binoc_range_mult when boosted) rather than the base C.max_dist
-- means binoculars mitigate this for free -- the same physical distance is
-- a smaller fraction of a longer range, so a target that would be almost at
-- the (slow) unaided cutoff reads as comfortably inside the (fast) boosted
-- one instead, on top of the flat binoc_scan_mult speed multiplier applied
-- separately in try_identify().
local function distance_scan_mult(dist, max_dist)
	if not C.dist_penalty then
		return 1
	end
	local t = dist / math.max(1, max_dist)
	if t < 0 then
		t = 0
	elseif t > 1 then
		t = 1
	end
	return 1 + (C.dist_penalty_max - 1) * t
end

-- Rank ladder for the rank-based scan penalty, in ascending order of how
-- accomplished/well-known the stalker is. Deliberately the same rank-id set
-- and relative ordering as the Skill System's own rank_table
-- ($HOME/code/lua/skillsystem/gamedata/scripts/haru_skills.script's
-- scavanger_effect, novice=25 ... legend=100) rather than reading
-- obj:rank() (the raw numeric CHARACTER_RANK_VALUE, bound at
-- src/xrGame/script_game_object_script2.cpp:146): that value is threshold-
-- driven by each modpack's own game_relations.ltx, so its numeric scale
-- isn't safe to assume, where rank NAMES (obj:rank_name(), already what
-- this mod displays on the card via rank_label()) are the stable, ecosystem-
-- standard identity to key off.
-- Each rank's own difficulty weight (0 = reads exactly as fast as a rookie,
-- 1 = full rank_penalty_max slowdown) -- NOT an evenly-spaced position on a
-- ladder. A veteran isn't "5/8ths of the way" harder to place at a glance
-- than a novice; the early promotions (novice -> trainee -> experienced)
-- barely change how readable someone looks, while the last few tiers
-- (expert -> master -> legend) are the stalkers who are genuinely harder to
-- size up quickly. novice is pinned at exactly 0 so a rookie is always the
-- unpenalised baseline regardless of the rank_penalty_max slider.
local RANK_WEIGHT = {
	novice = 0.00,
	trainee = 0.08,
	experienced = 0.20,
	professional = 0.35,
	veteran = 0.50,
	expert = 0.68,
	master = 0.85,
	legend = 1.00,
}

-- rank_penalty_max is the multiplier at weight 1 (legend); every other rank
-- scales to its own fixed point between 1x (novice) and that ceiling via its
-- weight above -- not a formula-derived interpolation between rank *tiers*.
-- Monsters/mutants and any rank id outside RANK_WEIGHT (an unknown/modded
-- rank ladder) fail open to no penalty -- rank_name() returns "" for
-- non-stalkers (SAFE_WRAP, not an error), and there's nothing to classify a
-- rank we don't recognise against.
local function rank_scan_mult(obj)
	if not C.rank_penalty then
		return 1
	end
	local rid = safe_call(obj.rank_name, obj)
	if not rid or rid == "" then
		return 1
	end
	local w = RANK_WEIGHT[rid]
	if not w then
		return 1
	end
	return 1 + (C.rank_penalty_max - 1) * w
end

-- --------------------------------------------------------------------------
-- Night penalty: harder to make someone out in the dark.
-- --------------------------------------------------------------------------
-- In-game hour as a fractional 0..24 value (hours + minutes/60), or nil if
-- the time API isn't ready yet. level.get_time_hours()/get_time_minutes()
-- (src/xrGame/level_script.cpp:300/308, bound :2514-2515) return the current
-- world clock, the same one the HUD watch and A-Life day/night cycle read.
local function game_hour()
	if not (level and level.get_time_hours) then
		return nil
	end
	local h = safe_call(level.get_time_hours)
	if not h then
		return nil
	end
	local m = safe_call(level.get_time_minutes) or 0
	return h + m / 60
end

-- Darkness, 0 (full daylight) .. 1 (deepest night): lit through the day, dark
-- deep at night, with linear dusk/dawn ramps between. Deliberately peaks
-- across midnight -- the 23:00..04:00 plateau returns a flat 1, so 0:00 sits
-- squarely in the slowest-to-identify window (per the request). The ramps
-- make it "get harder as it gets dark" rather than flipping on at a hard
-- cutoff. Fails open to 0 (no penalty) if the clock can't be read.
local DUSK_START, NIGHT_START = 19.0, 23.0 -- 0 -> 1 over dusk
local NIGHT_END, DAWN_END = 4.0, 8.0 -- 1 -> 0 over dawn

local function darkness_factor()
	local h = game_hour()
	if not h then
		return 0
	end
	if h >= NIGHT_START or h < NIGHT_END then
		return 1
	end -- deep night, incl. midnight
	if h >= DAWN_END and h < DUSK_START then
		return 0
	end -- broad daylight
	if h < DAWN_END then
		return 1 - (h - NIGHT_END) / (DAWN_END - NIGHT_END)
	end -- dawn
	return (h - DUSK_START) / (NIGHT_START - DUSK_START) -- dusk
end

-- Scan-time multiplier from ambient darkness (1 at noon, up to
-- night_penalty_max in the dead of night), scaled by darkness_factor above so
-- the slowdown eases in over dusk instead of snapping on.
local function night_scan_mult()
	if not C.night_penalty then
		return 1
	end
	return 1 + (C.night_penalty_max - 1) * darkness_factor()
end

-- --------------------------------------------------------------------------
-- Skill System (haru_skills) compatibility: identification gets faster the
-- higher the actor's "perception" skill level is. Soft dependency throughout
-- -- the Skill System mod may not be installed at all, and even when it is,
-- its base pack ships no "perception" skill (only endurance/strength/
-- survival/scavenging), so this mod ships its own skill_perception.ltx as an
-- optional FOMOD component (see fomod/ModuleConfig.xml) that the skill
-- system's own `#include "skill_*.ltx"` wildcard picks up automatically.
-- Every access below is nil-chained rather than pcall'd: haru_skills is
-- either a whole missing global or a well-formed table (its own
-- on_game_load populates skills_levels for every configured skill), so there
-- is no method call here that can throw, just table field reads.
-- --------------------------------------------------------------------------
local function perception_level()
	if not C.perception_compat then
		return 0
	end
	local lv = haru_skills and haru_skills.skills_levels and haru_skills.skills_levels["perception"]
	return (lv and lv.current_level) or 0
end

-- Multiplicative scan-time reduction from the current perception level (1 =
-- no bonus, lower = faster), floored so it never reaches a near-instant
-- reveal at max level.
local function perception_scan_mult()
	local lvl = perception_level()
	if lvl <= 0 then
		return 1
	end
	local mult = 1 - C.perception_scan_mult * lvl
	if mult < 0.15 then
		mult = 0.15
	end
	return mult
end

-- Exposed as ii_identify.perception_hint_stats (cross-file global convention)
-- for the Skill System menu's own per-stat hint mechanism -- the exact
-- generic hook every one of its bundled skills uses to append live numbers
-- to their tooltip (ui_haru_skills.script:131 get_stats_func_value /
-- BuildDescription, e.g. survival's resistance stat -> functor =
-- ui_haru_skills, get_resistance_string). Wired in via this component's own
-- ui_settings/stats_perception.ltx ([perception] awareness = ... ; functor =
-- ii_identify, perception_hint_stats), so it appends automatically after the
-- static st_player_skills_hint_perception text, with no changes to the Skill
-- System's own files. Called with the "awareness" stat's numeric value
-- (BuildDescription always passes one), which is ignored -- awareness itself
-- carries no real meaning (see skill_perception.ltx's comment); everything
-- shown here is read fresh from the actor's actual current perception level
-- and live MCM config instead.
--
-- Shows identify time for a rookie stalker (rank held at baseline -- see
-- rank_scan_mult()'s RANK_WEIGHT, novice = 0 -- so this isolates perception's
-- own effect; a rank penalty on top of a higher-ranked target, if enabled,
-- multiplies further) at the actor's current level, across the four
-- range/binocular combinations. All four $-tokens in the string are always
-- followed by whitespace/punctuation, never another word character, so
-- there's no ambiguity for whatever token-matching utils_data.parse_string_keys
-- uses under the hood (confirmed by example against the Skill System's own
-- stat strings, which follow the same rule for their own $stat token).
function perception_hint_stats()
	local lvl = perception_level()
	local pmult = perception_scan_mult()

	local function scan_seconds(dist, boosted_case)
		local eff_max = boosted_case and (C.max_dist * C.binoc_range_mult) or C.max_dist
		local t = math.floor(SCAN_MS * distance_scan_mult(dist, eff_max))
		if boosted_case then
			t = math.floor(t * C.binoc_scan_mult)
		end
		t = math.floor(t * pmult)
		return string.format("%.2f", t / 1000)
	end

	local ok, txt = pcall(function()
		return utils_data.parse_string_keys(game.translate_string("st_ii_perception_hint_stats"), {
			["level"] = lvl,
			["t1"] = scan_seconds(0, false),
			["t2"] = scan_seconds(C.max_dist, false),
			["t3"] = scan_seconds(0, true),
			["t4"] = scan_seconds(C.max_dist, true),
		})
	end)
	return ok and txt or ""
end

-- Rewards using the identify feature with perception XP, same as the skill
-- system's own skills reward using them. Only fires when the "perception"
-- skill actually exists in skills_levels (the optional skill_perception.ltx
-- component is installed).
--
-- Deliberately does NOT call haru_skills.increase_skill(skill, amount): it
-- multiplies by options["exp_multiplier_" .. skill], which is only ever
-- populated for the four hardcoded base skills in both known variants of
-- that file, so it would throw on "perception" before touching .experience.
-- Writing .experience directly sidesteps that; the periodic update_stats()
-- (already running regardless of this mod) independently re-checks every
-- configured skill's experience against its requirement and levels it up,
-- so this needs no level-up logic of its own.
-- Returns true if XP was actually granted -- callers use this to gate their
-- own one-time-award table (xp_awarded/loot_xp_awarded below) so a target
-- isn't burned as already-farmed if the integration was off/absent at the
-- time. `amount` lets both the base identify reward and the loot bonus
-- (below) share this same function instead of duplicating it.
local function award_perception_xp(amount)
	if not C.perception_compat then
		return false
	end
	local lv = haru_skills and haru_skills.skills_levels and haru_skills.skills_levels["perception"]
	if not lv or type(lv.experience) ~= "number" then
		return false
	end
	lv.experience = lv.experience + amount
	return true
end

-- Per-target one-time XP gate: [npc_id] = true once that target has ever
-- earned perception XP, so repeatedly re-identifying the same stalker after
-- its tag fades out (tracked[id] clears, so the earlier "already tracked"
-- check alone doesn't stop this) can't farm unlimited XP off one NPC.
-- Persisted via save_state/load_state below so reloading a save doesn't
-- reset the list either. Keyed by the engine's alife object id like
-- `tracked` already is; the one edge case is a since-dead NPC's id being
-- recycled onto an unrelated new object, which would just silently deny
-- that one new NPC its first-time XP -- rare, and the failure mode is
-- "no XP" rather than anything worse, so not worth a heavier identity
-- scheme (e.g. name+community) that has its own collision problems.
local xp_awarded = {}

-- Familiarity gate: [npc_id] = true once you've identified that target at
-- least once, ever -- unlike xp_awarded (only set when perception XP was
-- actually granted, so a later-installed Skill System can still pay out a
-- previously-met NPC's first-time XP), this is set on every first successful
-- identify regardless of the Skill System's presence, since the familiarity
-- speed boost is a core mod feature, not part of that soft integration.
-- Also persisted via save_state/load_state.
local remembered = {}

-- Per-target one-time gate for the loot XP bonus below -- same rationale and
-- persistence as xp_awarded, kept separate since the two rewards are earned
-- independently (identify without ever looting, or loot a target identified
-- in an earlier session) and shouldn't share one gate.
local loot_xp_awarded = {}

-- Bonus perception XP for looting a corpse you'd already identified.
-- Detected by polling get_talking_npc() -- the actor's current dual-
-- inventory partner -- once a frame rather than via callback.on_item_take:
-- that callback is a single-slot-per-object registration (same conflict
-- class as the binocular zoom slot, see is_binoc_active()'s comment), fires
-- per item rather than per loot session, and doesn't say who the item came
-- from anyway. Anomaly's trade and corpse-loot screens both open through
-- this same "talk partner" mechanism (alive for trade, dead for loot), so
-- watching it for a "was set, now cleared" transition is a plain read with
-- no shared slot to fight over, and naturally fires once per loot session.
local loot_partner_id = nil

local function update_loot_xp()
	local partner = safe_call(db.actor.get_talking_npc, db.actor)
	if partner then
		loot_partner_id = partner:id()
		return
	end
	if not loot_partner_id then
		return
	end

	local id = loot_partner_id
	loot_partner_id = nil
	if not remembered[id] or loot_xp_awarded[id] then
		return
	end

	local corpse = level.object_by_id(id)
	local alive = corpse and safe_call(corpse.alive, corpse)
	if alive then
		return
	end -- the partner session ended some other way (e.g. a live trade), not a loot

	if award_perception_xp(C.perception_loot_xp) then
		loot_xp_awarded[id] = true
	end
end

-- Compute this target's scan time and commit it to `tracked` (create a fresh
-- reveal, or restart one that's already showing). Split out of try_identify()
-- so the keypress path and the auto-identify sweep (update_auto_identify)
-- share one identical commit path. Caller guarantees obj is alive and comm is
-- a non-empty community id; (boosted, eff_max_dist, eff_fade_dist) come from
-- the caller's boost_params() snapshot.
local function identify_target(obj, comm, boosted, eff_max_dist, eff_fade_dist, scan_mult, auto_mode)
	local dist = safe_call(function()
		return obj:position():distance_to(db.actor:position())
	end)
	if not dist or dist > eff_max_dist then
		return
	end

	-- Target-side difficulty first (how far away, how accomplished the
	-- stalker is), then the ambient darkness, then actor-side mitigation on
	-- top: distance penalty scales against eff_max_dist (already widened when
	-- boosted, mitigating the penalty for free), rank penalty scales with the
	-- target's own rank, the night penalty scales with how dark it currently
	-- is, the flat binoc_scan_mult speed boost applies next, then the actor's
	-- perception skill level (if the Skill System integration is present)
	-- shaves a further fraction off, and finally familiarity (below) discounts
	-- a target you've identified before.
	local eff_scan_ms = math.floor(SCAN_MS * distance_scan_mult(dist, eff_max_dist))
	eff_scan_ms = math.floor(eff_scan_ms * rank_scan_mult(obj))
	eff_scan_ms = math.floor(eff_scan_ms * night_scan_mult())
	if boosted then
		eff_scan_ms = math.floor(eff_scan_ms * (scan_mult or 1.0))
	end
	eff_scan_ms = math.floor(eff_scan_ms * perception_scan_mult())

	local id = obj:id()
	local tg = time_global()

	if C.familiarity_boost and remembered[id] then
		eff_scan_ms = math.floor(eff_scan_ms * C.familiarity_scan_mult)
	end

	-- Instant identify: skip the whole scanning phase (no spinner, no wait) so
	-- the tag reveals immediately. Overrides every scan-time factor above.
	if C.instant_identify then
		eff_scan_ms = 0
	end

	if tracked[id] then
		local e = tracked[id]
		-- Already being identified: NEVER restart the reveal. A re-trigger (manual key
		-- press OR the auto/steady sweep) on a target that's already tracked must not
		-- re-scan it -- a still-scanning tag is left completely alone to finish its scan
		-- (spamming the key can't pin it in the spinner), and an already-revealed one
		-- only gets its hold window refreshed (t0 parked at the start of hold, so it
		-- stays fully shown while the target remains visible) without ever re-scanning.
		-- Once the target leaves view/range it fades out normally; a genuine re-identify
		-- (with the familiarity discount, etc.) happens only after the tag fully clears
		-- and a fresh entry is created below.
		local revealed = (e.scan_ms or 0) + (e.fade_ms or FADE_MS)
		if (tg - e.t0) >= revealed then
			e.t0 = tg - revealed -- revealed: refresh hold, keep it shown, no re-scan
		end
		return
	end

	if not xp_awarded[id] and award_perception_xp(C.perception_xp) then
		xp_awarded[id] = true
	end
	remembered[id] = true

	local count, oldest_id, oldest_t = 0, nil, math.huge
	for k, e in pairs(tracked) do
		count = count + 1
		if e.t0 < oldest_t then
			oldest_t, oldest_id = e.t0, k
		end
	end
	if count >= MAX_TAGS and oldest_id then
		tracked[oldest_id] = nil
	end

	tracked[id] = {
		t0 = tg,
		col = relation_color(obj),
		fcol = faction_color(comm),
		sign = relation_sign(obj),
		header = faction_label(comm),
		name = display_name(obj, comm),
		icon = faction_icon_id(comm),
		rank = rank_label(obj),
		rank_col = rank_color(obj),
		weap = held_weapon_label(obj),
		scan_ms = eff_scan_ms,
		max_dist = eff_max_dist,
		fade_dist = eff_fade_dist,
		-- Snapshotted like scan_ms/max_dist/fade_dist above: FADE_MS/HOLD_MS
		-- can change live via MCM mid-reveal, and without this snapshot an
		-- already-active tag's `total` (see render()) would shrink/grow
		-- retroactively -- e.g. lowering hold_time while a tag is mid-hold
		-- could delete it outright the next frame instead of letting it
		-- finish the reveal it started.
		fade_ms = FADE_MS,
		hold_ms = HOLD_MS,
	}
end

-- Snapshot the current binocular-boost state into the triple both the keypress
-- path and the auto sweep consume. Binoculars boost identification regardless
-- of binocular_mode: faster reveal and a longer effective range. Captured once
-- at identify time (not read live in render()) so a tag identified at boosted
-- range doesn't immediately fail the (unboosted) fade/grace distance checks the
-- instant the player lowers the binoculars mid-reveal.
-- Returns: binoc (looking through binoculars), ads (aiming down sight), boosted
-- (a boost is actually active), the widened effective max/fade distances, and the
-- active scan_time multiplier. Binoculars take priority over ADS so the two never
-- stack. Each boost carries its own scan + range multipliers from its MCM section.
local function boost_params()
	local binoc = is_binoc_active()
	local ads = (not binoc) and is_ads_active()
	local boosted = false
	local scan_mult, range_mult = 1.0, 1.0
	if binoc and C.binoc_boost then
		boosted = true
		scan_mult, range_mult = C.binoc_scan_mult, C.binoc_range_mult
		-- Optionally scale the binocular range by its magnification, like ADS. Off by
		-- default so existing setups keep the flat binoc_range_mult.
		if C.binoc_zoom_scaling then
			local mag = scope_magnification()
			if mag and mag > 1 then
				range_mult = range_mult * mag
			end
		end
	elseif ads and C.ads_boost then
		boosted = true
		scan_mult, range_mult = C.ads_scan_mult, C.ads_range_mult
		-- Higher-power optics reach further: scale the ADS range by the scope's
		-- magnification (x2/x4/...), so ads_range_mult is the x1 base. Only when
		-- the engine reports a magnification (PiP scope); iron sights stay at x1.
		if C.ads_zoom_scaling then
			local mag = scope_magnification()
			if mag and mag > 1 then
				range_mult = range_mult * mag
			end
		end
	end
	local eff_max_dist = C.max_dist * range_mult
	local eff_fade_dist = C.fade_dist * range_mult
	return binoc, ads, boosted, eff_max_dist, eff_fade_dist, scan_mult
end

-- auto_mode: called by the steady-aim auto-trigger (binocular / ADS mode) rather
-- than a deliberate keypress. In that mode identify_target refreshes an already-
-- revealed target's hold window WITHOUT restarting its reveal, so holding/tracking
-- a target you've already identified doesn't re-scan it every time the steady aim
-- re-arms (the ADS "double identification" retrigger). A manual keypress (nil)
-- still restarts the reveal on purpose.
local function try_identify(auto_mode)
	if not C.enabled or not db.actor then
		return
	end
	debug_dump_aim()
	debug_dump_candidates()
	local binoc, _, boosted, eff_max_dist, eff_fade_dist, scan_mult = boost_params()
	if C.require_binoculars and not binoc then
		return
	end

	-- FOV target-assist is context-sensitive: fov_assist_binoc governs it while
	-- looking through raised binoculars, fov_assist otherwise.
	local allow_fov = C.fov_assist
	if binoc then
		allow_fov = C.fov_assist_binoc
	end

	local obj = get_target_obj(eff_max_dist, allow_fov)
	if not obj then
		return
	end
	if obj:id() == db.actor:id() then
		return
	end

	local alive = safe_call(obj.alive, obj)
	if not alive then
		return
	end

	local comm = safe_call(obj.character_community, obj)
	if not comm or comm == "" then
		return
	end

	identify_target(obj, comm, boosted, eff_max_dist, eff_fade_dist, scan_mult, auto_mode)
end

-- --------------------------------------------------------------------------
-- Auto-identify: continuously reveal every visible target in range, no key.
-- --------------------------------------------------------------------------
-- Sweeps all nearby NPCs/creatures (level.iterate_nearest, the same primitive
-- find_nearest_in_fov uses) and hands each alive, community-tagged, visible one
-- to identify_target. "Visible" is the whole point here, so LOS is always
-- required regardless of the require_los toggle (which only governs the FOV
-- assist fallback for the manual key). Throttled: iterate_nearest + a per-
-- candidate has_los() raycast every frame across a crowd is wasteful, and the
-- scan reveal is on a timescale where a few-hundred-ms cadence is invisible.
local AUTO_THROTTLE_MS = 250
local auto_last_tg = 0

local function update_auto_identify(tg)
	if not C.auto_identify then
		return
	end
	if tg - auto_last_tg < AUTO_THROTTLE_MS then
		return
	end
	auto_last_tg = tg
	if not db.actor or not level.iterate_nearest then
		return
	end

	local binoc, _, boosted, eff_max_dist, eff_fade_dist, scan_mult = boost_params()
	if C.require_binoculars and not binoc then
		return
	end

	local apos = db.actor:position()
	local actor_id = db.actor:id()
	pcall(level.iterate_nearest, apos, eff_max_dist, function(obj)
		if obj and obj:id() ~= actor_id and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			if safe_call(obj.alive, obj) then
				local comm = safe_call(obj.character_community, obj)
				if comm and comm ~= "" and has_los(obj) then
					identify_target(obj, comm, boosted, eff_max_dist, eff_fade_dist, scan_mult, true)
				end
			end
		end
		return false -- keep scanning the whole set within eff_max_dist
	end)
end

-- --------------------------------------------------------------------------
-- Binocular mode: auto-identify on a steady aim, no key needed.
-- --------------------------------------------------------------------------
-- "Steady" is tracked against an anchor direction (the camera direction when
-- steadiness tracking last (re)started) rather than frame-to-frame deltas,
-- so slow deliberate panning correctly resets it while ordinary hand-shake/
-- micro-jitter within the tolerance doesn't -- comparing only to the
-- previous frame would let a slow continuous pan stay "steady" forever.
local STEADY_MAX_D2 = 0.002 -- squared-distance tolerance between unit vectors, ~2.6 degrees

local steady_anchor = nil -- vector(), the camera direction steadiness is measured against
local steady_start_tg = nil
local steady_last_sweep_tg = 0 -- last time the steady sweep ran (throttle)
local STEADY_SWEEP_MS = 250 -- re-sweep cadence while the trigger stays armed
-- ADS-mode dwell state (bundled to spare top-level locals): armed = a valid target is
-- currently under the aim; start = when it first appeared; last = last identify tick;
-- check = last presence re-evaluation (throttles the per-frame raycasts).
local _ads_dwell = { armed = false, start = 0, last = 0, check = 0 }

local function reset_steady()
	steady_anchor = nil
	steady_start_tg = nil
end

-- Identify every alive, community-tagged, visible target whose body falls inside the
-- aim-assist RING (fov_radius around the current aim point) -- not just the single
-- nearest one, and NOT the whole screen. So aiming at a cluster of stacked targets
-- reveals all of them, while a lone target elsewhere on screen is left alone (same
-- fov_radius test find_nearest_in_fov uses, just applied to every match instead of the
-- nearest). auto_mode=true, so an already-revealed target just gets its hold window
-- refreshed. LOS is required. Shared by the steady-aim auto-trigger.
local function sweep_identify_in_fov(tg)
	if not db.actor or not level.iterate_nearest then
		return
	end
	local binoc, _, boosted, eff_max_dist, eff_fade_dist, scan_mult = boost_params()
	if C.require_binoculars and not binoc then
		return
	end
	local cone = aim_cone_rad()
	local apos = db.actor:position()
	local actor_id = db.actor:id()
	pcall(level.iterate_nearest, apos, eff_max_dist, function(obj)
		if obj and obj:id() ~= actor_id and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			if safe_call(obj.alive, obj) then
				local comm = safe_call(obj.character_community, obj)
				if comm and comm ~= "" then
					-- Inside the aim-assist cone (angle from the aim ray to any of the
					-- target's body bones <= the cone), and visible.
					local a = aim_angle_to_body(obj)
					if a and a <= cone and has_los(obj) then
						identify_target(obj, comm, boosted, eff_max_dist, eff_fade_dist, scan_mult, true)
					end
				end
			end
		end
		return false -- sweep the whole set within eff_max_dist
	end)
end

-- ADS-mode dwell trigger: keep a valid target under the aim -- directly (crosshair on
-- it) or, when fov_assist is on, inside the FOV assist range -- CONTINUOUSLY for
-- ads_hold_time, then auto-identify (and keep identifying, throttled, while a target
-- stays there). Unlike the binocular steadiness trigger below, this is dwell-on-target:
-- holding the aim still on empty air does nothing; a target must actually be present, but
-- you CAN track a moving one. Resets the instant no valid target is under the aim.
local function update_ads_dwell(tg)
	if not (C.ads_mode and is_ads_active()) or not db.actor then
		_ads_dwell.armed = false
		return
	end
	-- Throttle the raycast presence check (dwell timing still uses tg, so it's exact);
	-- 100 ms is well under any sane hold time and keeps ADS cheap.
	if tg - _ads_dwell.check < 100 then
		return
	end
	_ads_dwell.check = tg
	local binoc, _, boosted, eff_max_dist, eff_fade_dist, scan_mult = boost_params()
	if C.require_binoculars and not binoc then
		_ads_dwell.armed = false
		return
	end
	-- Is a valid target under the aim right now? Direct hit, or the FOV-assist pick when
	-- fov_assist is on (get_target_obj handles both via allow_fov).
	local obj = get_target_obj(eff_max_dist, C.fov_assist)
	local present = false
	if obj and obj:id() ~= db.actor:id() and safe_call(obj.alive, obj) then
		local comm = safe_call(obj.character_community, obj)
		present = comm and comm ~= "" and has_los(obj) and true or false
	end
	if not present then
		_ads_dwell.armed = false -- nothing valid on aim -> reset the dwell
		return
	end
	if not _ads_dwell.armed then
		_ads_dwell.armed = true
		_ads_dwell.start = tg
		_ads_dwell.last = 0
		return
	end
	-- Held long enough: identify (throttled). fov_assist on -> sweep everyone in the FOV
	-- assist range; off -> just the target directly under the aim.
	if (tg - _ads_dwell.start) >= (C.ads_hold_time or 0.6) * 1000 then
		if tg - _ads_dwell.last >= STEADY_SWEEP_MS then
			_ads_dwell.last = tg
			if C.fov_assist then
				sweep_identify_in_fov(tg)
			else
				try_identify(true)
			end
		end
	end
end

-- Steady-aim auto-identify. Binocular mode uses camera STEADINESS (hold the aim still for
-- steady_time, then sweep-identify the FOV); ADS mode uses target DWELL (update_ads_dwell
-- above). Both run every frame; each self-gates on its own toggle.
local function update_binocular_scan(tg)
	update_ads_dwell(tg)

	if not (C.binocular_mode and is_binoc_active()) then
		reset_steady()
		return
	end

	local dev = device and device()
	local dir = dev and dev.cam_dir
	if not dir then
		reset_steady()
		return
	end

	if not steady_anchor then
		steady_anchor = vector():set(dir)
		steady_start_tg = tg
		return
	end

	local dx, dy, dz = dir.x - steady_anchor.x, dir.y - steady_anchor.y, dir.z - steady_anchor.z
	if (dx * dx + dy * dy + dz * dz) > STEADY_MAX_D2 then
		steady_anchor:set(dir)
		steady_start_tg = tg
		return
	end

	-- Held steady long enough (throttled). Respect the binocular FOV-assist toggle:
	-- on -> sweep-identify every target inside the assist ring; off -> a DIRECT aim only.
	if (tg - steady_start_tg) >= C.steady_time * 1000 then
		if tg - steady_last_sweep_tg >= STEADY_SWEEP_MS then
			steady_last_sweep_tg = tg
			if C.fov_assist_binoc then
				sweep_identify_in_fov(tg)
			else
				try_identify(true) -- direct aim only (allow_fov off inside try_identify)
			end
		end
	end
end

local function install_key_hook()
	level_input = level_input or {}
	_prev_on_key_press = level_input.on_key_press
	level_input.on_key_press = function(key, action, disabled)
		local handled = false
		if _prev_on_key_press then
			local ok, res = pcall(_prev_on_key_press, key, action, disabled)
			if ok then
				handled = res
			end
		end
		if not disabled then
			local dik = active_dik()
			if dik and key == dik and modifiers_ok() then
				try_identify()
			end
		end
		return handled
	end
end

-- --------------------------------------------------------------------------
-- The tag dialog: a fixed pool of card widget-sets, positioned per frame.
-- Card layout (plate + accent bar + icon + header/name/rank text, joined to
-- a node dot on the target's body by a rotated leader line) mirrors
-- gamma-immersive-quest-markers' iqm_cards.xml / IqmCards:draw_slot
-- technique (see $HOME/code/lua/gamma-immersive-quest-markers).
-- --------------------------------------------------------------------------
local CARD_OFF_X, CARD_OFF_Y = 60, 34 -- px (before scale) from the anchor to the card

-- The `---@class` annotation has to attach to an actual declaration, and
-- `class "IiTags" (CUIScriptWnd)` below is a bare function-call statement
-- (`class("IiTags")(CUIScriptWnd)`), not an assignment -- so this shadow
-- global exists purely for the type checker; the classlib call immediately
-- below is what actually registers the real class at runtime.
---@class IiTags : CUIScriptWnd
---@field xml CScriptXmlInit
---@field slots table[]
IiTags = {}

class("IiTags")(CUIScriptWnd)

function IiTags:__init()
	super()
	self:InitControls()
end

function IiTags:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)

	self.xml = CScriptXmlInit()
	self.xml:ParseFile("ii_tags.xml")

	self.slots = {}
	for i = 1, MAX_TAGS do
		-- Creation order = draw order (later draws on top): shadow, leader
		-- line (behind the plate, so the plate's edge draws over its end for
		-- a flush join), plate, accent bar, icon, then the header/name/rank
		-- text (parented to `self`, not the plate, so they draw on top of
		-- it), and finally the glow/node at the body anchor.
		local shadow = self.xml:InitStatic("tag_shadow", self)
		local line_sh = self.xml:InitStatic("tag_line_sh", self)
		local line = self.xml:InitStatic("tag_line", self)
		local plate = self.xml:InitStatic("tag_plate", self)
		local accent = self.xml:InitStatic("tag_accent", self)
		local icon = self.xml:InitStatic("tag_icon", self)
		local head_sh = self.xml:InitTextWnd("tag_head_sh:text", self)
		local head = self.xml:InitTextWnd("tag_head:text", self)
		local name_sh = self.xml:InitTextWnd("tag_name_sh:text", self)
		local name = self.xml:InitTextWnd("tag_name:text", self)
		local rank_sh = self.xml:InitTextWnd("tag_rank_sh:text", self)
		local rank = self.xml:InitTextWnd("tag_rank:text", self)
		local weap_sh = self.xml:InitTextWnd("tag_weap_sh:text", self)
		local weap = self.xml:InitTextWnd("tag_weap:text", self)
		local sign_sh = self.xml:InitTextWnd("tag_sign_sh:text", self)
		local sign = self.xml:InitTextWnd("tag_sign:text", self)
		local glow = self.xml:InitStatic("tag_glow", self)
		local node = self.xml:InitStatic("tag_node", self)
		local spinner = self.xml:InitStatic("tag_spinner", self)
		spinner:EnableHeading(true)
		-- Bodycam-style head-outline edges (created last = drawn on top).
		local box_top = self.xml:InitStatic("tag_box_top", self)
		local box_bottom = self.xml:InitStatic("tag_box_bottom", self)
		local box_left = self.xml:InitStatic("tag_box_left", self)
		local box_right = self.xml:InitStatic("tag_box_right", self)
		-- Simple 2 style shapes.
		local s2_circle = self.xml:InitStatic("tag_s2_circle", self)
		local s2_tri = self.xml:InitStatic("tag_s2_tri", self)
		local s2_bar = self.xml:InitStatic("tag_s2_bar", self)
		self.slots[i] = {
			shadow = shadow,
			line_sh = line_sh,
			line = line,
			plate = plate,
			accent = accent,
			icon = icon,
			head_sh = head_sh,
			head = head,
			name_sh = name_sh,
			name = name,
			rank_sh = rank_sh,
			rank = rank,
			weap_sh = weap_sh,
			weap = weap,
			sign_sh = sign_sh,
			sign = sign,
			glow = glow,
			node = node,
			spinner = spinner,
			box_top = box_top,
			box_bottom = box_bottom,
			box_left = box_left,
			box_right = box_right,
			s2_circle = s2_circle,
			s2_tri = s2_tri,
			s2_bar = s2_bar,
		}
		-- hidden starts unset (falsy) so this first hide_slot() call actually
		-- runs the Show(false) calls below, instead of short-circuiting on its
		-- own "already hidden" guard and leaving all widgets at their XML
		-- default position (0,0 -- top-left) permanently visible.
		self:hide_slot(i)
	end

	-- Debug-draw pool (MCM "Debug draw"): round dots for the FOV ring + in-ring
	-- entity bones, one text line for the radius, and a dedicated aim dot created
	-- LAST so it draws on top. All start hidden; only shown when debug_draw is on.
	self.dbg = { dots = {}, texts = {}, text = nil, aim = nil }
	for i = 1, DBG_DOTS do
		local d = self.xml:InitStatic("dbg_dot", self)
		d:Show(false)
		self.dbg.dots[i] = d
	end
	for i = 1, DBG_TEXTS do
		local t = self.xml:InitTextWnd("dbg_text:text", self)
		t:Show(false)
		self.dbg.texts[i] = t
	end
	self.dbg.text = self.xml:InitTextWnd("dbg_text:text", self)
	self.dbg.text:Show(false)
	self.dbg.status = self.xml:InitTextWnd("dbg_status:text", self)
	self.dbg.status:Show(false)
	self.dbg.aim = self.xml:InitStatic("dbg_dot", self)
	self.dbg.aim:Show(false)
end

-- The plate/accent/icon/text widgets, shared by hide_slot and draw_slot's
-- scanning/mini/minimal branches -- glow/node/spinner are deliberately
-- excluded since each caller shows or hides those three differently. sign/
-- sign_sh are card-style-irrelevant like the rest of this list (hidden
-- together with it); the minimal-style branch shows them back explicitly,
-- same pattern as mini-mode already does for glow/node below.
local CARD_WIDGET_KEYS = {
	"shadow",
	"line_sh",
	"line",
	"plate",
	"accent",
	"icon",
	"head_sh",
	"head",
	"name_sh",
	"name",
	"rank_sh",
	"rank",
	"weap_sh",
	"weap",
	"sign_sh",
	"sign",
}

local function hide_card_widgets(s)
	for _, k in ipairs(CARD_WIDGET_KEYS) do
		s[k]:Show(false)
	end
end

-- Bodycam box edges: hidden every frame by default (see draw_slot), only shown
-- by the bodycam reveal branch, so switching away from bodycam or into a
-- scanning/other-style frame leaves no stale edges behind. Kept out of
-- CARD_WIDGET_KEYS deliberately -- the card path shows its widgets one-by-one
-- and never calls hide_card_widgets, so a shared list wouldn't cover it.
local BOX_WIDGET_KEYS = { "box_top", "box_bottom", "box_left", "box_right" }

local function hide_box_widgets(s)
	for _, k in ipairs(BOX_WIDGET_KEYS) do
		s[k]:Show(false)
	end
end

-- Simple 2 style shapes (circle, triangle, rank bar). Hidden every frame at the top of
-- draw_slot; only the simple2 branch re-shows them.
local function hide_s2_widgets(s)
	s.s2_circle:Show(false)
	s.s2_tri:Show(false)
	s.s2_bar:Show(false)
end

function IiTags:hide_slot(i)
	local s = self.slots[i]
	if not s or s.hidden then
		return
	end
	s.hidden = true
	hide_card_widgets(s)
	hide_box_widgets(s)
	hide_s2_widgets(s)
	s.glow:Show(false)
	s.node:Show(false)
	s.spinner:Show(false)
end

-- Hide every debug-draw widget (the FOV-ring/bone dot pool, the radius text, and
-- the aim dot). Called when debug_draw is off / on teardown.
function IiTags:hide_debug()
	local d = self.dbg
	if not d then
		return
	end
	if d._active == false then
		return
	end
	d._active = false
	for i = 1, DBG_DOTS do
		d.dots[i]:Show(false)
	end
	for i = 1, DBG_TEXTS do
		d.texts[i]:Show(false)
	end
	if d.text then
		d.text:Show(false)
	end
	if d.status then
		d.status:Show(false)
	end
	if d.aim then
		d.aim:Show(false)
	end
end

-- Target-assist debug visualiser (MCM "Debug draw"). Draws, in the 1024x768 virtual
-- UI space that world2ui + fov_radius already live in:
--   * the current aim point (aim_center) as a RED dot,
--   * the FOV target-assist ring (radius = fov_radius) as a circle of YELLOW dots,
--   * dots on every body bone of each NPC/creature whose nearest body point is inside
--     the ring (a candidate) -- GREEN if within max_dist (would identify), RED if the
--     target is OUTSIDE max range (rejected for distance),
--   * the distance (metres) to each candidate as text on it,
--   * the radius value as text.
-- The test matches find_nearest_in_fov exactly (aim_angle_to_body vs aim_cone_rad),
-- so what you see is precisely what the assist tests. Pure debug: gated on
-- C.debug_draw, iterates once per frame, dot/text pools reused (no per-frame alloc).
function IiTags:draw_debug()
	local d = self.dbg
	if not d then
		return
	end
	d._active = true
	local used = 0
	local used_t = 0
	-- Consume one pooled dot: centre (cx,cy) in virtual px, `size` px, colour a/r/g/b.
	-- UI_KX corrects the horizontal size so the dot stays round on any aspect (the
	-- CENTRE is raw virtual px, matching world2ui / the fov_radius comparison).
	local function dot(cx, cy, size, a, r, g, b)
		used = used + 1
		local w = d.dots[used]
		if not w then
			return false
		end
		local wx = math.max(2, math.floor(size * UI_KX + 0.5))
		w:SetWndSize(S(wx, size))
		w:SetWndPos(P(math.floor(cx - wx / 2), math.floor(cy - size / 2)))
		w:SetTextureColor(GetARGB(a, r, g, b))
		w:Show(true)
		return used < DBG_DOTS
	end
	-- Consume one pooled text label at (cx,cy).
	local function label(cx, cy, str, a, r, g, b)
		used_t = used_t + 1
		local w = d.texts[used_t]
		if not w then
			return false
		end
		w:SetText(str)
		w:SetTextColor(GetARGB(a, r, g, b))
		w:SetWndPos(P(math.floor(cx), math.floor(cy)))
		w:Show(true)
		return used_t < DBG_TEXTS
	end

	local cx, cy = aim_center()
	local cone = aim_cone_rad() -- assist tolerance, radians
	-- Draw the cone as a screen ring at the CURRENT FOV: px = cone * 768 / fov_rad, so
	-- the drawn circle matches the angular assist visually (unzoomed -> ~fov_radius px;
	-- a non-PiP zoom grows it). It's an approximation under a PiP scope (the main camera
	-- is the un-zoomed swayed view), but the actual test below is angular either way.
	local dev = device and device()
	local fov_rad = (dev and dev.fov and dev.fov > 0) and (dev.fov * math.pi / 180) or 1.047
	local radius = cone * 768 / fov_rad
	-- Use the EFFECTIVE max range (base * binoc/ADS boost, incl. scope magnification)
	-- so the green/red range colouring matches what would actually identify right now.
	local dbg_binoc, dbg_ads, _, eff_max = boost_params()
	local max_dist = eff_max or (C.max_dist or 50)
	local mag = scope_magnification()

	-- FOV ring outline (yellow).
	for i = 0, DBG_RING_SEG - 1 do
		local ang = (i / DBG_RING_SEG) * 2 * math.pi
		dot(cx + math.cos(ang) * radius, cy + math.sin(ang) * radius, 4, 210, 255, 220, 40)
	end

	-- Bones of every entity inside the ring: GREEN if within max_dist (a real
	-- identify candidate), RED if beyond max range (rejected for distance). Scans a
	-- bit past max_dist so out-of-range candidates you're aiming at still show.
	if db.actor and level and level.iterate_nearest then
		local apos = db.actor:position()
		local actor_id = db.actor:id()
		local scan = math.max(max_dist * 2, max_dist + 40)
		pcall(level.iterate_nearest, apos, scan, function(obj)
			if used >= DBG_DOTS then
				return true
			end
			if
				obj
				and obj:id() ~= actor_id
				and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj))
				and safe_call(obj.alive, obj)
			then
				local ang = aim_angle_to_body(obj)
				if ang and ang <= cone then
					local base = obj:position()
					local dist = math.sqrt(apos:distance_to_sqr(base))
					-- Green in range, red out of range.
					local cr, cg, cb = 235, 60, 70
					if dist <= max_dist then
						cr, cg, cb = 60, 235, 70
					end
					local drew = false
					local tx, ty -- label anchor: first projected bone
					for _, bone in ipairs(BODY_BONES) do
						local p = safe_call(obj.bone_position, obj, bone)
						if p and p:distance_to_sqr(base) < 16 then
							local sx, sy = project_world(p)
							if sx then
								drew = true
								tx, ty = tx or sx, ty or sy
								if not dot(sx, sy, 6, 200, cr, cg, cb) then
									break
								end
							end
						end
					end
					if not drew then -- monster / non-bip01 rig: the vertical-span fallback
						for _, lift in ipairs(MONSTER_SPAN) do
							local sx, sy = project_world(_v.body_pt:set(base.x, base.y + lift, base.z))
							if sx then
								tx, ty = tx or sx, ty or sy
								if not dot(sx, sy, 6, 200, cr, cg, cb) then
									break
								end
							end
						end
					end
					-- Distance label on the candidate (same colour as its dots).
					if tx then
						label(tx + 8, ty - 8, string.format("%.0fm", dist), 255, cr, cg, cb)
					end
				end
			end
			return false
		end)
	end

	-- Hide any unused pooled dots + labels.
	for i = used + 1, DBG_DOTS do
		d.dots[i]:Show(false)
	end
	for i = used_t + 1, DBG_TEXTS do
		d.texts[i]:Show(false)
	end

	-- Aim point (red), dedicated widget created last so it draws on top.
	if d.aim then
		local aw = math.max(2, math.floor(9 * UI_KX + 0.5))
		d.aim:SetWndSize(S(aw, 9))
		d.aim:SetWndPos(P(math.floor(cx - aw / 2), math.floor(cy - 9 / 2)))
		d.aim:SetTextureColor(GetARGB(255, 235, 40, 40))
		d.aim:Show(true)
	end

	-- Radius value + the angular cone the assist actually uses, just above the ring.
	if d.text then
		d.text:SetText(
			string.format("fov_radius %d  (cone %.2fdeg)", math.floor(C.fov_radius or 110), cone * 180 / math.pi)
		)
		d.text:SetTextColor(GetARGB(255, 255, 220, 40))
		d.text:SetWndPos(P(math.floor(cx + 6), math.floor(cy - radius - 18)))
		d.text:Show(true)
	end

	-- Status line, under the radius. Shows the active mode, the RANGE multiplier that
	-- is actually applied (eff/base -- this is what widens the range, may differ from
	-- the optical zoom: binoculars use a flat binoc_range_mult unless binoc_zoom_scaling
	-- is on), and the optical `zoom` (informational -- the scope/binoc magnification).
	if d.status then
		local base = C.max_dist or 50
		local mode = dbg_binoc and "binoc" or (dbg_ads and "ADS" or "hip")
		local rmult = base > 0 and (max_dist / base) or 1
		local rtxt
		if math.abs(max_dist - base) < 0.5 then
			rtxt = string.format("range x1.0 (%dm)", math.floor(base))
		else
			rtxt = string.format("range x%.1f (%d -> %dm)", rmult, math.floor(base), math.floor(max_dist))
		end
		local ztxt = mag and string.format("zoom x%.1f", mag) or "zoom -"
		d.status:SetText(string.format("%s  %s  %s", mode, rtxt, ztxt))
		d.status:SetTextColor(GetARGB(255, 120, 220, 255))
		d.status:SetWndPos(P(math.floor(cx + 6), math.floor(cy - radius - 2)))
		d.status:Show(true)
	end
end

-- Bodycam style: gap (px) from the box's right edge to the name/weapon text, and
-- the vertical step between the name and weapon lines.
local BODYCAM_TEXT_PAD = 8
local BODYCAM_LINE_H = 19

-- Draws an unfilled rectangle outline (four thin strips) centred on (cx,cy)
-- with the given screen-space half-width/half-height, in the fixed 1024x768
-- virtual space. hw/hh already come from a world2ui projection of the head's
-- real-world extents (see screen_box), so they're in the correct virtual units
-- and need NO UI_KX squeeze -- the engine's virtual->screen stretch maps
-- position and size together, landing each edge exactly on the projected point.
--
-- Thickness is the fixed C.box_thickness (virtual px), not distance-scaled, so
-- the outline stays a predictable weight the player sets. The vertical edges'
-- WIDTH is pre-divided by UI_KX so they render the same on-screen thickness as
-- the horizontal edges (a raw px width is stretched differently on the X axis --
-- see UI_KX). Edges butt at the corners with NO overlap: top/bottom span the
-- full width, left/right fill only the gap between them -- so a thick outline
-- no longer double-draws (and darkens) at the corners.
-- Depth-aware overlay binding (custom bodycam exe): draws world-anchored rects
-- depth-tested against the scene, so walls/viewmodel clip the box per-pixel. Same
-- guarded-existence pattern as the redaction/marker paths; inert on a stock exe, where
-- draw_head_box falls back to the (non-depth-aware) CUIStatic edges.
local function overlay_binding()
	local bc = rawget(_G, "bodycam")
	if bc and bc.overlay_begin and bc.overlay_rect and bc.overlay_commit then
		return bc
	end
	return nil
end
---@type any
local _overlay_bc = nil -- set for the current frame in render() (begin..commit)

-- Submit one rect to the depth overlay. Coords are in the mod's 1024x768 virtual
-- space; the engine scales them to real pixels (dwWidth/1024, dwHeight/768 -- the
-- same stretch world2ui uses). world anchor drives the per-pixel depth test.
local function overlay_rect_v(vx0, vy0, vx1, vy1, a, r, g, b, wx, wy, wz)
	local bc = _overlay_bc
	if not bc then
		return
	end
	pcall(bc.overlay_rect, vx0, vy0, vx1, vy1, r / 255, g / 255, b / 255, a / 255, wx or 0, wy or 0, wz or 0)
end

local function draw_head_box(s, cx, cy, hw, hh, alpha, r, g, b, wx, wy, wz)
	local t = C.box_thickness or 2
	if t < 1 then
		t = 1
	end
	local tw = math.max(1, t * UI_KX) -- vertical-edge width, aspect-corrected
	local a = math.floor(alpha * (C.box_opacity or 1))
	local x0, y0 = cx - hw, cy - hh
	local w, h = hw * 2, hh * 2
	local vh = math.max(1, h - 2 * t) -- vertical edges fill between top & bottom

	-- Depth-aware path: submit the 4 edges as world-anchored rects to the engine
	-- (occluded per-pixel by walls/viewmodel) and hide the flat CUIStatic edges.
	if _overlay_bc and wx then
		s.box_top:Show(false)
		s.box_bottom:Show(false)
		s.box_left:Show(false)
		s.box_right:Show(false)
		overlay_rect_v(x0, y0, x0 + w, y0 + t, a, r, g, b, wx, wy, wz) -- top
		overlay_rect_v(x0, y0 + h - t, x0 + w, y0 + h, a, r, g, b, wx, wy, wz) -- bottom
		overlay_rect_v(x0, y0 + t, x0 + tw, y0 + h - t, a, r, g, b, wx, wy, wz) -- left
		overlay_rect_v(x0 + w - tw, y0 + t, x0 + w, y0 + h - t, a, r, g, b, wx, wy, wz) -- right
		return
	end

	-- Fallback: flat CUIStatic edges (no depth awareness).
	local col = GetARGB(a, r, g, b)
	s.box_top:SetWndSize(S(w, t))
	s.box_top:SetWndPos(P(x0, y0))
	s.box_top:SetTextureColor(col)
	s.box_top:Show(true)

	s.box_bottom:SetWndSize(S(w, t))
	s.box_bottom:SetWndPos(P(x0, y0 + h - t))
	s.box_bottom:SetTextureColor(col)
	s.box_bottom:Show(true)

	s.box_left:SetWndSize(S(tw, vh))
	s.box_left:SetWndPos(P(x0, y0 + t))
	s.box_left:SetTextureColor(col)
	s.box_left:Show(true)

	s.box_right:SetWndSize(S(tw, vh))
	s.box_right:SetWndPos(P(x0 + w - tw, y0 + t))
	s.box_right:SetTextureColor(col)
	s.box_right:Show(true)
end

local SPIN_D = 20 -- spinner diameter, px, at scale 1
local SPIN_PERIOD_MS = 900 -- one full rotation

-- Draws just the relation-coloured node dot + its glow halo at the body
-- anchor -- shared by the scanning-spinner branch and draw_slot's mini/full
-- paths, since all three need this exact pair positioned the same way. `s`
-- is a slot table (has .node/.glow), not `self` -- a plain function, not a
-- method. Sizing matches gamma-immersive-quest-markers' card_node/card_glow
-- proportions (node_size=7, glow = node_size * nscale * 2.8).
--
-- Capped separately from the card's own `scale` (which the user can push
-- well past 1x via the card_scale MCM slider): applying that same growth to
-- the small marker dot ballooned it into a blob at high scale, most visible
-- in its baked-in outline ring (see ii_node's texture comment) getting
-- proportionally thick, since a ring that's a fixed fraction of the dot's
-- radius reads heavier the bigger the dot gets. The leader line (drawn
-- separately in draw_slot) isn't capped since a thicker line doesn't have
-- that same "blob" problem.
local NODE_SCALE_MAX = 1.4

-- Minimal (dot) style distance scale: 1.0 at ~20 m, larger up close, smaller far, so a
-- distant target's dot isn't oversized. Clamped both ways. Constants inline to spare
-- top-level locals (Lua 5.1's 200-per-chunk limit).
local function mini_dist_scale_factor(dist)
	if not dist or dist <= 0 then
		return 1
	end
	local s = 20 / dist
	if s < 0.4 then
		s = 0.4
	elseif s > 1.6 then
		s = 1.6
	end
	return s
end

local function draw_node_glow(s, hx, hy, scale, alpha, r, g, b)
	local node_scale = math.min(scale, NODE_SCALE_MAX)
	local ns = 7 * node_scale
	local nsx = math.max(2, math.floor(ns * UI_KX + 0.5))
	s.node:SetWndSize(S(nsx, ns))
	s.node:SetWndPos(P(math.floor(hx - nsx / 2), math.floor(hy - ns / 2)))
	s.node:SetTextureColor(GetARGB(alpha, r, g, b))
	s.node:Show(true)

	local gs = ns * 2.8
	local gsx = math.max(2, math.floor(gs * UI_KX + 0.5))
	s.glow:SetWndSize(S(gsx, gs))
	s.glow:SetWndPos(P(math.floor(hx - gsx / 2), math.floor(hy - gs / 2)))
	s.glow:SetTextureColor(GetARGB(math.floor(alpha * 0.55), r, g, b))
	s.glow:Show(true)
end

-- Positions/tints/shows one text line plus its 1px-offset shadow copy.
local function draw_shadowed_text(main, sh, x, y, alpha, r, g, b, shadow_a)
	sh:SetWndPos(P(x + 1, y + 1))
	sh:SetTextColor(GetARGB(shadow_a, 0, 0, 0))
	sh:Show(true)
	main:SetWndPos(P(x, y))
	main:SetTextColor(GetARGB(alpha, r, g, b))
	main:Show(true)
end

-- Depth-aware TEXT: ENABLED via the engine glyph-emitter (custom bodycam exe).
-- overlay_text_add submits each line (virtual coords + world anchor); the engine's
-- phase_bodycam_text rasterises the glyphs directly as screen-space quads (atlas UVs,
-- bypassing CGameFont::OnRender -- the transform-inheritance that left rt_bodycam_text
-- empty across v2.31..v2.38), then composites depth-tested (occluded by walls +
-- viewmodel, like the box). Inert on a stock exe: overlay_text_add is absent there, so
-- draw_bodycam_line falls back to the flat CUIStatic text. See docs/engine-depth-overlay.md.
local DEPTH_TEXT = true

-- Draw one bodycam text line either depth-aware (engine overlay, occluded by
-- walls/viewmodel) or, when disabled/absent, as the flat CUIStatic shadowed text.
-- main_w/sh_w are the widget + its shadow copy.
local function draw_bodycam_line(main_w, sh_w, str, x, y, alpha, r, g, b, shadow_a, wx, wy, wz)
	if DEPTH_TEXT and _overlay_bc and _overlay_bc.overlay_text_add and wx then
		main_w:Show(false)
		sh_w:Show(false)
		pcall(_overlay_bc.overlay_text_add, str, x, y, r / 255, g / 255, b / 255, alpha / 255, wx, wy, wz)
	else
		main_w:SetText(str)
		sh_w:SetText(str)
		draw_shadowed_text(main_w, sh_w, x, y, alpha, r, g, b, shadow_a)
	end
end

-- Minimal-style relation sign (-/+/o), centred on the same anchor point as
-- the node dot. Text size is fixed, like head/name/rank in the card style --
-- this engine only has 3 discrete font sizes (no continuous scaling), so
-- only its position tracks hx,hy, not its size.
local SIGN_W, SIGN_H = 20, 18

local function draw_sign(s, hx, hy, alpha, sign_char)
	local col = SIGN_COLOR[sign_char] or COL_NEUTRAL
	s.sign:SetText(sign_char)
	s.sign_sh:SetText(sign_char)
	local shadow_a = math.floor(180 * alpha / 255)
	draw_shadowed_text(
		s.sign,
		s.sign_sh,
		math.floor(hx - SIGN_W / 2),
		math.floor(hy - SIGN_H / 2),
		alpha,
		col[1],
		col[2],
		col[3],
		shadow_a
	)
end

-- hx, hy: anchor screen position (1024x768 virtual space) -- the identify
-- point on the NPC's body, and where the leader line starts. alpha: 0..255.
-- scanning: true while the pre-reveal spinner is running (no card yet); tg:
-- time_global(), drives the spinner's rotation. scale: C.card_scale, a flat
-- MCM-configurable multiplier (1 = reference size), unaffected by range or
-- pose -- applied to the whole card, the node/glow, and the card's offset
-- from the anchor. Text itself is font-rendered at a fixed size (this UI
-- system has no continuous runtime text-scaling API, and an attempt at
-- distance-reactive discrete font tiers didn't work out -- see git history),
-- so only the plate/paddings around it grow or shrink.
--
-- Below C.mini_scale_cutoff the card layout doesn't hold up any more (text
-- unreadable, plate a near-illegible sliver), so this falls back to just the
-- relation-coloured node dot + glow instead -- see the branch below.
--
-- Layout once revealed (above the mini cutoff): a plate offset up and to one
-- side of the anchor (flipped to the other side near the screen edge), with
-- a relation-tinted accent bar down its left edge, the faction icon inlined,
-- then a header line (faction, relation-tinted) and a name line (the
-- target's own name, brighter) stacked, plus a rank line (if any) below
-- both. A leader line joins the node dot at the anchor to the plate's
-- nearest corner. Mirrors gamma-immersive-quest-markers' card technique
-- (see this class's header comment above InitControls).
--
-- stack_offset (px, optional): extra vertical push above the normal
-- CARD_OFF_Y, set by render()'s overlap-avoidance pass when another active
-- card's anchor is close enough to plausibly collide with this one's. The
-- leader line naturally gets longer to reach the raised card; no separate
-- handling needed for it.
-- box_cx/box_cy/box_hw/box_hh (bodycam style only): the head-bone screen centre
-- and its projected half-extents, precomputed in render(); nil for other styles
-- or when the head doesn't project this frame.
function IiTags:draw_slot(
	i,
	hx,
	hy,
	header,
	name,
	alpha,
	col,
	icon_id,
	scanning,
	tg,
	scale,
	rank,
	stack_offset,
	fcol,
	sign,
	weap,
	box_cx,
	box_cy,
	box_hw,
	box_hh,
	box_wx,
	box_wy,
	box_wz,
	rank_col
)
	local s = self.slots[i]
	if not s then
		return
	end
	s.hidden = false
	hide_box_widgets(s) -- box only ever re-shown by the bodycam branch below
	hide_s2_widgets(s) -- Simple 2 shapes only ever re-shown by the simple2 branch below

	local r, g, b = col[1], col[2], col[3]
	scale = scale or 1
	stack_offset = stack_offset or 0
	alpha = math.floor(alpha)
	if alpha > 255 then
		alpha = 255
	end

	if scanning then
		-- scanning only: a rotating spinner on the body, nothing revealed yet.
		-- Always plain white -- relation isn't known/shown as a colour cue
		-- until the tag actually reveals. Branches on the `scanning` flag
		-- itself, not `alpha <= 1`: alpha is also driven by distance fade, so
		-- a target near the max fade-out distance during the *revealed*
		-- phase could hit alpha<=1 too and wrongly flip back to the spinner.
		-- NOT width-squeezed by UI_KX like the static node/glow/line: those
		-- are pre-distorted so the engine's anisotropic virtual-to-screen
		-- stretch turns them back into circles, but that trick only holds
		-- for a shape at a fixed orientation. SetHeading() below rotates
		-- this widget in virtual space *before* that stretch is applied, and
		-- rotation doesn't commute with a non-uniform scale -- a squeezed
		-- rectangle rotated first comes out elliptical at every angle rather
		-- than circular, so this stays square instead.
		local spin_d = SPIN_D * scale
		local spin_angle = (tg % SPIN_PERIOD_MS) / SPIN_PERIOD_MS * (2 * math.pi)
		s.spinner:SetWndSize(S(spin_d, spin_d))
		s.spinner:SetWndPos(P(hx - spin_d / 2, hy - spin_d / 2))
		s.spinner:SetTextureColor(GetARGB(230, 255, 255, 255))
		s.spinner:SetHeading(spin_angle)
		s.spinner:Show(true)

		hide_card_widgets(s)
		s.glow:Show(false)
		s.node:Show(false)
		return
	end

	s.spinner:Show(false)

	-- Minimal style: always just the faction-coloured dot + a relation sign,
	-- regardless of scale -- a distinct, user-selected visual language, not
	-- just Card style's own too-small-to-fit fallback below.
	if C.ui_style == 2 then
		hide_card_widgets(s)
		draw_node_glow(s, hx, hy, scale, alpha, fcol[1], fcol[2], fcol[3])
		draw_sign(s, hx, hy, alpha, sign)
		return
	end

	-- Bodycam style: an unfilled, faction-coloured outline box locked to the
	-- head bone and auto-scaled so it stays a constant real-world size around
	-- the head -- no plate, dot, or sign, just the frame. box_hw/box_hh are nil
	-- when the head doesn't project this frame (off-screen / no camera vectors),
	-- in which case nothing is drawn (box already hidden at the top).
	if C.ui_style == 3 then
		hide_card_widgets(s)
		s.glow:Show(false)
		s.node:Show(false)
		if box_hw and box_hh then
			-- Box colour source: faction colour, or the relationship colour
			-- (red/green/grey) keyed off the relation sign -- which stays accurate
			-- regardless of color_by_relation, unlike the relation-tinted `col`.
			local bcol = fcol
			if C.box_color_source == 2 then
				bcol = SIGN_COLOR[sign] or COL_NEUTRAL
			end
			draw_head_box(s, box_cx, box_cy, box_hw, box_hh, alpha, bcol[1], bcol[2], bcol[3], box_wx, box_wy, box_wz)

			-- Name / faction / weapon+caliber, stacked just to the right of the box
			-- and tracking it every frame, each gated by its generic show toggle.
			-- Reuse the card's text widgets (hidden above by hide_card_widgets,
			-- re-shown per present line). Weapon skipped for the unarmed/monsters.
			local tx = math.floor(box_cx + box_hw + BODYCAM_TEXT_PAD)
			local ty = math.floor(box_cy - box_hh)
			local shadow_a = math.floor(180 * alpha / 255)
			if C.show_name and name and name ~= "" then
				draw_bodycam_line(
					s.name,
					s.name_sh,
					name,
					tx,
					ty,
					alpha,
					236,
					230,
					218,
					shadow_a,
					box_wx,
					box_wy,
					box_wz
				)
				ty = ty + BODYCAM_LINE_H
			end
			if C.show_faction and header and header ~= "" then
				draw_bodycam_line(
					s.head,
					s.head_sh,
					header,
					tx,
					ty,
					alpha,
					fcol[1],
					fcol[2],
					fcol[3],
					shadow_a,
					box_wx,
					box_wy,
					box_wz
				)
				ty = ty + BODYCAM_LINE_H
			end
			if C.show_weapon and weap and weap ~= "" then
				draw_bodycam_line(
					s.weap,
					s.weap_sh,
					weap,
					tx,
					ty,
					alpha,
					172,
					178,
					188,
					shadow_a,
					box_wx,
					box_wy,
					box_wz
				)
			end
		end
		return
	end

	-- Simple 2 style: over the head -- a faction-coloured circle and a relation-coloured
	-- (red enemy / green friendly / grey neutral) triangle side by side, with a thin
	-- rank-coloured bar spanning them above. Distance-scaled (scale) and anchored at the
	-- head like the PiP markers. Shape WIDTHS are UI_KX-corrected so the circle/triangle
	-- stay round/undistorted on wide screens (the virtual->screen stretch, same trick as
	-- the node dot); heights aren't.
	if C.ui_style == 4 then
		hide_card_widgets(s)
		s.glow:Show(false)
		s.node:Show(false)
		local sc = scale
		local cd = 12 * sc -- circle diameter (also the row height driver)
		local tw, th = 13 * sc, 11 * sc -- triangle width / height
		local gap = 3 * sc -- gap between circle and triangle
		local bh = math.max(2, 3 * sc) -- rank bar height
		local bgap = 3 * sc -- gap between the bar and the shapes
		local kx = UI_KX
		local cw = math.max(2, math.floor(cd * kx + 0.5)) -- circle screen width (kept round)
		local twx = math.max(2, math.floor(tw * kx + 0.5)) -- triangle screen width
		local gpx = gap * kx
		local roww = cw + gpx + twx
		local left = hx - roww / 2
		local rowh = math.max(cd, th)
		local cy = hy - rowh / 2 - 2 * sc -- sit the shapes just above the head anchor

		s.s2_circle:SetWndSize(S(cw, cd))
		s.s2_circle:SetWndPos(P(math.floor(left), math.floor(cy - cd / 2)))
		s.s2_circle:SetTextureColor(GetARGB(alpha, fcol[1], fcol[2], fcol[3]))
		s.s2_circle:Show(true)

		local rc = SIGN_COLOR[sign] or COL_NEUTRAL
		s.s2_tri:SetWndSize(S(twx, th))
		s.s2_tri:SetWndPos(P(math.floor(left + cw + gpx), math.floor(cy - th / 2)))
		s.s2_tri:SetTextureColor(GetARGB(alpha, rc[1], rc[2], rc[3]))
		s.s2_tri:Show(true)

		local rk = rank_col or { 150, 150, 150 }
		s.s2_bar:SetWndSize(S(math.floor(roww), math.floor(bh)))
		s.s2_bar:SetWndPos(P(math.floor(left), math.floor(cy - rowh / 2 - bgap - bh)))
		s.s2_bar:SetTextureColor(GetARGB(alpha, rk[1], rk[2], rk[3]))
		s.s2_bar:Show(true)
		return
	end

	-- Mini fallback: below the cutoff, the card doesn't fit any more, so just
	-- show the relation dot -- the same node the leader line would otherwise
	-- connect to a card, minus the card. `scale` is a single flat MCM value
	-- shared by every card (not distance-derived), so this is a global
	-- on/off rather than a per-target one -- no hysteresis needed, since it
	-- only ever changes when the player edits the slider, not per frame.
	if scale < C.mini_scale_cutoff then
		hide_card_widgets(s)
		draw_node_glow(s, hx, hy, scale, alpha, r, g, b)
		return
	end

	if s.icon_key ~= icon_id then
		pcall(s.icon.InitTexture, s.icon, icon_id)
		s.icon_key = icon_id
	end

	-- Which lines this style shows (the toggles are generic across the text
	-- styles): faction (header), name and weapon are user toggles; rank shows
	-- whenever the target has one. The faction icon patch stays regardless.
	local has_head = C.show_faction and header and header ~= ""
	local has_name = C.show_name and name and name ~= ""
	local has_rank = rank and rank ~= ""
	local has_weap = C.show_weapon and weap and weap ~= ""
	local pad, accent_w = 8, 3
	local iw = 16 * scale
	local lead = 5 * scale
	local ispan = iw + 4 * scale

	-- Text width: re-measured only when the strings OR which lines are shown
	-- change (AdjustWidthToText/GetWidth per change, not per frame).
	local text_w = s.text_w
	if
		header ~= s.last_head
		or name ~= s.last_name
		or rank ~= s.last_rank
		or weap ~= s.last_weap
		or has_head ~= s.last_hhead
		or has_name ~= s.last_hname
		or has_weap ~= s.last_hweap
	then
		text_w = 0
		if has_head then
			s.head:SetText(header)
			s.head_sh:SetText(header)
			s.head:AdjustWidthToText()
			s.head_sh:AdjustWidthToText()
			text_w = math.max(text_w, s.head:GetWidth())
		end
		if has_name then
			s.name:SetText(name)
			s.name_sh:SetText(name)
			s.name:AdjustWidthToText()
			s.name_sh:AdjustWidthToText()
			text_w = math.max(text_w, s.name:GetWidth())
		end
		if has_rank then
			s.rank:SetText(rank)
			s.rank_sh:SetText(rank)
			s.rank:AdjustWidthToText()
			s.rank_sh:AdjustWidthToText()
			text_w = math.max(text_w, s.rank:GetWidth())
		end
		if has_weap then
			s.weap:SetText(weap)
			s.weap_sh:SetText(weap)
			s.weap:AdjustWidthToText()
			s.weap_sh:AdjustWidthToText()
			text_w = math.max(text_w, s.weap:GetWidth())
		end
		s.text_w, s.last_head, s.last_name, s.last_rank, s.last_weap = text_w, header, name, rank, weap
		s.last_hhead, s.last_hname, s.last_hweap = has_head, has_name, has_weap
	end

	local cw = math.floor(accent_w + lead + ispan + text_w + pad + 0.5)

	-- Vertical layout: PAD_TOP, each present line separated by GAP, then
	-- PAD_BOTTOM. Fixed line heights matching each widget's font (letterica16 for
	-- header/rank/weap, letterica18 for name). Computed generically since any line
	-- can be toggled off (header/name are no longer assumed present).
	local PAD_TOP, PAD_BOTTOM, GAP = 7, 7, 4
	local head_h, name_h, rank_h, weap_h = 16, 18, 16, 16
	local ch, nlines = PAD_TOP, 0
	if has_head then
		ch = ch + head_h
		nlines = nlines + 1
	end
	if has_name then
		if nlines > 0 then
			ch = ch + GAP
		end
		ch = ch + name_h
		nlines = nlines + 1
	end
	if has_rank then
		if nlines > 0 then
			ch = ch + GAP
		end
		ch = ch + rank_h
		nlines = nlines + 1
	end
	if has_weap then
		if nlines > 0 then
			ch = ch + GAP
		end
		ch = ch + weap_h
		nlines = nlines + 1
	end
	ch = ch + PAD_BOTTOM

	-- place the card up and to one side of the anchor; flip to the left near
	-- the right edge of the (1024-wide virtual) screen. stack_offset (see
	-- render()'s overlap-avoidance pass) pushes it further up still when
	-- another card's anchor is close enough to plausibly collide -- the
	-- leader line below just extends to reach it, which is what visually
	-- stacks the two instead of them landing flush on top of each other.
	local off_x, off_y = CARD_OFF_X * scale, CARD_OFF_Y * scale + stack_offset
	local right = (hx + off_x + cw) <= 1014
	local cx = right and (hx + off_x) or (hx - off_x - cw)
	if cx < 4 then
		cx = 4
	end
	local cy = hy - off_y - ch
	if cy < 4 then
		cy = 4
	end

	-- soft drop shadow (ii_shadow, feathered -- see its texture comment),
	-- larger and offset down-right of the plate, so the card reads as lifted
	-- off the world instead of pasted flat on it. Margin needs real room for
	-- the feather band to show past the plate's edge, not just a couple of
	-- px -- 5 read as another hard rectangle peeking out from behind the
	-- plate rather than a soft shadow.
	local sh_m = 9 * scale
	s.shadow:SetWndPos(P(cx - sh_m + 3, cy - sh_m + 4))
	s.shadow:SetWndSize(S(cw + sh_m * 2, ch + sh_m * 2))
	s.shadow:SetTextureColor(GetARGB(math.floor(160 * alpha / 255), 0, 0, 0))
	s.shadow:Show(true)

	s.plate:SetWndPos(P(cx, cy))
	s.plate:SetWndSize(S(cw, ch))
	s.plate:SetTextureColor(GetARGB(math.floor(185 * alpha / 255), 24, 22, 19))
	s.plate:Show(true)

	local acc_in = 6 * scale
	s.accent:SetWndPos(P(cx, cy + acc_in))
	s.accent:SetWndSize(S(accent_w, ch - acc_in * 2))
	s.accent:SetTextureColor(GetARGB(alpha, r, g, b))
	s.accent:Show(true)

	s.icon:SetWndPos(P(cx + accent_w + lead, cy + math.floor((ch - iw) * 0.5)))
	s.icon:SetWndSize(S(iw, iw))
	s.icon:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	s.icon:Show(true)

	-- Stack the present lines past the accent bar + icon: faction (relation-
	-- tinted), name (brighter), then muted rank + weapon. A running cursor walks
	-- down, so any toggled-off line simply contributes nothing and the ones below
	-- close up under it -- matching the ch calc above. Hidden lines are Show(false).
	local txo = cx + accent_w + lead + ispan
	local shadow_a = math.floor(180 * alpha / 255)
	local y = math.floor(cy + PAD_TOP)
	local placed = 0

	if has_head then
		draw_shadowed_text(s.head, s.head_sh, txo, y, alpha, r, g, b, shadow_a)
		y = y + head_h
		placed = placed + 1
	else
		s.head:Show(false)
		s.head_sh:Show(false)
	end

	if has_name then
		if placed > 0 then
			y = y + GAP
		end
		draw_shadowed_text(s.name, s.name_sh, txo, y, alpha, 235, 230, 220, shadow_a)
		y = y + name_h
		placed = placed + 1
	else
		s.name:Show(false)
		s.name_sh:Show(false)
	end

	if has_rank then
		if placed > 0 then
			y = y + GAP
		end
		-- muted: secondary to the name, so its own (lower) alpha
		draw_shadowed_text(
			s.rank,
			s.rank_sh,
			txo,
			math.floor(y),
			math.floor(200 * alpha / 255),
			210,
			205,
			195,
			shadow_a
		)
		y = y + rank_h
		placed = placed + 1
	else
		s.rank:Show(false)
		s.rank_sh:Show(false)
	end

	if has_weap then
		if placed > 0 then
			y = y + GAP
		end
		-- steel-grey, dimmer still: an equipment note, not competing with the name
		draw_shadowed_text(
			s.weap,
			s.weap_sh,
			txo,
			math.floor(y),
			math.floor(185 * alpha / 255),
			165,
			180,
			195,
			shadow_a
		)
		y = y + weap_h
		placed = placed + 1
	else
		s.weap:Show(false)
		s.weap_sh:Show(false)
	end

	-- node + its glow halo at the anchor point on the body (shared with the
	-- mini-mode branch above -- see draw_node_glow's comment).
	draw_node_glow(s, hx, hy, scale, alpha, r, g, b)

	-- leader line: node -> nearest bottom corner of the card, extended
	-- slightly past the corner so its end tucks under the plate (drawn over
	-- it), giving a flush join at any aspect ratio. The engine's heading
	-- rotation multiplies the strip's X by UI_KX, so dx is pre-divided by it
	-- here to land exactly on both endpoints (see UI_KX's declaration).
	local corner_x = right and cx or (cx + cw)
	local corner_y = cy + ch
	local dx, dy = corner_x - hx, corner_y - hy
	local seglen = math.sqrt(dx * dx + dy * dy)
	if seglen > 0.001 then
		local over = 6
		dx = dx + dx / seglen * over
		dy = dy + dy / seglen * over
		corner_x, corner_y = hx + dx, hy + dy
	end
	local dxk = dx / UI_KX
	local len = math.sqrt(dxk * dxk + dy * dy)
	local ang = math.atan2(-dy, dxk)
	local mx, my = (hx + corner_x) * 0.5, (hy + corner_y) * 0.5
	local thick = 2 * scale

	s.line_sh:SetWndSize(S(len, thick + 2))
	s.line_sh:SetWndPos(P(mx - len * 0.5, my - (thick + 2) * 0.5))
	s.line_sh:EnableHeading(true)
	s.line_sh:SetHeading(ang)
	s.line_sh:SetTextureColor(GetARGB(math.floor(alpha * 0.5), 0, 0, 0))
	s.line_sh:Show(true)

	s.line:SetWndSize(S(len, thick))
	s.line:SetWndPos(P(mx - len * 0.5, my - thick * 0.5))
	s.line:EnableHeading(true)
	s.line:SetHeading(ang)
	s.line:SetTextureColor(GetARGB(math.floor(alpha * 0.8), r, g, b))
	s.line:Show(true)
end

-- --------------------------------------------------------------------------
-- Per-frame update
-- --------------------------------------------------------------------------
local function ensure_tags()
	if TAGS then
		return true
	end
	local hud = get_hud and get_hud()
	if not hud then
		return false
	end
	TAGS = IiTags()
	hud:AddDialogToRender(TAGS)
	return true
end

-- Overlap avoidance: two anchors this close together in screen space (px,
-- 1024x768 virtual space) would draw their cards on top of each other,
-- since both extend the same fixed offset in roughly the same direction
-- from their own anchor. STACK_STEP is how much further up each additional
-- overlapping card gets pushed -- the leader line just extends to reach it,
-- which is what stacks them cleanly instead of them sitting flush on the
-- same spot. Deliberately a proximity heuristic on the anchors themselves,
-- not real measured card-rect overlap: the actual plate width/height isn't
-- known until draw_slot measures the text, and gathering that up front
-- would mean either duplicating that measurement here or restructuring
-- draw_slot to run in two phases -- this is simpler and, since it only ever
-- misfires by stacking a pair that would narrowly NOT have overlapped, the
-- failure mode is "slightly more separated than strictly necessary", not a
-- visible collision.
local STACK_DIST_X, STACK_DIST_Y = 140, 90
local STACK_STEP = 58

-- hide_unseen: how long a target must stay continuously out of sight before its
-- tag is dropped. Small enough to feel instant, big enough to ride out a
-- one-frame ray flicker through a thin obstacle (see render's drop logic).
local HIDE_GRACE_MS = 150

-- --------------------------------------------------------------------------
-- Face redaction feed (multi-rect engine pass). Fully independent of identification:
-- every frame it builds the list of face boxes for the visible humanoids in range
-- (membership refreshed on a throttle in update_redact_membership; boxes recomputed
-- here every frame so they track movement) and submits them in one atomic
-- begin/add/commit. Inert without the custom exe.
-- --------------------------------------------------------------------------
local face_ids = {} -- cached humanoid-in-range ids (face redaction, alive OR dead)
local redact_last_tg = 0
-- Membership refresh cadence: iterate_nearest + alive checks (no LOS raycasts), so a
-- newly-in-range face starts redacting promptly. The per-frame feed re-projects the
-- cached set every frame regardless.
local REDACT_THROTTLE_MS = 150
local _redaction_boxes = {} -- reused per-frame box list, avoids GC churn

-- Head box (screen bbox, 1024x768 virtual space) as cx,cy,hw,hh, or nil if it
-- doesn't project this frame. Head bone (lifted to the face centre) first, body
-- anchor for monsters without a bip01_head.
-- Returns the screen bbox (cx,cy,hw,hh,depth) PLUS the box's WORLD centre and
-- world half-extents (metres) -- the engine reprojects the latter through the
-- scope camera for in-scope redaction (see redaction_submit).
local function head_box_for(obj)
	local hc = head_center(obj) or anchor_pos(obj)
	if not hc then
		return nil
	end
	local cx, cy, hw, hh, depth = screen_box(hc, BOX_HALF_W, BOX_HALF_H)
	if not cx then
		return nil
	end
	return cx, cy, hw, hh, depth, hc.x, hc.y, hc.z, BOX_HALF_W, BOX_HALF_H
end

-- Full-body box: the screen-space bounding box of the actual body bones, so it
-- follows the physics RAGDOLL in any pose (a dead entity's obj:position() stays
-- at the last-alive/AI spot and does NOT track the ragdoll, which is why the old
-- position-based box floated where the target died -- bone_position tracks the
-- real model). Projects a spread of bip01 bones, takes their min/max screen
-- extent, and pads it out a little. Falls back to a vertical span at the origin
-- for monsters / rigs without these bones.
local BODY_BOX_BONES = {
	"bip01_head",
	"bip01_neck",
	"bip01_spine2",
	"bip01_spine1",
	"bip01_spine",
	"bip01_pelvis",
	"bip01_l_forearm",
	"bip01_r_forearm",
	"bip01_l_hand",
	"bip01_r_hand",
	"bip01_l_calf",
	"bip01_r_calf",
	"bip01_l_foot",
	"bip01_r_foot",
}
-- Reused world-AABB accumulator for body_box_for: a module-level scratch so the
-- per-frame box build allocates neither a table nor a closure (hot path). bbw_add
-- grows it; body_box_for resets _bbw.has = false at the start of each build.
local _bbw = { has = false, minx = 0, miny = 0, minz = 0, maxx = 0, maxy = 0, maxz = 0 }
local function bbw_add(px, py, pz)
	if not _bbw.has then
		_bbw.has = true
		_bbw.minx, _bbw.miny, _bbw.minz = px, py, pz
		_bbw.maxx, _bbw.maxy, _bbw.maxz = px, py, pz
		return
	end
	if px < _bbw.minx then
		_bbw.minx = px
	elseif px > _bbw.maxx then
		_bbw.maxx = px
	end
	if py < _bbw.miny then
		_bbw.miny = py
	elseif py > _bbw.maxy then
		_bbw.maxy = py
	end
	if pz < _bbw.minz then
		_bbw.minz = pz
	elseif pz > _bbw.maxz then
		_bbw.maxz = pz
	end
end
local function body_box_for(obj)
	local base = obj:position()
	local minx, miny, maxx, maxy
	-- World-space AABB of the same bones (in _bbw), for the in-scope reprojection.
	_bbw.has = false
	for _, bone in ipairs(BODY_BOX_BONES) do
		local p = safe_call(obj.bone_position, obj, bone)
		if p and p:distance_to_sqr(base) < 25 then -- sane bone (within 5 m of origin)
			local sx, sy = project_world(p)
			if sx then
				if not minx then
					minx, miny, maxx, maxy = sx, sy, sx, sy
				else
					if sx < minx then
						minx = sx
					elseif sx > maxx then
						maxx = sx
					end
					if sy < miny then
						miny = sy
					elseif sy > maxy then
						maxy = sy
					end
				end
				bbw_add(p.x, p.y, p.z)
			end
		end
	end

	if not minx then
		-- monster / non-bip01 rig: bound a vertical span at the origin instead.
		for _, lift in ipairs(MONSTER_SPAN) do
			local sx, sy = project_world(_v.bb_pt:set(base.x, base.y + lift, base.z))
			if sx then
				if not minx then
					minx, miny, maxx, maxy = sx, sy, sx, sy
				else
					if sx < minx then
						minx = sx
					elseif sx > maxx then
						maxx = sx
					end
					if sy < miny then
						miny = sy
					elseif sy > maxy then
						maxy = sy
					end
				end
				bbw_add(base.x, base.y + lift, base.z)
			end
		end
		if not minx then
			return nil
		end
	end

	local cx, cy = (minx + maxx) * 0.5, (miny + maxy) * 0.5
	-- Pad the tight bone bounds outward so the box encloses body thickness/limbs,
	-- not just the bone points: a fraction of each axis plus a small floor.
	local hw = (maxx - minx) * 0.5 + math.max(6, (maxx - minx) * 0.12)
	local hh = (maxy - miny) * 0.5 + math.max(6, (maxy - miny) * 0.10)
	if hw < 2 or hh < 2 then
		return nil
	end
	-- World centre + billboard half-extents from the bone AABB (horizontal =
	-- widest of the X/Z spans, vertical = Y span), padded a touch, for the
	-- in-scope reprojection. Falls back to a metric guess if no world data.
	local wcx, wcy, wcz, whw, whh
	if _bbw.has then
		wcx, wcy, wcz = (_bbw.minx + _bbw.maxx) * 0.5, (_bbw.miny + _bbw.maxy) * 0.5, (_bbw.minz + _bbw.maxz) * 0.5
		whw = math.max(_bbw.maxx - _bbw.minx, _bbw.maxz - _bbw.minz) * 0.5 + 0.1
		whh = (_bbw.maxy - _bbw.miny) * 0.5 + 0.1
	else
		wcx, wcy, wcz, whw, whh = base.x, base.y + 0.9, base.z, 0.45, 0.95
	end
	-- Depth for the shader mask: the chest anchor (ragdoll-tracking) is a good
	-- representative view-depth for the whole body box.
	return cx, cy, hw, hh, view_depth(anchor_pos(obj)), wcx, wcy, wcz, whw, whh
end

-- Head-only (area 1) or full-body (area 2) box for an object. Used by the bodycam
-- outline rectangle (box_area).
local function area_box_for(obj, area)
	if area == 2 then
		return body_box_for(obj)
	end
	return head_box_for(obj)
end

-- Face-only box, for FACE redaction (applies to living entities too, and covers just
-- the face). Tighter than the
-- head box, and nudged FORWARD along the entity's facing so it sits over the face
-- (the front of the head) rather than centred on the skull. Humanoids only --
-- head_center is nil for monsters/rigs without bip01_head, so they're skipped.
local FACE_HALF_W = 0.12 -- the face is narrower/shorter than the whole head box
local FACE_HALF_H = 0.15
local FACE_FWD = 0.08 -- metres to push the box toward the face front, along facing
local function face_box_for(obj)
	local hc = head_center(obj)
	if not hc then
		return nil
	end
	local dir = safe_call(obj.direction, obj)
	if dir then
		hc = _v.face_c:set(hc.x + dir.x * FACE_FWD, hc.y + dir.y * FACE_FWD, hc.z + dir.z * FACE_FWD)
	end
	local cx, cy, hw, hh, depth = screen_box(hc, FACE_HALF_W, FACE_HALF_H)
	if not cx then
		return nil
	end
	-- NEGATE the depth to flag this as a FACE box: the redaction shader then uses a
	-- tight, front-biased depth band (only the face front + sides, not the back of
	-- the head). The engine passes the value through untouched, so no rebuild; the
	-- world data below stays positive (the in-scope SVP pass reprojects it normally).
	return cx, cy, hw, hh, -(depth or 0), hc.x, hc.y, hc.z, FACE_HALF_W, FACE_HALF_H
end

-- Throttled: rebuild the set of dead NPCs/creatures in range. NO LOS check here
-- on purpose: the redaction shader is depth-aware (it rejects any pixel nearer
-- than the corpse, so a body behind a wall simply shows no redacted pixels), so
-- gating membership on db.actor:see was both redundant AND the cause of a pop-in
-- delay -- see() is smoothed/cached with a grace window, so a body you turn to
-- look at took a beat to start redacting. Dropping it makes it appear the instant
-- the box is on screen, and per-pixel depth occlusion is more accurate than a
-- whole-corpse LOS gate. Off-screen corpses cost nothing (their box won't
-- project). The per-frame feed re-projects each head from this membership.
-- Throttled sweep: face_ids = humanoids in range, alive or dead (face redaction).
local function update_redact_membership(tg)
	if not C.redact_face then
		if #face_ids > 0 then
			face_ids = {}
		end
		return
	end
	if tg - redact_last_tg < REDACT_THROTTLE_MS then
		return
	end
	redact_last_tg = tg
	if not db.actor or not level.iterate_nearest then
		face_ids = {}
		return
	end
	local apos = db.actor:position()
	local actor_id = db.actor:id()
	local fids, fn = {}, 0
	-- Redaction has its OWN range, decoupled from the identification max_dist:
	-- redaction is passive (no aiming), so it should reach as far as a face is
	-- actually visible. (A distant face still stops naturally once its box projects
	-- below ~1px, see screen_box.)
	local redact_range = C.redact_range or C.max_dist or 50
	pcall(level.iterate_nearest, apos, redact_range, function(obj)
		-- Face redaction: humanoids only (they have a face), alive or dead.
		if obj and obj:id() ~= actor_id and fn < REDACTION_MAX and safe_call(IsStalker, obj) then
			fn = fn + 1
			fids[fn] = obj:id()
		end
		return false -- keep scanning the whole set within range
	end)
	face_ids = fids
end

-- box_fn(obj) -> the screen box + world data (face_box_for); padding is the loosen
-- fraction.
local function add_redaction_box(boxes, n, obj, box_fn, padding)
	local cx, cy, hw, hh, depth, wcx, wcy, wcz, whw, whh = box_fn(obj)
	if not cx then
		return n
	end
	-- Loosen the redacted region off the model (a fraction of its size, so it stays
	-- proportional at any distance). Applied to both the main-screen rect and the
	-- world half-extents.
	local rp = 1 + (padding or 0)
	n = n + 1
	local b = boxes[n] or {}
	b.cx, b.cy, b.hw, b.hh, b.depth = cx, cy, hw * rp, hh * rp, depth or 0
	b.wcx, b.wcy, b.wcz = wcx or 0, wcy or 0, wcz or 0
	b.whw, b.whh = (whw or 0) * rp, (whh or 0) * rp
	boxes[n] = b
	return n
end

-- No longer skips when scoped: the engine runs the redaction in BOTH the main
-- pass (screen rects) and the SVP pass (world boxes reprojected through the scope
-- camera), so the same submission feeds both. The main-pass rects are simply
-- against the wrong picture inside the lens, but the lens only samples the SVP
-- pass's output, so there's no conflict.
local function feed_redaction(suppress_main)
	local bc = redaction_binding()
	if not bc then
		return
	end -- stock exe: nothing to feed

	-- Face redaction: humanoid faces (front-only band).
	local boxes, n = _redaction_boxes, 0
	if C.redact_face then
		for _, id in ipairs(face_ids) do
			if n >= REDACTION_MAX then
				break
			end
			local obj = level.object_by_id(id)
			if obj then
				n = add_redaction_box(boxes, n, obj, face_box_for, C.redact_face_padding)
			end
		end
	end

	redaction_submit(boxes, n, C.redact_strength or 1.0, suppress_main, C.redact_face_style)

	if C.debug_log then
		local on = n > 0
		if on ~= _redaction_dbg_active then
			_redaction_dbg_active = on
			dbg(
				on and string.format("redact ON: %d face box(es) strength=%.2f", n, C.redact_strength or 1.0)
					or "redact OFF"
			)
		end
	end
end

local function render(tg)
	if not TAGS then
		return
	end -- only ever called after ensure_tags() succeeds, but don't assume it

	-- Target-assist debug visualiser (independent of the tag/scope paths below, so
	-- it draws even when the HUD is suppressed / a scope is up).
	if C.debug_draw then
		TAGS:draw_debug()
	else
		TAGS:hide_debug()
	end

	local apos = db.actor and db.actor:position()

	-- While a true PiP scope is actively raised, the normal card/dot (always
	-- projected through the MAIN camera) would be positioned against the
	-- wrong picture -- the magnified disc shows a different, narrower view
	-- via its own SVP camera entirely. So this path replaces the on-screen
	-- HUD with in-scope markers instead of drawing both (a misplaced main-
	-- view card floating next to a correctly placed in-scope dot would just
	-- read as broken, not additive). See svp_ui_markers_add()'s own comment
	-- for why the marker's position is submitted as a world point rather
	-- than pre-projected here: the render thread projects it fresh through
	-- this frame's own SVP camera, so there's no cross-thread staleness.
	-- pip_scope: a PiP scope is physically rendering (regardless of our toggles).
	-- pip_active: our in-scope UI path is on (pip_markers gates it) -- off = behave
	-- as if there were no PiP support (normal HUD, no in-scope markers).
	local pip_scope = PIP_AVAILABLE and is_svp_active()
	local pip_active = C.pip_markers and pip_scope
	-- Suppress ALL main-view drawing (HUD tags + main-pass redaction) while aiming
	-- down sight (ads_hide_main) or while a scope is up (pip_hide_main). The
	-- in-scope UI is unaffected -- markers still publish and scope redaction still
	-- draws. (pip_active already hides the main HUD on its own; this also covers
	-- the ADS-without-PiP and pip_markers-off cases, plus the main-pass redaction.)
	local suppress_main = (C.ads_hide_main and is_ads_active()) or (C.pip_hide_main and pip_scope)
	-- Unconditional on PIP_AVAILABLE (not pip_active): runs every frame the
	-- engine supports it, scoped or not, so lowering the scope mid-reveal
	-- still publishes one more (empty) snapshot instead of leaving the last
	-- scoped frame's markers published indefinitely.
	if PIP_AVAILABLE then
		svp_ui_markers_begin()
	end

	-- Depth-aware bodycam overlay: open the per-frame rect + text batches
	-- (draw_head_box / draw_slot fill them). Committed at every exit below so a
	-- stale batch never persists.
	_overlay_bc = overlay_binding()
	if _overlay_bc then
		pcall(_overlay_bc.overlay_begin)
		if _overlay_bc.overlay_text_begin then
			pcall(_overlay_bc.overlay_text_begin)
		end
	end

	-- First pass: resolve which targets are actually on-screen and drawable
	-- this frame (unchanged logic from before), collecting them instead of
	-- drawing immediately, so the second pass below can see every card's
	-- anchor at once before any of them are actually positioned.
	local active_n = 0

	for id, e in pairs(tracked) do
		-- Per-instance range/speed, captured at identify time in try_identify()
		-- (see the binocular-boost comment there) rather than read live from
		-- C here, so a tag identified at boosted range/speed keeps using
		-- that boost for its whole reveal even if the player lowers the
		-- binoculars partway through.
		local scan_ms = e.scan_ms or SCAN_MS
		local max_dist = e.max_dist or C.max_dist
		local fade_dist = e.fade_dist or C.fade_dist
		local fade_ms = e.fade_ms or FADE_MS
		local hold_ms = e.hold_ms or HOLD_MS
		local total = scan_ms + fade_ms + hold_ms + fade_ms

		local obj = level.object_by_id(id)
		local remove = not obj
		if obj then
			remove = not safe_call(obj.alive, obj) -- a tag is dropped the instant its target dies
		end

		local elapsed = tg - e.t0
		if not remove and elapsed > total then
			remove = true
		end

		-- Out of sight: drop the tag near-instantly rather than wait out its
		-- visibility timer (overrides the "stay visible after identify" hold).
		-- tag_visible is now geometric (see has_clear_ray), so it goes false the
		-- instant a wall interposes. A tiny debounce (HIDE_GRACE_MS) absorbs a
		-- single-frame ray flicker through a thin obstacle so the tag isn't lost
		-- for good on a blink; re-identify / auto-identify re-adds it regardless.
		if not remove and obj and C.hide_unseen then
			if tag_visible(obj) then
				e.unseen_since = nil
			else
				e.unseen_since = e.unseen_since or tg
				if tg - e.unseen_since >= HIDE_GRACE_MS then
					remove = true
				end
			end
		end

		if remove then
			tracked[id] = nil
		else
			local phase_alpha, scanning = 0, false
			if elapsed < scan_ms then
				scanning = true
			elseif elapsed < scan_ms + fade_ms then
				phase_alpha = (elapsed - scan_ms) / fade_ms
			elseif elapsed < scan_ms + fade_ms + hold_ms then
				phase_alpha = 1
			else
				phase_alpha = 1 - (elapsed - (scan_ms + fade_ms + hold_ms)) / fade_ms
				if phase_alpha < 0 then
					phase_alpha = 0
				end
			end

			local pos = anchor_pos(obj)
			local dist = apos and pos:distance_to(apos) or 0
			local dist_fade = 1
			if dist > fade_dist then
				local span = math.max(1, max_dist - fade_dist)
				dist_fade = 1 - (dist - fade_dist) / span
				if dist_fade < 0 then
					dist_fade = 0
				end
			end

			-- (Out-of-sight targets are already dropped above via hide_unseen.)
			local sx, sy = project_world(pos)
			if sx and dist <= max_dist * 1.15 then
				-- Fill = faction colour, ring = relation colour -- same
				-- two-signal split as the Minimal HUD style's dot+sign,
				-- adapted to what a flat shader shape can actually convey
				-- (see scope_custom_markers.h). While scanning, the shader
				-- draws a rotating spinner arc instead of fill+ring (there's
				-- no reveal to colour yet, same as the main HUD's spinner
				-- being plain white until the tag actually reveals) -- fill
				-- colour/alpha there only carries the spinner's own alpha
				-- (0.9, matching the HUD spinner's fixed GetARGB(230,...)),
				-- not phase_alpha, which is still 0 for the whole scan.
				if pip_active then
					local col, fcol = e.col, e.fcol
					local alpha = scanning and (0.9 * dist_fade) or (phase_alpha * dist_fade)
					svp_ui_markers_add(
						pos.x,
						pos.y + PIP_MARKER.lift,
						pos.z,
						fcol[1] / 255,
						fcol[2] / 255,
						fcol[3] / 255,
						alpha,
						pip_marker_radius(dist),
						col[1] / 255,
						col[2] / 255,
						col[3] / 255,
						scanning
					)
				end

				active_n = active_n + 1
				local a = active_pool[active_n]
				-- User X/Y nudge (virtual px) for all on-screen UI elements.
				local off_x, off_y = C.ui_offset_x or 0, C.ui_offset_y or 0
				a.hx, a.hy, a.header, a.name = sx + off_x, sy + off_y, e.header, e.name
				a.a = math.floor(255 * phase_alpha * dist_fade + 0.5)
				a.col, a.icon, a.scanning = e.col, e.icon, scanning
				-- Minimal (dot, style 2, opt-in) and Simple 2 (style 4, always) scale with
				-- distance so a far target's marker isn't oversized; other styles keep the
				-- flat card_scale.
				if (C.ui_style == 2 and C.mini_dist_scale) or C.ui_style == 4 then
					a.scale = C.card_scale * mini_dist_scale_factor(dist)
					-- Pull the marker DOWN toward the head as the target gets far. Its size is
					-- floored to stay visible while the head keeps shrinking, so without this
					-- the floored marker floats high over the now-tiny head. Close range (raw
					-- >= ~0.85, under ~24 m) is untouched.
					local raw = 20 / math.max(dist, 1)
					a.hy = a.hy + math.min(16, math.max(0, 0.85 - raw) * 20)
				else
					a.scale = C.card_scale
				end
				a.rank = e.rank
				a.rank_col = e.rank_col
				a.fcol, a.sign = e.fcol, e.sign
				a.weap = e.weap

				-- Bodycam style: precompute the outline box's screen centre and
				-- distance-scaled half-extents here (draw_slot has no world access),
				-- head-only or full-body per box_area. Cleared otherwise, since
				-- active_pool entries are reused and would carry stale extents.
				if C.ui_style == 3 then
					local bcx, bcy, bhw, bhh, _, bwx, bwy, bwz = area_box_for(obj, C.box_area or 1)
					if bcx then
						-- Loosen the box off the model by box_padding (a fraction of
						-- its size, so it stays proportional at any distance).
						local bp = 1 + (C.box_padding or 0)
						a.box_cx, a.box_cy = bcx + off_x, bcy + off_y
						a.box_hw, a.box_hh = bhw * bp, bhh * bp
						-- World anchor for depth-aware overlay drawing (engine occlusion).
						a.box_wx, a.box_wy, a.box_wz = bwx, bwy, bwz
					else
						a.box_cx, a.box_cy, a.box_hw, a.box_hh = nil, nil, nil, nil
						a.box_wx, a.box_wy, a.box_wz = nil, nil, nil
					end
				else
					a.box_hw, a.box_hh = nil, nil
				end
			end
		end
	end

	-- Snapshot published every frame PIP_AVAILABLE (even with zero markers,
	-- and even when not currently scoped -- see begin() above): without
	-- this, the last scoped frame's markers would otherwise linger
	-- published forever once tracked drains out, or once the scope lowers.
	if PIP_AVAILABLE then
		svp_ui_markers_commit()
	end

	-- Drive the engine redaction pass with every in-range face box (custom bodycam exe
	-- only; inert otherwise). Submits every frame -- an empty set clears the pass -- and
	-- feeds both the main pass and the SVP pass (see feed_redaction's own comment).
	feed_redaction(suppress_main)

	if pip_active or suppress_main then
		for i = 1, MAX_TAGS do
			TAGS:hide_slot(i)
		end
		if _overlay_bc then
			pcall(_overlay_bc.overlay_commit) -- empty: clear any prior overlay rects
			if _overlay_bc.overlay_text_commit then
				pcall(_overlay_bc.overlay_text_commit)
			end
			_overlay_bc = nil
		end
		return
	end

	-- Second pass: for each active card, count how many EARLIER cards in
	-- this same list have an anchor close enough (in both axes) to
	-- plausibly collide, and stack it that many steps higher. Scanning-only
	-- and mini-mode cards don't get a stack offset (draw_slot ignores it in
	-- both cases): a bare spinner or a single small dot at the same spot is
	-- a far smaller collision than two full cards, not worth the extra
	-- separation.
	local slot_i = 0
	for i = 1, active_n do
		local ai = active_pool[i]
		local stack = 0
		for j = 1, i - 1 do
			local aj = active_pool[j]
			if math.abs(ai.hx - aj.hx) < STACK_DIST_X and math.abs(ai.hy - aj.hy) < STACK_DIST_Y then
				stack = stack + 1
			end
		end

		slot_i = slot_i + 1
		if slot_i <= MAX_TAGS then
			TAGS:draw_slot(
				slot_i,
				ai.hx,
				ai.hy,
				ai.header,
				ai.name,
				ai.a,
				ai.col,
				ai.icon,
				ai.scanning,
				tg,
				ai.scale,
				ai.rank,
				stack * STACK_STEP,
				ai.fcol,
				ai.sign,
				ai.weap,
				ai.box_cx,
				ai.box_cy,
				ai.box_hw,
				ai.box_hh,
				ai.box_wx,
				ai.box_wy,
				ai.box_wz,
				ai.rank_col
			)
		end
	end

	for i = slot_i + 1, MAX_TAGS do
		TAGS:hide_slot(i)
	end

	if _overlay_bc then
		pcall(_overlay_bc.overlay_commit) -- publish this frame's depth-overlay rects
		if _overlay_bc.overlay_text_commit then
			pcall(_overlay_bc.overlay_text_commit)
		end
		_overlay_bc = nil
	end
end

-- Tear down every UI element the mod has drawn: hide all tag slots, drop the
-- active reveals, forget cached corpses, and clear the engine redaction pass.
local function teardown_ui()
	if TAGS then
		for i = 1, MAX_TAGS do
			TAGS:hide_slot(i)
		end
		TAGS:hide_debug()
	end
	for k in pairs(tracked) do
		tracked[k] = nil
	end
	face_ids = {}
	redaction_clear()
	local ob = overlay_binding() -- clear any depth-overlay rects
	if ob then
		pcall(ob.overlay_begin)
		pcall(ob.overlay_commit)
	end
end

-- When the ADS range boost ends (you zoom out / lower the sight), the effective
-- identify range snaps back from the extended (ads_range_mult) range to the base.
-- Any tag identified at that extended range that now sits beyond the base range is
-- dropped immediately -- rather than lingering invisibly on its reveal timer --
-- and survivors are re-snapshotted to the base range so their distance fade-out
-- matches it. Fires only on the ADS-boost active->inactive edge.
--
-- Deliberately NOT applied to binoculars: those keep a just-glassed distant tag
-- readable after you lower them (see boost_params()'s snapshot comment), a
-- dedicated-observation UX that differs from ADS's transient combat aid.
local _was_ads_boost = false
local function update_ads_range_cull()
	local _, ads, _, eff_max_dist, eff_fade_dist = boost_params()
	local ads_boost = ads and C.ads_boost
	if _was_ads_boost and not ads_boost then
		local apos = db.actor and safe_call(db.actor.position, db.actor)
		if apos then
			for id, e in pairs(tracked) do
				local obj = level.object_by_id(id)
				local pos = obj and safe_call(obj.position, obj)
				if pos and pos:distance_to(apos) > eff_max_dist then
					tracked[id] = nil -- out of the (now unboosted) range: clear it
				else
					e.max_dist, e.fade_dist = eff_max_dist, eff_fade_dist
				end
			end
		end
	end
	_was_ads_boost = ads_boost
end

local function actor_on_update()
	update_fov_baseline() -- keep this warm even while the mod is disabled

	-- Actor death: clear everything we drew so no tag/box/redaction lingers on
	-- the death screen. Polled here (idempotent); also fires if the actor object
	-- is momentarily absent.
	if not db.actor or not safe_call(db.actor.alive, db.actor) then
		teardown_ui()
		reset_steady()
		return
	end

	if not C.enabled then
		if TAGS then
			for i = 1, MAX_TAGS do
				TAGS:hide_slot(i)
			end
		end
		reset_steady()
		redaction_clear()
		return
	end
	if not ensure_tags() then
		return
	end
	local tg = time_global()
	update_binocular_scan(tg)
	update_auto_identify(tg)
	update_ads_range_cull()
	update_redact_membership(tg)
	update_loot_xp()
	render(tg)
end

-- --------------------------------------------------------------------------
-- Save/load: persists xp_awarded, remembered, and loot_xp_awarded only (tracked is transient
-- reveal state, deliberately not saved -- an active scan/reveal just
-- restarts clean after a load, same as it would after walking out of range
-- and back). Declared `local` rather than a bare global specifically to
-- avoid colliding with other scripts' own same-named save_state/load_state
-- globals (e.g. haru_skills.script defines its own): RegisterScriptCallback
-- is a proper multi-subscriber event bus (every mod's registered save_state
-- fires, none overwrite each other), unlike this engine's single-slot
-- native set_callback, so there's no need for -- and no benefit to -- a
-- global here.
-- --------------------------------------------------------------------------
local function save_state(m_data)
	m_data.ii_xp_awarded = xp_awarded
	m_data.ii_remembered = remembered
	m_data.ii_loot_xp_awarded = loot_xp_awarded
end

local function load_state(m_data)
	xp_awarded = m_data.ii_xp_awarded or {}
	remembered = m_data.ii_remembered or {}
	loot_xp_awarded = m_data.ii_loot_xp_awarded or {}
end

-- --------------------------------------------------------------------------
-- MCM live-apply + startup (on_mcm_load lives in ii_mcm.script)
-- --------------------------------------------------------------------------
function on_option_change()
	read_config()
end

-- Actor death: tear everything down at the MOMENT of death. actor_on_update's
-- own death poll isn't enough on its own -- the death screen can freeze updates
-- with the last frame's tags still drawn -- so this fires right before death to
-- blank them immediately. Multi-subscriber bus, so it never clobbers other mods'
-- handlers. Declared local to avoid a global name collision.
local function actor_on_before_death()
	teardown_ui()
	reset_steady()
end

function on_game_start()
	read_config()
	install_key_hook()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	-- Stock weapon-zoom callbacks -> ADS flag (see _ads / is_ads_active). Anonymous
	-- handlers so they add no top-level locals (Lua 5.1's 200-per-chunk limit).
	RegisterScriptCallback("actor_on_weapon_zoom_in", function()
		_ads.zoomed = true
	end)
	RegisterScriptCallback("actor_on_weapon_zoom_out", function()
		_ads.zoomed = false
	end)
end
