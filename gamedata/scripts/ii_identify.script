-- ======================================================================
--  Immersive Identification
--  Aim at an NPC, press the identify key: after a brief "scan" pulse, a
--  floating tag naming their faction appears anchored to their body in
--  world space (not a HUD element), fades to full, holds, then fades out.
-- ======================================================================

local MAX_TAGS = 12 -- most identifications tracked/drawn at once (raised from 5
-- so the auto-identify option, which reveals every visible
-- target at once, isn't constantly evicting the oldest tag)

local DBG_DOTS = 96 -- debug-draw dot pool (bones of the entities inside the FOV ring)
-- FOV ring texture (ii_ring): its stroke centreline sits at 120/256 of the image
-- width, so a widget sized 2*radius*span puts that centreline exactly on fov_radius.
local DBG_RING = { span = 128 / 120 }
local DBG_TEXTS = 16 -- per-candidate distance labels
local DBG_INFO = 28 -- bottom-right info panel lines (perf + scan breakdown + aim/LOS state + FOV list)

-- render()'s per-frame scratch list of on-screen cards, reused instead of
-- allocated fresh every call -- tracked is capped at MAX_TAGS (see
-- try_identify), so this pool never needs to grow past it.
local active_pool = {}
for i = 1, MAX_TAGS do
	active_pool[i] = {}
end

-- Defaults, also the fallback when MCM is absent. Keys match the MCM option
-- ids under the "ii" menu (see ii_mcm.script). Declared non-local so the menu
-- file can read it as ii_identify.DEFAULTS (single source of truth).
DEFAULTS = ii_config.DEFAULTS

-- Section name of the stock binoculars item (confirmed from this engine's
-- own bundled gamedata/scripts/axr_main.script:355:
-- `binoc_is_zoomed = wpn and (wpn:section() == "wpn_binoc_inv")`). Matched
-- as a substring too, not just exact-equal, in case a modpack ships a
-- differently-sectioned binoculars variant that still follows this naming.
local BINOC_SECTION = "wpn_binoc_inv"

-- --------------------------------------------------------------------------
-- PiP (picture-in-picture scope) compatibility gate
-- --------------------------------------------------------------------------
-- is_svp_active()/svp_ui_markers_begin/add/commit() only exist when the
-- engine build itself has the True PiP feature (xray-monolith-pip, or a
-- fork built on it) -- stock xray-monolith and vanilla Anomaly builds don't
-- register them at all. Checked once via rawget(_G, ...), the same
-- existence-check idiom this engine's own PiP-aware scripts use (e.g.
-- zzz_extra_scope_features.script's svp_optic_api_* lookups), so referencing
-- a name that doesn't exist never errors -- it's just nil, same as any other
-- undefined global. Checked once at load rather than per-call: unlike
-- haru_skills (a separate Lua script whose load order isn't guaranteed
-- relative to this one), these are C++-registered engine globals, already
-- present before any Lua runs at all.
local PIP_AVAILABLE = rawget(_G, "is_svp_active") ~= nil
	and rawget(_G, "svp_ui_markers_begin") ~= nil
	and rawget(_G, "svp_ui_markers_add") ~= nil
	and rawget(_G, "svp_ui_markers_commit") ~= nil

-- Marker size in the shader's lens-UV space (0..1 of the disc radius, see
-- svp_ui_markers_add()'s C++-side comment) -- a flat constant rather than an
-- MCM slider for now, since this whole feature is still an in-progress
-- engine patch. PIP_MARKER.lift floats the marker above the head instead of
-- sitting on it (metres, on top of anchor_pos()'s own ANCHOR_LIFT), separate
-- from the main HUD's anchor so the normal card/dot isn't affected by it.
-- PIP_MARKER_RADIUS is the size AT the reference distance below.
-- Bundled into one local (radius/lift/ref-dist/scale floor+ceiling) to spare top-level
-- locals (Lua 5.1's 200-per-chunk limit).
local PIP_MARKER = { radius = 0.03, lift = 0.22, ref = 15, smin = 0.25, smax = 1.3 }

-- Distance scaling for the PiP marker. The radius is a fixed fraction of the lens
-- (screen space), so without this a far target -- whose head is small on screen --
-- gets the same big dot and it overlaps the head. The world LIFT already scales
-- correctly (it's a world offset, its screen gap shrinks with distance), so only the
-- radius needs it. Scale ~ REF_DIST/dist (like apparent size), clamped so a very close
-- target doesn't balloon and a distant one doesn't vanish. PIP_MARKER_RADIUS is the
-- size at PIP_MARKER_REF_DIST metres (tuned so nearby targets look right).
local function pip_marker_radius(dist)
	if not dist or dist <= 0 then
		return PIP_MARKER.radius
	end
	local s = PIP_MARKER.ref / dist
	if s < PIP_MARKER.smin then
		s = PIP_MARKER.smin
	elseif s > PIP_MARKER.smax then
		s = PIP_MARKER.smax
	end
	return PIP_MARKER.radius * s
end

-- Fallback key when key_dik hasn't been captured yet (fresh install, or MCM
-- absent). Resolved lazily via DIK_keys (not ready when this file is
-- parsed). Declared non-local so ii_mcm.script can read it as
-- ii_identify.DEFAULT_KEY_NAME to seed the key-capture widget's default.
DEFAULT_KEY_NAME = ii_config.DEFAULT_KEY_NAME
MODIFIER_LIST = ii_config.MODIFIER_LIST
UI_STYLE_LIST = ii_config.UI_STYLE_LIST
ANCHOR_BASIS_LIST = ii_config.ANCHOR_BASIS_LIST
CROOKS_POS_LIST = ii_config.CROOKS_POS_LIST
REDACT_AREA_LIST = ii_config.REDACT_AREA_LIST
BOX_COLOR_SOURCE_LIST = ii_config.BOX_COLOR_SOURCE_LIST

-- Community id -> display-name string id. Anything not listed here falls
-- back to a prettified version of the raw community id, so unknown/modded
-- factions still show something reasonable instead of nothing.
local FACTION_NAMES = {
	stalker = "st_ii_faction_stalker",
	bandit = "st_ii_faction_bandit",
	dolg = "st_ii_faction_dolg",
	freedom = "st_ii_faction_freedom",
	csky = "st_ii_faction_csky",
	ecolog = "st_ii_faction_ecolog",
	killer = "st_ii_faction_killer",
	military = "st_ii_faction_military",
	monolith = "st_ii_faction_monolith",
	renegade = "st_ii_faction_renegade",
	zombied = "st_ii_faction_zombied",
	greh = "st_ii_faction_greh",
	trader = "st_ii_faction_trader",
	monster = "st_ii_faction_monster",
	isg = "st_ii_faction_isg",
	arena = "st_ii_faction_arena",
}

local COL_ENEMY = { 224, 76, 64 }
local COL_FRIEND = { 118, 206, 128 }
local COL_NEUTRAL = { 214, 194, 140 }

-- Minimal-style dot colour: distinct per faction (unlike the card's node,
-- which is relation-coloured -- see relation_color() below) so the dot alone
-- identifies WHO, leaving the sign (see relation_sign() below) to convey the
-- relation. Anything not listed here falls back to COL_NEUTRAL, same
-- "unknown/modded faction" fallback spirit as FACTION_NAMES above.
-- Explicit colours below (stalker/bandit/dolg/freedom/killer/isg/greh/
-- monolith) are per user request; the rest fill in the remaining factions
-- distinctly enough to stay readable alongside them.
local FACTION_COLOR = {
	stalker = { 220, 130, 40 }, -- loner orange
	bandit = { 150, 150, 150 }, -- bandit grey
	dolg = { 195, 45, 45 }, -- duty red
	freedom = { 90, 170, 70 }, -- freedom green
	csky = { 120, 190, 230 }, -- clear sky pale blue
	ecolog = { 200, 220, 90 }, -- ecologist yellow-green
	killer = { 60, 110, 200 }, -- mercenary blue
	military = { 120, 120, 70 }, -- military olive/grey
	monolith = { 235, 235, 235 }, -- monolith near-white
	renegade = { 170, 70, 50 }, -- renegade rust/copper
	zombied = { 150, 190, 60 }, -- zombified sickly green
	greh = { 185, 95, 35 }, -- sin burnt orange
	trader = { 220, 190, 60 }, -- trader gold
	monster = { 130, 100, 90 }, -- mutant muted grey-brown
	isg = { 60, 200, 190 }, -- UNISG turquoise
	arena = { 170, 70, 190 }, -- arena purple
}

-- Minimal-style sign colour, keyed by the glyph relation_sign() below
-- returns -- always the true relation colour regardless of
-- C.color_by_relation (that toggle only affects the card's own accent tint;
-- the sign's whole purpose is showing relation clearly).
local SIGN_COLOR = {
	["-"] = COL_ENEMY,
	["+"] = COL_FRIEND,
	["o"] = COL_NEUTRAL,
}

-- Bones to anchor the tag to, best first (humanoid skeleton; monsters that
-- lack all of these fall back to position()+offset in anchor_pos).
local ANCHOR_BONES = { "bip01_head", "bip01_spine2", "bip01_spine1", "bip01_spine" }
local ANCHOR_LIFT = 0.12 -- metres above the matched bone

local C = {} -- live config (DEFAULTS overlaid with MCM values)
local _frame = ii_frame.new()

---@type IiTags|nil
local TAGS = nil -- the IiTags dialog instance
local SCAN_MS, FADE_MS, HOLD_MS = 350, 450, 4000
-- Re-identify gap: if a tracked target hasn't been identified for at least this long (i.e. you
-- looked AWAY and back, vs. holding it under continuous auto/dwell which re-fires every ~250ms),
-- re-scan it from scratch (spinner + fade-in) instead of instantly refreshing the old reveal.
local REIDENTIFY_GAP_MS = 750
local _tracks = ii_tracking.new(MAX_TAGS, REIDENTIFY_GAP_MS)
local tracked = _tracks.entries

-- Aspect-correction factor the engine applies to rotated (SetHeading) statics:
-- the 4:3 virtual UI (1024x768) is stretched onto the real (usually wider)
-- screen, so a strip rotated to an angle in that virtual space needs its X
-- pre-divided by this to still point at the right screen pixel. Recomputed in
-- read_config() (device() isn't ready when this file is first parsed).
local UI_KX = 1

local _prev_on_key_press = nil

-- Shared scratch vectors bundled into ONE local (not nine) to stay well under Lua 5.1's
-- 200-local-per-chunk limit. Each field is a single reusable scratch used in exactly one
-- place (P/S, project_world, the box/aim/body helpers); reused, never per-call allocated.
local _v = {
	p = vector2(),
	s = vector2(),
	scratch = vector(),
	box_c = vector(),
	body_pt = vector(),
	aim_pos = vector(),
	aim_dir = vector(),
	bb_pt = vector(),
	face_c = vector(),
	marker_pt = vector(),
	anchor = vector(),
	head = vector(),
}
local function P(x, y)
	return _v.p:set(x, y)
end
local function S(x, y)
	return _v.s:set(x, y)
end

-- --------------------------------------------------------------------------
-- Config
-- --------------------------------------------------------------------------
-- Every MCM leaf-page id in ii_mcm.script, in tab order. read_config tries each to
-- resolve an option's storage path ("ii/<page>/<key>"). MUST list every page ii_mcm
-- defines -- a page missing here means that page's options silently never load. Global
-- (not local) so it costs no top-level-local slot (Lua 5.1's 200-per-chunk limit).
MCM_PAGES = ii_config.MCM_PAGES

-- Optional external TIER SYSTEM (st-wearable-devices compatibility). A compat addon
-- assigns `ii_identify.tier_provider = function() ... end` returning either nil (system
-- inactive -> normal behaviour) or an override table:
--   { scan_base=<s>, penalty_scale=<n>, max_dist=<m>, ignore_night=<bool>, allow_ads=<bool>, mag_boost=<bool>,
--     feat = { faction=, distance=, relationship=, rank=, weapon= } }  -- feat gates the display
-- actor_on_update snapshots it once per frame into _tier; every override point reads _tier
-- and, when nil, behaves exactly as before -- so the whole feature is inert without the addon.
-- Three states: provider returns nil (addon not intervening -> normal II); a table with
-- active=true (kit assembled -> tier params drive identification); or a table with
-- active~=true (addon installed but the kit isn't worn/assembled -> identification BLOCKED,
-- since the scanner IS the identify device). tier_active/tier_blocked encode that.
---@class ii_tier_override
---@field active boolean kit assembled/worn -> tier params drive identification
---@field scan_base number? fixed base scan time (seconds), from the process tier
---@field penalty_scale number? share of every enabled penalty's slowdown above 1x, from the process tier
---@field max_dist number? identify range (metres), from the scanner tier
---@field ignore_night boolean? scanner's no-night tier
---@field allow_ads boolean? scanner unlocks scope/ADS support
---@field allow_binoc boolean? scanner unlocks binocular identification (extends range by binoc_range_mult)
---@field mag_boost boolean? scanner unlocks the magnification range boost
---@field osd_only boolean? OSD scanner: identify normally but draw NO on-entity UI (tags/markers) -- the result shows only on the Promin ident page
---@field feat table? per-feature display gates { faction, distance, relationship, rank, weapon }

tier_provider = nil -- global (set by the compat script) so it costs no top-level-local slot
---@type ii_tier_override|nil
local _tier = nil -- this frame's tier_provider() result, or nil

-- Last-identified target snapshot (for external readouts like the Promin ident page).
-- Written in identify_target; read via get_last_identified(). One table = one local slot.
local _last_id = { id = nil }

-- Progress (0..1) of the currently-active scan (the furthest-along one if several), or nil
-- if nothing is scanning. Updated every frame in render(); read right after. Drives the
-- Promin OSD "scanning" spinner. Global so the WD compat page can read it.
function get_scan_progress()
	return _last_id.scan_frac
end

-- Cheap id-only accessor (no table allocation) for per-frame change-detection, e.g. the
-- Promin notification pop-up polling for a new identification. Global.
function get_last_identified_id()
	return _last_id.id
end

-- The last target identified this session (or nil if none yet). Returns a fresh table:
-- { name, faction, rank, weap, x, y, z, dist } -- any field may be nil if that data wasn't
-- unlocked/available at identify time. `dist` is computed LIVE from the stored position to
-- the actor (nil if either is unavailable). Global so the WD compat page can read it.
function get_last_identified()
	if not _last_id.id then
		return nil
	end
	local dist = nil
	local a = db.actor and _frame:position(db.actor)
	if a and _last_id.x then
		local dx, dy, dz = _last_id.x - a.x, _last_id.y - a.y, _last_id.z - a.z
		dist = math.sqrt(dx * dx + dy * dy + dz * dz)
	end
	return {
		name = _last_id.name,
		faction = _last_id.faction,
		rank = _last_id.rank,
		weap = _last_id.weap,
		portrait = _last_id.portrait,
		icon = _last_id.icon, -- faction emblem texture id
		rank_level = _last_id.rank_level, -- numeric rank (1..8) or nil
		x = _last_id.x,
		y = _last_id.y,
		z = _last_id.z,
		dist = dist,
	}
end

-- Resolved tier configuration for the WD compat driver (which lives in the optional
-- component and can't read the local C). Returns the live MCM-backed values so the
-- driver builds tier tables from the user's overrides. Global so the driver can call it.
function get_wd_tier_cfg()
	return {
		require_kit = C.wd_require_kit,
		proc = { C.wd_proc_t1, C.wd_proc_t2, C.wd_proc_t3 },
		penalty = { C.wd_penalty_t1, C.wd_penalty_t2, C.wd_penalty_t3 },
		scan = { C.wd_scan_t1, C.wd_scan_t2, C.wd_scan_t3 },
		feat = {
			faction = C.wd_feat_faction,
			distance = C.wd_feat_distance,
			relationship = C.wd_feat_relationship,
			rank = C.wd_feat_rank,
			weapon = C.wd_feat_weapon,
		},
		scanner_ads = C.wd_scanner_ads,
		scanner_binoc = C.wd_scanner_binoc,
		scanner_mag = C.wd_scanner_mag,
		scanner_nonight = C.wd_scanner_nonight,
	}
end
local function tier_active()
	return _tier ~= nil and _tier.active == true
end
local function tier_blocked()
	return _tier ~= nil and _tier.active ~= true
end

local function read_config()
	SCAN_MS, FADE_MS, HOLD_MS, UI_KX = ii_config.read(C, COLOR_DEFS)
	C._ui_kx = UI_KX
	---@diagnostic disable-next-line: undefined-global
	ii_combat.configure(C)
end

-- C.key_dik comes straight from MCM's key-capture widget (whatever DIK/mouse
-- code the player last clicked into the box); 0/nil means "never captured
-- one", so fall back to the compiled-in default key.
local function active_dik()
	if C.key_dik and C.key_dik ~= 0 then
		return C.key_dik
	end
	return DIK_keys and DIK_keys[DEFAULT_KEY_NAME]
end

-- key_state() returns a raw C BOOL (marshalled as a Lua number, not a real
-- boolean), so 0 is truthy under plain Lua "if" semantics -- compare
-- explicitly rather than trusting truthiness.
local function key_down(dik)
	if not dik or not key_state then
		return false
	end
	local v = key_state(dik)
	return v ~= nil and v ~= false and v ~= 0
end

local function modifiers_ok()
	local e = MODIFIER_LIST[C.modifier_index] or MODIFIER_LIST[1]
	if not e or not e.dik or not DIK_keys then
		return true
	end
	return key_down(DIK_keys[e.dik]) or (e.alt_dik and key_down(DIK_keys[e.alt_dik])) or false
end

-- Calls fn(...) through pcall and returns its result, or nil on error --
-- collapses the `local ok, v = pcall(...); if not ok then ...` idiom used
-- throughout this file down to a single expression at each call site.
local function safe_call(fn, ...)
	local ok, v = pcall(fn, ...)
	if ok then
		return v
	end
	return nil
end

-- The custom bodycam engine module (bodycam.*), or nil on a stock exe. Central accessor so
-- the debug_sim_stock toggle can make the whole mod behave as if the custom bindings weren't
-- compiled in (for testing stock-engine fallbacks without copying the custom exe).
local function ext_bodycam()
	if C.debug_sim_stock then
		return nil
	end
	return rawget(_G, "bodycam")
end

-- --------------------------------------------------------------------------
-- Faction label / relation colour
-- --------------------------------------------------------------------------
local function faction_label(comm)
	local sid = FACTION_NAMES[comm]
	if sid then
		local txt = safe_call(game.translate_string, sid)
		if txt and txt ~= sid then
			return txt
		end
	end
	local pretty = comm:gsub("_", " ")
	pretty = pretty:gsub("(%a)([%w']*)", function(a, b)
		return a:upper() .. b:lower()
	end)
	return pretty
end

local function faction_color(comm)
	return FACTION_COLOR[comm] or COL_NEUTRAL
end

-- The name shown on the tag: the NPC's own name where they have one (most
-- humanoid stalkers), falling back to the faction label for generic mobs/
-- monsters that carry no personal name.
local function display_name(obj, comm)
	local name = safe_call(obj.character_name, obj)
	if name and name ~= "" then
		local txt = safe_call(game.translate_string, name)
		if txt and txt ~= "" and txt ~= name then
			return txt
		end
		return name
	end
	return faction_label(comm)
end

-- Rank shown under the name: obj:rank_name() (src/xrGame/script_game_object3.cpp:597,
-- SAFE_WRAP-bound at script_game_object_script2.cpp:147) returns a raw id
-- ("novice", "experienced", "veteran", "master", "expert") for CAI_Stalker
-- objects, empty string (logged, not thrown, since it's SAFE_WRAP) for
-- anything else -- monsters/mutants included, which is why this returns nil
-- for them rather than a fallback: no rank line makes more sense than a
-- fabricated one. Localised via "st_rank_" + id, the same convention this
-- engine's own Discord Rich Presence integration uses (Actor.cpp:1442-1449),
-- so it matches the game's own terminology instead of inventing new labels.
-- Rank -> colour for the Simple 2 style's rank bar. A rarity-style gradient from grey
-- (novice) through green/blue/purple/orange/red up to gold (legend). Keyed by the
-- engine rank id (obj:rank_name); anything unknown / rankless falls back to grey.
local RANK_COLOR = {
	novice = { 165, 165, 165 }, -- grey
	trainee = { 205, 205, 205 }, -- light grey
	experienced = { 120, 200, 120 }, -- green
	professional = { 90, 165, 235 }, -- blue
	veteran = { 175, 120, 225 }, -- purple
	expert = { 235, 165, 70 }, -- orange
	master = { 225, 80, 70 }, -- red
	legend = { 240, 205, 90 }, -- gold
}
local function rank_color(obj)
	local rid = safe_call(obj.rank_name, obj)
	return (rid and RANK_COLOR[rid]) or { 150, 150, 150 }
end

-- Rank id -> numeric level (novice=1 .. legend=8), for the notification card's "Rank N".
-- Global (no top-level-local cost); nil for an unknown/rankless id.
RANK_LEVEL = {
	novice = 1,
	trainee = 2,
	experienced = 3,
	professional = 4,
	veteran = 5,
	expert = 6,
	master = 7,
	legend = 8,
}

-- User-configurable colours (MCM "Colors" section). MCM has no colour-picker
-- widget, so each colour is exposed as three 0-255 R/G/B tracks. This registry is
-- the single source of truth for BOTH the runtime apply (read_config) and the menu
-- generation (ii_mcm.script reads ii_identify.COLOR_DEFS): each entry points `tbl`
-- at a LIVE colour table above, so applying overrides mutates it IN PLACE -- the
-- faction/rank/relation tables are shared by reference (SIGN_COLOR aliases COL_*,
-- tracked tags hold the same refs), so one in-place update recolours everything,
-- including in-flight tags. Global (not local) so it costs no top-level-local slot.
COLOR_DEFS = {
	{ id = "rel_enemy", group = "rel", tbl = COL_ENEMY },
	{ id = "rel_friend", group = "rel", tbl = COL_FRIEND },
	{ id = "rel_neutral", group = "rel", tbl = COL_NEUTRAL },
	{ id = "fac_stalker", group = "fac", tbl = FACTION_COLOR.stalker },
	{ id = "fac_bandit", group = "fac", tbl = FACTION_COLOR.bandit },
	{ id = "fac_dolg", group = "fac", tbl = FACTION_COLOR.dolg },
	{ id = "fac_freedom", group = "fac", tbl = FACTION_COLOR.freedom },
	{ id = "fac_csky", group = "fac", tbl = FACTION_COLOR.csky },
	{ id = "fac_ecolog", group = "fac", tbl = FACTION_COLOR.ecolog },
	{ id = "fac_killer", group = "fac", tbl = FACTION_COLOR.killer },
	{ id = "fac_military", group = "fac", tbl = FACTION_COLOR.military },
	{ id = "fac_monolith", group = "fac", tbl = FACTION_COLOR.monolith },
	{ id = "fac_renegade", group = "fac", tbl = FACTION_COLOR.renegade },
	{ id = "fac_zombied", group = "fac", tbl = FACTION_COLOR.zombied },
	{ id = "fac_greh", group = "fac", tbl = FACTION_COLOR.greh },
	{ id = "fac_trader", group = "fac", tbl = FACTION_COLOR.trader },
	{ id = "fac_monster", group = "fac", tbl = FACTION_COLOR.monster },
	{ id = "fac_isg", group = "fac", tbl = FACTION_COLOR.isg },
	{ id = "fac_arena", group = "fac", tbl = FACTION_COLOR.arena },
	{ id = "rank_novice", group = "rank", tbl = RANK_COLOR.novice },
	{ id = "rank_trainee", group = "rank", tbl = RANK_COLOR.trainee },
	{ id = "rank_experienced", group = "rank", tbl = RANK_COLOR.experienced },
	{ id = "rank_professional", group = "rank", tbl = RANK_COLOR.professional },
	{ id = "rank_veteran", group = "rank", tbl = RANK_COLOR.veteran },
	{ id = "rank_expert", group = "rank", tbl = RANK_COLOR.expert },
	{ id = "rank_master", group = "rank", tbl = RANK_COLOR.master },
	{ id = "rank_legend", group = "rank", tbl = RANK_COLOR.legend },
}

-- Capture each colour's built-in default (for the custom_colors=off restore) and
-- register its three MCM-backed keys so read_config picks them up generically.
DEFAULTS.custom_colors = false -- master toggle: off = built-in colours, on = the overrides below
for _, cd in ipairs(COLOR_DEFS) do
	cd.def = { cd.tbl[1], cd.tbl[2], cd.tbl[3] }
	DEFAULTS["col_" .. cd.id .. "_r"] = cd.tbl[1]
	DEFAULTS["col_" .. cd.id .. "_g"] = cd.tbl[2]
	DEFAULTS["col_" .. cd.id .. "_b"] = cd.tbl[3]
end

local function rank_label(obj)
	local rid = safe_call(obj.rank_name, obj)
	if not rid or rid == "" then
		return nil
	end
	local txt = safe_call(game.translate_string, "st_rank_" .. rid)
	if txt and txt ~= "" and txt ~= ("st_rank_" .. rid) then
		return txt
	end
	local pretty = rid:gsub("_", " ")
	pretty = pretty:gsub("(%a)([%w']*)", function(a, b)
		return a:upper() .. b:lower()
	end)
	return pretty
end

-- Caliber string for a weapon section, e.g. "5.45x39", "9x18", "12x70".
-- Weapon sections carry no explicit caliber field, but ammo_class points at
-- the ammo section(s) the gun chambers (a comma-separated list, e.g.
-- "ammo_5.45x39_fmj, ammo_5.45x39_ap"); the caliber is the NxM token baked
-- into that ammo id. Best-effort: returns nil (no caliber shown) when there's
-- no ammo_class or the token doesn't match the standard cartridge pattern
-- (gauss/energy/grenade ammo, exotic naming), rather than guessing wrong.
local function weapon_caliber(sec)
	if not ini_sys or not sec then
		return nil
	end
	local ac = safe_call(ini_sys.r_string, ini_sys, sec, "ammo_class")
	if not ac or ac == "" then
		return nil
	end
	local first = ac:match("^%s*([^,]+)") -- first ammo section if it's a list
	local cal = first and first:match("[%d%.]+x[%d%.]+") -- e.g. 5.45x39 / 9x18 / 12x70
	if cal and cal ~= "" then
		return cal
	end
	return nil
end

-- The target's currently-wielded weapon name (with caliber appended when it
-- can be derived), shown as an extra line on the card when C.show_weapon is on.
-- obj:best_weapon() (src/xrGame/script_game_object_script2.cpp:217, SAFE_WRAP-
-- bound to CObjectHandler::best_weapon) returns the NPC's equipped weapon
-- game_object, or nil for the unarmed / monsters / mutants -- the same call the
-- engine's own trade and stalker-combat code use to find "the gun this NPC is
-- actually holding" (see this repo's axr_main-adjacent aaaa_script_fixes_mp
-- best_weapon() calls). Its section's "inv_name", run through translate_string,
-- is the exact readable name the inventory UI shows; if that lookup fails
-- (throws on a missing field -- swallowed by safe_call), a prettified section
-- id is the fallback. Returns nil (no line) rather than a placeholder when
-- there's no weapon to show.
local function held_weapon_label(obj)
	-- Under the tier system the weapon feature is gated at snapshot (feat.weapon), so
	-- skip the C.show_weapon MCM gate here; otherwise it's the normal user toggle.
	if not tier_active() and not C.show_weapon then
		return nil
	end
	local wpn = safe_call(obj.best_weapon, obj)
	if not wpn then
		return nil
	end
	local sec = safe_call(wpn.section, wpn)
	if not sec or sec == "" then
		return nil
	end

	local label
	if ini_sys then
		local inv = safe_call(ini_sys.r_string, ini_sys, sec, "inv_name")
		if inv and inv ~= "" then
			local txt = safe_call(game.translate_string, inv)
			if txt and txt ~= "" and txt ~= inv then
				label = txt
			end
		end
	end
	if not label then
		label = sec:gsub("^wpn_", ""):gsub("_", " ")
		label = label:gsub("(%a)([%w']*)", function(a, b)
			return a:upper() .. b:lower()
		end)
	end

	local cal = weapon_caliber(sec)
	if cal then
		return label .. "  (" .. cal .. ")"
	end
	return label
end

-- Faction patch texture ids.
--
-- Default: the same "<community_id>_icon" convention the game's own character/relations UI
-- uses (src/xrGame/ui/UICharacterInfo.cpp), so the tag reuses whatever emblem art already
-- ships with the game/modpack instead of needing bundled icons for every faction.
--
-- custom_patches on: "ii_patch_<community_id>" instead, which the player (or a texture addon)
-- registers themselves in a configs/ui/textures_descr XML. Nothing is shipped for these ids --
-- an unregistered one just draws nothing, and there is no way to ask the engine whether a
-- texture id exists, so the option is deliberately all-or-nothing rather than per-faction.
--
-- BOTH ids are built once per identify and the choice is made per frame in render(). That
-- makes the toggle live -- tags already on screen switch over immediately, which matters when
-- you are iterating on patch art -- without a per-target, per-frame string concatenation.
local function faction_icon_id(comm)
	return comm .. "_icon"
end

local function custom_patch_id(comm)
	return "ii_patch_" .. comm
end

local function relation_color(obj)
	if not C.color_by_relation then
		return COL_NEUTRAL
	end
	local rel = safe_call(obj.relation, obj, db.actor)
	if rel == game_object.enemy then
		return COL_ENEMY
	end
	if rel == game_object.friend then
		return COL_FRIEND
	end
	return COL_NEUTRAL
end

-- Minimal-style relation sign -- unlike relation_color() above, always
-- distinguishes hostile/friendly/neutral regardless of C.color_by_relation
-- (that toggle only affects the card's own accent tint; the whole point of
-- the sign in minimal style is showing relation clearly).
local function relation_sign(obj)
	local rel = safe_call(obj.relation, obj, db.actor)
	if rel == game_object.enemy then
		return "-"
	end
	if rel == game_object.friend then
		return "+"
	end
	return "o"
end

-- Hostile-faction warning sounds, shipped by the WD compat component under
-- gamedata/sounds/ii/. `file` maps an Anomaly COMMUNITY id to the audio's base name: the two
-- differ because the files are named after the DISPLAY faction (loner/duty/merc/clearsky/sin)
-- rather than the internal id (stalker/dolg/killer/csky/greh). A community with no entry simply
-- has no warning -- ecolog, zombied, trader, monster and arena ship none.
--
-- The engine's loader STRIPS any extension and appends .ogg (SoundRender_Source_loader.cpp), so
-- these must be Vorbis; an .mp3 silently resolves to $no_sound. Hence no extension here.
--
-- One sound_object per community, built on first use and kept: constructing one per play would
-- allocate on a path that fires on every identify. A failed build caches `false` so a missing
-- file is attempted once rather than every time.
local HOSTILE_SND = {
	dir = "ii\\",
	cache = {},
	file = {
		stalker = "loner_hostile",
		bandit = "bandit_hostile",
		dolg = "duty_hostile",
		freedom = "freedom_hostile",
		csky = "clearsky_hostile",
		killer = "merc_hostile",
		military = "military_hostile",
		monolith = "monolith_hostile",
		renegade = "renegade_hostile",
		greh = "sin_hostile",
		isg = "isg_hostile",
	},
}

-- Plays a faction's hostile warning once, at the moment its identification first shows.
-- Hostility is read LIVE from the engine rather than from the snapshotted `sign`, which is nil
-- whenever show_relation is off and would otherwise mute this silently -- the warning is a
-- safety cue, not a display detail, so it should not depend on what the tag chooses to draw.
local function play_hostile_sound(obj, comm)
	local base = comm and HOSTILE_SND.file[comm]
	if not base or not db.actor then
		return
	end
	if safe_call(obj.relation, obj, db.actor) ~= game_object.enemy then
		return
	end
	local snd = HOSTILE_SND.cache[comm]
	if snd == nil then
		local ok, s = pcall(sound_object, HOSTILE_SND.dir .. base)
		snd = (ok and s) or false
		HOSTILE_SND.cache[comm] = snd
	end
	if snd then
		safe_call(snd.play, snd, db.actor, 0, sound_object.s2d)
	end
end

-- --------------------------------------------------------------------------
-- World anchor / projection
-- --------------------------------------------------------------------------
local function anchor_pos(obj)
	local base = obj:position()
	for _, bone in ipairs(ANCHOR_BONES) do
		local p = _frame:bone(obj, bone)
		if p and p:distance_to_sqr(base) < 9 then
			p = _v.anchor:set(p)
			p.y = p.y + ANCHOR_LIFT
			return p
		end
	end
	base.y = base.y + 1.3
	return base
end

-- Where the tag/marker is drawn on the target, per the `anchor_basis` MCM list (1 head / 2 torso /
-- 3 feet). Head reuses anchor_pos (the legacy default). Distinct from anchor_pos() itself, which
-- LOS/foliage geometry keeps using head-biased regardless of this UI preference. Each branch
-- returns a FRESH vector (bone_position / position copies), so callers may mutate it freely.
local function ui_anchor_pos(obj)
	local basis = C.anchor_basis or 1
	if basis == 3 then
		return obj:position() -- feet / ground: the object's base position, unlifted
	end
	if basis == 2 then
		local base = obj:position()
		local p = _frame:bone(obj, "bip01_spine2") or _frame:bone(obj, "bip01_spine1")
		if p and p:distance_to_sqr(base) < 9 then
			return p -- torso / chest
		end
		-- monster / non-bip01 rig: no spine bone -> fall through to the head anchor
	end
	return anchor_pos(obj) -- head (default)
end

local function project_world(pos)
	local w2u = (game and game.world2ui) or (level and level.world2ui)
	if not w2u then
		return nil
	end
	local ui = w2u(_v.scratch:set(pos), false, false)
	if not ui or ui.x < -9000 then
		return nil
	end
	return ui.x, ui.y
end

-- View-space depth (metres along the view axis) of a world point: the projection
-- of (pos - cam_pos) onto the camera forward. Matches the engine's s_position.z, so
-- a depth-aware engine pass can reject anything nearer. 0 (no test) if unavailable.
local function view_depth(pos)
	local dev = _frame:camera()
	local cp = dev and dev.cam_pos
	local cd = dev and dev.cam_dir
	if not cp or not cd then
		return 0
	end
	local d = (pos.x - cp.x) * cd.x + (pos.y - cp.y) * cd.y + (pos.z - cp.z) * cd.z
	return d > 0 and d or 0
end

-- world2ui returns coordinates in the engine's fixed 1024x768 "virtual UI"
-- space regardless of actual resolution/aspect, so the screen centre (where the
-- crosshair normally sits) is always exactly (512, 384) here.
local UI_CX, UI_CY = 512, 384

-- --------------------------------------------------------------------------
-- Bodycam style: a faction-coloured outline box locked to the head bone.
-- --------------------------------------------------------------------------
-- Head anchor. bip01_head sits at the SKULL BASE (top of the neck), not the
-- face centre -- a box centred straight on it rides low over the neck/chest, so
-- lift it up to the middle of the head. Returns nil for monsters/rigs without a
-- bip01_head bone -- caller falls back to anchor_pos() for those.
local HEAD_LIFT = 0.09 -- metres of world-up from bip01_head to the face centre
local function head_center(obj)
	local base = obj:position()
	local p = _frame:bone(obj, "bip01_head")
	if p and p:distance_to_sqr(base) < 9 then
		p = _v.head:set(p)
		p.y = p.y + HEAD_LIFT
		return p
	end
	return nil
end

-- Half-extents (metres) of the HEAD box, padding included. Head is taller than
-- wide, so H > W. Tunable constants, not MCM sliders (the box auto-scales with
-- distance, nothing resolution-specific). The full-body box is computed
-- differently -- from projected ragdoll bone bounds, see body_box_for.
local BOX_HALF_W = 0.17
local BOX_HALF_H = 0.22

-- Screen bounding box (1024x768 virtual space) of a box of metric half-extents
-- hw_m/hh_m centred at world `center`, as cx,cy,hw,hh.
--
-- Projects all FOUR corners (center +/- cam_right*hw_m +/- cam_top*hh_m) and
-- bounds them, rather than offsetting along one axis and reading a single screen
-- delta. The single-axis shortcut is only correct at screen centre: under
-- perspective, an off-centre world offset projects DIAGONALLY (mixed x and y)
-- and with non-uniform scale, so near the screen edges the old method mis-sized
-- and mis-centred the box -- the "slips off the head at the corners" bug. The
-- 4-corner bound is perspective-correct everywhere. nil if the camera vectors or
-- any corner projection aren't available this frame.
local function screen_box(center, hw_m, hh_m)
	local dev = _frame:camera()
	local cr = dev and dev.cam_right
	local ct = dev and dev.cam_top
	if not cr or not ct then
		return nil
	end
	local minx, miny, maxx, maxy
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			local px, py = project_world(
				_v.box_c:set(
					center.x + cr.x * hw_m * sx + ct.x * hh_m * sy,
					center.y + cr.y * hw_m * sx + ct.y * hh_m * sy,
					center.z + cr.z * hw_m * sx + ct.z * hh_m * sy
				)
			)
			if not px then
				return nil
			end
			if not minx then
				minx, miny, maxx, maxy = px, py, px, py
			else
				if px < minx then
					minx = px
				elseif px > maxx then
					maxx = px
				end
				if py < miny then
					miny = py
				elseif py > maxy then
					maxy = py
				end
			end
		end
	end
	local hw, hh = (maxx - minx) * 0.5, (maxy - miny) * 0.5
	if hw < 1 or hh < 1 then
		return nil
	end
	return (minx + maxx) * 0.5, (miny + maxy) * 0.5, hw, hh, view_depth(center)
end

-- Free-aim target-assist centre. On a normal engine the weapon points at the screen centre,
-- so the FOV assist circle is centred on (512,384). On a bodycam / free-aim engine the aim
-- points OFF-centre, so the assist follows it. Two sources (see weapon_aim_ui):
--   1. bodycam.get_fire_ray() -- the actor's first-eye aim camera. Reflects free aim for EVERY
--      held item (gun, knife, binoculars). Needs the custom bodycam binding.
--   2. get_target_pos(ETraceTarget.Weapon) -- the standard engine weapon trace. Barrel-
--      accurate for FIREARMS and works on a stock exe, but for a knife/binoculars it's the
--      cosmetic HUD-model transform, not the aim -- hence source 1 for those.
local FREEAIM_PROJECT_DIST = 100 -- metres along the aim ray to project for the reticle screen point

-- The gameplay aim ray (actor first-eye camera) via the custom bodycam.get_fire_ray() binding.
-- Returns origin + unit dir, or nil on an engine without the binding.
local function freeaim_ray()
	local bc = ext_bodycam()
	if not (bc and bc.get_fire_ray) then
		return nil
	end
	local ok, r = pcall(bc.get_fire_ray)
	if not ok or type(r) ~= "table" or r.valid == false or not r.dir_x then
		return nil
	end
	return r.pos_x, r.pos_y, r.pos_z, r.dir_x, r.dir_y, r.dir_z
end

local function weapon_aim_ui()
	-- Source 1: the first-eye aim ray (works for any held item). Project a far point + world2ui.
	local px, py, pz, dx, dy, dz = freeaim_ray()
	if px then
		return project_world(
			_v.aim_pos:set(
				px + dx * FREEAIM_PROJECT_DIST,
				py + dy * FREEAIM_PROJECT_DIST,
				pz + dz * FREEAIM_PROJECT_DIST
			)
		)
	end
	-- Source 2: the standard weapon trace (firearms; stock exe). ETraceTarget is a GLOBAL enum.
	local ET = rawget(_G, "ETraceTarget")
	if level and level.get_target_pos and ET then
		local wpos = safe_call(level.get_target_pos, ET.Weapon)
		if wpos and not (wpos.x == 0 and wpos.y == 0 and wpos.z == 0) then
			local sx, sy = project_world(wpos)
			if sx then
				return sx, sy
			end
		end
	end
	return nil
end

-- The point the FOV target-assist circle is measured from this frame: the
-- weapon's real aim point when free-aim assist is enabled and available,
-- otherwise the fixed screen centre. Target selection (screen_dist_to_body) and the
-- debug visualiser both measure screen distance from here.
local function aim_center()
	if C.freeaim_assist then
		local sx, sy = weapon_aim_ui()
		if sx then
			return sx, sy
		end
	end
	return UI_CX, UI_CY
end

-- Bones sampled across the whole body so the FOV target-assist matches wherever
-- you aim on an NPC, not just one anchor point (aiming at the legs/torso used to
-- miss when only the head/chest anchor was tested). Humanoid bip01 rig; monsters
-- and anything without these bones fall back to a vertical span at the origin.
local BODY_BONES = {
	"bip01_head",
	"bip01_neck",
	"bip01_spine2",
	"bip01_spine1",
	"bip01_spine",
	"bip01_pelvis",
	"bip01_l_forearm",
	"bip01_r_forearm",
	"bip01_l_calf",
	"bip01_r_calf",
}
-- Vertical lift samples (metres) for a non-bip01 rig (monster) with a span at its origin.
-- Shared by screen_dist_to_body and body_box_for (moved up so both see it as an upvalue).
local MONSTER_SPAN = { 0.3, 0.9, 1.5 }
local _body_pt = vector() -- scratch for the monster vertical-span fallback

-- Pixel distance from the aim point (cx,cy) to a world point projected to the 1024x768
-- virtual UI space, or nil if the point is off-screen / behind the camera.
local function screen_dist_to(pos, cx, cy)
	local sx, sy = project_world(pos)
	if not sx then
		return nil
	end
	local dx, dy = sx - cx, sy - cy
	return math.sqrt(dx * dx + dy * dy)
end

-- Smallest screen-pixel distance from the aim point (cx,cy) to any sampled body point (head,
-- torso, pelvis, limbs -- so aiming anywhere on the entity counts), or nil. A monster / rig
-- without bip01 bones falls back to a vertical span at its origin. This is the FOV assist's
-- target-acquisition measure: fov_radius is a straight SCREEN RADIUS, no angular cone.
local function screen_dist_to_body(obj, cx, cy)
	local base = obj:position()
	local best = nil
	local found = false
	for _, bone in ipairs(BODY_BONES) do
		local p = _frame:bone(obj, bone)
		if p and p:distance_to_sqr(base) < 16 then -- sane bone (within 4 m of origin)
			found = true
			local d = screen_dist_to(p, cx, cy)
			if d and (not best or d < best) then
				best = d
			end
		end
	end
	if not found then
		for _, lift in ipairs(MONSTER_SPAN) do
			local d = screen_dist_to(_body_pt:set(base.x, base.y + lift, base.z), cx, cy)
			if d and (not best or d < best) then
				best = d
			end
		end
	end
	return best
end

_frame.screen_dist_to_body = screen_dist_to_body
screen_dist_to_body = function(obj, cx, cy)
	local record = _frame:record(obj)
	if record and record.body_ready and record.body_cx == cx and record.body_cy == cy then
		return record.body_dist
	end
	local dist = _frame.screen_dist_to_body(obj, cx, cy)
	if record then
		record.body_ready, record.body_dist = true, dist
		record.body_cx, record.body_cy = cx, cy
	end
	return dist
end

-- --------------------------------------------------------------------------
-- Debug (MCM "Log aim debug"): on every identify attempt, dump the trace/aim
-- state to the mod's own log file (appdata/logs/immersive_identification.log via
-- dbg() -> ii_log_file(); falls back to xray_*.log) so free-aim problems can be
-- diagnosed from real numbers instead of guessed at. Off by default; the whole
-- block is skipped when C.debug_log is false, so it costs nothing in normal
-- play. Key comparison: whether the WEAPON trace differs from the CAMERA trace,
-- and whether the bodycam module exposes the free-aim offset.
-- --------------------------------------------------------------------------
-- Dedicated log file so the mod's debug output doesn't get buried in the shared
-- xray_*.log. Opened lazily (append) under the game's logs directory
-- (appdata/logs/immersive_identification.log) on the first dbg() call, with a
-- timestamped session header. Falls back to printf (the game log) if io / the FS
-- alias isn't available on this build. Only ever touched while debug_log is on.
-- State bundled into one table to stay under Lua 5.1's 200-local-per-chunk limit.
local _iilog = { f = nil, tried = false }
local function ii_log_file()
	if _iilog.tried then
		return _iilog.f
	end
	_iilog.tried = true
	local lio = rawget(_G, "io")
	local gfs = rawget(_G, "getFS")
	if not (lio and lio.open and gfs) then
		return nil
	end
	local ok, path = pcall(function()
		return gfs():update_path("$logs$", "immersive_identification.log")
	end)
	if not ok or type(path) ~= "string" then
		return nil
	end
	local f = lio.open(path, "a")
	_iilog.f = f
	if f then
		local osl = rawget(_G, "os")
		local stamp = (osl and osl.date) and osl.date("%Y-%m-%d %H:%M:%S") or "?"
		f:write("\n==== immersive-identification session " .. stamp .. " ====\n")
		f:flush()
	end
	return f
end

local function dbg(msg)
	if not C.debug_log then
		return
	end
	local line = "[ii] " .. tostring(msg)
	local f = ii_log_file()
	if f then
		local osl = rawget(_G, "os")
		local t = (osl and osl.date) and osl.date("%H:%M:%S ") or ""
		f:write(t, line, "\n")
		f:flush()
	elseif printf then
		printf("%s", line) -- fallback to the shared game log when the dedicated file can't open
	end
end

local function fv(v)
	if not v then
		return "nil"
	end
	return string.format("(%.2f, %.2f, %.2f)", v.x or 0, v.y or 0, v.z or 0)
end

local function obj_desc(o)
	if not o then
		return "nil"
	end
	local nm = safe_call(o.character_name, o) or safe_call(o.name, o) or "?"
	return tostring(nm) .. "#" .. tostring(o:id())
end

local function ui_of(pos)
	if not pos then
		return "nil"
	end
	local sx, sy = project_world(pos)
	if not sx then
		return "offscreen"
	end
	return string.format("(%.0f, %.0f)", sx, sy)
end

local function debug_dump_aim()
	if not C.debug_log then
		return
	end
	dbg("---- identify ----")
	local dev = _frame:camera()
	if dev then
		dbg(string.format("cam_pos=%s cam_dir=%s fov=%.1f", fv(dev.cam_pos), fv(dev.cam_dir), dev.fov or -1))
	end

	local ET = rawget(_G, "ETraceTarget")
	if not ET then
		dbg("ETraceTarget MISSING (no weapon-trace enum global on this engine)")
	else
		dbg(
			string.format(
				"obj  camera=%s  weapon=%s",
				obj_desc(safe_call(level.get_target_obj, ET.Camera)),
				obj_desc(safe_call(level.get_target_obj, ET.Weapon))
			)
		)
		if level.get_target_pos then
			local cpos = safe_call(level.get_target_pos, ET.Camera)
			local wpos = safe_call(level.get_target_pos, ET.Weapon)
			dbg(string.format("pos  camera=%s ui=%s", fv(cpos), ui_of(cpos)))
			dbg(string.format("pos  weapon=%s ui=%s", fv(wpos), ui_of(wpos)))
		else
			dbg("level.get_target_pos MISSING")
		end
	end

	local cx, cy = aim_center()
	dbg(string.format("aim_center=(%.0f, %.0f)  screen_center=(%d, %d)", cx, cy, UI_CX, UI_CY))

	local bc = ext_bodycam()
	if not (bc and bc.get_state) then
		dbg("bodycam module not present")
	else
		local ok, st = pcall(bc.get_state)
		if not ok or type(st) ~= "table" then
			dbg("bodycam.get_state() failed")
		else
			dbg(
				string.format(
					"bodycam active=%s ads=%s mstate=%s",
					tostring(st.active),
					tostring(st.ads),
					tostring(st.mstate)
				)
			)
			dbg(
				string.format(
					"bodycam yaw=%s pitch=%s roll=%s",
					tostring(st.camera_yaw),
					tostring(st.camera_pitch),
					tostring(st.camera_roll)
				)
			)
			dbg(
				string.format(
					"bodycam vm_pos=(%s,%s,%s) vm_rot=(%s,%s,%s)",
					tostring(st.vm_pos_x),
					tostring(st.vm_pos_y),
					tostring(st.vm_pos_z),
					tostring(st.vm_rot_x),
					tostring(st.vm_rot_y),
					tostring(st.vm_rot_z)
				)
			)
		end
	end
end

-- Geometric occlusion test -- the authoritative LOS signal (see has_los: the actor's AI-vision
-- db.actor:see() is intentionally not used, as it false-negatives on distant/peripheral/shadowed
-- targets the player clearly sees). A fresh, instantaneous raycast against STATIC world geometry
-- answers "is there an opaque wall between the render camera and the target," transparency-aware
-- so see-through clutter (fences/foliage/glass/wide clip meshes) doesn't false-block. ray_pick /
-- rq_target confirmed in xray-monolith src/xrGame/level_script.cpp (class_<CRayPick>("ray_pick"),
-- enum rq_target).
--
-- Cast from the target's anchor point (chest/head, already lifted clear of the
-- floor) toward the active camera, stopping RAY_LOS_TOL short so near-eye
-- geometry can't false-trigger. rqtStatic only, so other NPCs / the actor never
-- self-block -- the trade-off is that anything with solid static collision
-- blocks even when you can see through it (chain-link fences, some foliage);
-- acceptable for the far more common "behind a building/wall" case. query()
-- returns true when the ray HIT something (i.e. occluded), so a clear line of
-- sight is `not query()`.
local _visibility = ii_visibility.new(C, _frame, anchor_pos)
local _los = _visibility.state
local _los_point_clear = _visibility.point_clear
local has_clear_ray = _visibility.has_clear_ray
local RQT_BOTH = (rq_target and rq_target.rqtBoth) or 3

-- aim_model_target(max_dist) -> the stalker/monster whose MODEL the crosshair is directly over
-- (mesh raycast along the true aim ray), or nil. Forward-declared here (defined below, after the
-- aim-ray helpers) so has_los can consult it; also the FOV assist's "aiming at it" fallback.
local aim_model_target

-- assist_radius() -> the effective target-assist screen radius for this frame (fov_radius,
-- shrunk under magnification). Forward-declared here (defined below, once scope_magnification
-- exists) because find_nearest_in_fov above it already needs it.
local assist_radius

-- Line-of-sight check. GEOMETRY is the authority: a direct mesh hit, or a clear
-- transparency-aware ray from the RENDER CAMERA to any body point (has_clear_ray).
--
-- We deliberately do NOT gate on db.actor:see() anymore. That is the actor's AI vision
-- (script_game_object_script2.cpp:138 -> visual_memory_manager::visible_now): a lookup in the
-- actor's visual-MEMORY set, populated by object_visible_distance() from the AI eye bone/head
-- direction and limited by vision RANGE, an FOV CONE, and target LUMINOSITY -- none of which
-- match "what the player sees on screen." It false-negatives on exactly this mod's cases: a
-- distant target you're scoping/glassing (beyond AI vision range), a peripheral one (outside the
-- cone), or one in shadow -- all clearly visible to the player. (Night is already a scan-time
-- penalty, not a visibility block.) Geometry alone answers "is there an opaque wall in the way,"
-- which is the real question here.
local function has_los(target_obj)
	if not db.actor then
		return true
	end
	-- A direct mesh hit already proved a clear geometric line (the aim ray reached the model past
	-- any opaque blocker), so skip the body-bone sampling. The crosshair's direct-hit id is cached
	-- by time_global (in the _los bundle) so a crowd of has_los() calls triggers at most one mesh
	-- raycast per frame. SKIPPED when a see-through/foliage block is on: the mesh pick sees through
	-- exactly those surfaces, so the geometric march (which enforces the block) must run instead.
	if not (C.los_block_seethrough or C.los_block_foliage) then
		local tg = time_global()
		if _los.aim_tg ~= tg then
			_los.aim_tg = tg
			local m = aim_model_target and aim_model_target(1e6)
			_los.aim_id = m and m:id() or nil
		end
		if target_obj:id() == _los.aim_id then
			return true
		end
	end
	return has_clear_ray(target_obj)
end

-- Is `obj` actively hostile toward the actor AND aware of them -- i.e. in combat / has pulled
-- aggro and will attack? Two signals, either sufficient:
--   1. its AI combat target IS the actor (`best_enemy()` -- the precise "engaging you now" signal;
--      guarded via existence + pcall since the binding may be absent on some exes), OR
--   2. it is enemy-DISPOSED toward the actor (`relation` == enemy, which reflects dynamic goodwill,
--      so shooting a neutral flips it) AND currently SEES the actor (`see()` -- the NPC's own
--      perception of you). "hostile + aware" is a solid proxy for "will attack".
-- All engine calls guarded so a missing binding degrades to "not hostile" (never over-excludes).
local function is_hostile_engaging(obj)
	if not db.actor or not obj then
		return false
	end
	local aid = db.actor:id()
	if obj.best_enemy then
		local ok, e = pcall(obj.best_enemy, obj)
		if ok and e and e:id() == aid then
			return true
		end
	end
	local ok2, rel = pcall(obj.relation, obj, db.actor)
	if ok2 and rel == game_object.enemy then
		local ok3, seen = pcall(obj.see, obj, db.actor)
		if ok3 and seen then
			return true
		end
	end
	return false
end

-- Per-frame visibility for the hide_unseen drop. Pure geometry (has_clear_ray): a fresh
-- transparency-aware raycast that goes false the instant a wall interposes, giving the
-- near-instant drop the option promises. Deliberately NOT gated on db.actor:see() -- same reason
-- as has_los: see() is the actor's AI vision (range/FOV-cone/luminosity limited), which would
-- wrongly drop a tag on a distant scoped/glassed or shadowed target the player still sees. Fails
-- open (never blanks a tag on a check error). Per-frame across tracked targets, but there are
-- only ever a handful.
local function tag_visible(obj)
	if not db.actor then
		return true
	end
	return has_clear_ray(obj)
end

-- Fallback target search: the nearest identifiable, visible NPC/creature to
-- the aim point on screen (not the nearest to the actor in world space) within
-- fov_radius, so an approximate aim still finds someone -- you don't have to
-- land a pixel-perfect hit on them. The aim point is the screen centre on a
-- normal engine, or the weapon's real (off-centre) barrel point on a bodycam /
-- free-aim engine -- see aim_center().
--
-- Candidates already mid-identification (tracked[id] set) are kept in a
-- separate "busy" runner-up rather than competing on screen distance: a
-- target you've already triggered shouldn't out-rank some other eligible
-- target just for sitting closer to the aim point, since re-hitting it does
-- nothing new (see try_identify()'s tracked[id] branch) -- the busy one is
-- only ever returned when nothing else in the FOV circle qualifies at all.

local function find_nearest_in_fov(max_dist)
	if not db.actor or not level.iterate_nearest then
		return nil
	end
	local apos = _frame:position(db.actor)
	local actor_id = db.actor:id()
	local cx, cy = aim_center() -- weapon aim point under free-aim, else screen centre
	local radius = assist_radius()
	local best_obj, best_d = nil, radius
	local best_busy_obj, best_busy_d = nil, radius

	pcall(level.iterate_nearest, apos, max_dist, function(obj)
		if obj and obj:id() ~= actor_id and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			local alive = safe_call(obj.alive, obj)
			if alive then
				local comm = safe_call(obj.character_community, obj)
				if comm and comm ~= "" and not (C.exclude_hostile and is_hostile_engaging(obj)) then
					-- Screen-pixel distance to the NEAREST point on the whole body (head,
					-- torso, pelvis, limbs), not a single anchor -- so aiming anywhere on
					-- the entity counts. fov_radius is a straight screen radius.
					local d = screen_dist_to_body(obj, cx, cy)
					if
						d
						and d < (tracked[obj:id()] and best_busy_d or best_d)
						and (not C.require_los or has_los(obj))
					then
						if tracked[obj:id()] then
							if d < best_busy_d then
								best_busy_d, best_busy_obj = d, obj
							end
						elseif d < best_d then
							best_d, best_obj = d, obj
						end
					end
				end
			end
		end
		return false -- keep scanning the full set within max_dist
	end)

	local pick = best_obj or best_busy_obj
	if pick then
		return pick
	end
	-- Nothing inside the screen radius (too close, or aiming just off the silhouette).
	-- Fall back to a mesh raycast: if the crosshair is on the target's MODEL, take it --
	-- the same "aiming at it" pick used when FOV assist is off.
	local model = aim_model_target(max_dist)
	if model and (not C.require_los or has_los(model)) and not (C.exclude_hostile and is_hostile_engaging(model)) then
		return model
	end
	return nil
end

-- Debug: dump why find_nearest_in_fov accepts/rejects each nearby NPC. Mirrors
-- its exact filter so the log shows, per candidate, screen position, distance
-- from the aim point, LOS, and whether it falls inside fov_radius -- plus the
-- gating flags. Defined here (after has_los / find_nearest_in_fov) so it can
-- reuse them. Only runs when C.debug_log is on.
local function debug_dump_candidates()
	if not C.debug_log then
		return
	end
	if not (db.actor and level.iterate_nearest) then
		return
	end
	local cx, cy = aim_center()
	dbg(
		string.format(
			"flags enabled=%s fov_assist=%s freeaim_assist=%s require_los=%s require_binoc=%s fov_radius=%.1f aim=(%.0f,%.0f) max_dist=%.0f",
			tostring(C.enabled),
			tostring(C.fov_assist),
			tostring(C.freeaim_assist),
			tostring(C.require_los),
			tostring(C.require_binoculars),
			assist_radius(),
			cx,
			cy,
			C.max_dist
		)
	)
	local apos = _frame:position(db.actor)
	local aid = db.actor:id()
	local n = 0
	pcall(level.iterate_nearest, apos, C.max_dist, function(obj)
		if n >= 8 then
			return true
		end
		if obj and obj:id() ~= aid and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			local alive = safe_call(obj.alive, obj)
			local comm = safe_call(obj.character_community, obj)
			local sx, sy = project_world(anchor_pos(obj))
			local d = screen_dist_to_body(obj, cx, cy)
			local within = (d ~= nil and d <= assist_radius())
			local los = has_los(obj)
			dbg(
				string.format(
					"cand %s alive=%s comm=%s ui=%s dist=%s within=%s los=%s",
					obj_desc(obj),
					tostring(alive),
					tostring(comm),
					sx and string.format("(%.0f,%.0f)", sx, sy) or "offscreen",
					d and string.format("%.0fpx", d) or "n/a",
					within and "YES" or "no",
					tostring(los)
				)
			)
			n = n + 1
		end
		return false
	end)
	if n == 0 then
		dbg("cand (none nearby)")
	end
end

-- --------------------------------------------------------------------------
-- Identify trigger
-- --------------------------------------------------------------------------
-- Traces from the equipped weapon's own hit-test first (get_target_obj(ETraceTarget.Weapon)
-- -- global enum, see weapon_aim_ui -- reads the attached hud item's pick result, the same
-- barrel-aligned trace the engine uses for firing, not the camera centre), falls back to the
-- camera trace, and if neither hit anything, falls back to the nearest
-- identifiable target within the on-screen FOV circle.
--
-- Both direct-raycast results are also LOS-checked, not just the FOV
-- fallback: the engine's own crosshair pick (src/xrGame/HUDManager.cpp,
-- pick_trace_callback) doesn't stop at the first static-geometry hit --
-- for each static hit it multiplies a running "power" by that triangle's
-- material fVisTransparencyFactor, and if the *cumulative* result is still
-- above 0.34 it keeps tracing past it, only stopping for good once it hits
-- an actual object or a material opaque enough to drop under that
-- threshold. Fences, glass, foliage and similar semi-transparent materials
-- routinely have a high enough fVisTransparencyFactor for this to return an
-- object behind them directly, bypassing find_nearest_in_fov() (and its LOS
-- check) entirely -- so a direct hit is not on its own proof of visibility
-- and needs the same has_los() gate applied to it.
local function get_target_obj(max_dist, allow_fov)
	local function accept(obj)
		if not obj or (db.actor and obj:id() == db.actor:id()) then
			return nil
		end
		if not (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) or not safe_call(obj.alive, obj) then
			return nil
		end
		local pos, apos = _frame:position(obj), _frame:position(db.actor)
		if pos and apos and pos:distance_to_sqr(apos) > max_dist * max_dist then
			return nil
		end
		if C.require_los and not has_los(obj) then
			return nil
		end
		return obj
	end

	local direct = nil
	local ET = rawget(_G, "ETraceTarget") -- GLOBAL enum (not level.ETraceTarget); see weapon_aim_ui
	if ET then
		direct = accept(safe_call(level.get_target_obj, ET.Weapon))
	end
	if not direct then
		direct = accept(safe_call(level.get_target_obj))
	end

	-- A fresh (not-yet-tracked) engine hit wins immediately.
	if direct and not tracked[direct:id()] then
		return direct
	end

	-- The target whose MODEL the crosshair is actually on -- a mesh raycast along the TRUE aim
	-- ray, so it hits between the sampled bones and works with a tight fov_radius. This is
	-- "identify what I'm aiming AT", so it takes priority over a merely-nearby non-tracked
	-- FOV-cone pick (which would otherwise keep stealing selection while you point straight at
	-- someone), and it returns the target even if already tracked -- a re-aim then refreshes it
	-- rather than leaving it faded and un-re-identifiable until it clears. LOS via accept.
	local model = accept(aim_model_target(max_dist))
	if model then
		return model
	end

	-- FOV target-assist (fov_assist / fov_assist_binoc, decided per-context by
	-- the caller). When disabled, identification is direct-hit only: you must
	-- actually aim at the target, with no nearest-in-circle fallback.
	if allow_fov then
		local nearby = find_nearest_in_fov(max_dist)
		if nearby then
			return nearby
		end
	end
	return direct
end

-- Is the binoculars item currently equipped/held? `active_item()`/`section()`
-- confirmed via src/xrGame/script_game_object_script2.cpp:99,102,156 and the
-- section name via this repo's own axr_main.script:355. On its own this only
-- means "in hand", not "raised to the eye" -- see is_binoc_active() below.
local function is_binoc_held()
	if not db.actor then
		return false
	end
	local item = _frame:active_item()
	if not item then
		return false
	end
	local sec = safe_call(item.section, item)
	if not sec then
		return false
	end
	return sec == BINOC_SECTION or sec:find("binoc") ~= nil
end
is_binoc_held = _frame:memoize(is_binoc_held)

-- Is the player LOOKING AT the PDA, rather than merely holding it? Identification is an act of
-- looking at the TARGET, so only the focused/zoomed device blocks it.
--
-- The 3D PDA (g_3d_pda, GAMMA's default) comes up with its screen SHOWN but input DISABLED
-- (PDA.cpp UpdateCL: ShowDialog(false) then Enable(false)) -- the device sits low, the world is
-- still in view, so identification stays live. Right-click (kWPN_ZOOM), left-click (kWPN_FIRE) and
-- R (kWPN_RELOAD, the zoom toggle) each call pda->Enable(true) and raise it to the face
-- (CPda::Action); m_bZoomed is kept in lockstep with that flag -- zooming implies Enable(true), and
-- losing Enable clears m_bZoomed (UpdateHudAdditional). So the window's own Enable flag IS the
-- "reading the PDA" state. m_bZoomed itself is unreachable: CPda is bound to Lua with no methods
-- at all (torch_script.cpp class_<CPda, CGameObject> -- constructor only).
--
-- The classic fullscreen PDA (3D PDA off) never enters the hands; ShowPdaMenu() just shows the
-- dialog, which is enabled by default, so the same test covers it.
local function pda_focused()
	local get = ActorMenu and ActorMenu.get_pda_menu
	local menu = get and safe_call(get)
	if not menu or not safe_call(menu.IsShown, menu) then
		return false
	end
	return safe_call(menu.IsEnabled, menu) and true or false
end
pda_focused = _frame:memoize(pda_focused)

-- Is the actor actually looking through raised binoculars right now (not
-- just holding them)? There's no usable Lua-side zoom-state getter: the
-- native IsZoomed is on a class hierarchy Lua can't reach, and the zoom
-- callback slot (obj:set_callback(callback.weapon_zoom_in/out, ...)) is a
-- single last-writer-wins slot already claimed by this repo's own
-- axr_main.script -- registering our own would break its `binoc_is_zoomed`
-- global, and reading that global instead proved unreliable in practice.
--
-- So this polls device().fov directly instead: any optic narrows the
-- camera's FOV, so it self-calibrates a "normal" baseline from the widest
-- FOV seen while binoculars are NOT held, then treats a shrunk FOV while
-- they ARE held as "looking through them". Calibration runs every frame
-- from actor_on_update() regardless of feature state, so the baseline is
-- already warm whenever is_binoc_active() is actually called.
-- FOV-ratio thresholds, bundled into one table (spares top-level-local slots -- Lua 5.1's
-- 200-per-chunk limit). binoc/ads = fov must drop below this fraction of the unzoomed
-- baseline to count as zoomed/aiming; mag_min = below this ratio the FOV barely narrowed
-- (treat as un-magnified, x1).
-- Zoom-detection config + the live ADS flag, bundled into one local (200-per-chunk cap).
--   `zoomed`: ADS (aim-down-sight) state, tracked from STOCK engine callbacks so it works on ANY
--   exe -- the engine fires actor_on_weapon_zoom_in/out (WeaponMagazined -> eOnWeaponZoomIn/Out)
--   the instant the sight is raised/lowered, for EVERY weapon including 1x optics that change no
--   FOV. Set by the handlers registered in on_game_start; read by is_ads_active below.
local _ZOOMCFG = {
	binoc = 0.7,
	ads = 0.85,
	mag_min = 1.05,
	assist_min_px = 4,
	zoomed = false,
	was_boost = false,
	was_binoc = false,
	zoom_item = false,
}
local _fov_baseline = 60 -- self-corrects within moments of normal (unzoomed) play either way

-- Debug tracing + perf, surfaced on the Debug-draw info panel. One bundle to spare top-level
-- locals (see the 200-local cap in CLAUDE.md).
--   Perf: `cps` = actor_on_update cycles counted per 1 s window; `loop_ms`/`loop_peak` = wall time
--   the mod's per-frame work took (os.clock, when available; ms). `frames`/`sec_start` accumulate
--   the current window.
--   Trace: `src` is the trigger CONTEXT, set right before each identify attempt (key / hipfire /
--   ads / binoc / auto); `last_*` snapshot the most recent successful commit so the panel can show
--   WHY the last identification happened. `scan` holds its ordered factor timing; `combat` and
--   `weather` hold the situational sources. WHY one ISN'T happening is computed live in draw_debug.
local _trace = {
	frames = 0,
	sec_start = 0,
	cps = 0,
	loop_ms = 0,
	loop_peak = 0, -- accumulates within the current window
	loop_shown_peak = 0, -- peak of the last completed window (what the panel shows)
	src = "-",
	last_src = "-",
	last_name = "-",
	last_tg = 0,
	last_scan = 0,
	weather = {
		rain = 0,
		storm = 0,
		fog = 0,
		visor = 0,
		visor_raw = 0,
		visor_threshold = 0,
		visor_mask = false,
		visor_available = false,
		severity = 0,
		mult = 1,
		before_ms = 0,
		after_ms = 0,
	},
	scan = {
		tier = false,
		base_ms = 0,
		penalty_scale = 1,
		final_ms = 0,
		factors = {
			dist = {},
			rank = {},
			weight = {},
			foliage = {},
			night = {},
			aim = {},
			perception = {},
			combat = {},
			familiarity = {},
			instant = {},
		},
	},
	combat = {
		enabled = false,
		active = false,
		pressure = false,
		source = "none",
		enemies = 0,
		remaining_ms = 0,
		inertia_ms = 0,
		mult = 1,
	},
}

local function update_fov_baseline()
	if is_binoc_held() then
		return
	end
	local dev = _frame:camera()
	local fov = dev and dev.fov
	if fov and fov > _fov_baseline then
		_fov_baseline = fov -- only ever raised, and only while not holding binoculars
	end
end

local function is_binoc_active()
	if not is_binoc_held() then
		return false
	end
	local dev = _frame:camera()
	local fov = dev and dev.fov
	if not fov or fov <= 0 then
		return true
	end -- can't read fov: fail open to "held" behaviour
	return fov < _fov_baseline * _ZOOMCFG.binoc
end
is_binoc_active = _frame:memoize(is_binoc_active)

-- Is the actor aiming down sight (ADS) with a weapon right now? Prefers the
-- bodycam engine's real aim flag (bodycam.get_state().ads) -- which catches even
-- low-zoom iron sights -- and falls back to the same FOV-zoom heuristic
-- is_binoc_active() uses, with a gentler ratio because ADS narrows the FOV less
-- than a scope or binoculars. Binoculars are excluded (that's binocular mode's
-- job), so ADS and binocular boosts never both fire.
local function is_ads_active()
	if is_binoc_held() then
		return false
	end
	-- PRIMARY: the weapon-zoom flag driven by the stock actor_on_weapon_zoom_in/out
	-- callbacks (see _ZOOMCFG.zoomed above). Works on ANY exe and for 1x optics that change no FOV
	-- -- the case the heuristics below can't detect. When true we are aiming, period.
	if _ZOOMCFG.zoomed then
		-- Self-heal a stuck flag: zoom_out normally clears it, but a build can skip that callback,
		-- leaving the flag set at hipfire. Two heals:
		--   1. Empty hand (no active item = holstered) is never ADS.
		--   2. A DIFFERENT active item than the one that raised the flag = you switched weapons
		--      (the common missed-zoom_out case), so treat as lowered. Only fires once we captured
		--      the zooming weapon's id (see the zoom_in callback), so it never wrongly cancels a
		--      valid 1x-optic ADS where no FOV change is visible.
		local item = db.actor and _frame:active_item()
		if not item then
			_ZOOMCFG.zoomed = false
			_ZOOMCFG.zoom_item = false
			return false
		end
		local iid = safe_call(item.id, item)
		if _ZOOMCFG.zoom_item and iid and iid ~= _ZOOMCFG.zoom_item then
			_ZOOMCFG.zoomed = false
			_ZOOMCFG.zoom_item = false
			return false
		end
		return true
	end
	-- Fallbacks, in case a given build doesn't dispatch the zoom callbacks:
	-- Bodycam camera ADS flag, ONLY when its logic is ACTIVE (when disabled the
	-- get_state() ads field is stale/false and would wrongly report "hip").
	local bc = ext_bodycam()
	if bc and bc.get_state then
		local ok, st = pcall(bc.get_state)
		if ok and type(st) == "table" and st.active and st.ads ~= nil then
			return st.ads and true or false
		end
	end
	-- A live PiP scope means we're aiming down a sight: it doesn't narrow the MAIN
	-- camera FOV (the zoom lives in the second viewport), so the FOV heuristic can't
	-- see it -- detect it directly.
	if PIP_AVAILABLE and not C.debug_sim_stock then
		local ok, a = pcall(is_svp_active)
		if ok and a then
			return true
		end
	end
	-- Non-PiP magnifying optic: the main camera FOV narrows when aiming down sight.
	local dev = _frame:camera()
	local fov = dev and dev.fov
	if not fov or fov <= 0 then
		return false
	end
	return fov < _fov_baseline * _ZOOMCFG.ads
end
is_ads_active = _frame:memoize(is_ads_active)

-- Current effective aiming magnification (1.0 = 1x), or nil when not meaningfully
-- zoomed. Hybrid, so it works with OR without a PiP engine, and tracks variable/
-- dynamic (x2/x4/...) zoom live in both cases:
--   1. PiP engine: the zoom lives in the SECOND viewport, so the main camera FOV
--      does NOT change -- only the engine binding svp_scope_magnification() (added
--      alongside is_svp_active) can report it accurately.
--   2. No PiP (stock engine), or the binding reports nothing (iron sights, a
--      non-PiP-rendered scope): a non-PiP optic narrows the MAIN camera FOV, so
--      the zoom is recoverable from device().fov against the self-calibrating
--      unzoomed baseline (_fov_baseline, see update_fov_baseline).
local SVP_MAG_AVAILABLE = rawget(_G, "svp_scope_magnification") ~= nil
local function scope_magnification()
	if SVP_MAG_AVAILABLE and not C.debug_sim_stock then
		-- Only trust the PiP binding while a scope is ACTIVELY rendering. The engine's
		-- svp_mag is set while the SVP optics pass runs but is NOT reset on unscope, so
		-- it holds the last scope's value (e.g. 3x) at hipfire / on a scopeless weapon
		-- otherwise -- the "stuck at 3x" bug. is_svp_active() gates that out. (The
		-- engine binding was also fixed to gate on IsSVPActive; this guard makes it
		-- correct without needing that rebuild.)
		local scoped = true
		if PIP_AVAILABLE and not C.debug_sim_stock then
			local ok, a = pcall(is_svp_active)
			scoped = ok and a and true or false
		end
		if scoped then
			local ok, m = pcall(svp_scope_magnification)
			if ok and m and m > 0 then
				return m
			end
		end
	end
	local dev = _frame:camera()
	local fov = dev and dev.fov
	if fov and fov > 0 and _fov_baseline > 0 then
		local m = _fov_baseline / fov
		if m > _ZOOMCFG.mag_min then
			return m
		end
	end
	return nil
end
scope_magnification = _frame:memoize(scope_magnification)

-- fov_radius is a screen-pixel tolerance measured to the target's SILHOUETTE, so a fixed pixel
-- count is not a fixed amount of forgiveness: magnify 4x and the same 35 px covers a four times
-- wider world-space cone, i.e. scoping in quietly makes the assist grabbier exactly where the
-- player is aiming most precisely. Dividing by the live magnification keeps the forgiveness
-- constant in WORLD terms. It stays usable at high zoom because the silhouette it is measured
-- from grows by the same factor the radius shrinks by -- "within 2 px of a body filling half the
-- screen" is still a generous target. Floored at _ZOOMCFG.assist_min_px so an extreme optic (a
-- binocular's raw angular ratio runs ~19x) can't collapse it to direct-hit-only; fov_radius 0 is
-- the player disabling the assist outright and stays 0.
function assist_radius()
	local r = C.fov_radius or 35
	if r <= 0 then
		return 0
	end
	if not C.fov_zoom_scaling then
		return r
	end
	local mag = scope_magnification()
	if not mag or mag <= 1 then
		return r
	end
	local eff = r / mag
	local floor_px = _ZOOMCFG.assist_min_px
	if eff < floor_px then
		return r < floor_px and r or floor_px
	end
	return eff
end

-- The binocular's REAL magnification from the engine, or nil on a stock exe. Unlike
-- scope_magnification(), this deliberately does NOT fall back to the camera-FOV ratio: for
-- binoculars that ratio is the raw ANGULAR zoom (e.g. ~19.6x), not the intended range
-- factor (~4.4x), so scaling the identify range by it blew the range far out (50 m -> ~977 m
-- instead of the intended 50 x 4.4 = 220 m). Without a real engine binding the binocular
-- range uses the flat MCM binoc_range_mult (the "range multiplier" = the magnification) --
-- see boost_params()'s binoc branch. The bodycam.* binding is the future engine-mod seam.
local function binoc_engine_magnification()
	local bc = ext_bodycam()
	if bc and bc.binoc_magnification then
		local ok, m = pcall(bc.binoc_magnification)
		if ok and m and m > 1 then
			return m
		end
	end
	return nil
end

-- The binoculars' REAL current magnification, for the range boost (boost_params binoc branch).
-- Only called while binoculars are ACTIVE (the caller guarantees it), which lets us pick the
-- accurate source in order:
--   1. bodycam.binoc_magnification -- a future exact custom binding, if present.
--   2. svp_scope_magnification() -- the SVP/PiP engine value, which reports the binoculars'
--      TRUE scale (e.g. 1.7-4.4x). Read DIRECTLY here (not via scope_magnification), skipping
--      its is_svp_active scope-gate: that gate flickers false for binoculars -- true_pip_on &&
--      IsSVPActive (engine) -- which was dropping us onto the FOV fallback below.
--   3. FOV fallback (engines with no SVP binding): the camera-FOV ratio (self-calibrating
--      baseline / current fov), same source scope_magnification uses -- returned as-is so the
--      applied range multiplier matches the magnification shown (no extra shaping).
local function binoc_magnification()
	local m = binoc_engine_magnification()
	if m then
		return m
	end
	if SVP_MAG_AVAILABLE and not C.debug_sim_stock then
		local ok, sm = pcall(svp_scope_magnification)
		if ok and sm and sm > 1 then
			return sm
		end
	end
	local dev = _frame:camera()
	local fov = dev and dev.fov
	if fov and fov > 0 and _fov_baseline > 0 then
		local raw = _fov_baseline / fov
		if raw > _ZOOMCFG.mag_min then
			return raw
		end
	end
	return nil
end
binoc_magnification = _frame:memoize(binoc_magnification)

-- Reusable ray_pick object for the free-aim mesh raycast below (has_los uses its own).
local _aim_ray = nil

-- "Are we aiming at the model" direct pick. Two sources, matching weapon_aim_ui:
--   1. A mesh raycast along the first-eye aim ray (bodycam.get_fire_ray) -- works for EVERY
--      held item (gun/knife/binoculars); rqtBoth so walls block; ignores the actor's capsule.
--   2. The standard engine weapon trace get_target_obj(ETraceTarget.Weapon) -- barrel-accurate
--      for firearms, works on a stock exe, range-gated by max_dist here.
-- The FOV assist uses this as a fallback when its screen radius doesn't cover the target (too
-- close, or aiming just off the silhouette). Assigns the forward-declared upvalue so
-- find_nearest_in_fov can call it. nil when neither source resolves an NPC.
local function accept_npc(obj)
	if not obj then
		return nil
	end
	if db.actor and obj:id() == db.actor:id() then
		return nil
	end
	if not (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
		return nil
	end
	return obj
end

function aim_model_target(max_dist)
	-- Source 1: first-eye aim-ray mesh raycast (any held item).
	local px, py, pz, dx, dy, dz = freeaim_ray()
	if px and py and pz and dx and dy and dz and rawget(_G, "ray_pick") then
		local ok, obj = pcall(function()
			if not _aim_ray then
				_aim_ray = ray_pick()
			end
			_aim_ray:set_flags(RQT_BOTH)
			if db.actor then
				_aim_ray:set_ignore_object(db.actor)
			end
			_aim_ray:set_position(_v.aim_pos:set(px, py, pz))
			_aim_ray:set_direction(_v.aim_dir:set(dx, dy, dz))
			_aim_ray:set_range(max_dist or 1000)
			if _aim_ray:query() then
				return _aim_ray:get_object()
			end
			return nil
		end)
		local hit = ok and accept_npc(obj) or nil
		if hit then
			return hit
		end
	end
	-- Source 2: standard weapon trace (firearms; stock exe). Range-gate the barrel pick.
	local ET = rawget(_G, "ETraceTarget")
	if not (ET and level and level.get_target_obj) then
		return nil
	end
	local obj = accept_npc(safe_call(level.get_target_obj, ET.Weapon))
	if not obj then
		return nil
	end
	if max_dist and db.actor then
		local ap = _frame:position(db.actor)
		local op = safe_call(obj.position, obj)
		if op and ap:distance_to(op) > max_dist then
			return nil
		end
	end
	return obj
end

-- The further away a target is (as a fraction of the CURRENT effective max
-- range), the longer the "scanning" phase takes: 1x at point-blank, ramping
-- up to dist_penalty_max right at the cutoff. Passing eff_max_dist (already
-- widened by binoc_range_mult when boosted) rather than the base C.max_dist
-- means binoculars mitigate this for free -- the same physical distance is
-- a smaller fraction of a longer range, so a target that would be almost at
-- the (slow) unaided cutoff reads as comfortably inside the (fast) boosted
-- one instead, on top of the flat binoc_scan_mult speed multiplier applied
-- separately in try_identify().
local function distance_scan_mult(dist, max_dist)
	if not C.dist_penalty then
		return 1
	end
	local t = dist / math.max(1, max_dist)
	if t < 0 then
		t = 0
	elseif t > 1 then
		t = 1
	end
	return 1 + (C.dist_penalty_max - 1) * t
end

-- Rank ladder for the rank-based scan penalty, in ascending order of how
-- accomplished/well-known the stalker is. Deliberately the same rank-id set
-- and relative ordering as the Skill System's own rank_table
-- ($HOME/code/lua/skillsystem/gamedata/scripts/haru_skills.script's
-- scavanger_effect, novice=25 ... legend=100) rather than reading
-- obj:rank() (the raw numeric CHARACTER_RANK_VALUE, bound at
-- src/xrGame/script_game_object_script2.cpp:146): that value is threshold-
-- driven by each modpack's own game_relations.ltx, so its numeric scale
-- isn't safe to assume, where rank NAMES (obj:rank_name(), already what
-- this mod displays on the card via rank_label()) are the stable, ecosystem-
-- standard identity to key off.
-- Each rank's own difficulty weight (0 = reads exactly as fast as a rookie,
-- 1 = full rank_penalty_max slowdown) -- NOT an evenly-spaced position on a
-- ladder. A veteran isn't "5/8ths of the way" harder to place at a glance
-- than a novice; the early promotions (novice -> trainee -> experienced)
-- barely change how readable someone looks, while the last few tiers
-- (expert -> master -> legend) are the stalkers who are genuinely harder to
-- size up quickly. novice is pinned at exactly 0 so a rookie is always the
-- unpenalised baseline regardless of the rank_penalty_max slider.
local RANK_WEIGHT = {
	novice = 0.00,
	trainee = 0.08,
	experienced = 0.20,
	professional = 0.35,
	veteran = 0.50,
	expert = 0.68,
	master = 0.85,
	legend = 1.00,
}

-- rank_penalty_max is the multiplier at weight 1 (legend); every other rank
-- scales to its own fixed point between 1x (novice) and that ceiling via its
-- weight above -- not a formula-derived interpolation between rank *tiers*.
-- Monsters/mutants and any rank id outside RANK_WEIGHT (an unknown/modded
-- rank ladder) fail open to no penalty -- rank_name() returns "" for
-- non-stalkers (SAFE_WRAP, not an error), and there's nothing to classify a
-- rank we don't recognise against.
local function rank_scan_mult(obj)
	if not C.rank_penalty then
		return 1
	end
	local rid = safe_call(obj.rank_name, obj)
	if not rid or rid == "" then
		return 1
	end
	local w = RANK_WEIGHT[rid]
	if not w then
		return 1
	end
	return 1 + (C.rank_penalty_max - 1) * w
end

-- --------------------------------------------------------------------------
-- Target visibility penalty: harder to make someone out in poor light.
-- --------------------------------------------------------------------------
-- In-game hour as a fractional 0..24 value (hours + minutes/60), or nil if
-- the time API isn't ready yet. level.get_time_hours()/get_time_minutes()
-- (src/xrGame/level_script.cpp:300/308, bound :2514-2515) return the current
-- world clock, the same one the HUD watch and A-Life day/night cycle read. This is
-- only used when the target has no renderer luminance reading.
local function game_hour()
	if not (level and level.get_time_hours) then
		return nil
	end
	local h = safe_call(level.get_time_hours)
	if not h then
		return nil
	end
	local m = safe_call(level.get_time_minutes) or 0
	return h + m / 60
end

-- Fallback darkness, 0 (full daylight) .. 1 (deepest night): lit through the day, dark
-- deep at night, with linear dusk/dawn ramps between. Deliberately peaks
-- across midnight -- the 23:00..04:00 plateau returns a flat 1, so 0:00 sits
-- squarely in the slowest-to-identify window (per the request). The ramps
-- make it "get harder as it gets dark" rather than flipping on at a hard
-- cutoff. Fails open to 0 (no penalty) if the clock can't be read.
local DUSK_START, NIGHT_START = 19.0, 23.0 -- 0 -> 1 over dusk
local NIGHT_END, DAWN_END = 4.0, 8.0 -- 1 -> 0 over dawn

local function darkness_factor()
	local h = game_hour()
	if not h then
		return 0
	end
	if h >= NIGHT_START or h < NIGHT_END then
		return 1
	end -- deep night, incl. midnight
	if h >= DAWN_END and h < DUSK_START then
		return 0
	end -- broad daylight
	if h < DAWN_END then
		return 1 - (h - NIGHT_END) / (DAWN_END - NIGHT_END)
	end -- dawn
	return (h - DUSK_START) / (NIGHT_START - DUSK_START) -- dusk
end

-- Prefer the target's renderer luminance so shadows and dynamic lights affect that entity.
-- The clock remains a fallback for engine forks or objects without a render-light reading.
local function target_visibility_scan_mult(obj)
	if not C.night_penalty then
		return 1
	end
	local luminance = obj and obj.get_luminocity and safe_call(obj.get_luminocity, obj)
	local severity
	local source
	local threshold
	if type(luminance) == "number" and luminance == luminance then
		luminance = math.max(0, math.min(1, luminance))
		threshold = math.max(0.01, C.night_luminance_threshold or 0.5)
		severity = 1 - math.min(1, luminance / threshold)
		source = "entity"
	else
		luminance = nil
		severity = darkness_factor()
		source = "clock"
	end
	if _tier and _tier.active and _tier.ignore_night then
		return 1, "scanner tier", luminance, severity, source, threshold
	end
	local devices = rawget(_G, "item_device")
	if C.night_ignore_nvg and devices and devices.nv_state then
		return 1, "NVG active", luminance, severity, source, threshold
	end
	return 1 + (C.night_penalty_max - 1) * severity, nil, luminance, severity, source, threshold
end

-- --------------------------------------------------------------------------
-- Weight penalty: the heavier the item you're HOLDING, the harder it is to keep the aim steady
-- enough to read a target, so the scan takes longer. Actor-side (your gear), unlike the
-- distance/rank penalties which are target-side. Linear ramp: 1x at 0 kg up to
-- weight_penalty_max at (>=) weight_penalty_ref kg. Reads the held item's configured inv_weight
-- from ini_sys (deterministic and menu-independent; the game_object weight binding varies across
-- exes, and inv_weight is a universal item field). No held item / no weight field -> no penalty.
-- --------------------------------------------------------------------------
local function weight_scan_mult()
	if not C.weight_penalty or not db.actor or not ini_sys then
		return 1
	end
	local item = _frame:active_item()
	if not item then
		return 1
	end
	local sec = safe_call(item.section, item)
	if not sec or sec == "" then
		return 1
	end
	local w = safe_call(ini_sys.r_float, ini_sys, sec, "inv_weight")
	if not w or w <= 0 then
		return 1
	end
	local ref = math.max(0.1, C.weight_penalty_ref or 6.0)
	local t = w / ref
	if t > 1 then
		t = 1
	elseif t < 0 then
		t = 0
	end
	return 1 + (C.weight_penalty_max - 1) * t
end

-- --------------------------------------------------------------------------
-- Skill System (haru_skills) compatibility: identification gets faster the
-- higher the actor's "perception" skill level is. Soft dependency throughout
-- -- the Skill System mod may not be installed at all, and even when it is,
-- its base pack ships no "perception" skill (only endurance/strength/
-- survival/scavenging), so this mod ships its own skill_perception.ltx as an
-- optional FOMOD component (see fomod/ModuleConfig.xml) that the skill
-- system's own `#include "skill_*.ltx"` wildcard picks up automatically.
-- Every access below is nil-chained rather than pcall'd: haru_skills is
-- either a whole missing global or a well-formed table (its own
-- on_game_load populates skills_levels for every configured skill), so there
-- is no method call here that can throw, just table field reads.
-- --------------------------------------------------------------------------
local function perception_level()
	if not C.perception_compat then
		return 0
	end
	local lv = haru_skills and haru_skills.skills_levels and haru_skills.skills_levels["perception"]
	return (lv and lv.current_level) or 0
end

-- Multiplicative scan-time reduction from the current perception level (1 =
-- no bonus, lower = faster), floored so it never reaches a near-instant
-- reveal at max level.
local function perception_scan_mult()
	local lvl = perception_level()
	if lvl <= 0 then
		return 1
	end
	local mult = 1 - C.perception_scan_mult * lvl
	if mult < 0.15 then
		mult = 0.15
	end
	return mult
end

-- Exposed as ii_identify.perception_hint_stats (cross-file global convention)
-- for the Skill System menu's own per-stat hint mechanism -- the exact
-- generic hook every one of its bundled skills uses to append live numbers
-- to their tooltip (ui_haru_skills.script:131 get_stats_func_value /
-- BuildDescription, e.g. survival's resistance stat -> functor =
-- ui_haru_skills, get_resistance_string). Wired in via this component's own
-- ui_settings/stats_perception.ltx ([perception] awareness = ... ; functor =
-- ii_identify, perception_hint_stats), so it appends automatically after the
-- static st_player_skills_hint_perception text, with no changes to the Skill
-- System's own files. Called with the "awareness" stat's numeric value
-- (BuildDescription always passes one), which is ignored -- awareness itself
-- carries no real meaning (see skill_perception.ltx's comment); everything
-- shown here is read fresh from the actor's actual current perception level
-- and live MCM config instead.
--
-- Shows identify time for a rookie stalker (rank held at baseline -- see
-- rank_scan_mult()'s RANK_WEIGHT, novice = 0 -- so this isolates perception's
-- own effect; a rank penalty on top of a higher-ranked target, if enabled,
-- multiplies further) at the actor's current level, across the four
-- range/binocular combinations. All four $-tokens in the string are always
-- followed by whitespace/punctuation, never another word character, so
-- there's no ambiguity for whatever token-matching utils_data.parse_string_keys
-- uses under the hood (confirmed by example against the Skill System's own
-- stat strings, which follow the same rule for their own $stat token).
function perception_hint_stats()
	local lvl = perception_level()
	local pmult = perception_scan_mult()

	local function scan_seconds(dist, boosted_case)
		local eff_max = boosted_case and (C.max_dist * C.binoc_range_mult) or C.max_dist
		local t = math.floor(SCAN_MS * distance_scan_mult(dist, eff_max))
		if boosted_case then
			t = math.floor(t * C.binoc_scan_mult)
		end
		t = math.floor(t * pmult)
		return string.format("%.2f", t / 1000)
	end

	local ok, txt = pcall(function()
		return utils_data.parse_string_keys(game.translate_string("st_ii_perception_hint_stats"), {
			["level"] = lvl,
			["t1"] = scan_seconds(0, false),
			["t2"] = scan_seconds(C.max_dist, false),
			["t3"] = scan_seconds(0, true),
			["t4"] = scan_seconds(C.max_dist, true),
		})
	end)
	return ok and txt or ""
end

-- Rewards using the identify feature with perception XP, same as the skill
-- system's own skills reward using them. Only fires when the "perception"
-- skill actually exists in skills_levels (the optional skill_perception.ltx
-- component is installed).
--
-- Deliberately does NOT call haru_skills.increase_skill(skill, amount): it
-- multiplies by options["exp_multiplier_" .. skill], which is only ever
-- populated for the four hardcoded base skills in both known variants of
-- that file, so it would throw on "perception" before touching .experience.
-- Writing .experience directly sidesteps that; the periodic update_stats()
-- (already running regardless of this mod) independently re-checks every
-- configured skill's experience against its requirement and levels it up,
-- so this needs no level-up logic of its own.
-- Returns true if XP was actually granted -- callers use this to gate their
-- own one-time-award table (xp_awarded/loot_xp_awarded below) so a target
-- isn't burned as already-farmed if the integration was off/absent at the
-- time. `amount` lets both the base identify reward and the loot bonus
-- (below) share this same function instead of duplicating it.
local function award_perception_xp(amount)
	if not C.perception_compat then
		return false
	end
	local hs = haru_skills
	if not hs then
		return false
	end
	-- ORPHAN GUARD. haru_skills persists each skill's LEVEL in the save (skills_levels) but
	-- rebuilds its STATS config (skills_stats, from the installed skill_*.ltx) fresh each load.
	-- If our Perception Skill Integration is UNINSTALLED from a save that once had it,
	-- skills_levels["perception"] survives (from the save) while skills_stats["perception"] is
	-- gone -- an orphan. Feeding XP to it would eventually cross the level-up threshold, and
	-- haru_skills' level-up does `pairs(skills_stats[name])`, which crashes on the nil stats
	-- table (bad argument #1 to 'pairs'). So: only feed the skill when it's actually configured
	-- this session. Guarded on skills_stats being a table so a variant that doesn't expose it
	-- falls back to the old behaviour rather than silently never granting XP.
	if type(hs.skills_stats) == "table" and type(hs.skills_stats["perception"]) ~= "table" then
		return false
	end
	local lv = hs.skills_levels and hs.skills_levels["perception"]
	if not lv or type(lv.experience) ~= "number" then
		return false
	end
	lv.experience = lv.experience + amount
	return true
end

-- Per-target one-time XP gate: [npc_id] = true once that target has ever
-- earned perception XP, so repeatedly re-identifying the same stalker after
-- its tag fades out (tracked[id] clears, so the earlier "already tracked"
-- check alone doesn't stop this) can't farm unlimited XP off one NPC.
-- Persisted via save_state/load_state below so reloading a save doesn't
-- reset the list either. Keyed by the engine's alife object id like
-- `tracked` already is; the one edge case is a since-dead NPC's id being
-- recycled onto an unrelated new object, which would just silently deny
-- that one new NPC its first-time XP -- rare, and the failure mode is
-- "no XP" rather than anything worse, so not worth a heavier identity
-- scheme (e.g. name+community) that has its own collision problems.
local xp_awarded = {}

-- Familiarity gate: [npc_id] = true once you've identified that target at
-- least once, ever -- unlike xp_awarded (only set when perception XP was
-- actually granted, so a later-installed Skill System can still pay out a
-- previously-met NPC's first-time XP), this is set on every first successful
-- identify regardless of the Skill System's presence, since the familiarity
-- speed boost is a core mod feature, not part of that soft integration.
-- Also persisted via save_state/load_state.
local remembered = {}

-- Per-target one-time gate for the loot XP bonus below -- same rationale and
-- persistence as xp_awarded, kept separate since the two rewards are earned
-- independently (identify without ever looting, or loot a target identified
-- in an earlier session) and shouldn't share one gate.
local loot_xp_awarded = {}

-- Bonus perception XP for looting a corpse you'd already identified.
-- Detected by polling get_talking_npc() -- the actor's current dual-
-- inventory partner -- once a frame rather than via callback.on_item_take:
-- that callback is a single-slot-per-object registration (same conflict
-- class as the binocular zoom slot, see is_binoc_active()'s comment), fires
-- per item rather than per loot session, and doesn't say who the item came
-- from anyway. Anomaly's trade and corpse-loot screens both open through
-- this same "talk partner" mechanism (alive for trade, dead for loot), so
-- watching it for a "was set, now cleared" transition is a plain read with
-- no shared slot to fight over, and naturally fires once per loot session.
local loot_partner_id = nil

local function update_loot_xp()
	local partner = safe_call(db.actor.get_talking_npc, db.actor)
	if partner then
		loot_partner_id = partner:id()
		return
	end
	if not loot_partner_id then
		return
	end

	local id = loot_partner_id
	loot_partner_id = nil
	if not remembered[id] or loot_xp_awarded[id] then
		return
	end

	local corpse = level.object_by_id(id)
	local alive = corpse and safe_call(corpse.alive, corpse)
	if alive then
		return
	end -- the partner session ended some other way (e.g. a live trade), not a loot

	if award_perception_xp(C.perception_loot_xp) then
		loot_xp_awarded[id] = true
	end
end

-- Compute this target's scan time and commit it to `tracked` (create a fresh
-- reveal, or restart one that's already showing). Split out of try_identify()
-- so the keypress path and the auto-identify sweep (update_auto_identify)
-- share one identical commit path. Caller guarantees obj is alive and comm is
-- a non-empty community id; (boosted, eff_max_dist) come from
-- the caller's boost_params() snapshot.
local function identify_target(obj, comm, boosted, eff_max_dist, scan_mult, auto_mode, priority)
	-- Tier system installed but the kit isn't assembled/worn: the scanner IS the identify
	-- device, so block all identification. Single choke point -- every path commits here.
	if tier_blocked() then
		return
	end
	-- Reading the PDA: no path may identify while the player is looking at its screen.
	if pda_focused() then
		return
	end
	-- Exclude an entity that is actively hostile + engaging the actor (in combat / pulled aggro).
	-- Choke-point gate so NO path (key / auto / dwell / sweep) can identify one; the selection
	-- filters below also skip them so the FOV assist moves on to another target.
	if C.exclude_hostile and is_hostile_engaging(obj) then
		return
	end
	local pos, apos = _frame:position(obj), _frame:position(db.actor)
	local dist = pos and apos and pos:distance_to(apos)
	if not dist or dist > eff_max_dist then
		return
	end

	local id = obj:id()
	local tg = time_global()
	if _tracks:refresh(id, tg, FADE_MS, HOLD_MS) then
		return
	end
	local slot = _tracks:claim(id, priority or not auto_mode)
	if not slot then
		return
	end
	local scan_trace = _trace.scan
	local factors = scan_trace.factors
	for _, factor in pairs(factors) do
		factor.applied, factor.mult, factor.before_ms, factor.after_ms, factor.ignored = false, 1, 0, 0, nil
	end
	local night_mult, night_ignored, night_luminance, night_severity, night_source, night_threshold =
		target_visibility_scan_mult(obj)
	factors.night.ignored = night_ignored
	factors.night.luminance = night_luminance
	factors.night.severity = night_severity
	factors.night.source = night_source
	factors.night.threshold = night_threshold
	scan_trace.tier = tier_active()
	local tier = scan_trace.tier and _tier or nil
	local penalty_scale = tier and math.max(0, tier.penalty_scale or 1) or 1
	scan_trace.penalty_scale = penalty_scale
	local function apply_factor(factor, value, mult, applied)
		factor.applied = applied
		factor.mult = mult
		factor.before_ms = value
		factor.after_ms = math.floor(value * mult)
		return factor.after_ms
	end
	local function scaled_penalty(mult)
		return 1 + (math.max(1, mult or 1) - 1) * penalty_scale
	end

	-- Target-side difficulty first (how far away, how accomplished the
	-- stalker is), then target lighting, then actor-side mitigation on
	-- top: distance penalty scales against eff_max_dist (already widened when
	-- boosted, mitigating the penalty for free), rank penalty scales with the
	-- target's own rank, the weight penalty scales with the item YOU'RE holding,
	-- target visibility scales with renderer luminance, the flat binoc_scan_mult
	-- speed boost applies next, then the actor's perception skill level (if the Skill
	-- System integration is present) shaves a further fraction off. Combat pressure applies
	-- next, weather visibility adds one capped rain/storm/fog/visor penalty, and finally
	-- familiarity (below) discounts a target you've identified before.
	local base_ms = tier and tier.scan_base and math.floor(tier.scan_base * 1000) or SCAN_MS
	scan_trace.base_ms = base_ms
	local eff_scan_ms =
		apply_factor(factors.dist, base_ms, scaled_penalty(distance_scan_mult(dist, eff_max_dist)), C.dist_penalty)
	eff_scan_ms = apply_factor(factors.rank, eff_scan_ms, scaled_penalty(rank_scan_mult(obj)), C.rank_penalty)
	eff_scan_ms = apply_factor(factors.weight, eff_scan_ms, scaled_penalty(weight_scan_mult()), C.weight_penalty)

	-- The LOS march is shared by standard and WD scans so the tier scale can attenuate foliage too.
	local foliage_mult = 1
	if C.foliage_penalty and (C.foliage_penalty_max or 1) > 1 and obj then
		local dev = _frame:camera()
		local org = anchor_pos(obj)
		if dev and dev.cam_pos and org then
			_los.saw_foliage = false
			_los_point_clear(org, dev.cam_pos)
			if _los.saw_foliage then
				foliage_mult = C.foliage_penalty_max
			end
		end
	end
	eff_scan_ms = apply_factor(factors.foliage, eff_scan_ms, scaled_penalty(foliage_mult), C.foliage_penalty)
	eff_scan_ms =
		apply_factor(factors.night, eff_scan_ms, scaled_penalty(night_mult), C.night_penalty and not night_ignored)
	if not tier then
		eff_scan_ms = apply_factor(factors.aim, eff_scan_ms, boosted and (scan_mult or 1.0) or 1, boosted)
		eff_scan_ms = apply_factor(factors.perception, eff_scan_ms, perception_scan_mult(), C.perception_compat)
	end
	---@diagnostic disable-next-line: undefined-global
	local combat_mult = scaled_penalty(ii_combat.scan_mult(C, _trace.combat))
	_trace.combat.mult = combat_mult
	eff_scan_ms = apply_factor(factors.combat, eff_scan_ms, combat_mult, C.combat_penalty and _trace.combat.active)
	_trace.weather.before_ms = eff_scan_ms
	---@diagnostic disable-next-line: undefined-global
	local weather_mult = scaled_penalty(ii_weather.scan_mult(C, dist, _trace.weather))
	_trace.weather.mult = weather_mult
	eff_scan_ms = math.floor(eff_scan_ms * weather_mult)
	_trace.weather.after_ms = eff_scan_ms

	local familiar = not scan_trace.tier and C.familiarity_boost and remembered[id]
	if familiar then
		eff_scan_ms = apply_factor(factors.familiarity, eff_scan_ms, C.familiarity_scan_mult, true)
	end

	-- Instant identify: skip the whole scanning phase (no spinner, no wait) so the tag reveals
	-- immediately. Overrides every scan-time factor above. Ignored under the tier system (the
	-- tier base scan time governs instead). Per-aim-mode excludes let you keep the normal scan
	-- wait for a specific mode (e.g. instant hip-fire but a scan delay through binoculars).
	if not scan_trace.tier and C.instant_identify then
		local binoc = is_binoc_active()
		local ads = (not binoc) and is_ads_active()
		local excluded = (binoc and C.instant_exclude_binoc)
			or (ads and C.instant_exclude_ads)
			or (not binoc and not ads and C.instant_exclude_hipfire)
		if not excluded then
			eff_scan_ms = apply_factor(factors.instant, eff_scan_ms, 0, true)
		end
	end
	scan_trace.final_ms = eff_scan_ms

	if not xp_awarded[id] and award_perception_xp(C.perception_xp) then
		xp_awarded[id] = true
	end
	remembered[id] = true

	-- Which data lines this tag shows. Under the tier system (WD compat) each feature is
	-- gated by the module tiers (_tier.feat.*), IGNORING the C.show_* MCM toggles; without
	-- it, the normal user toggles apply (rank/relationship always shown, distance never --
	-- distance is a tier-only readout). The gate is folded into the snapshot here so the
	-- draw code just checks field presence (see draw_slot). ft nil => non-tier path.
	local ft = (_tier and _tier.active) and _tier.feat or nil
	local show_faction = ft and (ft.faction == true) or (not ft and C.show_faction)
	local show_name = ft and true or C.show_name
	local show_rank = ft and (ft.rank == true) or (not ft and C.show_rank)
	local show_weapon = ft and (ft.weapon == true) or (not ft and C.show_weapon)
	-- MCM toggle wins over the tier gate: off means no relation cue at all.
	local show_rel = C.show_relation and ((ft and ft.relationship == true) or not ft)
	local show_dist = ft and (ft.distance == true) or false

	-- Portrait for the Promin OSD readout (a ui_npc_u_* texture region). character_icon() is
	-- only valid for InventoryOwners, so it errors on monsters -- guarded; nil = no portrait.
	local portrait = safe_call(obj.character_icon, obj)
	portrait = (portrait and portrait ~= "") and portrait or nil

	_tracks:put(id, {
		t0 = tg,
		last_seen_tg = tg, -- last identify tick, for the look-away-and-back re-scan gap (see above)
		col = show_rel and relation_color(obj) or COL_NEUTRAL,
		fcol = faction_color(comm),
		-- nil, not "o": absence is how the draw code learns a line/cue is off (same idiom as
		-- name/rank/weap above), and every SIGN_COLOR[sign] lookup degrades to COL_NEUTRAL.
		sign = show_rel and relation_sign(obj) or nil,
		header = show_faction and faction_label(comm) or nil,
		name = show_name and display_name(obj, comm) or nil,
		comm = comm, -- kept for the hostile warning sound, which maps community -> audio file
		icon = faction_icon_id(comm),
		icon_custom = custom_patch_id(comm), -- used instead when custom_patches is on (live, see render)
		rank = show_rank and rank_label(obj) or nil,
		rank_col = rank_color(obj),
		rank_level = show_rank and RANK_LEVEL[safe_call(obj.rank_name, obj) or ""] or nil, -- for the notification card

		weap = show_weapon and held_weapon_label(obj) or nil,
		portrait = portrait, -- for the Promin OSD readout (captured at reveal, see render())
		want_dist = show_dist,
		scan_ms = eff_scan_ms,
		max_dist = eff_max_dist,
		-- Snapshotted like scan_ms/max_dist above: FADE_MS/HOLD_MS
		-- can change live via MCM mid-reveal, and without this snapshot an
		-- already-active tag's `total` (see render()) would shrink/grow
		-- retroactively -- e.g. lowering hold_time while a tag is mid-hold
		-- could delete it outright the next frame instead of letting it
		-- finish the reveal it started.
		fade_ms = FADE_MS,
		hold_ms = HOLD_MS,
	}, slot)

	-- Debug trace: a fresh reveal was just committed (the refresh branch returned above). Record
	-- the trigger context (_trace.src, set by whichever path is identifying) + result so the
	-- Debug-draw panel can show WHY the last identification happened.
	_trace.last_src = _trace.src
	_trace.last_name = display_name(obj, comm) or safe_call(obj.name, obj) or "?"
	_trace.last_tg = tg
	_trace.last_scan = eff_scan_ms

	-- NB: the Promin OSD readout (_last_id, read by get_last_identified) is NOT populated
	-- here at scan START -- it's captured in render() at the moment the scan COMPLETES, so
	-- the readout respects scan time (a slower process module = a longer wait before the
	-- target appears on the Promin) and keeps the previous target until the new one finishes.
end

-- Snapshot the current binocular-boost state into the triple both the keypress
-- path and the auto sweep consume. Binoculars boost identification regardless
-- of binocular_mode: faster reveal and a longer effective range. Captured once
-- at identify time (not read live in render()) so a tag identified at boosted
-- range doesn't immediately fail the (unboosted) fade/grace distance checks the
-- instant the player lowers the binoculars mid-reveal.
-- Returns: binoc (looking through binoculars), ads (aiming down sight), boosted
-- (a boost is actually active), the widened effective max/fade distances, and the
-- active scan_time multiplier. Binoculars take priority over ADS so the two never
-- stack. Each boost carries its own scan + range multipliers from its MCM section.
-- Per-mode HARD cutoff on the effective identify distance. After the base distance is scaled up
-- (magnification / range boosts), clamp it to the ACTIVE aim mode's cap so a runaway
-- magnification (or any future scaling) can't push identify range absurdly high. 0 = no cap.
-- fade never exceeds the (capped) max. hipfire = the default aim (neither binoculars nor ADS).
local function apply_mode_cap(binoc, ads, max_d)
	local cap = (binoc and C.binoc_max_dist) or (ads and C.ads_max_dist) or C.hipfire_max_dist
	if cap and cap > 0 and max_d > cap then
		max_d = cap
	end
	return max_d
end

local function boost_params()
	if tier_active() then
		-- Tier system: range comes from the scanner tier (t.max_dist). Binoculars count when
		-- the scanner unlocks them (allow_binoc, tier 1+) and extend the tier range by
		-- binoc_range_mult; ADS counts only when the scanner unlocks scope/ADS (allow_ads),
		-- with the magnification range boost at the scanner's mag tier (mag_boost). scan_mult
		-- is unused (identify_target's tier branch sets scan time from the process tier).
		local t = _tier ---@cast t ii_tier_override
		local base_max = t.max_dist or C.max_dist
		local binoc = t.allow_binoc and is_binoc_active() or false
		local ads = (not binoc) and t.allow_ads and is_ads_active() or false
		local range_mult = 1.0
		if binoc then
			range_mult = C.binoc_range_mult
		elseif ads and t.mag_boost then
			local mag = scope_magnification()
			if mag and mag > 1 then
				range_mult = mag
			end
		end
		local eff = base_max * range_mult
		return binoc, ads, (binoc or ads), apply_mode_cap(binoc, ads, eff), 1.0
	end
	local binoc = is_binoc_active()
	local ads = (not binoc) and is_ads_active()
	local boosted = false
	local scan_mult, range_mult = 1.0, 1.0
	if binoc and C.binoc_boost then
		boosted = true
		scan_mult = C.binoc_scan_mult
		-- Two range modes, chosen by binoc_zoom_scaling:
		--   OFF -> the flat MCM "max-distance multiplier" (binoc_range_mult), e.g. 4.4.
		--   ON  -> the binocular's REAL CURRENT magnification, so the range tracks how far the
		--          binoculars are actually zoomed (see binoc_magnification: SVP true value when
		--          available, else a sqrt-softened camera-FOV ratio). Falls back to
		--          binoc_range_mult if no magnification is readable.
		range_mult = C.binoc_range_mult
		if C.binoc_zoom_scaling then
			local mag = binoc_magnification()
			if mag and mag > 1 then
				range_mult = mag
			end
		end
	elseif ads and C.ads_boost then
		boosted = true
		scan_mult, range_mult = C.ads_scan_mult, C.ads_range_mult
		-- Higher-power optics reach further: scale the ADS range by the scope's
		-- magnification (x2/x4/...), so ads_range_mult is the x1 base. Only when
		-- the engine reports a magnification (PiP scope); iron sights stay at x1.
		if C.ads_zoom_scaling then
			local mag = scope_magnification()
			if mag and mag > 1 then
				range_mult = range_mult * mag
			end
		end
	end
	local eff_max_dist = apply_mode_cap(binoc, ads, C.max_dist * range_mult)
	return binoc, ads, boosted, eff_max_dist, scan_mult
end

_frame.compute_boost = boost_params
boost_params = function()
	if not _frame.active then
		return _frame.compute_boost()
	end
	if _frame.boost_serial ~= _frame.serial then
		_frame.binoc, _frame.ads, _frame.boosted, _frame.max_dist, _frame.scan_mult = _frame.compute_boost()
		_frame.boost_serial = _frame.serial
	end
	return _frame.binoc, _frame.ads, _frame.boosted, _frame.max_dist, _frame.scan_mult
end

-- auto_mode: called by the steady-aim auto-trigger (binocular / ADS mode) rather
-- than a deliberate keypress. In that mode identify_target refreshes an already-
-- revealed target's hold window WITHOUT restarting its reveal, so holding/tracking
-- a target you've already identified doesn't re-scan it every time the steady aim
-- re-arms (the ADS "double identification" retrigger). A manual keypress (nil)
-- still restarts the reveal on purpose.
local function try_identify(auto_mode)
	if not C.enabled or not db.actor then
		return
	end
	debug_dump_aim()
	debug_dump_candidates()
	local binoc, _, boosted, eff_max_dist, scan_mult = boost_params()
	if C.require_binoculars and not tier_active() and not binoc then
		return
	end

	-- FOV target-assist is context-sensitive: fov_assist_binoc governs it while
	-- looking through raised binoculars, fov_assist otherwise.
	local allow_fov = C.fov_assist
	if binoc then
		allow_fov = C.fov_assist_binoc
	end

	local obj = get_target_obj(eff_max_dist, allow_fov)
	if not obj then
		return
	end
	if obj:id() == db.actor:id() then
		return
	end

	local alive = safe_call(obj.alive, obj)
	if not alive then
		return
	end

	local comm = safe_call(obj.character_community, obj)
	if not comm or comm == "" then
		return
	end

	identify_target(obj, comm, boosted, eff_max_dist, scan_mult, auto_mode, true)
end

-- --------------------------------------------------------------------------
-- Auto-identify: continuously reveal every visible target in range, no key.
-- --------------------------------------------------------------------------
-- Sweeps all nearby NPCs/creatures (level.iterate_nearest, the same primitive
-- find_nearest_in_fov uses) and hands each alive, community-tagged one that is
-- in the player's view to identify_target -- no aiming involved. "Visible" is the
-- whole point here, so LOS is always required regardless of the require_los toggle
-- (which only governs the FOV assist fallback for the manual key). Throttled:
-- iterate_nearest + a per-candidate has_los() raycast every frame across a crowd
-- is wasteful, and the scan reveal is on a timescale where a few-hundred-ms
-- cadence is invisible.
local _auto = { throttle_ms = 250, last_tg = 0 }

-- LOS alone also passes targets behind the camera; those would occupy tag slots
-- without ever being drawable, starving the targets actually in view.
local function in_view(obj)
	local x, y = project_world(anchor_pos(obj))
	if x and x >= 0 and x <= 1024 and y >= 0 and y <= 768 then
		return true
	end
	x, y = project_world(_frame:position(obj))
	return x ~= nil and x >= 0 and x <= 1024 and y >= 0 and y <= 768
end

local function update_auto_identify(tg)
	if not C.auto_identify then
		return
	end
	-- Reading the PDA (see pda_focused): nothing is identified while looking at its screen.
	if pda_focused() then
		return
	end
	if not db.actor or not level.iterate_nearest then
		return
	end

	local binoc, _, boosted, eff_max_dist, scan_mult = boost_params()
	if C.require_binoculars and not tier_active() and not binoc then
		return
	end
	_trace.src = "auto-identify"

	-- Snappy on-aim: identify the target directly under the crosshair EVERY frame (direct-hit
	-- only via get_target_obj(..., allow_fov=false) -- no scene scan, so it's cheap). This starts
	-- the scan the instant you're on target instead of waiting up to _auto.throttle_ms for the
	-- throttled full sweep below. LOS is always required for auto-identify.
	local direct = get_target_obj(eff_max_dist, false)
	if direct then
		local comm = safe_call(direct.character_community, direct)
		if comm and comm ~= "" and has_los(direct) then
			identify_target(direct, comm, boosted, eff_max_dist, scan_mult, true, true)
		end
	end

	-- Throttled full sweep of everything in view. Deliberately independent of fov_identify_all:
	-- that option picks all-vs-nearest inside the aim-assist radius, while auto-identify
	-- does not involve aiming at all.
	if tg - _auto.last_tg < _auto.throttle_ms then
		return
	end
	_auto.last_tg = tg

	local apos = _frame:position(db.actor)
	local actor_id = db.actor:id()
	-- hide_off_aim scopes identification to the aimed target(s): with it on, only identify what's
	-- inside the FOV assist radius, so auto never adds an off-aim target that render's membership
	-- gate would immediately drop (that add/drop churn is what would strobe the scan spinner).
	local aim_only = C.hide_off_aim
	local acx, acy
	if aim_only then
		acx, acy = aim_center()
	end
	pcall(level.iterate_nearest, apos, eff_max_dist, function(obj)
		if obj and not _tracks:has_room(obj:id()) then
			return false
		end
		if obj and obj:id() ~= actor_id and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			if safe_call(obj.alive, obj) then
				local comm = safe_call(obj.character_community, obj)
				if comm and comm ~= "" then
					local aimed = not aim_only
					if aim_only then
						local d = screen_dist_to_body(obj, acx, acy)
						aimed = d ~= nil and d <= assist_radius()
					end
					if aimed and in_view(obj) and has_los(obj) then
						identify_target(obj, comm, boosted, eff_max_dist, scan_mult, true)
					end
				end
			end
		end
		return false -- keep scanning the whole set within eff_max_dist
	end)
end

-- --------------------------------------------------------------------------
-- Binocular mode: auto-identify on a steady aim, no key needed.
-- --------------------------------------------------------------------------
-- "Steady" is tracked against an anchor direction (the camera direction when
-- steadiness tracking last (re)started) rather than frame-to-frame deltas,
-- so slow deliberate panning correctly resets it while ordinary hand-shake/
-- micro-jitter within the tolerance doesn't -- comparing only to the
-- previous frame would let a slow continuous pan stay "steady" forever.
local STEADY_MAX_D2 = 0.002 -- squared-distance tolerance between unit vectors, ~2.6 degrees

-- Binocular steady-aim state, bundled into one table (spares top-level-local slots -- Lua
-- 5.1's 200-per-chunk limit): anchor = the camera direction steadiness is measured against
-- (a reused vector), start = when the current steady hold began, last_sweep = last sweep tick.
local _steady = { anchor = nil, start = nil, last_sweep = 0 }
local STEADY_SWEEP_MS = 250 -- re-sweep cadence while the trigger stays armed
-- ADS-mode dwell state (bundled to spare top-level locals): armed = a valid target is
-- currently under the aim; start = when it first appeared; last = last identify tick;
-- check = last presence re-evaluation (throttles the per-frame raycasts).
-- ADS + hipfire dwell state, bundled into one table (spares top-level-local slots -- Lua
-- 5.1's 200-per-chunk limit). Each: armed = a valid target is currently under the aim;
-- start = when it first appeared; last = last identify tick; check = last presence re-eval.
local _dwell =
	{ ads = { armed = false, start = 0, last = 0, check = 0 }, hip = { armed = false, start = 0, last = 0, check = 0 } }

local function reset_steady()
	_steady.anchor = nil
	_steady.start = nil
end

-- Identify every alive, community-tagged, visible target whose body falls inside the
-- aim-assist RING (fov_radius around the current aim point) -- not just the single
-- nearest one, and NOT the whole screen. So aiming at a cluster of stacked targets
-- reveals all of them, while a lone target elsewhere on screen is left alone (same
-- fov_radius test find_nearest_in_fov uses, just applied to every match instead of the
-- nearest). auto_mode=true, so an already-revealed target just gets its hold window
-- refreshed. LOS is required. Shared by the steady-aim auto-trigger.
local function sweep_identify_in_fov(tg)
	if not db.actor or not level.iterate_nearest then
		return
	end
	local binoc, _, boosted, eff_max_dist, scan_mult = boost_params()
	if C.require_binoculars and not tier_active() and not binoc then
		return
	end
	local cx, cy = aim_center()
	local radius = assist_radius()
	local apos = _frame:position(db.actor)
	local actor_id = db.actor:id()
	pcall(level.iterate_nearest, apos, eff_max_dist, function(obj)
		if obj and not _tracks:has_room(obj:id()) then
			return false
		end
		if obj and obj:id() ~= actor_id and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj)) then
			if safe_call(obj.alive, obj) then
				local comm = safe_call(obj.character_community, obj)
				if comm and comm ~= "" then
					-- Inside the aim-assist screen radius (nearest body point within
					-- fov_radius px of the aim point), and visible.
					local d = screen_dist_to_body(obj, cx, cy)
					if d and d <= radius and has_los(obj) then
						identify_target(obj, comm, boosted, eff_max_dist, scan_mult, true)
					end
				end
			end
		end
		return false -- sweep the whole set within eff_max_dist
	end)

	-- Fallback: also identify whatever the crosshair is directly on the MODEL of, in case the
	-- radius missed it (too close, or aiming just off the silhouette).
	local model = aim_model_target(eff_max_dist)
	if model and (not C.require_los or has_los(model)) then
		local comm = safe_call(model.character_community, model)
		if comm and comm ~= "" then
			identify_target(model, comm, boosted, eff_max_dist, scan_mult, true, true)
		end
	end
end

-- ADS-mode dwell trigger: keep a valid target under the aim -- directly (crosshair on
-- it) or, when fov_assist is on, inside the FOV assist range -- CONTINUOUSLY for
-- ads_hold_time, then auto-identify (and keep identifying, throttled, while a target
-- stays there). Unlike the binocular steadiness trigger below, this is dwell-on-target:
-- holding the aim still on empty air does nothing; a target must actually be present, but
-- you CAN track a moving one. Resets the instant no valid target is under the aim.
local function update_ads_dwell(tg)
	if not (C.ads_mode and is_ads_active()) or not db.actor then
		_dwell.ads.armed = false
		return
	end
	-- Throttle the raycast presence check (dwell timing still uses tg, so it's exact);
	-- 100 ms is well under any sane hold time and keeps ADS cheap.
	if tg - _dwell.ads.check < 100 then
		return
	end
	_dwell.ads.check = tg
	local binoc, _, boosted, eff_max_dist, scan_mult = boost_params()
	if C.require_binoculars and not tier_active() and not binoc then
		_dwell.ads.armed = false
		return
	end
	-- Is a valid target under the aim right now? Direct hit, or the FOV-assist pick when
	-- fov_assist is on (get_target_obj handles both via allow_fov).
	local obj = get_target_obj(eff_max_dist, C.fov_assist)
	local present = false
	if obj and obj:id() ~= db.actor:id() and safe_call(obj.alive, obj) then
		local comm = safe_call(obj.character_community, obj)
		present = comm and comm ~= "" and has_los(obj) and true or false
	end
	if not present then
		_dwell.ads.armed = false -- nothing valid on aim -> reset the dwell
		return
	end
	if not _dwell.ads.armed then
		_dwell.ads.armed = true
		_dwell.ads.start = tg
		_dwell.ads.last = 0
		-- No early return: with ads_hold_time 0 the elapsed check below is already
		-- satisfied, so identification fires on the SAME frame the target is acquired
		-- (instant). A positive hold time isn't satisfied yet, so it waits as before.
	end
	-- Held long enough: identify (throttled). fov_assist on -> sweep everyone in the FOV
	-- assist range; off -> just the target directly under the aim.
	if (tg - _dwell.ads.start) >= (C.ads_hold_time or 0) * 1000 then
		if tg - _dwell.ads.last >= STEADY_SWEEP_MS then
			_dwell.ads.last = tg
			_trace.src = "ADS dwell"
			if C.fov_assist and C.fov_identify_all then
				sweep_identify_in_fov(tg)
			else
				try_identify(true)
			end
		end
	end
end

-- Hipfire dwell trigger: identify a target you keep under the aim while hip-firing (NOT
-- aiming down sight, NOT through binoculars) for hipfire_hold_time -- for players who'd
-- rather not press the key. Same dwell-on-target logic as the ADS version, gated on hipfire.
-- State is _dwell.hip (bundled with _dwell.ads above to spare top-level-local slots).
local function update_hipfire_dwell(tg)
	if not (C.hipfire_mode and db.actor) or is_ads_active() or is_binoc_active() then
		_dwell.hip.armed = false
		return
	end
	if tg - _dwell.hip.check < 100 then
		return
	end
	_dwell.hip.check = tg
	local binoc, _, boosted, eff_max_dist, scan_mult = boost_params()
	if C.require_binoculars and not tier_active() and not binoc then
		_dwell.hip.armed = false
		return
	end
	local obj = get_target_obj(eff_max_dist, C.fov_assist)
	local present = false
	if obj and obj:id() ~= db.actor:id() and safe_call(obj.alive, obj) then
		local comm = safe_call(obj.character_community, obj)
		present = comm and comm ~= "" and has_los(obj) and true or false
	end
	if not present then
		_dwell.hip.armed = false
		return
	end
	if not _dwell.hip.armed then
		_dwell.hip.armed = true
		_dwell.hip.start = tg
		_dwell.hip.last = 0
		-- No early return: with hipfire_hold_time 0 identification fires on the SAME frame
		-- the target is acquired (instant); a positive hold time waits as before.
	end
	if (tg - _dwell.hip.start) >= (C.hipfire_hold_time or 0) * 1000 then
		if tg - _dwell.hip.last >= STEADY_SWEEP_MS then
			_dwell.hip.last = tg
			_trace.src = "hipfire dwell"
			if C.fov_assist and C.fov_identify_all then
				sweep_identify_in_fov(tg)
			else
				try_identify(true)
			end
		end
	end
end

-- Steady-aim auto-identify. Binocular mode uses camera STEADINESS (hold the aim still for
-- steady_time, then sweep-identify the FOV); ADS mode uses target DWELL (update_ads_dwell
-- above); hipfire mode also uses target DWELL (update_hipfire_dwell). All run every frame;
-- each self-gates on its own toggle + aim context.
local function update_binocular_scan(tg)
	-- Reading the PDA: disarm every auto trigger instead of just skipping it, so unzooming the
	-- PDA can't fire a dwell that "held" for as long as the player was reading the map.
	if pda_focused() then
		_dwell.ads.armed, _dwell.hip.armed = false, false
		reset_steady()
		return
	end
	update_ads_dwell(tg)
	update_hipfire_dwell(tg)

	if not (C.binocular_mode and is_binoc_active()) then
		reset_steady()
		return
	end

	local dev = _frame:camera()
	local dir = dev and dev.cam_dir
	if not dir then
		reset_steady()
		return
	end

	if not _steady.anchor then
		_steady.anchor = vector():set(dir)
		_steady.start = tg
		return
	end

	local dx, dy, dz = dir.x - _steady.anchor.x, dir.y - _steady.anchor.y, dir.z - _steady.anchor.z
	if (dx * dx + dy * dy + dz * dz) > STEADY_MAX_D2 then
		_steady.anchor:set(dir)
		_steady.start = tg
		return
	end

	-- Held steady long enough (throttled). Respect the binocular FOV-assist toggle:
	-- on -> sweep-identify every target inside the assist ring; off -> a DIRECT aim only.
	if (tg - _steady.start) >= C.steady_time * 1000 then
		if tg - _steady.last_sweep >= STEADY_SWEEP_MS then
			_steady.last_sweep = tg
			_trace.src = "binoc steady"
			if C.fov_assist_binoc and C.fov_identify_all then
				sweep_identify_in_fov(tg)
			else
				try_identify(true) -- nearest-to-aim only (all-in-radius off, or fov assist off)
			end
		end
	end
end

local function install_key_hook()
	level_input = level_input or {}
	_prev_on_key_press = level_input.on_key_press
	level_input.on_key_press = function(key, action, disabled)
		local handled = false
		if _prev_on_key_press then
			local ok, res = pcall(_prev_on_key_press, key, action, disabled)
			if ok then
				handled = res
			end
		end
		if not disabled then
			local dik = active_dik()
			if dik and key == dik and modifiers_ok() then
				_trace.src = "key press"
				try_identify()
			end
		end
		return handled
	end
end

-- --------------------------------------------------------------------------
-- The tag dialog: a fixed pool of card widget-sets, positioned per frame.
-- Card layout (plate + accent bar + icon + header/name/rank text, joined to
-- a node dot on the target's body by a rotated leader line) mirrors
-- gamma-immersive-quest-markers' iqm_cards.xml / IqmCards:draw_slot
-- technique (see $HOME/code/lua/gamma-immersive-quest-markers).
-- --------------------------------------------------------------------------

-- Crooks style (ui_style 6): a static on-screen "[faction logo]  NAME" readout of the LAST
-- identified stalker, anchored to a screen corner. All in the 1024x768 virtual UI space.
-- style = the UI_STYLE_LIST index; margins = inset from the screen edges; gap = px between
-- the logo and the name; icon = logo size (square). Bundled into one table (local budget).
local CROOKS = { style = 6, margin_x = 34, margin_y = 40, gap = 10, icon = 26, rank_dy = 20 }
local COL_WHITE_PATCH = { 255, 255, 255 } -- reused tint for the Crooks emblem (no per-frame table)

-- The `---@class` annotation has to attach to an actual declaration, and
-- `class "IiTags" (CUIScriptWnd)` below is a bare function-call statement
-- (`class("IiTags")(CUIScriptWnd)`), not an assignment -- so this shadow
-- global exists purely for the type checker; the classlib call immediately
-- below is what actually registers the real class at runtime.
---@class IiTags : CUIScriptWnd
---@field xml CScriptXmlInit
---@field slots table[]
IiTags = {}

class("IiTags")(CUIScriptWnd)

function IiTags:__init()
	super()
	self:InitControls()
end

local MARKER = { unit_m = 0.03, max_scale = 4, card_node_max = 1.4 }

-- Project a camera-up metre to obtain scale from the same camera as the anchor.
-- Allow the sample off-screen so markers at the top edge retain their size.
local function mini_dist_scale_factor(pos, sy)
	local dev = _frame:camera()
	local top = dev and dev.cam_top
	local w2u = (game and game.world2ui) or (level and level.world2ui)
	if not top or not w2u then
		return 1
	end
	local ui = w2u(_v.marker_pt:set(pos.x + top.x, pos.y + top.y, pos.z + top.z), false, true)
	if not ui then
		return 1
	end
	return math.abs(ui.y - sy) * MARKER.unit_m
end

local _ui = ii_ui.install(IiTags, {
	config = C,
	position = P,
	size = S,
	max_tags = MAX_TAGS,
	debug_dots = DBG_DOTS,
	debug_texts = DBG_TEXTS,
	debug_info = DBG_INFO,
	crooks = CROOKS,
	marker = MARKER,
	neutral = COL_NEUTRAL,
	sign_colors = SIGN_COLOR,
})
local show, set_text = _ui.show, _ui.set_text
local place_fit, set_patch = _ui.place_fit, _ui.set_patch
local draw_shadowed_text = _ui.draw_shadowed_text

-- Target-assist debug visualiser (MCM "Debug draw"). Draws, in the 1024x768 virtual
-- UI space that world2ui + fov_radius already live in:
--   * the current aim point (aim_center) as a RED dot,
--   * the FOV target-assist ring (radius = fov_radius) as a YELLOW circle outline,
--   * dots on every body bone of each NPC/creature whose nearest body point is inside
--     the ring (a candidate) -- GREEN if within max_dist (would identify), RED if the
--     target is OUTSIDE max range (rejected for distance),
--   * the distance (metres) to each candidate as text on it,
--   * the radius value as text.
-- The test matches find_nearest_in_fov exactly (screen_dist_to_body vs fov_radius),
-- so what you see is precisely what the assist tests. Pure debug: gated on
-- C.debug_draw, iterates once per frame, dot/text pools reused (no per-frame alloc).
function IiTags:draw_debug()
	local d = self.dbg
	if not d then
		return
	end
	d._active = true
	local used = 0
	local used_t = 0
	-- Consume one pooled dot: centre (cx,cy) in virtual px, `size` px, colour a/r/g/b.
	-- UI_KX corrects the horizontal size so the dot stays round on any aspect (the
	-- CENTRE is raw virtual px, matching world2ui / the fov_radius comparison).
	local function dot(cx, cy, size, a, r, g, b)
		used = used + 1
		local w = d.dots[used]
		if not w then
			return false
		end
		local wx = math.max(2, math.floor(size * UI_KX + 0.5))
		w:SetWndSize(S(wx, size))
		w:SetWndPos(P(math.floor(cx - wx / 2), math.floor(cy - size / 2)))
		w:SetTextureColor(GetARGB(a, r, g, b))
		show(w, true)
		return used < DBG_DOTS
	end
	-- Consume one pooled text label at (cx,cy).
	local function label(cx, cy, str, a, r, g, b)
		used_t = used_t + 1
		local w = d.texts[used_t]
		if not w then
			return false
		end
		set_text(w, str)
		w:SetTextColor(GetARGB(a, r, g, b))
		w:SetWndPos(P(math.floor(cx), math.floor(cy)))
		show(w, true)
		return used_t < DBG_TEXTS
	end

	local cx, cy = aim_center()
	local radius = assist_radius() -- assist tolerance: a straight screen-px ring (zoom-shrunk)
	-- Use the EFFECTIVE max range (base * binoc/ADS boost, incl. scope magnification)
	-- so the green/red range colouring matches what would actually identify right now.
	local dbg_binoc, dbg_ads, _, eff_max = boost_params()
	local max_dist = eff_max or (C.max_dist or 50)
	local mag = scope_magnification()

	-- FOV ring outline (yellow). Raw virtual px on BOTH axes -- no UI_KX: fov_radius is
	-- Euclidean distance in the 1024x768 virtual space, so the true acceptance region
	-- really is this screen ellipse on a non-4:3 display, and the ring must show that.
	if d.ring then
		local rs = math.floor(2 * radius * DBG_RING.span + 0.5)
		if rs < 2 then -- fov_radius 0 (the MCM slider allows it): nothing to draw
			show(d.ring, false)
		else
			d.ring:SetWndSize(S(rs, rs))
			d.ring:SetWndPos(P(math.floor(cx - rs / 2), math.floor(cy - rs / 2)))
			d.ring:SetTextureColor(GetARGB(210, 255, 220, 40))
			show(d.ring, true)
		end
	end

	-- Bones of every entity inside the ring: GREEN if within max_dist (a real
	-- identify candidate), RED if beyond max range (rejected for distance). Scans a
	-- bit past max_dist so out-of-range candidates you're aiming at still show.
	-- Also collects the in-ring targets for the bottom-right info panel (name/dist/LOS).
	local fov_list = {}
	if db.actor and level and level.iterate_nearest then
		local apos = _frame:position(db.actor)
		local actor_id = db.actor:id()
		local scan = math.max(max_dist * 2, max_dist + 40)
		pcall(level.iterate_nearest, apos, scan, function(obj)
			if used >= DBG_DOTS then
				return true
			end
			if
				obj
				and obj:id() ~= actor_id
				and (safe_call(IsStalker, obj) or safe_call(IsMonster, obj))
				and safe_call(obj.alive, obj)
			then
				local sd = screen_dist_to_body(obj, cx, cy)
				if sd and sd <= radius then
					local base = obj:position()
					local dist = math.sqrt(apos:distance_to_sqr(base))
					local in_range = dist <= max_dist
					-- Green in range, red out of range.
					local cr, cg, cb = 235, 60, 70
					if in_range then
						cr, cg, cb = 60, 235, 70
					end
					fov_list[#fov_list + 1] = {
						obj = obj, -- kept for the gate/why-not evaluation in the info panel below
						name = safe_call(obj.character_name, obj) or safe_call(obj.name, obj) or "?",
						dist = dist,
						in_range = in_range,
						los = has_los(obj),
					}
					local drew = false
					local tx, ty -- label anchor: first projected bone
					for _, bone in ipairs(BODY_BONES) do
						local p = _frame:bone(obj, bone)
						if p and p:distance_to_sqr(base) < 16 then
							local sx, sy = project_world(p)
							if sx then
								drew = true
								tx, ty = tx or sx, ty or sy
								if not dot(sx, sy, 6, 200, cr, cg, cb) then
									break
								end
							end
						end
					end
					if not drew then -- monster / non-bip01 rig: the vertical-span fallback
						for _, lift in ipairs(MONSTER_SPAN) do
							local sx, sy = project_world(_v.body_pt:set(base.x, base.y + lift, base.z))
							if sx then
								tx, ty = tx or sx, ty or sy
								if not dot(sx, sy, 6, 200, cr, cg, cb) then
									break
								end
							end
						end
					end
					-- Distance label on the candidate (same colour as its dots).
					if tx then
						label(tx + 8, ty - 8, string.format("%.0fm", dist), 255, cr, cg, cb)
					end
				end
			end
			return false
		end)
	end

	-- Hide any unused pooled dots + labels.
	for i = used + 1, DBG_DOTS do
		show(d.dots[i], false)
	end
	for i = used_t + 1, DBG_TEXTS do
		show(d.texts[i], false)
	end

	-- Aim point (red), dedicated widget created last so it draws on top.
	if d.aim then
		local aw = math.max(2, math.floor(9 * UI_KX + 0.5))
		d.aim:SetWndSize(S(aw, 9))
		d.aim:SetWndPos(P(math.floor(cx - aw / 2), math.floor(cy - 9 / 2)))
		d.aim:SetTextureColor(GetARGB(255, 235, 40, 40))
		show(d.aim, true)
	end

	-- Radius value, just above the ring.
	if d.text then
		-- Shows the EFFECTIVE radius (what the ring above actually is); the configured value and
		-- the live magnification are appended whenever zoom has shrunk it, so the two are never
		-- confusable on screen.
		local set_r = C.fov_radius or 35
		if radius < set_r - 0.05 then
			d.text:SetText(string.format("fov_radius %.1f (%d / %.1fx)", radius, set_r, scope_magnification() or 1))
		else
			d.text:SetText(string.format("fov_radius %d", math.floor(set_r)))
		end
		d.text:SetTextColor(GetARGB(255, 255, 220, 40))
		d.text:SetWndPos(P(math.floor(cx + 6), math.floor(cy - radius - 18)))
		show(d.text, true)
	end

	-- Status line, under the radius. Shows the active mode, the RANGE multiplier that
	-- is actually applied (eff/base -- this is what widens the range, may differ from
	-- the optical zoom: binoculars use a flat binoc_range_mult unless binoc_zoom_scaling
	-- is on), and the optical `zoom` (informational -- the scope/binoc magnification).
	if d.status then
		local base = C.max_dist or 50
		local mode = dbg_binoc and "binoc" or (dbg_ads and "ADS" or "hip")
		local rmult = base > 0 and (max_dist / base) or 1
		local rtxt
		if math.abs(max_dist - base) < 0.5 then
			rtxt = string.format("range x1.0 (%dm)", math.floor(base))
		else
			rtxt = string.format("range x%.1f (%d -> %dm)", rmult, math.floor(base), math.floor(max_dist))
		end
		local ztxt = mag and string.format("zoom x%.1f", mag) or "zoom -"
		d.status:SetText(string.format("%s  %s  %s", mode, rtxt, ztxt))
		d.status:SetTextColor(GetARGB(255, 120, 220, 255))
		d.status:SetWndPos(P(math.floor(cx + 6), math.floor(cy - radius - 2)))
		show(d.status, true)
	end

	-- Bottom-right info panel: the aim-model raycast hit + its LOS, then the list of targets
	-- currently inside the FOV radius (name, distance, in-range?, LOS?). All from this frame's
	-- data, so it mirrors exactly what target acquisition sees right now.
	if d.info then
		local INFO_LEFT, INFO_BOTTOM, INFO_LH = 590, 744, 16
		local lines = {} -- { str, r, g, b }

		-- Aim-model mesh raycast (what the crosshair is directly ON) + its LOS. `see` is the engine
		-- AI-vision flag, shown for diagnostics ONLY -- it no longer gates LOS (LOS = mesh hit OR a
		-- clear geometric ray). So `see: NO` with `LOS: CONFIRMED` is expected: the player sees a
		-- target the AI vision (range/cone/light) doesn't.
		local aim_obj = aim_model_target(max_dist)

		-- Perf: cycles/sec of actor_on_update, plus the last cycle's mod-work time and the peak over
		-- the previous 1 s window (os.clock; may read 0 on a coarse clock but still flags spikes).
		lines[#lines + 1] = {
			string.format("cps %d  loop %.2fms (pk %.2f)", _trace.cps, _trace.loop_ms, _trace.loop_shown_peak),
			150,
			220,
			150,
		}

		-- Which auto triggers are enabled (why it would / wouldn't auto-identify without a keypress).
		local trg = {}
		if C.auto_identify then
			trg[#trg + 1] = "auto"
		end
		if C.hipfire_mode then
			trg[#trg + 1] = "hip"
		end
		if C.ads_mode then
			trg[#trg + 1] = "ads"
		end
		if C.binocular_mode then
			trg[#trg + 1] = "binoc"
		end
		if pda_focused() then
			lines[#lines + 1] = { "PDA focused: identification blocked", 255, 170, 60 }
		end

		lines[#lines + 1] =
			{ "triggers: " .. (#trg > 0 and table.concat(trg, ",") or "none (key only)"), 180, 180, 180 }

		-- WHY the last identification happened: trigger context + target + how long ago + scan time.
		if _trace.last_tg > 0 then
			local ln = _trace.last_name
			if #ln > 14 then
				ln = ln:sub(1, 14)
			end
			lines[#lines + 1] = {
				string.format(
					"last id: %s <- %s  %.1fs  %dms",
					ln,
					_trace.last_src,
					(time_global() - _trace.last_tg) / 1000,
					_trace.last_scan
				),
				200,
				200,
				120,
			}
		else
			lines[#lines + 1] = { "last id: (none yet)", 160, 160, 160 }
		end

		-- Full scan chain from the last commit. Changed factors get exact before/after timing;
		-- enabled factors that evaluated to x1 are grouped so the panel remains compact.
		if _trace.last_tg > 0 then
			local scan = _trace.scan
			local factors = scan.factors
			local neutral = {}
			local scan_mode = scan.tier
					and string.format("WD tier, penalties %d%%", math.floor((scan.penalty_scale or 1) * 100 + 0.5))
				or "standard"
			lines[#lines + 1] = {
				string.format("scan base: %dms (%s)", scan.base_ms, scan_mode),
				170,
				205,
				235,
			}
			local function add_factor(label, factor)
				if not factor.applied then
					return
				end
				local delta = factor.after_ms - factor.before_ms
				if delta == 0 then
					neutral[#neutral + 1] = label
					return
				end
				lines[#lines + 1] = {
					string.format(
						"%s x%.2f  %d>%d (%+dms)",
						label,
						factor.mult,
						factor.before_ms,
						factor.after_ms,
						delta
					),
					delta > 0 and 255 or 120,
					delta > 0 and 185 or 220,
					delta > 0 and 80 or 160,
				}
			end
			add_factor("distance", factors.dist)
			add_factor("rank", factors.rank)
			add_factor("weight", factors.weight)
			add_factor("foliage", factors.foliage)
			add_factor("target light", factors.night)
			if factors.night.source then
				local luminance = factors.night.luminance and string.format("%.2f", factors.night.luminance) or "n/a"
				local threshold = factors.night.threshold and string.format("/%.2f", factors.night.threshold) or ""
				local ignored = factors.night.ignored and (" ignored:" .. factors.night.ignored) or ""
				lines[#lines + 1] = {
					string.format(
						"light: %s%s dark:%d%% %s%s",
						luminance,
						threshold,
						math.floor((factors.night.severity or 0) * 100 + 0.5),
						factors.night.source,
						ignored
					),
					140,
					210,
					180,
				}
			end
			add_factor("aim", factors.aim)
			add_factor("perception", factors.perception)
			add_factor("combat", factors.combat)
			local combat = _trace.combat
			local combat_status = "combat: disabled"
			if combat.enabled and not combat.active then
				combat_status = "combat: calm"
			elseif combat.pressure then
				combat_status = string.format(
					"combat: %s pressure, %d enemies, %.1fs left",
					combat.source,
					combat.enemies,
					combat.remaining_ms / 1000
				)
			elseif combat.enemies > 0 then
				combat_status = string.format("combat: engaged, %d enemies", combat.enemies)
			elseif combat.active then
				combat_status = string.format("combat: lingering, %.1fs left", combat.inertia_ms / 1000)
			end
			lines[#lines + 1] = {
				combat_status,
				combat.pressure and 255 or (combat.active and 230 or 160),
				combat.pressure and 120 or (combat.active and 185 or 160),
				combat.active and 80 or 160,
			}

			-- Visibility sources overlap, so the strongest one sets a single multiplier.
			local w = _trace.weather
			local effects = {}
			if w.rain > 0 then
				effects[#effects + 1] = string.format("rain:%d%%", math.floor(w.rain * 100 + 0.5))
			end
			if w.storm > 0 then
				effects[#effects + 1] = string.format("storm:%d%%", math.floor(w.storm * 100 + 0.5))
			end
			if w.fog > 0 then
				effects[#effects + 1] = string.format("fog:%d%%", math.floor(w.fog * 100 + 0.5))
			end
			if w.visor > 0 then
				effects[#effects + 1] = string.format("visor:%d%%", math.floor(w.visor * 100 + 0.5))
			end
			local visibility_state = #effects > 0 and table.concat(effects, " ") or "clear"
			if not w.weather_enabled and not w.visor_enabled then
				visibility_state = "disabled"
			end
			lines[#lines + 1] = {
				"visibility: " .. visibility_state,
				#effects > 0 and 255 or 160,
				#effects > 0 and 185 or 160,
				#effects > 0 and 80 or 160,
			}
			local visor_status
			if not w.visor_enabled then
				visor_status = "visor drops: disabled"
			elseif not w.visor_mask then
				visor_status = "visor drops: no active mask"
			elseif not w.visor_available then
				visor_status = "visor drops: state unavailable (mask=yes)"
			else
				visor_status = string.format(
					"visor drops: %.3f (%d%%) threshold=%.2f penalty=%d%%",
					w.visor_raw,
					math.floor(w.visor_raw * 100 + 0.5),
					w.visor_threshold,
					math.floor(w.visor * 100 + 0.5)
				)
			end
			lines[#lines + 1] = { visor_status, w.visor > 0 and 255 or 160, w.visor > 0 and 185 or 160, 120 }

			local strongest_name, strongest = "rain", w.rain
			if w.storm > strongest then
				strongest_name, strongest = "storm", w.storm
			end
			if w.fog > strongest then
				strongest_name, strongest = "fog", w.fog
			end
			if w.visor > strongest then
				strongest_name, strongest = "visor", w.visor
			end
			if strongest <= 0 then
				strongest_name = "clear"
			end
			lines[#lines + 1] = {
				string.format(
					"weather max=%s x%.2f  %d>%d (%+dms)",
					strongest_name,
					w.mult,
					w.before_ms,
					w.after_ms,
					w.after_ms - w.before_ms
				),
				220,
				205,
				110,
			}

			add_factor("familiarity", factors.familiarity)
			add_factor("instant", factors.instant)
			if #neutral > 0 then
				lines[#lines + 1] = { "x1/no impact: " .. table.concat(neutral, ","), 145, 145, 145 }
			end
			if scan.tier then
				lines[#lines + 1] = { "WD skips dist/rank/weight/fol/aim/perc/fam/instant", 145, 145, 145 }
			end
			lines[#lines + 1] = { string.format("scan final: %dms", scan.final_ms), 210, 210, 120 }
		end

		-- WHY an identification IS / ISN'T happening for the best candidate right now: walk the same
		-- gates target acquisition applies and report the first blocker (or "eligible").
		local cand = aim_obj
		if not cand and #fov_list > 0 then
			table.sort(fov_list, function(a, b)
				return a.dist < b.dist
			end)
			cand = fov_list[1].obj
		end
		local why, wr, wg, wb = "eligible -> press key / auto", 90, 235, 110
		if not C.enabled then
			why, wr, wg, wb = "mod disabled", 235, 70, 70
		elseif C.require_binoculars and not is_binoc_active() and not tier_active() then
			why, wr, wg, wb = "needs binoculars (require_binoculars)", 235, 160, 60
		elseif not cand then
			why, wr, wg, wb = "no target on aim / in FOV", 235, 160, 60
		elseif tier_blocked() then
			why, wr, wg, wb = "scanner kit not worn (WD)", 235, 160, 60
		else
			local cid = cand:id()
			local cdist = math.sqrt(_frame:position(db.actor):distance_to_sqr(cand:position()))
			local comm = safe_call(cand.character_community, cand)
			if cdist > max_dist then
				why, wr, wg, wb =
					string.format("out of range (%dm > %dm)", math.floor(cdist), math.floor(max_dist)), 235, 160, 60
			elseif not safe_call(cand.alive, cand) then
				why, wr, wg, wb = "target not alive", 235, 160, 60
			elseif not (comm and comm ~= "") then
				why, wr, wg, wb = "no community (unidentifiable)", 235, 160, 60
			elseif not has_los(cand) then
				why, wr, wg, wb = "no LOS (see mesh/ray below)", 235, 70, 70
			elseif C.exclude_hostile and is_hostile_engaging(cand) then
				why, wr, wg, wb = "hostile & engaging (excluded)", 235, 120, 60
			elseif tracked[cid] then
				local e = tracked[cid]
				why, wr, wg, wb =
					string.format("already identified (%.1fs)", (time_global() - (e.last_seen_tg or e.t0)) / 1000),
					120,
					200,
					235
			end
		end
		lines[#lines + 1] = { "gate: " .. why, wr, wg, wb }

		if aim_obj then
			local an = safe_call(aim_obj.character_name, aim_obj) or safe_call(aim_obj.name, aim_obj) or "?"
			lines[#lines + 1] = { "mesh hit: " .. an, 90, 235, 110 }
			local seen = db.actor and (safe_call(db.actor.see, db.actor, aim_obj) ~= false) or false
			local ray = has_clear_ray(aim_obj)
			local los = has_los(aim_obj)
			-- First surface between the camera and the aimed target's head: material + transparency,
			-- so the foliage-block token list (_los.foliage) can be tuned against real material names.
			if _los.ray and _los.ray.get_result then
				local ddev = _frame:camera()
				local cam = ddev and ddev.cam_pos
				local hp = anchor_pos(aim_obj)
				if cam and hp then
					local ok2, mtxt = pcall(function()
						local dr = _v.aim_dir:set(cam.x - hp.x, cam.y - hp.y, cam.z - hp.z)
						local rng = dr:magnitude() - RAY_LOS_TOL
						dr:normalize()
						_los.ray:set_flags(RQT_STATIC)
						_los.ray:set_position(hp)
						_los.ray:set_direction(dr)
						_los.ray:set_range(rng)
						if not _los.ray:query() then
							return "front: (clear)"
						end
						local rr = _los.ray:get_result()
						local mn = (rr and rr.material_name) or "?"
						local tr = (rr and rr.material_vis_transparency_factor) or 0
						return string.format("front: %s t=%.2f", mn, tr)
					end)
					if ok2 and mtxt then
						lines[#lines + 1] = { "  " .. mtxt, 200, 190, 150 }
					end
				end
			end
			lines[#lines + 1] =
				{ "  see: " .. (seen and "yes" or "NO") .. "  ray: " .. (ray and "clear" or "blocked"), 150, 200, 235 }
			lines[#lines + 1] = {
				"  LOS: " .. (los and "CONFIRMED" or "blocked"),
				los and 90 or 235,
				los and 235 or 70,
				los and 110 or 70,
			}
		else
			lines[#lines + 1] = { "mesh hit: none", 180, 180, 180 }
		end

		lines[#lines + 1] = { string.format("in FOV radius: %d", #fov_list), 255, 220, 40 }
		table.sort(fov_list, function(a, b)
			return a.dist < b.dist
		end)
		for i = 1, #fov_list do
			local e = fov_list[i]
			local r, g, b = 60, 235, 70
			if not e.in_range then
				r, g, b = 235, 60, 70
			end
			local nm = e.name
			if #nm > 16 then
				nm = nm:sub(1, 16)
			end
			lines[#lines + 1] = {
				string.format(
					"%s %dm %s %s",
					nm,
					math.floor(e.dist + 0.5),
					e.in_range and "R" or "-",
					e.los and "LOS" or "los?"
				),
				r,
				g,
				b,
			}
		end

		-- Bottom-aligned: the block's LAST line sits at INFO_BOTTOM, earlier lines stack upward.
		local n = math.min(#lines, DBG_INFO)
		local top = INFO_BOTTOM - (n - 1) * INFO_LH
		for i = 1, n do
			local w = d.info[i]
			local ln = lines[i]
			w:SetText(ln[1])
			w:SetTextColor(GetARGB(255, ln[2], ln[3], ln[4]))
			w:SetWndPos(P(INFO_LEFT, top + (i - 1) * INFO_LH))
			show(w, true)
		end
		for i = n + 1, DBG_INFO do
			show(d.info[i], false)
		end
	end
end

-- --------------------------------------------------------------------------
-- Per-frame update
-- --------------------------------------------------------------------------
local function ensure_tags()
	if TAGS then
		return true
	end
	local hud = get_hud and get_hud()
	if not hud then
		return false
	end
	TAGS = IiTags()
	hud:AddDialogToRender(TAGS)
	return true
end

-- Overlap avoidance: two anchors this close together in screen space (px,
-- 1024x768 virtual space) would draw their cards on top of each other,
-- since both extend the same fixed offset in roughly the same direction
-- from their own anchor. STACK_STEP is how much further up each additional
-- overlapping card gets pushed -- the leader line just extends to reach it,
-- which is what stacks them cleanly instead of them sitting flush on the
-- same spot. Deliberately a proximity heuristic on the anchors themselves,
-- not real measured card-rect overlap: the actual plate width/height isn't
-- known until draw_slot measures the text, and gathering that up front
-- would mean either duplicating that measurement here or restructuring
-- draw_slot to run in two phases -- this is simpler and, since it only ever
-- misfires by stacking a pair that would narrowly NOT have overlapped, the
-- failure mode is "slightly more separated than strictly necessary", not a
-- visible collision.
local STACK_DIST_X, STACK_DIST_Y = 140, 90
local STACK_STEP = 58

-- hide_unseen: how long a target must stay continuously out of sight before its
-- tag is dropped. Small enough to feel instant, big enough to ride out a
-- one-frame ray flicker through a thin obstacle (see render's drop logic).
local HIDE_GRACE_MS = 150

-- Head box (screen bbox, 1024x768 virtual space) as cx,cy,hw,hh, or nil if it
-- doesn't project this frame. Head bone (lifted to the face centre) first, body
-- anchor for monsters without a bip01_head.
-- Returns the screen bbox (cx,cy,hw,hh,depth) PLUS the box's WORLD centre and
-- world half-extents (metres) -- the engine reprojects the latter through the
-- scope camera for the in-scope markers (a main-camera rect can't be reused there).
local function head_box_for(obj)
	local hc = head_center(obj) or anchor_pos(obj)
	if not hc then
		return nil
	end
	local cx, cy, hw, hh, depth = screen_box(hc, BOX_HALF_W, BOX_HALF_H)
	if not cx then
		return nil
	end
	return cx, cy, hw, hh, depth, hc.x, hc.y, hc.z, BOX_HALF_W, BOX_HALF_H
end

-- Full-body box: the screen-space bounding box of the actual body bones, so it
-- follows the physics RAGDOLL in any pose (a dead entity's obj:position() stays
-- at the last-alive/AI spot and does NOT track the ragdoll, which is why the old
-- position-based box floated where the target died -- bone_position tracks the
-- real model). Projects a spread of bip01 bones, takes their min/max screen
-- extent, and pads it out a little. Falls back to a vertical span at the origin
-- for monsters / rigs without these bones.
local BODY_BOX_BONES = {
	"bip01_head",
	"bip01_neck",
	"bip01_spine2",
	"bip01_spine1",
	"bip01_spine",
	"bip01_pelvis",
	"bip01_l_forearm",
	"bip01_r_forearm",
	"bip01_l_hand",
	"bip01_r_hand",
	"bip01_l_calf",
	"bip01_r_calf",
	"bip01_l_foot",
	"bip01_r_foot",
}
-- Reused world-AABB accumulator for body_box_for: a module-level scratch so the
-- per-frame box build allocates neither a table nor a closure (hot path). bbw_add
-- grows it; body_box_for resets _bbw.has = false at the start of each build.
local _bbw = { has = false, minx = 0, miny = 0, minz = 0, maxx = 0, maxy = 0, maxz = 0 }
local function bbw_add(px, py, pz)
	if not _bbw.has then
		_bbw.has = true
		_bbw.minx, _bbw.miny, _bbw.minz = px, py, pz
		_bbw.maxx, _bbw.maxy, _bbw.maxz = px, py, pz
		return
	end
	if px < _bbw.minx then
		_bbw.minx = px
	elseif px > _bbw.maxx then
		_bbw.maxx = px
	end
	if py < _bbw.miny then
		_bbw.miny = py
	elseif py > _bbw.maxy then
		_bbw.maxy = py
	end
	if pz < _bbw.minz then
		_bbw.minz = pz
	elseif pz > _bbw.maxz then
		_bbw.maxz = pz
	end
end
local function body_box_for(obj)
	local base = obj:position()
	local minx, miny, maxx, maxy
	-- World-space AABB of the same bones (in _bbw), for the in-scope reprojection.
	_bbw.has = false
	for _, bone in ipairs(BODY_BOX_BONES) do
		local p = _frame:bone(obj, bone)
		if p and p:distance_to_sqr(base) < 25 then -- sane bone (within 5 m of origin)
			local sx, sy = project_world(p)
			if sx then
				if not minx then
					minx, miny, maxx, maxy = sx, sy, sx, sy
				else
					if sx < minx then
						minx = sx
					elseif sx > maxx then
						maxx = sx
					end
					if sy < miny then
						miny = sy
					elseif sy > maxy then
						maxy = sy
					end
				end
				bbw_add(p.x, p.y, p.z)
			end
		end
	end

	if not minx then
		-- monster / non-bip01 rig: bound a vertical span at the origin instead.
		for _, lift in ipairs(MONSTER_SPAN) do
			local sx, sy = project_world(_v.bb_pt:set(base.x, base.y + lift, base.z))
			if sx then
				if not minx then
					minx, miny, maxx, maxy = sx, sy, sx, sy
				else
					if sx < minx then
						minx = sx
					elseif sx > maxx then
						maxx = sx
					end
					if sy < miny then
						miny = sy
					elseif sy > maxy then
						maxy = sy
					end
				end
				bbw_add(base.x, base.y + lift, base.z)
			end
		end
		if not minx then
			return nil
		end
	end

	local cx, cy = (minx + maxx) * 0.5, (miny + maxy) * 0.5
	-- Pad the tight bone bounds outward so the box encloses body thickness/limbs,
	-- not just the bone points: a fraction of each axis plus a small floor.
	local hw = (maxx - minx) * 0.5 + math.max(6, (maxx - minx) * 0.12)
	local hh = (maxy - miny) * 0.5 + math.max(6, (maxy - miny) * 0.10)
	if hw < 2 or hh < 2 then
		return nil
	end
	-- World centre + billboard half-extents from the bone AABB (horizontal =
	-- widest of the X/Z spans, vertical = Y span), padded a touch, for the
	-- in-scope reprojection. Falls back to a metric guess if no world data.
	local wcx, wcy, wcz, whw, whh
	if _bbw.has then
		wcx, wcy, wcz = (_bbw.minx + _bbw.maxx) * 0.5, (_bbw.miny + _bbw.maxy) * 0.5, (_bbw.minz + _bbw.maxz) * 0.5
		whw = math.max(_bbw.maxx - _bbw.minx, _bbw.maxz - _bbw.minz) * 0.5 + 0.1
		whh = (_bbw.maxy - _bbw.miny) * 0.5 + 0.1
	else
		wcx, wcy, wcz, whw, whh = base.x, base.y + 0.9, base.z, 0.45, 0.95
	end
	-- Depth for the shader mask: the chest anchor (ragdoll-tracking) is a good
	-- representative view-depth for the whole body box.
	return cx, cy, hw, hh, view_depth(anchor_pos(obj)), wcx, wcy, wcz, whw, whh
end

-- Head-only (area 1) or full-body (area 2) box for an object. Used by the bodycam
-- outline rectangle (box_area).
local function area_box_for(obj, area)
	if area == 2 then
		return body_box_for(obj)
	end
	return head_box_for(obj)
end

-- Crooks style (ui_style 6): the single static "FACTION | NAME" readout of the LAST
-- identified stalker, anchored to a screen corner (crooks_pos) and nudged by crooks_x/
-- crooks_y. Called every frame from render(); self-gates on the style + a valid _last_id.
-- Pure screen-space (no world anchor). Widths are re-measured only when the content changes.
function IiTags:draw_crooks()
	local ck = self.crooks
	if not ck then
		return
	end
	local name, icon, rank = _last_id.name, _last_id.icon, _last_id.rank
	-- Show the readout only while its target is still in the list. That single check covers both
	-- modes: normally the entry lives out its reveal window (scan+fade+hold+fade-out) = the
	-- linger; under hide_off_aim the entry is dropped the moment you aim away (see render's
	-- membership gate), so the readout follows the aim with no extra on_aim bookkeeping.
	if C.ui_style ~= CROOKS.style or not _last_id.id or not tracked[_last_id.id] or not (name and name ~= "") then
		self:hide_crooks()
		return
	end
	local has_rank = rank ~= nil and rank ~= "" -- already gated by C.show_rank at identify time

	-- Re-measure the name + (re)bind the faction emblem only when the content changes.
	local key = tostring(_last_id.id) .. "\0" .. tostring(icon) .. "\0" .. name .. "\0" .. tostring(rank)
	if ck.last ~= key then
		ck.last = key
		set_text(ck.name, name)
		set_text(ck.name_sh, name)
		ck.name:AdjustWidthToText()
		ck.name_sh:AdjustWidthToText()
		ck.nw = ck.name:GetWidth()
		if has_rank then
			set_text(ck.rank, rank)
			set_text(ck.rank_sh, rank)
			ck.rank:AdjustWidthToText()
			ck.rank_sh:AdjustWidthToText()
		end
		ck.has_icon = icon ~= nil and icon ~= ""
		if ck.has_icon then
			set_patch(ck, ck.icon, icon)
		end
	end

	-- Emblem box, scaled by the player's crooks_icon_scale. Reserve the width it will
	-- ACTUALLY occupy: it is drawn aspect-corrected, so reserving the uncorrected size left
	-- box*(1-kx) of dead space before the text (a 16.5 px gap instead of the intended 10 on
	-- 16:9). The gap is its own setting and is deliberately NOT scaled with the emblem -- it
	-- spaces the emblem from the text, not from itself, so it stays put as the emblem grows.
	local icon_box = CROOKS.icon * (C.crooks_icon_scale or 1)
	local icon_w = icon_box * C._ui_kx
	local icon_span = ck.has_icon and (icon_w + (C.crooks_icon_gap or CROOKS.gap)) or 0
	local total = icon_span + ck.nw
	local pos = C.crooks_pos or 1
	local start_x
	if pos == 2 then -- bottom middle
		start_x = UI_CX - total / 2
	elseif pos == 3 then -- bottom right
		start_x = 1024 - CROOKS.margin_x - total
	else -- bottom left
		start_x = CROOKS.margin_x
	end
	start_x = start_x + (C.crooks_x or 0)
	-- Anchor y is the NAME line's top; the rank line (if any) sits below, so lift the whole
	-- block up by the rank line's height to keep it inside the bottom margin.
	local y = 768 - CROOKS.margin_y - (C.crooks_y or 0) - (has_rank and CROOKS.rank_dy or 0)
	local text_x = math.floor(start_x + icon_span)
	if ck.has_icon then
		-- Centred on the WHOLE readout, not just the name line: with a rank line present the
		-- block runs y .. y + rank_dy + 16, and centring on the 18 px name alone left the
		-- emblem sitting visibly high beside it. FITTED, so the art keeps its proportions.
		local block_h = has_rank and (CROOKS.rank_dy + 16) or 18
		place_fit(
			ck.icon,
			start_x + icon_w / 2,
			y + block_h / 2,
			icon_box,
			icon_box,
			ck.icon_aspect,
			COL_WHITE_PATCH,
			255
		)
	else
		show(ck.icon, false)
	end
	draw_shadowed_text(ck.name, ck.name_sh, text_x, math.floor(y), 255, 235, 230, 220, 180)
	if has_rank then
		draw_shadowed_text(ck.rank, ck.rank_sh, text_x, math.floor(y + CROOKS.rank_dy), 255, 190, 180, 150, 170)
	else
		show(ck.rank, false)
		show(ck.rank_sh, false)
	end
end

function IiTags:hide_crooks()
	local ck = self.crooks
	if not ck then
		return
	end
	ck.last = nil
	show(ck.icon, false)
	show(ck.name, false)
	show(ck.name_sh, false)
	show(ck.rank, false)
	show(ck.rank_sh, false)
end

local function render(tg)
	if not TAGS then
		return
	end -- only ever called after ensure_tags() succeeds, but don't assume it

	-- Target-assist debug visualiser (independent of the tag/scope paths below, so
	-- it draws even when the HUD is suppressed / a scope is up).
	if C.debug_draw then
		TAGS:draw_debug()
	else
		TAGS:hide_debug()
	end

	-- Reading the PDA: identification is already blocked at every entry point (see pda_focused),
	-- and the existing tags go with it -- raising the PDA DROPS what was identified rather than
	-- leaving cards pinned to a world the player isn't looking at, so lowering it re-scans from
	-- scratch instead of restoring a stale set. Consistent with the dwell timers being disarmed
	-- rather than merely paused. Runs before the PiP block so the in-scope markers are cleared
	-- too: begin+commit publishes one EMPTY snapshot, otherwise the render thread keeps drawing
	-- the last scoped frame's markers for as long as the PDA is up.
	if pda_focused() then
		if _tracks.count > 0 then
			_tracks:clear()
		end
		TAGS:hide_crooks()
		for i = 1, MAX_TAGS do
			TAGS:hide_slot(i)
		end
		if PIP_AVAILABLE and not C.debug_sim_stock then
			svp_ui_markers_begin()
			svp_ui_markers_commit()
		end
		return
	end

	local apos = db.actor and _frame:position(db.actor)

	-- While a true PiP scope is actively raised, the normal card/dot (always
	-- projected through the MAIN camera) would be positioned against the
	-- wrong picture -- the magnified disc shows a different, narrower view
	-- via its own SVP camera entirely. So this path replaces the on-screen
	-- HUD with in-scope markers instead of drawing both (a misplaced main-
	-- view card floating next to a correctly placed in-scope dot would just
	-- read as broken, not additive). See svp_ui_markers_add()'s own comment
	-- for why the marker's position is submitted as a world point rather
	-- than pre-projected here: the render thread projects it fresh through
	-- this frame's own SVP camera, so there's no cross-thread staleness.
	-- pip_scope: a PiP scope is physically rendering (regardless of our toggles).
	-- pip_active: our in-scope UI path is on (pip_markers gates it) -- off = behave
	-- as if there were no PiP support (normal HUD, no in-scope markers).
	local pip_scope = PIP_AVAILABLE and not C.debug_sim_stock and is_svp_active()
	local pip_active = C.pip_markers and pip_scope
	-- Suppress ALL main-view tag drawing while aiming down sight (ads_hide_main) or
	-- while a scope is up (pip_hide_main). The in-scope UI is unaffected -- markers
	-- still publish. (pip_active already hides the main HUD on its own; this also
	-- covers the ADS-without-PiP and pip_markers-off cases.)
	local suppress_main = (C.ads_hide_main and is_ads_active()) or (C.pip_hide_main and pip_scope)
	-- OSD scanner mode: identification still runs (tracked/_last_id populated for the Promin
	-- ident page), but NO identification UI draws on entities -- neither the main-view tags
	-- nor the in-scope PiP markers.
	local osd_only = _tier ~= nil and _tier.active == true and _tier.osd_only == true
	-- Unconditional on PIP_AVAILABLE (not pip_active): runs every frame the
	-- engine supports it, scoped or not, so lowering the scope mid-reveal
	-- still publishes one more (empty) snapshot instead of leaving the last
	-- scoped frame's markers published indefinitely.
	if PIP_AVAILABLE and not C.debug_sim_stock then
		svp_ui_markers_begin()
	end

	-- First pass: resolve which targets are actually on-screen and drawable
	-- this frame (unchanged logic from before), collecting them instead of
	-- drawing immediately, so the second pass below can see every card's
	-- anchor at once before any of them are actually positioned.
	local draw_main = not (pip_active or suppress_main or osd_only or C.ui_style == CROOKS.style)
	for i = 1, MAX_TAGS do
		active_pool[i].active = false
	end

	_last_id.scan_frac = nil -- recomputed below: progress of any in-progress scan this frame

	-- Per-frame "what am I looking at" state, needed by hide_off_aim (membership gate) and the
	-- Crooks readout (which target's info to show). aim_model_id = the target whose MODEL the
	-- crosshair is directly on (mesh raycast) -- counts as aimed-at even when no BONE falls in
	-- fov_radius (tight radius / aiming between bones), matching how identification resolves it.
	local crooks_style = C.ui_style == CROOKS.style
	local need_aim = C.hide_off_aim or crooks_style
	local aim_cx, aim_cy, aim_model_id
	if need_aim then
		aim_cx, aim_cy = aim_center()
		local m = aim_model_target(1e6) -- any range; the tag's own max_dist gates identification
		aim_model_id = m and m:id() or nil
	end

	-- The LIVE effective identify range for this frame (base, plus whatever binocular / ADS /
	-- magnification boost applies right now). Drives the out-of-range drop below; per-instance
	-- e.max_dist stays the identify-time snapshot for everything else.
	-- The add-on style selected this frame, if any (nil for a built-in). Hoisted out of the
	-- per-target loop below: it feeds the distance-scaling and box-geometry opt-ins, both of
	-- which are per-target decisions driven by one per-frame fact.
	local api_def = ii_config.custom_style(C.ui_style)
	local _, _, _, live_max = boost_params()
	live_max = live_max or C.max_dist or 50

	for id, e in pairs(tracked) do
		-- Per-instance range/speed, captured at identify time in try_identify()
		-- (see the binocular-boost comment there) rather than read live from
		-- C here, so a tag identified at boosted range/speed keeps using
		-- that boost for its whole reveal even if the player lowers the
		-- binoculars partway through.
		local scan_ms = e.scan_ms or SCAN_MS
		local max_dist = e.max_dist or C.max_dist
		local fade_ms = e.fade_ms or FADE_MS
		local hold_ms = e.hold_ms or HOLD_MS
		local total = scan_ms + fade_ms + hold_ms + fade_ms

		local obj = level.object_by_id(id)
		local remove = not obj
		if obj then
			remove = not safe_call(obj.alive, obj) -- a tag is dropped the instant its target dies
		end

		local elapsed = tg - e.t0
		if not remove and elapsed > total then
			remove = true
		end

		-- Out of range: a tag whose target now sits beyond the CURRENT effective identify range is
		-- dropped, not left floating. e.max_dist above is deliberately the range snapshotted at
		-- identify time, so it can't notice the range shrinking under it -- the common case being
		-- magnification going away (scope lowered, binoculars down), which collapses the effective
		-- range by the whole zoom factor and would otherwise strand every distant tag you just
		-- earned. Also covers either party simply walking apart. Measured against the same live
		-- boost_params() range identification itself uses, so what stays tagged is exactly what
		-- could be re-acquired right now.
		if not remove and obj and apos then
			local tpos = _frame:position(obj)
			if tpos and tpos:distance_to(apos) > live_max then
				remove = true
			end
		end

		-- Is this target under the aim right now? A body point inside fov_radius OR the crosshair
		-- directly on the model (the same direct-hit case identification honours). Drives the
		-- hide_off_aim MEMBERSHIP gate here and the Crooks gaze re-point below. Only when needed.
		local under_aim = nil
		if not remove and need_aim and obj then
			local ad = screen_dist_to_body(obj, aim_cx, aim_cy)
			under_aim = (ad ~= nil and ad <= assist_radius()) or id == aim_model_id
		end
		-- hide_off_aim: aim AWAY = drop the target from the list (a membership gate, not a display
		-- gate). Aiming back finds it gone, so identification re-runs the whole scan from scratch
		-- rather than instantly reappearing. (The identify sources are aim-scoped too -- manual/
		-- dwell aim the target, and auto-identify skips off-aim ones -- so a dropped target isn't
		-- immediately re-added while you're still looking away.)
		if not remove and C.hide_off_aim and under_aim == false then
			remove = true
		end

		-- exclude_hostile: a target identified BEFORE combat that now turns hostile + engages you
		-- (you pulled aggro after identifying it) is dropped immediately -- consistent with never
		-- being able to acquire one. Only a handful of tracked targets, and only when the toggle's on.
		if not remove and obj and C.exclude_hostile and is_hostile_engaging(obj) then
			remove = true
		end

		-- Out of sight: drop the tag near-instantly rather than wait out its
		-- visibility timer (overrides the "stay visible after identify" hold).
		-- tag_visible is now geometric (see has_clear_ray), so it goes false the
		-- instant a wall interposes. A tiny debounce (HIDE_GRACE_MS) absorbs a
		-- single-frame ray flicker through a thin obstacle so the tag isn't lost
		-- for good on a blink; re-identify / auto-identify re-adds it regardless.
		if not remove and obj and C.hide_unseen then
			if tag_visible(obj) then
				e.unseen_since = nil
			else
				e.unseen_since = e.unseen_since or tg
				if tg - e.unseen_since >= HIDE_GRACE_MS then
					remove = true
				end
			end
		end

		if remove then
			_tracks:remove(id)
		else
			local phase_alpha, scanning, progress = _tracks:phase(e, tg, scan_ms, fade_ms, hold_ms)
			if progress and (not _last_id.scan_frac or progress > _last_id.scan_frac) then
				_last_id.scan_frac = progress
			end

			-- Publish this revealed target as the "last identified" for external readouts (the
			-- Promin OSD ident page + the Crooks HUD). Two triggers, both only once REVEALED:
			--   1. first scan COMPLETION (osd_done, once per target) -- keeps the previously-shown
			--      target until the new one finishes, so the readout respects scan time.
			--   2. Crooks: when you re-AIM at an already-identified target, re-point to it so the
			--      readout follows your gaze (Crooks draws only _last_id, no per-entity tag; the
			--      osd_done-only gate would otherwise leave it stuck on the last NEW scan).
			-- Fields come straight from the (already tier-gated) tracked entry.
			local capture = not scanning and (not e.osd_done or (crooks_style and under_aim and _last_id.id ~= id))
			-- First completion only: `capture` also fires on the Crooks re-aim path, and the
			-- warning is a "this target just resolved as hostile" cue, not a gaze follow.
			local first_reveal = capture and not e.osd_done
			local pos = (capture or draw_main or (pip_active and not osd_only)) and ui_anchor_pos(obj)
			if capture then
				e.osd_done = true
				_last_id.id = id
				_last_id.name, _last_id.faction = e.name, e.header
				_last_id.rank, _last_id.weap = e.rank, e.weap
				_last_id.rank_level = e.rank_level
				-- Same live pick as the per-entity tag above.
				_last_id.icon = (C.custom_patches and e.icon_custom) or e.icon
				_last_id.portrait = e.portrait
				_last_id.x = pos and pos.x or nil
				_last_id.y = pos and pos.y or nil
				_last_id.z = pos and pos.z or nil
			end

			-- Faction hostile warning. Gated on the WD scanner being what identified them --
			-- the audio ships with that component, so without it there is nothing to play.
			if first_reveal and C.wd_hostile_sound and tier_active() then
				play_hostile_sound(obj, e.comm)
			end

			local dist = apos and pos and pos:distance_to(apos) or 0

			-- (Off-aim targets under hide_off_aim, and out-of-sight ones under hide_unseen, are
			-- already dropped above -- so everything drawn here is a live, in-view, aimed target.)
			local sx, sy
			if draw_main or (pip_active and not osd_only) then
				sx, sy = project_world(pos)
			end
			if sx and dist <= max_dist * 1.15 then
				-- Fill = faction colour, ring = relation colour -- same
				-- two-signal split as the Minimal HUD style's dot+sign,
				-- adapted to what a flat shader shape can actually convey
				-- (see scope_custom_markers.h). While scanning, the shader
				-- draws a rotating spinner arc instead of fill+ring (there's
				-- no reveal to colour yet, same as the main HUD's spinner
				-- being plain white until the tag actually reveals) -- fill
				-- colour/alpha there only carries the spinner's own alpha
				-- (0.9, matching the HUD spinner's fixed GetARGB(230,...)),
				-- not phase_alpha, which is still 0 for the whole scan.
				if pip_active and not osd_only then
					local col, fcol = e.col, e.fcol
					local alpha = scanning and 0.9 or phase_alpha
					svp_ui_markers_add(
						pos.x,
						pos.y + PIP_MARKER.lift,
						pos.z,
						fcol[1] / 255,
						fcol[2] / 255,
						fcol[3] / 255,
						alpha,
						pip_marker_radius(dist),
						col[1] / 255,
						col[2] / 255,
						col[3] / 255,
						scanning
					)
				end

				if draw_main then
					local a = active_pool[e.slot]
					a.active = true
					-- User X/Y nudge (virtual px) for all on-screen UI elements.
					local off_x, off_y = C.ui_offset_x or 0, C.ui_offset_y or 0
					local scaling_style = (C.ui_style == 2 and C.mini_dist_scale)
						or C.ui_style == 4
						or C.ui_style == 5
						or C.ui_style == 7
						or C.ui_style == 8
						or (api_def ~= nil and api_def.dist_scale == true)
					local dscale = scaling_style and mini_dist_scale_factor(pos, sy) or 1
					if scaling_style then
						-- Offsets describe the billboard plane in reference units. Keep them
						-- attached even when the near-camera size limit caps the graphics.
						off_x, off_y = off_x * dscale * UI_KX, off_y * dscale
					end
					-- Distance-to-target readout (tier system's distance feature). LIVE (recomputed
					-- each frame), appended to the name line so it needs no extra widget; rounded to
					-- whole metres so the card's text-width cache only rebusts once per metre walked.
					-- Only the text styles (card/bodycam) draw the name line, so it shows only there.
					local nm = e.name
					if e.want_dist and dist then
						local metres = math.floor(dist + 0.5)
						if e.display_metres ~= metres then
							local text = string.format("%dm", metres)
							e.display_name = (nm and nm ~= "") and (nm .. "  " .. text) or text
							e.display_metres = metres
						end
						nm = e.display_name
					end
					a.hx, a.hy, a.header, a.name = sx + off_x, sy + off_y, e.header, nm
					a.a = math.floor(255 * phase_alpha + 0.5)
					-- Patch id picked HERE, not at identify time, so the custom_patches toggle applies
					-- to tags already on screen. Both strings were built once per identify.
					a.col, a.scanning = e.col, scanning
					a.icon = (C.custom_patches and e.icon_custom) or e.icon
					if scaling_style then
						a.scale = C.card_scale * math.min(dscale, MARKER.max_scale)
					else
						a.scale = C.card_scale
					end
					-- Metres to the target, and its engine id. Neither is used by a built-in style; both
					-- are here for add-on styles (ii_api), which otherwise cannot fade by range, show a
					-- distance, or look anything up about the target -- `dist` is already computed above.
					a.dist, a.id = dist, id
					a.rank = e.rank
					a.rank_col = e.rank_col
					a.fcol, a.sign = e.fcol, e.sign
					a.weap = e.weap

					-- Bodycam style, and any add-on style opting in with want_box: precompute the
					-- outline box's screen centre and distance-scaled half-extents here (draw_slot
					-- has no world access), head-only or full-body per box_area. Cleared otherwise,
					-- since active_pool entries are reused and would carry stale extents.
					if C.ui_style == 3 or (api_def and api_def.want_box) then
						local bcx, bcy, bhw, bhh, _, bwx, bwy, bwz = area_box_for(obj, C.box_area or 1)
						if bcx then
							-- Loosen the box off the model by box_padding (a fraction of
							-- its size, so it stays proportional at any distance).
							local bp = 1 + (C.box_padding or 0)
							a.box_cx, a.box_cy = bcx + off_x, bcy + off_y
							a.box_hw, a.box_hh = bhw * bp, bhh * bp
							-- World anchor for depth-aware overlay drawing (engine occlusion).
							a.box_wx, a.box_wy, a.box_wz = bwx, bwy, bwz
						else
							a.box_cx, a.box_cy, a.box_hw, a.box_hh = nil, nil, nil, nil
							a.box_wx, a.box_wy, a.box_wz = nil, nil, nil
						end
					else
						a.box_hw, a.box_hh = nil, nil
					end
				end
			end
		end
	end

	-- Snapshot published every frame PIP_AVAILABLE (even with zero markers,
	-- and even when not currently scoped -- see begin() above): without
	-- this, the last scoped frame's markers would otherwise linger
	-- published forever once tracked drains out, or once the scope lowers.
	if PIP_AVAILABLE and not C.debug_sim_stock then
		svp_ui_markers_commit()
	end

	if pip_active or suppress_main or osd_only then
		TAGS:hide_crooks()
		for i = 1, MAX_TAGS do
			TAGS:hide_slot(i)
		end
		return
	end

	for i = 1, MAX_TAGS do
		local a = active_pool[i]
		if a.active then
			local stack = 0
			if C.ui_style == 1 and not a.scanning and a.scale >= C.mini_scale_cutoff then
				for j = 1, i - 1 do
					local previous = active_pool[j]
					if
						previous.active
						and not previous.scanning
						and previous.scale >= C.mini_scale_cutoff
						and math.abs(a.hx - previous.hx) < STACK_DIST_X
						and math.abs(a.hy - previous.hy) < STACK_DIST_Y
					then
						stack = stack + 1
					end
				end
			end
			a.stack_offset = stack * STACK_STEP
			TAGS:draw_slot(i, a, tg)
		else
			TAGS:hide_slot(i)
		end
	end

	-- Crooks style: the single static "last identified" readout (self-gates / hides itself
	-- when the style is off or there's nothing identified yet).
	TAGS:draw_crooks()
end

-- Tear down every UI element the mod has drawn: hide all tag slots and drop the
-- active reveals.
local function teardown_ui()
	if TAGS then
		for i = 1, MAX_TAGS do
			TAGS:hide_slot(i)
		end
		TAGS:hide_debug()
		TAGS:hide_crooks()
	end
	_tracks:clear()
end

-- When the ADS range boost ends (you zoom out / lower the sight), the effective identify range
-- snaps back from the extended (ads_range_mult) range to the base. Survivors are re-snapshotted to
-- that base range so their per-instance e.max_dist -- and the draw gate that reads it -- stay
-- coherent with what is actually identifiable now. Fires only on the ADS-boost active->inactive edge.
--
-- DROPPING the tags that no longer fit is not this function's job: render's per-frame out-of-range
-- check owns that, continuously and for every cause (boost released, magnification lost, either
-- party walking away), which is also why binoculars need no special case here any more.
local function update_ads_range_snapshot()
	local _, ads, _, eff_max_dist = boost_params()
	local ads_boost = ads and C.ads_boost
	if _ZOOMCFG.was_boost and not ads_boost then
		for _, e in pairs(tracked) do
			e.max_dist = eff_max_dist
		end
	end
	_ZOOMCFG.was_boost = ads_boost
end

-- Binoculars lowered: optionally wipe every identified tag (binoc_clear_on_lower, off by default).
-- Narrower than it sounds now that render culls out-of-range tags continuously: lowering the
-- binoculars already collapses the effective range by the zoom factor, so everything you glassed
-- BEYOND base range goes on its own. What this option adds is the rest -- the targets still inside
-- base range, which would otherwise keep their tags. On = glassing is strictly live observation:
-- the whole set goes the moment the optic leaves your eyes, near targets included.
--
-- Fires on the active->inactive EDGE only (one boolean compare on every other frame), and
-- updates was_binoc unconditionally so toggling the option mid-glass can't strand a stale edge.
local function update_binoc_clear()
	local binoc = is_binoc_active()
	if _ZOOMCFG.was_binoc and not binoc and C.binoc_clear_on_lower and _tracks.count > 0 then
		_tracks:clear()
	end
	_ZOOMCFG.was_binoc = binoc
end

local function actor_on_update()
	-- Debug perf: count this cycle; every 1 s window roll the frame tally into CPS and publish the
	-- window's peak loop time. Runs every call (including early-return frames) so CPS is honest.
	_trace.frames = _trace.frames + 1
	local _tnow = time_global()
	_frame:begin(_tnow)
	---@diagnostic disable-next-line: undefined-global
	ii_combat.update(_tnow)
	if _tnow - _trace.sec_start >= 1000 then
		_trace.cps = _trace.frames
		_trace.frames = 0
		_trace.loop_shown_peak = _trace.loop_peak
		_trace.loop_peak = 0
		_trace.sec_start = _tnow
	end
	-- Wall-clock start of this cycle's mod work (only when debug draw is on, to avoid the os.clock
	-- calls otherwise). os.clock may be coarse on some builds -- peak/last still flag spikes.
	local _c0 = (C.debug_draw and os and os.clock) and os.clock() or nil

	update_fov_baseline() -- keep this warm even while the mod is disabled

	-- Snapshot the optional external tier system (WD compat) once for this frame. Every
	-- override point reads _tier; nil = the addon isn't driving us -> normal behaviour.
	-- wd_ignore is a master toggle: skip the provider entirely so the mod runs exactly as
	-- if the Wearable Devices compat component were never installed (plain identification).
	if tier_provider and not C.wd_ignore then
		local ok, r = pcall(tier_provider)
		_tier = (ok and type(r) == "table") and r or nil
	else
		_tier = nil
	end

	-- Actor death: clear everything we drew so no tag or box lingers on
	-- the death screen. Polled here (idempotent); also fires if the actor object
	-- is momentarily absent.
	if not db.actor or not safe_call(db.actor.alive, db.actor) then
		teardown_ui()
		reset_steady()
		_frame:finish()
		return
	end

	if not C.enabled then
		if TAGS then
			for i = 1, MAX_TAGS do
				TAGS:hide_slot(i)
			end
			TAGS:hide_crooks()
		end
		reset_steady()
		_frame:finish()
		return
	end
	if not ensure_tags() then
		_frame:finish()
		return
	end
	local tg = time_global()
	update_binocular_scan(tg)
	update_auto_identify(tg)
	update_ads_range_snapshot()
	update_binoc_clear()
	update_loot_xp()
	render(tg)
	_frame:finish()

	if _c0 then
		local ms = (os.clock() - _c0) * 1000
		_trace.loop_ms = ms
		if ms > _trace.loop_peak then
			_trace.loop_peak = ms
		end
	end
end

-- --------------------------------------------------------------------------
-- Save/load: persists xp_awarded, remembered, and loot_xp_awarded only (tracked is transient
-- reveal state, deliberately not saved -- an active scan/reveal just
-- restarts clean after a load, same as it would after walking out of range
-- and back). Declared `local` rather than a bare global specifically to
-- avoid colliding with other scripts' own same-named save_state/load_state
-- globals (e.g. haru_skills.script defines its own): RegisterScriptCallback
-- is a proper multi-subscriber event bus (every mod's registered save_state
-- fires, none overwrite each other), unlike this engine's single-slot
-- native set_callback, so there's no need for -- and no benefit to -- a
-- global here.
-- --------------------------------------------------------------------------
local function save_state(m_data)
	m_data.ii_xp_awarded = xp_awarded
	m_data.ii_remembered = remembered
	m_data.ii_loot_xp_awarded = loot_xp_awarded
end

local function load_state(m_data)
	xp_awarded = m_data.ii_xp_awarded or {}
	remembered = m_data.ii_remembered or {}
	loot_xp_awarded = m_data.ii_loot_xp_awarded or {}
end

-- --------------------------------------------------------------------------
-- MCM live-apply + startup (on_mcm_load lives in ii_mcm.script)
-- --------------------------------------------------------------------------
function on_option_change()
	read_config()
end

-- Actor death: tear everything down at the MOMENT of death. actor_on_update's
-- own death poll isn't enough on its own -- the death screen can freeze updates
-- with the last frame's tags still drawn -- so this fires right before death to
-- blank them immediately. Multi-subscriber bus, so it never clobbers other mods'
-- handlers. Declared local to avoid a global name collision.
local function actor_on_before_death()
	teardown_ui()
	reset_steady()
end

function on_game_start()
	read_config()
	install_key_hook()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	---@diagnostic disable-next-line: undefined-global
	RegisterScriptCallback("actor_on_hit_callback", ii_combat.on_actor_hit)
	---@diagnostic disable-next-line: undefined-global
	pcall(RegisterScriptCallback, "bullet_on_update", ii_combat.on_bullet_update)
	-- Stock weapon-zoom callbacks -> ADS flag (see _ZOOMCFG.zoomed / is_ads_active). Anonymous
	-- handlers so they add no top-level locals (Lua 5.1's 200-per-chunk limit).
	RegisterScriptCallback("actor_on_weapon_zoom_in", function()
		_ZOOMCFG.zoomed = true
		-- Remember WHICH weapon zoomed, so is_ads_active can detect a later weapon switch that the
		-- engine forgot to emit a zoom_out for (else the flag sticks and hipfire reads as ADS).
		local it = db.actor and _frame:active_item()
		_ZOOMCFG.zoom_item = (it and safe_call(it.id, it)) or false
	end)
	RegisterScriptCallback("actor_on_weapon_zoom_out", function()
		_ZOOMCFG.zoomed = false
		_ZOOMCFG.zoom_item = false
	end)
end
