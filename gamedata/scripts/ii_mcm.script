-- ======================================================================
--  Immersive Identification: MCM menu
-- ======================================================================
--  MCM only discovers on_mcm_load in scripts whose filename ends in
--  "mcm.script", so the menu lives here. The logic lives in
--  ii_identify.script; defaults/modifier list come from ii_identify.DEFAULTS
--  / ii_identify.MODIFIER_LIST so there is a single source of truth.
-- ======================================================================

function on_mcm_load()
	local d = ii_identify and ii_identify.DEFAULTS or {}

	local modifier_content = {}
	if ii_identify and ii_identify.MODIFIER_LIST then
		for idx, e in ipairs(ii_identify.MODIFIER_LIST) do
			modifier_content[#modifier_content + 1] = { idx, e.label }
		end
	end

	-- Default DIK for the key-capture widget below: resolved here (not in
	-- DEFAULTS, since DIK_keys isn't ready when ii_identify.script is first
	-- parsed) from ii_identify.DEFAULT_KEY_NAME, the single source of truth.
	local default_key_name = (ii_identify and ii_identify.DEFAULT_KEY_NAME) or "DIK_X"
	local default_key_dik = (DIK_keys and DIK_keys[default_key_name]) or 0

	-- `text` is used literally as the string-table id. `hint` (the caption
	-- shown next to each control) gets "ui_mcm_" auto-prepended by MCM, so it
	-- must be passed bare (e.g. "ii_enabled_desc", resolving to the real id
	-- "ui_mcm_ii_enabled_desc" in st_ii_texts.xml) — passing the full id here
	-- double-prefixes it and shows the raw unresolved id in-game instead.
	local function opt_title(text)
		return { id = "title", type = "slide", text = text, size = { 512, 50 }, spacing = 20 }
	end
	local function opt_check(id)
		return { id = id, type = "check", val = 1, def = d[id],
			text = "ui_mcm_ii_" .. id, hint = "ii_" .. id .. "_desc" }
	end
	local function opt_track(id, min, max, step, prec)
		return { id = id, type = "track", val = 2, min = min, max = max, step = step, prec = prec, def = d[id],
			text = "ui_mcm_ii_" .. id, hint = "ii_" .. id .. "_desc" }
	end

	-- The top-level node must NOT carry sh (sh marks a leaf PAGE whose gr holds
	-- actual options; a folder of pages is a plain node whose children carry
	-- sh). One page ("main") is enough here, but the wrapper is still required
	-- or MCM's option-tree walker recurses into these entries looking for a
	-- gr of their own and crashes on the first real option (nil "gr").
	return {
		id = "ii", gr = {
			{ id = "main", sh = true, gr = {
				opt_title("ui_mcm_ii_title"),

				opt_check("enabled"),

				-- Click into the box, then press a keyboard/mouse key to bind it.
				-- type = "key_bind", val = 2 -- confirmed schema.
				{ id = "key_dik", type = "key_bind", val = 2, def = default_key_dik,
					text = "ui_mcm_ii_key", hint = "ii_key_desc" },

				{ id = "modifier_index", type = "list", val = 2, def = d.modifier_index, content = modifier_content,
					text = "ui_mcm_ii_modifier", hint = "ii_modifier_desc" },

				opt_check("color_by_relation"),
				opt_track("scan_time", 0, 2, 0.05, 2),
				opt_track("fade_time", 0.1, 2, 0.05, 2),
				opt_track("hold_time", 1, 15, 0.5, 1),
				opt_track("max_dist", 10, 500, 10),
				opt_track("fade_dist", 5, 500, 10),
				opt_track("fov_radius", 20, 400, 10),
				opt_check("require_los"),
				opt_check("binocular_mode"),
				opt_track("steady_time", 0.2, 3, 0.1, 1),

				opt_title("ui_mcm_ii_binoc_title"),
				opt_check("binoc_boost"),
				opt_track("binoc_scan_mult", 0.1, 1, 0.05, 2),
				opt_track("binoc_range_mult", 1, 5, 0.1, 1),

				opt_title("ui_mcm_ii_distance_scaling_title"),
				opt_track("card_scale", 0.5, 2, 0.05, 2),
				opt_track("mini_scale_cutoff", 0.1, 1, 0.05, 2),

				opt_title("ui_mcm_ii_dist_penalty_title"),
				opt_check("dist_penalty"),
				opt_track("dist_penalty_max", 1, 6, 0.1, 1),

				opt_title("ui_mcm_ii_rank_penalty_title"),
				opt_check("rank_penalty"),
				opt_track("rank_penalty_max", 1, 6, 0.1, 1),

				opt_title("ui_mcm_ii_familiarity_title"),
				opt_check("familiarity_boost"),
				opt_track("familiarity_scan_mult", 0.1, 1, 0.05, 2),

				opt_title("ui_mcm_ii_perception_title"),
				opt_check("perception_compat"),
				opt_track("perception_scan_mult", 0, 0.1, 0.01, 2),
				opt_track("perception_xp", 0, 100, 5),
			}},
		}
	}
end
