-- ======================================================================
--  Immersive Identification: MCM menu
-- ======================================================================
--  MCM only discovers on_mcm_load in scripts whose filename ends in
--  "mcm.script", so the menu lives here. The logic lives in
--  ii_identify.script; defaults/modifier list come from ii_identify.DEFAULTS
--  / ii_identify.MODIFIER_LIST so there is a single source of truth.
-- ======================================================================

function on_mcm_load()
	local d = ii_identify and ii_identify.DEFAULTS or {}

	local modifier_content = {}
	if ii_identify and ii_identify.MODIFIER_LIST then
		for idx, e in ipairs(ii_identify.MODIFIER_LIST) do
			modifier_content[#modifier_content + 1] = { idx, e.label }
		end
	end

	-- Built-ins plus whatever add-ons registered through ii_api (ii_config.style_list), so a
	-- third-party style appears in this dropdown without touching this file. Each entry's
	-- label is the string-table suffix MCM resolves -- an add-on ships its own
	-- ii_uistyle_general_ui_style_lst_<id> string.
	local ui_style_content = {}
	local style_list = ii_config and ii_config.style_list and ii_config.style_list()
		or (ii_identify and ii_identify.UI_STYLE_LIST)
	if style_list then
		for idx, e in ipairs(style_list) do
			ui_style_content[#ui_style_content + 1] = { idx, e.label }
		end
	end

	local crooks_pos_content = {}
	if ii_identify and ii_identify.CROOKS_POS_LIST then
		for idx, e in ipairs(ii_identify.CROOKS_POS_LIST) do
			crooks_pos_content[#crooks_pos_content + 1] = { idx, e.label }
		end
	end

	local anchor_basis_content = {}
	if ii_identify and ii_identify.ANCHOR_BASIS_LIST then
		for idx, e in ipairs(ii_identify.ANCHOR_BASIS_LIST) do
			anchor_basis_content[#anchor_basis_content + 1] = { idx, e.label }
		end
	end

	local redact_area_content = {}
	if ii_identify and ii_identify.REDACT_AREA_LIST then
		for idx, e in ipairs(ii_identify.REDACT_AREA_LIST) do
			redact_area_content[#redact_area_content + 1] = { idx, e.label }
		end
	end

	local box_color_source_content = {}
	if ii_identify and ii_identify.BOX_COLOR_SOURCE_LIST then
		for idx, e in ipairs(ii_identify.BOX_COLOR_SOURCE_LIST) do
			box_color_source_content[#box_color_source_content + 1] = { idx, e.label }
		end
	end

	-- Default DIK for the key-capture widget below: resolved here (not in
	-- DEFAULTS, since DIK_keys isn't ready when ii_identify.script is first
	-- parsed) from ii_identify.DEFAULT_KEY_NAME, the single source of truth.
	local default_key_name = (ii_identify and ii_identify.DEFAULT_KEY_NAME) or "DIK_X"
	local default_key_dik = (DIK_keys and DIK_keys[default_key_name]) or 0

	-- MCM (see ui_mcm.script) resolves an option's CAPTION from
	-- "ui_mcm_" .. hint and its HOVER TOOLTIP from "ui_mcm_" .. hint .. "_desc".
	-- So `hint` is the BARE base id (e.g. "ii_enabled") -- NOT suffixed with
	-- "_desc": suffixing it makes the long description show AS the caption and
	-- leaves no tooltip to resolve. `text` is only read for slide/title headers
	-- (a literal string id), not for the caption of check/track/list controls.
	local function opt_title(text)
		return { id = "title", type = "slide", text = text, size = { 512, 50 }, spacing = 20 }
	end
	local function opt_check(id)
		return { id = id, type = "check", val = 1, def = d[id], hint = "ii_" .. id }
	end
	-- `hint_override` lets many options share one caption string (e.g. every colour's
	-- R/G/B sliders resolve to the same "Red"/"Green"/"Blue" label); the option `id`
	-- stays unique for storage. Defaults to the "ii_<id>" convention otherwise.
	local function opt_track(id, min, max, step, prec, hint_override)
		return {
			id = id,
			type = "track",
			val = 2,
			min = min,
			max = max,
			step = step,
			prec = prec,
			def = d[id],
			hint = hint_override or ("ii_" .. id),
		}
	end
	local function opt_list(id, content)
		return { id = id, type = "list", val = 2, def = d[id], content = content, hint = "ii_" .. id }
	end

	-- The top-level node must NOT carry sh (sh marks a leaf PAGE whose gr holds the
	-- actual options; a folder of pages is a plain node whose children carry sh, or
	-- MCM's tree walker crashes on "attempt to get length of field 'gr'"). Each SECTION
	-- below is now its own leaf page -> its own tab (tab label = ui_mcm_menu_<page id>).
	-- Because an option's MCM storage path is "<top>/<page>/<id>", every option lives
	-- under "ii/<section>/<id>" now (NOT "ii/main/..."): read_config resolves that by
	-- trying each page (see MCM_PAGES there), and presets_ii.ltx paths match these ids.
	local function page(id, gr, precondition)
		return { id = id, sh = true, gr = gr, precondition = precondition }
	end

	-- The Wearable Devices page is hidden entirely unless the optional WD compat FOMOD
	-- component is installed. Without it, tier_provider is never set and every wd_* option is
	-- inert, so the page would just be confusing dead settings. MCM evaluates this precondition
	-- when rendering the tree -- INCLUDING in the main menu, where only *_mcm scripts are loaded.
	-- So detect via the component's shipped system-ltx section ([ii_wd_antenna]): the merged
	-- system ini is built at engine start and present both in the menu and in-game, no side
	-- effects. (rawget(_G,"ii_wd_compat") was wrong -- it bypasses X-ray's script auto-load AND
	-- the gameplay driver isn't loaded in the menu, so the page rendered empty there.)
	local wd_installed = {
		function()
			if ini_sys then
				return ini_sys:section_exist("ii_wd_antenna")
			end
			-- ini_sys not ready (rare): fall back to a non-raw access that auto-loads the driver.
			local ok, mod = pcall(function()
				---@diagnostic disable-next-line: undefined-field
				return _G.ii_wd_compat
			end)
			return ok and mod ~= nil
		end,
	}

	local tree = {
		id = "ii",
		gr = {
			-- General carries the preset dropdown (`presets` on a leaf page). A preset
			-- applies values across EVERY page by storage path, not just this one; entries
			-- are section ids in presets_ii.ltx, named by ui_mcm_prst_<id> strings.
			{
				id = "general",
				sh = true,
				presets = { "ii_default", "ii_card", "ii_minimal", "ii_bodycam", "ii_immersive", "ii_crooks" },
				gr = {
					opt_title("ui_mcm_ii_general_title"),
					opt_check("enabled"),
					-- Click into the box, then press a keyboard/mouse key to bind it.
					{ id = "key_dik", type = "key_bind", val = 2, def = default_key_dik, hint = "ii_key" },
					opt_list("modifier_index", modifier_content),
					opt_check("instant_identify"),
					opt_track("scan_time", 0, 2, 0.05, 2),
					opt_track("fade_time", 0, 2, 0.05, 2),
					opt_track("hold_time", 1, 15, 0.5, 1),
					opt_check("hide_unseen"),
					opt_track("max_dist", 10, 250, 5),
				},
			},
			-- UI Style is a CONTAINER (no `sh`), so MCM shows its sub-pages (General/Card/Simple/Bodycam/
			-- Crooks/Patch) in the third column. A container can hold NO options directly (MCM only
			-- codes options on sh=true nodes), so the general options live in the "general" sub-page.
			-- Option storage paths become ii/uistyle/<sub>/<key> -- kept in sync in MCM_PAGES +
			-- presets_ii.ltx.
			{
				id = "uistyle",
				gr = {
					page("general", {
						opt_title("ui_mcm_ii_uistyle_title"),
						opt_list("ui_style", ui_style_content),
						opt_check("show_name"),
						opt_check("show_faction"),
						opt_check("show_rank"),
						opt_check("show_relation"),
						opt_check("custom_patches"),
						opt_check("show_weapon"),
						opt_check("color_by_relation"),
						opt_check("mini_dist_scale"),
						opt_track("ui_offset_x", -200, 200, 5),
						opt_track("ui_offset_y", -200, 200, 5),
						opt_list("anchor_basis", anchor_basis_content),
					}),
					page("card", {
						opt_title("ui_mcm_ii_card_title"),
						opt_track("card_scale", 0.5, 2, 0.05, 2),
						opt_track("card_icon_scale", 0.5, 3, 0.05, 2),
						opt_track("mini_scale_cutoff", 0.1, 1, 0.05, 2),
					}),
					page("simple", {
						opt_title("ui_mcm_ii_simple_title"),
						opt_track("simple_icon_scale", 0.5, 3, 0.05, 2),
					}),
					page("bodycam", {
						opt_title("ui_mcm_ii_bodycam_title"),
						opt_list("box_area", redact_area_content),
						opt_list("box_color_source", box_color_source_content),
						opt_track("box_thickness", 1, 6, 0.5, 1),
						opt_track("box_padding", 0, 1, 0.05, 2),
						opt_track("box_opacity", 0.1, 1, 0.05, 2),
						opt_track("box_text_gap", 0, 40, 1, 0),
					}),
					page("crooks", {
						opt_title("ui_mcm_ii_crooks_title"),
						opt_list("crooks_pos", crooks_pos_content),
						opt_track("crooks_x", -500, 500, 5, 0),
						opt_track("crooks_y", -100, 700, 5, 0),
						opt_track("crooks_icon_scale", 0.5, 3, 0.05, 2),
						opt_track("crooks_icon_gap", 0, 40, 1, 0),
					}),
					page("patch", {
						opt_title("ui_mcm_ii_patch_title"),
						opt_track("patch_size", 8, 64, 1, 0),
						opt_track("patch_thickness", 0, 5, 0.5, 1),
						opt_track("patch_padding", 0, 12, 0.5, 1),
					}),
				},
			},
			page("targeting", {
				opt_title("ui_mcm_ii_targeting_title"),
				opt_check("fov_assist"),
				opt_check("freeaim_assist"),
				opt_track("fov_radius", 0, 90, 5),
				opt_check("fov_zoom_scaling"),
				opt_check("fov_identify_all"),
				opt_check("require_los"),
				opt_check("los_block_seethrough"),
				opt_check("los_block_foliage"),
				opt_check("exclude_hostile"),
				opt_check("hide_off_aim"),
				opt_check("auto_identify"),
			}),
			page("hipfire", {
				opt_title("ui_mcm_ii_hipfire_title"),
				opt_check("hipfire_mode"),
				opt_track("hipfire_hold_time", 0, 3, 0.1, 1),
				opt_check("instant_exclude_hipfire"),
				opt_track("hipfire_max_dist", 0, 1000, 5),
			}),
			page("binoc", {
				opt_title("ui_mcm_ii_binoc_title"),
				opt_check("binocular_mode"),
				opt_check("require_binoculars"),
				opt_track("steady_time", 0, 3, 0.1, 1),
				opt_check("fov_assist_binoc"),
				opt_check("binoc_boost"),
				opt_track("binoc_scan_mult", 0.1, 1, 0.05, 2),
				opt_track("binoc_range_mult", 1, 5, 0.1, 1),
				opt_check("binoc_zoom_scaling"),
				opt_check("binoc_clear_on_lower"),
				opt_check("instant_exclude_binoc"),
				opt_track("binoc_max_dist", 0, 1000, 5),
			}),
			page("ads", {
				opt_title("ui_mcm_ii_ads_title"),
				opt_check("ads_mode"),
				opt_track("ads_hold_time", 0, 3, 0.1, 1),
				opt_check("ads_boost"),
				opt_track("ads_scan_mult", 0.1, 1, 0.05, 2),
				opt_track("ads_range_mult", 1, 5, 0.1, 1),
				opt_check("ads_zoom_scaling"),
				opt_check("ads_hide_main"),
				opt_check("instant_exclude_ads"),
				opt_track("ads_max_dist", 0, 1000, 5),
			}),
			page("pip", {
				opt_title("ui_mcm_ii_pip_title"),
				opt_check("pip_markers"),
				opt_check("pip_hide_main"),
			}),
			page("scantime", {
				opt_title("ui_mcm_ii_dist_penalty_title"),
				opt_check("dist_penalty"),
				opt_track("dist_penalty_max", 1, 6, 0.1, 1),
				opt_title("ui_mcm_ii_rank_penalty_title"),
				opt_check("rank_penalty"),
				opt_track("rank_penalty_max", 1, 6, 0.1, 1),
				opt_title("ui_mcm_ii_night_penalty_title"),
				opt_check("night_penalty"),
				opt_track("night_penalty_max", 1, 6, 0.1, 1),
				opt_title("ui_mcm_ii_weather_penalty_title"),
				opt_check("weather_penalty"),
				opt_track("weather_penalty_max", 1, 6, 0.1, 1),
				opt_check("visor_water_penalty"),
				opt_track("visor_water_threshold", 0, 0.95, 0.05, 2),
				opt_title("ui_mcm_ii_combat_penalty_title"),
				opt_check("combat_penalty"),
				opt_track("combat_penalty_mult", 1, 6, 0.1, 1),
				opt_track("combat_pressure_mult", 1, 6, 0.1, 1),
				opt_track("combat_pressure_duration", 0.5, 15, 0.5, 1),
				opt_track("combat_near_miss_radius", 0.5, 10, 0.5, 1),
				opt_title("ui_mcm_ii_weight_penalty_title"),
				opt_check("weight_penalty"),
				opt_track("weight_penalty_max", 1, 6, 0.1, 1),
				opt_track("weight_penalty_ref", 1, 20, 0.5, 1),
				opt_title("ui_mcm_ii_foliage_penalty_title"),
				opt_check("foliage_penalty"),
				opt_track("foliage_penalty_max", 1, 6, 0.1, 1),
				opt_title("ui_mcm_ii_familiarity_title"),
				opt_check("familiarity_boost"),
				opt_track("familiarity_scan_mult", 0.1, 1, 0.05, 2),
				opt_title("ui_mcm_ii_perception_title"),
				opt_check("perception_compat"),
				opt_track("perception_scan_mult", 0, 0.1, 0.01, 2),
				opt_track("perception_xp", 0, 100, 5),
				opt_track("perception_loot_xp", 0, 100, 5),
			}),
			page("debug", {
				opt_title("ui_mcm_ii_debug_title"),
				opt_check("debug_log"),
				opt_check("debug_draw"),
				opt_check("debug_sim_stock"),
			}),
			-- st-wearable-devices compatibility: override the module/scanner tier values.
			-- Inert unless the optional WD compat component is installed (it reads these via
			-- ii_identify.get_wd_tier_cfg and drives the tier system). See that component.
			page("wdcompat", {
				opt_title("ui_mcm_ii_wdcompat_title"),
				opt_check("wd_ignore"),
				opt_check("wd_require_kit"),
				opt_check("wd_hostile_sound"),
				opt_title("ui_mcm_ii_wd_proc_title"),
				opt_track("wd_proc_t1", 0.1, 5, 0.1, 1),
				opt_track("wd_proc_t2", 0.1, 5, 0.1, 1),
				opt_track("wd_proc_t3", 0.1, 5, 0.1, 1),
				opt_title("ui_mcm_ii_wd_scan_title"),
				opt_track("wd_scan_t1", 5, 100, 5),
				opt_track("wd_scan_t2", 5, 100, 5),
				opt_track("wd_scan_t3", 5, 100, 5),
				opt_title("ui_mcm_ii_wd_feat_title"),
				opt_track("wd_feat_faction", 1, 3, 1),
				opt_track("wd_feat_distance", 1, 3, 1),
				opt_track("wd_feat_relationship", 1, 3, 1),
				opt_track("wd_feat_rank", 1, 3, 1),
				opt_track("wd_feat_weapon", 1, 3, 1),
				opt_title("ui_mcm_ii_wd_scanner_title"),
				opt_track("wd_scanner_binoc", 1, 3, 1),
				opt_track("wd_scanner_ads", 1, 3, 1),
				opt_track("wd_scanner_mag", 1, 3, 1),
				opt_track("wd_scanner_nonight", 1, 3, 1),
			}, wd_installed),
		},
	}

	-- Colors page, generated from ii_identify.COLOR_DEFS (appended so it's data-driven,
	-- not hand-listed -> stores under "ii/colors/<id>"). MCM has no colour-picker widget,
	-- so each colour is three 0-255 R/G/B sliders under a per-colour header; the R/G/B
	-- captions are shared across colours via the hint override (the header disambiguates
	-- which colour). custom_colors gates whether the overrides apply.
	local cg = {
		opt_title("ui_mcm_ii_colors_title"),
		opt_check("custom_colors"),
	}
	if ii_identify and ii_identify.COLOR_DEFS then
		local cur_group = nil
		for _, cd in ipairs(ii_identify.COLOR_DEFS) do
			if cd.group ~= cur_group then
				cur_group = cd.group
				cg[#cg + 1] = opt_title("ui_mcm_ii_colgrp_" .. cd.group)
			end
			cg[#cg + 1] = opt_title("ui_mcm_ii_col_" .. cd.id) -- per-colour name divider
			cg[#cg + 1] = opt_track("col_" .. cd.id .. "_r", 0, 255, 5, 0, "ii_col_ch_r")
			cg[#cg + 1] = opt_track("col_" .. cd.id .. "_g", 0, 255, 5, 0, "ii_col_ch_g")
			cg[#cg + 1] = opt_track("col_" .. cd.id .. "_b", 0, 255, 5, 0, "ii_col_ch_b")
		end
	end
	tree.gr[#tree.gr + 1] = page("colors", cg)

	return tree
end
