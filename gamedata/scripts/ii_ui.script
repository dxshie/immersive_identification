function install(IiTags, context)
	local C, P, S = context.config, context.position, context.size
	local MAX_TAGS, DBG_DOTS, DBG_TEXTS, DBG_INFO = context.max_tags, context.debug_dots, context.debug_texts, context.debug_info
	local CROOKS, MARKER = context.crooks, context.marker
	local COL_NEUTRAL, SIGN_COLOR = context.neutral, context.sign_colors
	local CARD_OFF_X, CARD_OFF_Y = 60, 34
	-- Card emblem box, virtual px at scale 1. Tuning value: it was 16 back when the emblem was
	-- drawn as a virtual square and so came out STRETCHED WIDE on anything past 4:3. Now that it
	-- is fitted and aspect-corrected it is honestly square, which at 16 read as a shrunken logo,
	-- hence the bump. The card reserves this plus 4 px, so raising it widens the plate to match.
	local CARD_ICON = 20
	-- Downward nudge for the card emblem, virtual px at scale 1. Optical, not geometric: the
	-- text lines are declared 16-18 px but the glyphs sit low inside those boxes, so an emblem
	-- centred on the plate's exact middle looks like it floats above the text.
	local CARD_ICON_DY = 1
	local RANK_FALLBACK = { 150, 150, 150 }
	-- Fixed tints the styles reuse, kept as constants so no draw path builds a colour table.
	local COL_WHITE, COL_BLACK, COL_PLATE = { 255, 255, 255 }, { 0, 0, 0 }, { 24, 22, 19 }
	local visibility, text = {}, {}
	local function show(widget, value)
		if visibility[widget] ~= value then
			widget:Show(value)
			visibility[widget] = value
		end
	end
	local function set_text(widget, value)
		if text[widget] ~= value then
			widget:SetText(value)
			text[widget] = value
		end
	end

	-- ------------------------------------------------------------------
	-- Drawing primitives. Every style, built-in or add-on, goes through these
	-- rather than hand-writing SetWndSize/SetWndPos/SetTextureColor/Show and its
	-- own aspect correction -- that four-line block appeared ~19 times here, with
	-- six different spellings of the C._ui_kx rule between them. All are exported
	-- on API_CTX, so the public API is the same code the built-ins run every frame.
	-- ------------------------------------------------------------------

	-- Top-left placement in raw virtual px. Use for geometry that is already in the
	-- correct space, e.g. extents that came from a world projection (the Bodycam box).
	local function place(w, x, y, width, height, col, alpha)
		w:SetWndSize(S(width, height))
		w:SetWndPos(P(x, y))
		w:SetTextureColor(GetARGB(alpha, col[1], col[2], col[3]))
		show(w, true)
	end

	-- Centred on (cx, cy), raw virtual px. The `- width / 2` that appeared 14 times.
	local function place_mid(w, cx, cy, width, height, col, alpha)
		place(w, cx - width / 2, cy - height / 2, width, height, col, alpha)
	end

	-- Centred, with the WIDTH aspect-corrected so a shape authored square comes out
	-- square. Pass the logical width; the C._ui_kx squeeze is applied here, which is
	-- why callers no longer have to remember that it goes on widths and never heights.
	-- Do NOT use for a widget you also rotate (SetHeading): rotation and a non-uniform
	-- scale do not commute, and a pre-squeezed shape turns elliptical at every angle.
	local function place_kx(w, cx, cy, width, height, col, alpha)
		local wx = width * C._ui_kx
		place(w, cx - wx / 2, cy - height / 2, wx, height, col, alpha)
	end

	-- The relation colour for this target, or `fallback` when there is none to show
	-- (`sign` is nil whenever show_relation is off). The single most repeated decision
	-- in every style that carries a friend-or-foe cue.
	local function relation_color(a, fallback)
		local sign = a.sign
		return (sign and SIGN_COLOR[sign]) or fallback or COL_NEUTRAL
	end

	-- Aspect ratio (width/height) of a static's CURRENT texture region, or nil when the
	-- engine will not report one. The region is what textures_descr declared, so this is
	-- the art's true shape even for a single tile of an atlas. Read once per texture
	-- SWAP and cached by the caller -- it is a luabind call, not something to do per frame.
	local function texture_aspect(widget)
		local ok, r = pcall(widget.GetTextureRect, widget)
		if not ok or not r then
			return nil
		end
		local x1, y1, x2, y2 = r.x1, r.y1, r.x2, r.y2
		if not (x1 and y1 and x2 and y2) then
			return nil
		end
		local tw, th = x2 - x1, y2 - y1
		if tw > 0 and th > 0 then
			return tw / th
		end
		return nil
	end

	-- Swaps a patch texture and re-reads its aspect, only when the id actually changed.
	-- `state` is any table to cache on (a tag slot, or the Crooks readout).
	local function set_patch(state, widget, icon_id)
		if state.icon_key ~= icon_id then
			pcall(widget.InitTexture, widget, icon_id)
			state.icon_key = icon_id
			state.icon_aspect = texture_aspect(widget)
		end
	end

	-- Centred placement that preserves the art's own proportions. The image is FITTED
	-- inside the box -- letterboxed, never cropped, since cropping a faction patch would
	-- eat its edges -- and the width is aspect-corrected on top of that. So a square patch
	-- stays square on any screen, and a non-square one keeps its shape instead of being
	-- stretched to whatever box the style hands it.
	--
	-- box_w/box_h are logical, pre-correction units, the same ones place_kx takes. The
	-- drawn width never exceeds the box (C._ui_kx is <= 1 on anything wider than 4:3), so
	-- a caller that reserved box_w of layout space stays safe. A nil aspect (no region
	-- reported) falls back to filling the box, i.e. the old behaviour.
	local function place_fit(w, cx, cy, box_w, box_h, aspect, col, alpha)
		local dw, dh = box_w, box_h
		if aspect and aspect > 0 then
			if aspect * box_h >= box_w then
				dh = box_w / aspect
			else
				dw = box_h * aspect
			end
		end
		place_kx(w, cx, cy, dw, dh, col, alpha)
	end

	-- Handed to every ii_api style hook. Built once and reused: `config` is the LIVE config
	-- table (so C._ui_kx and every setting read current values), and the helpers are the same
	-- ones the built-in styles use, so an add-on gets identical widget handling for free.
	-- `xml` / `parent` are filled in by InitControls, which always runs before any draw.
	--
	-- Only names that are ALREADY locals at this point may appear here. A member assigned
	-- from a helper defined further down silently becomes nil, because at this line that
	-- identifier is not a local yet and resolves as an (absent) global -- which is exactly
	-- what happened to draw_shadowed_text. Those are attached below, next to their
	-- definitions, and ii_api's test harness asserts every documented member is non-nil.
	local API_CTX = {
		api_version = 1,
		config = C,
		position = P,
		size = S,
		show = show,
		set_text = set_text,
		place = place,
		place_mid = place_mid,
		place_kx = place_kx,
		place_fit = place_fit,
		texture_aspect = texture_aspect,
		set_patch = set_patch,
		relation_color = relation_color,
		neutral = COL_NEUTRAL,
		sign_colors = SIGN_COLOR,
	}

	-- Add-on hooks run behind a pcall: this is third-party code on the per-frame render path,
	-- and an error escaping here would take the whole HUD down with it. A style that throws is
	-- logged ONCE and then skipped for that slot rather than spamming the log every frame --
	-- `state` doubles as the latch. Split in two because the signatures genuinely differ:
	-- on_draw needs the render record, the lifecycle hooks have none to give.
	local function api_guard(def, state, ok, err)
		if not ok then
			state._ii_broken = true
			printf("!![ii_api] style '%s' errored, disabling it for this slot: %s", def.id, tostring(err))
		end
	end

	-- on_create(state, ctx, slot) / on_hide(state, ctx, slot)
	local function api_lifecycle(def, hook, state, i)
		if not hook or state._ii_broken then
			return
		end
		api_guard(def, state, pcall(hook, state, API_CTX, i))
	end

	-- on_draw(state, a, ctx, slot)
	local function api_draw(def, state, i, a)
		if state._ii_broken then
			return
		end
		api_guard(def, state, pcall(def.on_draw, state, a, API_CTX, i))
	end
	function IiTags:InitControls()
		self:SetWndRect(Frect():set(0, 0, 1024, 768))
		self:SetAutoDelete(true)
	
		self.xml = CScriptXmlInit()
		self.xml:ParseFile("ii_tags.xml")

		-- Add-on styles may reuse the built-in widget templates (tag_icon, tag_node, ...) through
		-- ctx.xml, or parse their own XML and parent the widgets to ctx.parent.
		API_CTX.xml = self.xml
		API_CTX.parent = self
	
		self.slots = {}
		for i = 1, MAX_TAGS do
			-- Creation order = draw order (later draws on top): shadow, leader
			-- line (behind the plate, so the plate's edge draws over its end for
			-- a flush join), plate, accent bar, icon, then the header/name/rank
			-- text (parented to `self`, not the plate, so they draw on top of
			-- it), and finally the glow/node at the body anchor.
			local shadow = self.xml:InitStatic("tag_shadow", self)
			local line_sh = self.xml:InitStatic("tag_line_sh", self)
			local line = self.xml:InitStatic("tag_line", self)
			local plate = self.xml:InitStatic("tag_plate", self)
			local accent = self.xml:InitStatic("tag_accent", self)
			local icon = self.xml:InitStatic("tag_icon", self)
			local head_sh = self.xml:InitTextWnd("tag_head_sh:text", self)
			local head = self.xml:InitTextWnd("tag_head:text", self)
			local name_sh = self.xml:InitTextWnd("tag_name_sh:text", self)
			local name = self.xml:InitTextWnd("tag_name:text", self)
			local rank_sh = self.xml:InitTextWnd("tag_rank_sh:text", self)
			local rank = self.xml:InitTextWnd("tag_rank:text", self)
			local weap_sh = self.xml:InitTextWnd("tag_weap_sh:text", self)
			local weap = self.xml:InitTextWnd("tag_weap:text", self)
			local sign_sh = self.xml:InitTextWnd("tag_sign_sh:text", self)
			local sign = self.xml:InitTextWnd("tag_sign:text", self)
			local glow = self.xml:InitStatic("tag_glow", self)
			local node = self.xml:InitStatic("tag_node", self)
			local spinner = self.xml:InitStatic("tag_spinner", self)
			spinner:EnableHeading(true)
			-- Bodycam-style head-outline edges (created last = drawn on top).
			local box_top = self.xml:InitStatic("tag_box_top", self)
			local box_bottom = self.xml:InitStatic("tag_box_bottom", self)
			local box_left = self.xml:InitStatic("tag_box_left", self)
			local box_right = self.xml:InitStatic("tag_box_right", self)
			-- Simple 2 style shapes.
			local s2_circle = self.xml:InitStatic("tag_s2_circle", self)
			local s2_tri = self.xml:InitStatic("tag_s2_tri", self)
			local s2_bar = self.xml:InitStatic("tag_s2_bar", self)
			self.slots[i] = {
				shadow = shadow,
				line_sh = line_sh,
				line = line,
				plate = plate,
				accent = accent,
				icon = icon,
				head_sh = head_sh,
				head = head,
				name_sh = name_sh,
				name = name,
				rank_sh = rank_sh,
				rank = rank,
				weap_sh = weap_sh,
				weap = weap,
				sign_sh = sign_sh,
				sign = sign,
				glow = glow,
				node = node,
				spinner = spinner,
				-- Grouped so the outline primitive can take the four edges as one value.
				box = { top = box_top, bottom = box_bottom, left = box_left, right = box_right },
				s2_circle = s2_circle,
				s2_tri = s2_tri,
				s2_bar = s2_bar,
				-- Per-slot scratch for ii_api styles: id -> the state table that style owns.
				-- Filled lazily on first draw, so a style registered after InitControls still works.
				custom = {},
			}
			-- hidden starts unset (falsy) so this first hide_slot() call actually
			-- runs the Show(false) calls below, instead of short-circuiting on its
			-- own "already hidden" guard and leaving all widgets at their XML
			-- default position (0,0 -- top-left) permanently visible.
			self:hide_slot(i)
		end
	
		-- Debug-draw pool (MCM "Debug draw"): the FOV-radius ring (one stretched circle
		-- outline, created FIRST so everything else sits on top of it), round dots for
		-- in-ring entity bones, one text line for the radius, and a dedicated aim dot
		-- created LAST so it draws on top. All start hidden; shown only when debug_draw is on.
		self.dbg = { ring = nil, dots = {}, texts = {}, info = {}, text = nil, aim = nil }
		self.dbg.ring = self.xml:InitStatic("dbg_ring", self)
		show(self.dbg.ring, false)
		for i = 1, DBG_DOTS do
			local d = self.xml:InitStatic("dbg_dot", self)
			show(d, false)
			self.dbg.dots[i] = d
		end
		for i = 1, DBG_TEXTS do
			local t = self.xml:InitTextWnd("dbg_text:text", self)
			show(t, false)
			self.dbg.texts[i] = t
		end
		self.dbg.text = self.xml:InitTextWnd("dbg_text:text", self)
		show(self.dbg.text, false)
		self.dbg.status = self.xml:InitTextWnd("dbg_status:text", self)
		show(self.dbg.status, false)
		-- Bottom-right info-panel lines (aim/LOS state + list of targets in the FOV radius).
		for i = 1, DBG_INFO do
			local t = self.xml:InitTextWnd("dbg_status:text", self)
			show(t, false)
			self.dbg.info[i] = t
		end
		self.dbg.aim = self.xml:InitStatic("dbg_dot", self)
		show(self.dbg.aim, false)
	
		-- Crooks style (ui_style 6): one static "[faction logo]  NAME" readout of the LAST
		-- identified stalker -- the faction EMBLEM (reusing the tag_icon static) + the name (bright,
		-- with a 1px shadow, reusing the tag_name text template). Created LAST so it draws on top of
		-- everything. `last` caches the content so the width/texture are refreshed only on change.
		self.crooks = {
			icon = self.xml:InitStatic("tag_icon", self),
			name_sh = self.xml:InitTextWnd("tag_name_sh:text", self),
			name = self.xml:InitTextWnd("tag_name:text", self),
			rank_sh = self.xml:InitTextWnd("tag_rank_sh:text", self),
			rank = self.xml:InitTextWnd("tag_rank:text", self),
			last = nil,
		}
		show(self.crooks.icon, false)
		show(self.crooks.name, false)
		show(self.crooks.name_sh, false)
		show(self.crooks.rank, false)
		show(self.crooks.rank_sh, false)
	end
	
	-- The plate/accent/icon/text widgets, shared by hide_slot and draw_slot's
	-- scanning/mini/minimal branches -- glow/node/spinner are deliberately
	-- excluded since each caller shows or hides those three differently. sign/
	-- sign_sh are card-style-irrelevant like the rest of this list (hidden
	-- together with it); the minimal-style branch shows them back explicitly,
	-- same pattern as mini-mode already does for glow/node below.
	local CARD_WIDGET_KEYS = {
		"shadow",
		"line_sh",
		"line",
		"plate",
		"accent",
		"icon",
		"head_sh",
		"head",
		"name_sh",
		"name",
		"rank_sh",
		"rank",
		"weap_sh",
		"weap",
		"sign_sh",
		"sign",
	}
	
	local function hide_card_widgets(s)
		for _, k in ipairs(CARD_WIDGET_KEYS) do
			show(s[k], false)
		end
	end
	
	-- Outline edges: hidden every frame by default (see draw_slot), only shown by the
	-- branches that draw a box, so switching styles leaves no stale edges behind. Kept
	-- out of CARD_WIDGET_KEYS deliberately -- the card path shows its widgets one-by-one
	-- and never calls hide_card_widgets, so a shared list wouldn't cover it.
	local function hide_box_widgets(s)
		for _, w in pairs(s.box) do
			show(w, false)
		end
	end
	
	-- Simple 2 style shapes (circle, triangle, rank bar). Hidden every frame at the top of
	-- draw_slot; only the simple2 branch re-shows them.
	local function hide_s2_widgets(s)
		show(s.s2_circle, false)
		show(s.s2_tri, false)
		show(s.s2_bar, false)
	end
	
	function IiTags:hide_slot(i)
		local s = self.slots[i]
		if not s or s.hidden then
			return
		end
		s.hidden = true
		hide_card_widgets(s)
		hide_box_widgets(s)
		hide_s2_widgets(s)
		show(s.glow, false)
		show(s.node, false)
		show(s.spinner, false)
		-- Add-on styles own their widgets, so only they can hide them. Guarded by the slot's
		-- `hidden` latch above, so this runs on the transition, not every frame.
		for id, state in pairs(s.custom) do
			local def = ii_api and ii_api.get(id)
			if def then
				api_lifecycle(def, def.on_hide, state, i)
			end
		end
	end
	
	-- Hide every debug-draw widget (the FOV ring, the bone dot pool, the radius text,
	-- and the aim dot). Called when debug_draw is off / on teardown.
	function IiTags:hide_debug()
		local d = self.dbg
		if not d then
			return
		end
		if d._active == false then
			return
		end
		d._active = false
		for i = 1, DBG_DOTS do
			show(d.dots[i], false)
		end
		for i = 1, DBG_TEXTS do
			show(d.texts[i], false)
		end
		if d.info then
			for i = 1, DBG_INFO do
				show(d.info[i], false)
			end
		end
		if d.text then
			show(d.text, false)
		end
		if d.status then
			show(d.status, false)
		end
		if d.aim then
			show(d.aim, false)
		end
		if d.ring then
			show(d.ring, false)
		end
	end
	
	-- Bodycam style: gap (px) from the box's right edge to the name/weapon text, and
	-- the vertical step between the name and weapon lines.
	local BODYCAM_TEXT_PAD = 8
	local BODYCAM_LINE_H = 19
	
	-- Draws an unfilled rectangle outline from four thin strips, centred on (cx,cy) with
	-- the given half-width/half-height, in the fixed 1024x768 virtual space. `edges` is a
	-- table of four widgets keyed top/bottom/left/right.
	--
	-- hw/hh are taken as already being in virtual units and get NO C._ui_kx squeeze --
	-- Bodycam's come from a world2ui projection of the head's real extents (see
	-- screen_box), Patch style's from its own corrected sizing. The engine's
	-- virtual->screen stretch maps position and size together, landing each edge exactly
	-- on the projected point.
	--
	-- Thickness `t` and the alpha are the caller's: Bodycam passes its fixed (never
	-- distance-scaled) C.box_thickness with box_opacity folded in, Patch scales its own
	-- with distance so the ring keeps its proportions. The vertical edges' WIDTH is
	-- corrected so they render the same on-screen thickness as the horizontal ones (a raw
	-- px width is stretched differently on the X axis). Edges butt at the corners with NO
	-- overlap -- top/bottom span the full width, left/right fill only the gap between them
	-- -- so a thick outline does not double-draw and darken at its corners.
	local function outline(edges, cx, cy, hw, hh, t, col, alpha)
		if t < 1 then
			t = 1
		end
		local tw = math.max(1, t * C._ui_kx) -- vertical-edge width, aspect-corrected
		local x0, y0 = cx - hw, cy - hh
		local w, h = hw * 2, hh * 2
		local vh = math.max(1, h - 2 * t) -- vertical edges fill between top & bottom

		place(edges.top, x0, y0, w, t, col, alpha)
		place(edges.bottom, x0, y0 + h - t, w, t, col, alpha)
		place(edges.left, x0, y0 + t, tw, vh, col, alpha)
		place(edges.right, x0 + w - tw, y0 + t, tw, vh, col, alpha)
	end
	
	local SPIN_D = 20 -- spinner diameter, px, at scale 1
	local SPIN_PERIOD_MS = 900 -- one full rotation
	
	-- One round marker: a `size`-diameter dot, optionally behind a soft halo 2.8x its
	-- size at 55% of its alpha. Widths are aspect-corrected so it stays circular.
	--
	-- `snap` rounds to whole pixels and floors each width at 2. That is for markers whose
	-- size does NOT track the camera: at a fixed small size, fractional positions make the
	-- dot shimmer as the view moves. Distance-scaled markers pass false and keep
	-- fractional placement, which is what lets them shrink smoothly. `glow` may be nil.
	local function dot_part(w, cx, cy, d, col, alpha, snap)
		local dx = d * C._ui_kx
		if snap then
			dx = math.max(2, math.floor(dx + 0.5))
		end
		local x, y = cx - dx / 2, cy - d / 2
		if snap then
			x, y = math.floor(x), math.floor(y)
		end
		place(w, x, y, dx, d, col, alpha)
	end

	local function dot(node, glow, cx, cy, size, col, alpha, snap)
		dot_part(node, cx, cy, size, col, alpha, snap)
		if glow then
			dot_part(glow, cx, cy, size * 2.8, col, math.floor(alpha * 0.55), snap)
		end
	end

	-- Reused so draw_node_glow's r,g,b -> colour-table conversion allocates nothing; it
	-- runs several times per slot per frame. Same scratch discipline as ii_identify's _v.
	local _rgb = { 0, 0, 0 }

	-- The card/minimal/simple node: `scale` is the style's scale factor, not a diameter.
	-- world_scaled = the style distance-scales, so no pixel snapping and no clamp; the
	-- flat-scaled styles clamp the node so a large card_scale doesn't bloat the dot.
	local function draw_node_glow(s, hx, hy, scale, alpha, r, g, b, world_scaled)
		local node_scale = world_scaled and scale or math.min(scale, MARKER.card_node_max)
		_rgb[1], _rgb[2], _rgb[3] = r, g, b
		dot(s.node, s.glow, hx, hy, 7 * node_scale, _rgb, alpha, not world_scaled)
	end

	-- Positions/tints/shows one text line plus its 1px-offset shadow copy.
	local function draw_shadowed_text(main, sh, x, y, alpha, r, g, b, shadow_a)
		sh:SetWndPos(P(x + 1, y + 1))
		sh:SetTextColor(GetARGB(shadow_a, 0, 0, 0))
		show(sh, true)
		main:SetWndPos(P(x, y))
		main:SetTextColor(GetARGB(alpha, r, g, b))
		show(main, true)
	end

	-- Attached here, not in the API_CTX literal above: these helpers are defined after it,
	-- and assigning them up there would store nil (see that table's comment).
	API_CTX.outline = outline
	API_CTX.dot = dot
	API_CTX.draw_shadowed_text = draw_shadowed_text
	
	-- Draw one bodycam text line as flat CUIStatic shadowed text. (The depth-aware engine
	-- glyph-emitter path was reverted; this is the sole path now.) main_w/sh_w are the widget +
	-- its shadow copy. wx/wy/wz (the world anchor) are unused now but kept in the signature so the
	-- callers don't change.
	local function draw_bodycam_line(main_w, sh_w, str, x, y, alpha, r, g, b, shadow_a, wx, wy, wz)
		set_text(main_w, str)
		set_text(sh_w, str)
		draw_shadowed_text(main_w, sh_w, x, y, alpha, r, g, b, shadow_a)
	end
	
	-- Minimal-style relation sign (-/+/o), centred on the same anchor point as
	-- the node dot. Text size is fixed, like head/name/rank in the card style --
	-- this engine only has 3 discrete font sizes (no continuous scaling), so
	-- only its position tracks hx,hy, not its size.
	local SIGN_W, SIGN_H = 20, 18
	
	local function draw_sign(s, hx, hy, alpha, sign_char)
		local col = SIGN_COLOR[sign_char] or COL_NEUTRAL
		set_text(s.sign, sign_char)
		set_text(s.sign_sh, sign_char)
		local shadow_a = math.floor(180 * alpha / 255)
		draw_shadowed_text(
			s.sign,
			s.sign_sh,
			math.floor(hx - SIGN_W / 2),
			math.floor(hy - SIGN_H / 2),
			alpha,
			col[1],
			col[2],
			col[3],
			shadow_a
		)
	end
	
	-- Render records and widget slots are reused for the lifetime of a tracked target.
	local function measure_card(s, a)
		local m = s.measurement
		if not m then
			m = {}
			s.measurement = m
		end
		-- kx is part of the key: ispan below is aspect-corrected, so a resolution change
		-- alters the measured plate width even when nothing about the text did.
		if
			m.ready
			and m.header_key == a.header
			and m.name_key == a.name
			and m.rank_key == a.rank
			and m.weap_key == a.weap
			and m.scale == a.scale
			and m.kx == C._ui_kx
		then
			return m
		end
		local header, name, rank, weap = a.header, a.name, a.rank, a.weap
		local scale = a.scale or 1
		-- Which lines this style shows. Presence of each field already encodes its show
		-- decision (folded in at snapshot time: the C.show_* toggles, or the tier feature
		-- gates under WD compat -- see identify_target). So here it's pure field-presence.
		local has_head = header and header ~= ""
		local has_name = name and name ~= ""
		local has_rank = rank and rank ~= ""
		local has_weap = weap and weap ~= ""
		local pad, accent_w = 8, 3
		-- The emblem is drawn aspect-corrected, so the plate must reserve the width it will
		-- ACTUALLY occupy (ibox * kx), not the logical box. Reserving the uncorrected value
		-- left ibox*(1-kx) of dead space between emblem and text -- 9 px instead of the
		-- intended 4 on 16:9, worse on ultrawide.
		local ibox = CARD_ICON * scale -- emblem's logical (height) box
		local iw = ibox * C._ui_kx -- the width it really takes on the plate
		local lead = 5 * scale
		local ispan = iw + 4 * scale
	
		-- Text width: re-measured only when the strings OR which lines are shown
		-- change (AdjustWidthToText/GetWidth per change, not per frame). `or 0` guards the
		-- degenerate first-draw case where every line is empty (e.g. a Card for a target with no
		-- name/faction/rank/weapon): the invalidation check below is all nil~=nil = false, so the
		-- recompute is skipped and the cache (s.text_w) is still nil -- 0 = a plate with just the icon.
		local text_w = s.text_w or 0
		if
			header ~= s.last_head
			or name ~= s.last_name
			or rank ~= s.last_rank
			or weap ~= s.last_weap
			or has_head ~= s.last_hhead
			or has_name ~= s.last_hname
			or has_weap ~= s.last_hweap
		then
			text_w = 0
			if has_head then
				set_text(s.head, header)
				set_text(s.head_sh, header)
				s.head:AdjustWidthToText()
				s.head_sh:AdjustWidthToText()
				text_w = math.max(text_w, s.head:GetWidth())
			end
			if has_name then
				set_text(s.name, name)
				set_text(s.name_sh, name)
				s.name:AdjustWidthToText()
				s.name_sh:AdjustWidthToText()
				text_w = math.max(text_w, s.name:GetWidth())
			end
			if has_rank then
				set_text(s.rank, rank)
				set_text(s.rank_sh, rank)
				s.rank:AdjustWidthToText()
				s.rank_sh:AdjustWidthToText()
				text_w = math.max(text_w, s.rank:GetWidth())
			end
			if has_weap then
				set_text(s.weap, weap)
				set_text(s.weap_sh, weap)
				s.weap:AdjustWidthToText()
				s.weap_sh:AdjustWidthToText()
				text_w = math.max(text_w, s.weap:GetWidth())
			end
			s.text_w, s.last_head, s.last_name, s.last_rank, s.last_weap = text_w, header, name, rank, weap
			s.last_hhead, s.last_hname, s.last_hweap = has_head, has_name, has_weap
		end
	
		local cw = math.floor(accent_w + lead + ispan + text_w + pad + 0.5)
	
		-- Vertical layout: PAD_TOP, each present line separated by GAP, then
		-- PAD_BOTTOM. Fixed line heights matching each widget's font (letterica16 for
		-- header/rank/weap, letterica18 for name). Computed generically since any line
		-- can be toggled off (header/name are no longer assumed present).
		local PAD_TOP, PAD_BOTTOM, GAP = 7, 7, 4
		local head_h, name_h, rank_h, weap_h = 16, 18, 16, 16
		local ch, nlines = PAD_TOP, 0
		if has_head then
			ch = ch + head_h
			nlines = nlines + 1
		end
		if has_name then
			if nlines > 0 then
				ch = ch + GAP
			end
			ch = ch + name_h
			nlines = nlines + 1
		end
		if has_rank then
			if nlines > 0 then
				ch = ch + GAP
			end
			ch = ch + rank_h
			nlines = nlines + 1
		end
		if has_weap then
			if nlines > 0 then
				ch = ch + GAP
			end
			ch = ch + weap_h
			nlines = nlines + 1
		end
		ch = ch + PAD_BOTTOM
	
		m.header_key, m.name_key, m.rank_key, m.weap_key = header, name, rank, weap
		m.head, m.name, m.rank, m.weap = has_head, has_name, has_rank, has_weap
		m.width, m.height = cw, ch
		m.accent, m.lead, m.ispan, m.icon = accent_w, lead, ispan, ibox
		m.icon_w = iw
		m.scale, m.kx, m.ready = a.scale, C._ui_kx, true
		return m
	end
	
	local function place_card(a, measured)
		local hx, hy, scale = a.hx, a.hy, a.scale or 1
		local cw, ch = measured.width, measured.height
		local stack_offset = a.stack_offset or 0
		-- place the card up and to one side of the anchor; flip to the left near
		-- the right edge of the (1024-wide virtual) screen. stack_offset (see
		-- render()'s overlap-avoidance pass) pushes it further up still when
		-- another card's anchor is close enough to plausibly collide -- the
		-- leader line below just extends to reach it, which is what visually
		-- stacks the two instead of them landing flush on top of each other.
		local off_x, off_y = CARD_OFF_X * scale, CARD_OFF_Y * scale + stack_offset
		local right = (hx + off_x + cw) <= 1014
		local cx = right and (hx + off_x) or (hx - off_x - cw)
		if cx < 4 then
			cx = 4
		end
		local cy = hy - off_y - ch
		if cy < 4 then
			cy = 4
		end
	
		return cx, cy, right
	end
	
	function IiTags:draw_slot(i, a, tg)
		local hx, hy = a.hx, a.hy
		local header, name, rank, weap = a.header, a.name, a.rank, a.weap
		local alpha, col, icon_id = a.a, a.col, a.icon
		local scanning, scale, stack_offset = a.scanning, a.scale or 1, a.stack_offset or 0
		local fcol, sign, rank_col = a.fcol, a.sign, a.rank_col
		local box_cx, box_cy, box_hw, box_hh = a.box_cx, a.box_cy, a.box_hw, a.box_hh
		local box_wx, box_wy, box_wz = a.box_wx, a.box_wy, a.box_wz
		local s = self.slots[i]
		if not s then
			return
		end
		local mode = scanning and 0 or C.ui_style
		-- -1, not a free style index: the fallback has to stay distinct from every real
		-- ui_style so switching INTO a style whose number collided with it would still
		-- trip the mode change below and clear the previous style's widgets.
		if mode == 1 and scale < C.mini_scale_cutoff then
			mode = -1
		end
		if s.mode ~= mode then
			self:hide_slot(i)
			s.mode = mode
			s.last_head, s.last_name, s.last_rank, s.last_weap = false, false, false, false
			s.simple_last_name = nil
			if s.measurement then
				s.measurement.ready = false
			end
		end
		s.hidden = false
	
		-- Crooks style draws NO per-entity UI -- just the one static screen readout (draw_crooks,
		-- from render()). Hide everything on this slot and bail before the scanning/style branches.
		if C.ui_style == CROOKS.style then
			show(s.glow, false)
			show(s.node, false)
			show(s.spinner, false)
			return
		end
	
		local r, g, b = col[1], col[2], col[3]
		scale = scale or 1
		stack_offset = stack_offset or 0
		alpha = math.floor(alpha)
		if alpha > 255 then
			alpha = 255
		end
	
		if scanning then
			-- scanning only: a rotating spinner on the body, nothing revealed yet.
			-- Always plain white -- relation isn't known/shown as a colour cue
			-- until the tag actually reveals. Branches on the `scanning` flag
			-- itself, not `alpha <= 1`: a revealed tag's alpha also drops during its
			-- fade-out, which could hit alpha<=1 too and wrongly flip back to the spinner.
			-- NOT width-squeezed by C._ui_kx like the static node/glow/line: those
			-- are pre-distorted so the engine's anisotropic virtual-to-screen
			-- stretch turns them back into circles, but that trick only holds
			-- for a shape at a fixed orientation. SetHeading() below rotates
			-- this widget in virtual space *before* that stretch is applied, and
			-- rotation doesn't commute with a non-uniform scale -- a squeezed
			-- rectangle rotated first comes out elliptical at every angle rather
			-- than circular, so this stays square instead.
			local spin_d = SPIN_D * scale
			local spin_angle = (tg % SPIN_PERIOD_MS) / SPIN_PERIOD_MS * (2 * math.pi)
			s.spinner:SetWndSize(S(spin_d, spin_d))
			s.spinner:SetWndPos(P(hx - spin_d / 2, hy - spin_d / 2))
			s.spinner:SetTextureColor(GetARGB(230, 255, 255, 255))
			s.spinner:SetHeading(spin_angle)
			show(s.spinner, true)
	
			show(s.glow, false)
			show(s.node, false)
			return
		end
	
		show(s.spinner, false)
	
		-- Add-on styles (ii_api): any ui_style past the built-in range dispatches here. Placed
		-- AFTER the scanning branch above, so a custom style inherits the standard scan spinner
		-- and only ever draws revealed targets -- one less thing every add-on has to reimplement.
		-- Must also come before the mini-fallback/card tail below, which is the unmatched-style
		-- catch-all and would otherwise draw a card over the add-on's own graphics.
		local api_def = ii_config.custom_style(C.ui_style)
		if api_def then
			local state = s.custom[api_def.id]
			if not state then
				state = {}
				s.custom[api_def.id] = state
				api_lifecycle(api_def, api_def.on_create, state, i)
			end
			api_draw(api_def, state, i, a)
			return
		end
	
		-- Minimal style: always just the faction-coloured dot + a relation sign,
		-- regardless of scale -- a distinct, user-selected visual language, not
		-- just Card style's own too-small-to-fit fallback below.
		if C.ui_style == 2 then
			-- Minimal reuses the existing content toggles: the faction-coloured dot honours
			-- `show_faction`, the relation sign honours `show_relation` (via `sign` being nil when
			-- it's off). If BOTH are off, keep a neutral locator dot so the tag doesn't vanish.
			local show_dot = C.show_faction
			local show_relsign = sign ~= nil
			if show_dot then
				draw_node_glow(s, hx, hy, scale, alpha, fcol[1], fcol[2], fcol[3], C.mini_dist_scale)
			elseif not show_relsign then
				draw_node_glow(s, hx, hy, scale, alpha, COL_NEUTRAL[1], COL_NEUTRAL[2], COL_NEUTRAL[3], C.mini_dist_scale)
			else
				show(s.node, false)
				show(s.glow, false)
			end
			if show_relsign then
				draw_sign(s, hx, hy, alpha, sign)
			else
				show(s.sign, false)
				show(s.sign_sh, false)
			end
			return
		end
	
		-- Minimal 2 (style 7): a single bare DOT (no glow, no sign, no text) coloured by RELATION --
		-- red enemy / green friend / tan neutral, always relation-based (SIGN_COLOR is accurate
		-- regardless of color_by_relation). The most stripped-down "friend or foe" indicator.
		-- With `show_relation` off there IS no relation to show, so it falls back to the FACTION
		-- colour rather than a flat neutral dot -- otherwise the whole style would carry nothing.
		if C.ui_style == 7 then
			show(s.glow, false)
			-- No halo, no snapping: Minimal 2 always distance-scales.
			dot(s.node, nil, hx, hy, 7 * scale, relation_color(a, fcol), alpha, false)
			return
		end
	
		-- Simple style: a compact horizontal strip above the head -- the Card style's
		-- relation-coloured dot + glow, then the faction logo, then the name.
		if C.ui_style == 5 then
			set_patch(s, s.icon, icon_id)
			local has_name = name and name ~= ""
			if name ~= s.simple_last_name then
				if has_name then
					set_text(s.name, name)
					set_text(s.name_sh, name)
					s.name:AdjustWidthToText()
					s.name_sh:AdjustWidthToText()
				end
				s.simple_last_name = name
			end
			local has_icon = icon_id and icon_id ~= ""
	
			local glow_w = 7 * scale * 2.8 * C._ui_kx
			local icon_h = 16 * scale
			local icon_w = icon_h * C._ui_kx
			local gap = 5 * scale * C._ui_kx
			local row_y = hy - 14 * scale
	
			-- Native text has a fixed font size; exclude its width from the anchor
			-- calculation so a long name cannot push the marker off the entity.
			local total = glow_w
			if has_icon then
				total = total + gap + icon_w
			end
			local cursor = hx - total / 2
	
			draw_node_glow(s, cursor + glow_w / 2, row_y, scale, alpha, r, g, b, true)
			cursor = cursor + glow_w
	
			if has_icon then
				cursor = cursor + gap
				-- Centred in the icon_w slot the row already reserved, so a letterboxed
				-- patch does not shift the name beside it.
				place_fit(s.icon, cursor + icon_w / 2, row_y, icon_h, icon_h, s.icon_aspect, COL_WHITE, alpha)
				cursor = cursor + icon_w
			else
				show(s.icon, false)
			end
	
			if has_name then
				cursor = cursor + gap
				draw_shadowed_text(
					s.name,
					s.name_sh,
					cursor,
					row_y - 9,
					alpha,
					235,
					230,
					220,
					math.floor(180 * alpha / 255)
				)
			else
				show(s.name, false)
				show(s.name_sh, false)
			end
			return
		end
	
		-- Bodycam style: an unfilled, faction-coloured outline box locked to the
		-- head bone and auto-scaled so it stays a constant real-world size around
		-- the head -- no plate, dot, or sign, just the frame. box_hw/box_hh are nil
		-- when the head doesn't project this frame (off-screen / no camera vectors),
		-- in which case nothing is drawn (box already hidden at the top).
		if C.ui_style == 3 then
			if not (box_hw and box_hh) then
				hide_box_widgets(s)
				hide_card_widgets(s)
				return
			end
			show(s.name, name ~= nil and name ~= "")
			show(s.name_sh, name ~= nil and name ~= "")
			show(s.head, header ~= nil and header ~= "")
			show(s.head_sh, header ~= nil and header ~= "")
			show(s.weap, weap ~= nil and weap ~= "")
			show(s.weap_sh, weap ~= nil and weap ~= "")
			show(s.glow, false)
			show(s.node, false)
			if box_hw and box_hh then
				-- Box colour source: faction colour, or the relationship colour
				-- (red/green/grey) keyed off the relation sign -- which stays accurate
				-- regardless of color_by_relation, unlike the relation-tinted `col`.
				-- `show_relation` off nils the sign, and the box falls back to the faction
				-- colour: this style has no other cue, so a neutral box would say nothing.
				local bcol = fcol
				if C.box_color_source == 2 and sign then
					bcol = SIGN_COLOR[sign]
				end
				outline(
					s.box,
					box_cx,
					box_cy,
					box_hw,
					box_hh,
					C.box_thickness or 2,
					bcol,
					math.floor(alpha * (C.box_opacity or 1))
				)
	
				-- Name / faction / weapon+caliber, stacked just to the right of the box
				-- and tracking it every frame, each gated by its generic show toggle.
				-- Reuse the card's text widgets (hidden above by hide_card_widgets,
				-- re-shown per present line). Weapon skipped for the unarmed/monsters.
				local tx = math.floor(box_cx + box_hw + BODYCAM_TEXT_PAD)
				local ty = math.floor(box_cy - box_hh)
				local shadow_a = math.floor(180 * alpha / 255)
				if name and name ~= "" then
					draw_bodycam_line(
						s.name,
						s.name_sh,
						name,
						tx,
						ty,
						alpha,
						236,
						230,
						218,
						shadow_a,
						box_wx,
						box_wy,
						box_wz
					)
					ty = ty + BODYCAM_LINE_H
				end
				if header and header ~= "" then
					draw_bodycam_line(
						s.head,
						s.head_sh,
						header,
						tx,
						ty,
						alpha,
						fcol[1],
						fcol[2],
						fcol[3],
						shadow_a,
						box_wx,
						box_wy,
						box_wz
					)
					ty = ty + BODYCAM_LINE_H
				end
				if weap and weap ~= "" then
					draw_bodycam_line(
						s.weap,
						s.weap_sh,
						weap,
						tx,
						ty,
						alpha,
						172,
						178,
						188,
						shadow_a,
						box_wx,
						box_wy,
						box_wz
					)
				end
			end
			return
		end
	
		-- Simple 2 style: over the head -- a faction-coloured circle and a relation-coloured
		-- (red enemy / green friendly / grey neutral) triangle side by side, with a thin
		-- rank-coloured bar spanning them above. Distance-scaled (scale) and anchored at the
		-- head like the PiP markers. Shape WIDTHS are C._ui_kx-corrected so the circle/triangle
		-- stay round/undistorted on wide screens (the virtual->screen stretch, same trick as
		-- the node dot); heights aren't.
		if C.ui_style == 4 then
			show(s.glow, false)
			show(s.node, false)
			local sc = scale
			local cd = 12 * sc -- circle diameter (also the row height driver)
			local tw, th = 13 * sc, 11 * sc -- triangle width / height
			local gap = 3 * sc -- gap between circle and triangle
			local bh = 3 * sc
			local bgap = 3 * sc -- gap between the bar and the shapes
			local kx = C._ui_kx
			local cw = cd * kx
			local twx = tw * kx
			local gpx = gap * kx
			local has_tri = sign ~= nil
			local roww = has_tri and (cw + gpx + twx) or cw
			local left = hx - roww / 2
			local rowh = math.max(cd, th)
			local cy = hy - rowh / 2 - 2 * sc -- sit the shapes just above the head anchor
	
			place(s.s2_circle, left, cy - cd / 2, cw, cd, fcol, alpha)

			-- `show_relation` off nils the sign: drop the triangle entirely and let the row
			-- (and the rank bar spanning it) close up around the circle alone.
			if has_tri then
				place(s.s2_tri, left + cw + gpx, cy - th / 2, twx, th, SIGN_COLOR[sign], alpha)
			else
				show(s.s2_tri, false)
			end

			place(s.s2_bar, left, cy - rowh / 2 - bgap - bh, roww, bh, rank_col or RANK_FALLBACK, alpha)
			return
		end
	
		-- Patch style (style 8): the faction patch on its own, ringed by a relation-coloured
		-- outline -- "who they are" plus "friend or foe", no text, no dot. The ring is the
		-- style's ONLY relation cue, so `show_relation` off removes it outright rather than
		-- recolouring it: a neutral ring would be pure decoration claiming to mean something.
		-- Its colour is otherwise always relation-based (SIGN_COLOR stays accurate regardless
		-- of color_by_relation), like Minimal 2's dot. show_faction off drops the patch, so
		-- with both off the style draws nothing -- which is what the player asked for.
		-- Distance-scaled via `scale` like Simple / Simple 2, and the patch WIDTH plus the
		-- horizontal padding are C._ui_kx-corrected so the patch stays square on wide screens.
		if C.ui_style == 8 then
			show(s.glow, false)
			show(s.node, false)
			local kx = C._ui_kx
			local ph = (C.patch_size or 13) * scale
			local pw = ph * kx
			-- No ring when the player set thickness 0, or when there is no relation to show.
			-- Either way it must not pad the layout: margin collapses so the patch sits where
			-- it would if the ring had never been configured.
			local ring = (C.patch_thickness or 2) > 0 and sign ~= nil
			local t = ring and math.max(1, (C.patch_thickness or 2) * scale) or 0
			local margin = ring and ((C.patch_padding or 0) * scale + t) or 0
			local hh = ph / 2 + margin
			local hw = pw / 2 + margin * kx
			local cy = hy - hh - 2 * scale -- sit the patch just above the head anchor
			if ring then
				outline(s.box, hx, cy, hw, hh, t, SIGN_COLOR[sign], alpha)
			else
				hide_box_widgets(s)
			end
	
			if C.show_faction and icon_id and icon_id ~= "" then
				set_patch(s, s.icon, icon_id)
				-- Logical box is ph square; place_fit applies the aspect correction itself.
				place_fit(s.icon, hx, cy, ph, ph, s.icon_aspect, COL_WHITE, alpha)
			else
				show(s.icon, false)
			end
			return
		end
	
		-- Mini fallback: below the cutoff, the card doesn't fit any more, so just
		-- show the relation dot -- the same node the leader line would otherwise
		-- connect to a card, minus the card. `scale` is a single flat MCM value
		-- shared by every card (not distance-derived), so this is a global
		-- on/off rather than a per-target one -- no hysteresis needed, since it
		-- only ever changes when the player edits the slider, not per frame.
		if scale < C.mini_scale_cutoff then
			draw_node_glow(s, hx, hy, scale, alpha, r, g, b)
			return
		end
	
		set_patch(s, s.icon, icon_id)
	
		local measured = measure_card(s, a)
		local has_head, has_name, has_rank, has_weap = measured.head, measured.name, measured.rank, measured.weap
		local cw, ch = measured.width, measured.height
		local accent_w, lead, ispan, ibox = measured.accent, measured.lead, measured.ispan, measured.icon
		local PAD_TOP, GAP = 7, 4
		local head_h, name_h, rank_h, weap_h = 16, 18, 16, 16
	
		local cx, cy, right = place_card(a, measured)
	
		-- soft drop shadow (ii_shadow, feathered -- see its texture comment),
		-- larger and offset down-right of the plate, so the card reads as lifted
		-- off the world instead of pasted flat on it. Margin needs real room for
		-- the feather band to show past the plate's edge, not just a couple of
		-- px -- 5 read as another hard rectangle peeking out from behind the
		-- plate rather than a soft shadow.
		local sh_m = 9 * scale
		place(
			s.shadow,
			cx - sh_m + 3,
			cy - sh_m + 4,
			cw + sh_m * 2,
			ch + sh_m * 2,
			COL_BLACK,
			math.floor(160 * alpha / 255)
		)
		place(s.plate, cx, cy, cw, ch, COL_PLATE, math.floor(185 * alpha / 255))

		local acc_in = 6 * scale
		_rgb[1], _rgb[2], _rgb[3] = r, g, b
		place(s.accent, cx, cy + acc_in, accent_w, ch - acc_in * 2, _rgb, alpha)

		-- Fitted, so a non-square patch keeps its shape. Clamped to the plate's inner height:
		-- with every text line switched off the card collapses to padding alone, and an
		-- unclamped emblem would spill past its own edge. Centred in the width the plate
		-- actually reserved for it (measured.icon_w), and nudged down by CARD_ICON_DY --
		-- glyphs sit low inside their declared line boxes, so a geometrically centred emblem
		-- reads as sitting too high next to them.
		local icon_box = math.min(ibox, ch - 4 * scale)
		if icon_box > 0 then
			place_fit(
				s.icon,
				cx + accent_w + lead + measured.icon_w / 2,
				cy + ch / 2 + CARD_ICON_DY * scale,
				icon_box,
				icon_box,
				s.icon_aspect,
				COL_WHITE,
				alpha
			)
		else
			show(s.icon, false)
		end
		-- Stack the present lines past the accent bar + icon: faction (relation-
		-- tinted), name (brighter), then muted rank + weapon. A running cursor walks
		-- down, so any toggled-off line simply contributes nothing and the ones below
		-- close up under it -- matching the ch calc above. Hidden lines are Show(false).
		local txo = cx + accent_w + lead + ispan
		local shadow_a = math.floor(180 * alpha / 255)
		local y = math.floor(cy + PAD_TOP)
		local placed = 0
	
		if has_head then
			draw_shadowed_text(s.head, s.head_sh, txo, y, alpha, r, g, b, shadow_a)
			y = y + head_h
			placed = placed + 1
		else
			show(s.head, false)
			show(s.head_sh, false)
		end
	
		if has_name then
			if placed > 0 then
				y = y + GAP
			end
			draw_shadowed_text(s.name, s.name_sh, txo, y, alpha, 235, 230, 220, shadow_a)
			y = y + name_h
			placed = placed + 1
		else
			show(s.name, false)
			show(s.name_sh, false)
		end
	
		if has_rank then
			if placed > 0 then
				y = y + GAP
			end
			-- muted: secondary to the name, so its own (lower) alpha
			draw_shadowed_text(
				s.rank,
				s.rank_sh,
				txo,
				math.floor(y),
				math.floor(200 * alpha / 255),
				210,
				205,
				195,
				shadow_a
			)
			y = y + rank_h
			placed = placed + 1
		else
			show(s.rank, false)
			show(s.rank_sh, false)
		end
	
		if has_weap then
			if placed > 0 then
				y = y + GAP
			end
			-- steel-grey, dimmer still: an equipment note, not competing with the name
			draw_shadowed_text(
				s.weap,
				s.weap_sh,
				txo,
				math.floor(y),
				math.floor(185 * alpha / 255),
				165,
				180,
				195,
				shadow_a
			)
			y = y + weap_h
			placed = placed + 1
		else
			show(s.weap, false)
			show(s.weap_sh, false)
		end
	
		-- node + its glow halo at the anchor point on the body (shared with the
		-- mini-mode branch above -- see draw_node_glow's comment).
		draw_node_glow(s, hx, hy, scale, alpha, r, g, b)
	
		-- leader line: node -> nearest bottom corner of the card, extended
		-- slightly past the corner so its end tucks under the plate (drawn over
		-- it), giving a flush join at any aspect ratio. The engine's heading
		-- rotation multiplies the strip's X by C._ui_kx, so dx is pre-divided by it
		-- here to land exactly on both endpoints (see C._ui_kx's declaration).
		local corner_x = right and cx or (cx + cw)
		local corner_y = cy + ch
		local dx, dy = corner_x - hx, corner_y - hy
		local seglen = math.sqrt(dx * dx + dy * dy)
		if seglen > 0.001 then
			local over = 6
			dx = dx + dx / seglen * over
			dy = dy + dy / seglen * over
			corner_x, corner_y = hx + dx, hy + dy
		end
		local dxk = dx / C._ui_kx
		local len = math.sqrt(dxk * dxk + dy * dy)
		local ang = math.atan2(-dy, dxk)
		local mx, my = (hx + corner_x) * 0.5, (hy + corner_y) * 0.5
		local thick = 2 * scale
	
		s.line_sh:SetWndSize(S(len, thick + 2))
		s.line_sh:SetWndPos(P(mx - len * 0.5, my - (thick + 2) * 0.5))
		s.line_sh:EnableHeading(true)
		s.line_sh:SetHeading(ang)
		s.line_sh:SetTextureColor(GetARGB(math.floor(alpha * 0.5), 0, 0, 0))
		show(s.line_sh, true)
	
		s.line:SetWndSize(S(len, thick))
		s.line:SetWndPos(P(mx - len * 0.5, my - thick * 0.5))
		s.line:EnableHeading(true)
		s.line:SetHeading(ang)
		s.line:SetTextureColor(GetARGB(math.floor(alpha * 0.8), r, g, b))
		show(s.line, true)
	end
	
	return {
		show = show,
		set_text = set_text,
		draw_shadowed_text = draw_shadowed_text,
		place_fit = place_fit,
		set_patch = set_patch,
	}
end
