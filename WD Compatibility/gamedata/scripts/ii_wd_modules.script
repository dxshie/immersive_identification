-- Register the identification modules with WD's Promin so they show + install in the
-- bracer customize UI.
--
-- Bays (WD 0.9): WD's `conn` bay is still a do-nothing placeholder, so the ANTENNA lives
-- there. WD's `side` bay now holds its environmental modules, so the PROCESS and OSD SCANNER
-- modules get bays of their own (ii_proc, ii_osd), appended to WD's three. WD's MODULES are
-- left as they are. WD's customize screen builds one cell per bay, so the two extra bays need
-- cells 4 and 5, which modxml_ii_wd_customize adds to WD's XML as it loads.
--
-- WD's d_promin.has_module() drives detection and WD persists the installed set, so no save
-- state here. Items install through WD's own install_module, which evicts the bay's occupant.

-- No `pages`: the AR path shows on entities, not on the Promin.
local ANTENNA = { name = "ii_ant", section = "ii_wd_antenna", bay = "conn" }

-- `pages = {"ident"}`: WD's get_available_pages() adds an installed module's pages to the
-- Promin's number keys, so installing an OSD scanner adds the IDENTIFICATION page.
local OSD_SCANNER = {
	{ name = "ii_osd_t1", section = "ii_wd_osd_scanner_t1", bay = "ii_osd", pages = { "ident" } },
	{ name = "ii_osd_t2", section = "ii_wd_osd_scanner_t2", bay = "ii_osd", pages = { "ident" } },
	{ name = "ii_osd_t3", section = "ii_wd_osd_scanner_t3", bay = "ii_osd", pages = { "ident" } },
}

local PROCESS = {
	{ name = "ii_proc_t1", section = "ii_wd_process_t1", bay = "ii_proc" },
	{ name = "ii_proc_t2", section = "ii_wd_process_t2", bay = "ii_proc" },
	{ name = "ii_proc_t3", section = "ii_wd_process_t3", bay = "ii_proc" },
}

-- WD attaches each active bay's empty-slot mesh to the Promin; reuse its spare null mesh.
local OWN_BAYS = {
	{ id = "ii_osd", null_model = "wd\\promin\\promin_t2_m_null" },
	{ id = "ii_proc", null_model = "wd\\promin\\promin_t2_m_null" },
}
-- Active on every Promin tier, so the kit works on a tier-1 Promin too (WD grants conn on tier 2 only).
local KIT_BAYS = { "conn", "ii_osd", "ii_proc" }

local done = false

local function contains(list, value)
	for _, item in ipairs(list) do
		if item == value then
			return true
		end
	end
	return false
end

local function ensure_module(modules, m)
	for _, e in ipairs(modules) do
		if e.section == m.section then
			return
		end
	end
	modules[#modules + 1] = m
end

local function ensure_bay(bays, bay)
	for _, b in ipairs(bays) do
		if b.id == bay.id then
			return
		end
	end
	bays[#bays + 1] = bay
end

function register()
	if done then
		return
	end
	local cfg = rawget(_G, "d_promin_config")
	if not (cfg and cfg.MODULES and cfg.BAYS and cfg.TIERS) then
		return -- WD absent / unexpected shape: stay inert
	end
	done = true

	for _, bay in ipairs(OWN_BAYS) do
		ensure_bay(cfg.BAYS, bay)
	end
	ensure_module(cfg.MODULES, ANTENNA)
	for _, m in ipairs(OSD_SCANNER) do
		ensure_module(cfg.MODULES, m)
	end
	for _, m in ipairs(PROCESS) do
		ensure_module(cfg.MODULES, m)
	end

	for _, tier in ipairs(cfg.TIERS) do
		tier.bays = tier.bays or {}
		for _, bay in ipairs(KIT_BAYS) do
			if not contains(tier.bays, bay) then
				tier.bays[#tier.bays + 1] = bay
			end
		end
	end
end

-- ---- Driver accessors (via WD's own installed-module state) ----------------------

function has_antenna()
	local dp = rawget(_G, "d_promin")
	return dp ~= nil and dp.has_module ~= nil and dp.has_module("ii_ant") and true or false
end

function process_tier()
	local dp = rawget(_G, "d_promin")
	if not (dp and dp.has_module) then
		return nil
	end
	if dp.has_module("ii_proc_t3") then
		return 3
	elseif dp.has_module("ii_proc_t2") then
		return 2
	elseif dp.has_module("ii_proc_t1") then
		return 1
	end
	return nil
end

-- Installed OSD-scanner module tier (1/2/3), or nil. The OSD path's scanner tier.
function osd_scanner_tier()
	local dp = rawget(_G, "d_promin")
	if not (dp and dp.has_module) then
		return nil
	end
	if dp.has_module("ii_osd_t3") then
		return 3
	elseif dp.has_module("ii_osd_t2") then
		return 2
	elseif dp.has_module("ii_osd_t1") then
		return 1
	end
	return nil
end
