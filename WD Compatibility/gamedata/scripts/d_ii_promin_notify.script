-- Promin identification cards. When a target is identified while the Promin shows another
-- page (the IDENTIFICATION page shows the result itself), a card pops up bottom-right and
-- stacks upward. Each card is a WD panel box: the faction emblem, name and distance, then
-- faction and rank. It is built on a WD panel kit, so it follows WD's palette and brightness.
--
-- Every card widget hangs off one root static attached to the Promin window, and children
-- draw in attach order. A page WD builds later would draw over the cards, so ii_wd_promin
-- destroys the stack and builds a new one whenever the window gains a page.

local px = d_promin_config.get_px()
local set_shown = wd_screen.set_shown
local place_widget = wd_screen.place_widget
local get_upper = wd_text.get_upper
local min, max = math.min, math.max

local NOTIF_MAX = 4
local TTL_MS = 6000
local SEPARATOR = " \183 "
local DIST_TEXT = "%d M"
local UNKNOWN = "UNKNOWN"

-- Design px at wd_notify_scale 1. `right` lines the cards up with WD's sidebar edge.
LAYOUTS = {
	[d_promin_config.DEFAULT_THEME] = {
		right = 1025,
		bottom = 565,
		w = 300,
		h = 54,
		gap = 8,
		inset = 10,
		emblem = 30,
		name_y = 8,
		name_h = 18,
		sub_h = 15,
		line_gap = 4,
		dist_w = 64,
	},
	[d_promin_config.LARGE_THEME] = {
		right = 1075,
		bottom = 565,
		w = 340,
		h = 66,
		gap = 8,
		inset = 10,
		emblem = 38,
		name_y = 9,
		name_h = 23,
		sub_h = 19,
		line_gap = 5,
		dist_w = 84,
	},
}

function get_scale()
	local scale = ii_identify and ii_identify.get_wd_notify_scale and ii_identify.get_wd_notify_scale() or 1
	return max(0.5, min(2, scale or 1))
end

local function new_slot(kit, layout, scale, index)
	local s = function(v)
		return v * scale
	end
	local w, h = s(layout.w), s(layout.h)
	local left = layout.right - w
	local top = layout.bottom - h - index * (h + s(layout.gap))
	local inset, emblem = s(layout.inset), s(layout.emblem)
	local name_h, sub_h = s(layout.name_h), s(layout.sub_h)
	local text_x = left + inset + emblem + inset
	local dist_w = s(layout.dist_w)
	local name_w = layout.right - inset - dist_w - text_x
	local name_y = top + s(layout.name_y)
	local slot = { active = false, expiry = 0, name_w = name_w, sub_w = layout.right - inset - text_x }

	slot.box = kit.new_box()
	slot.box.place(px.x(left), px.y(top), px.w(w), px.h(h))
	slot.emblem = kit.new_image(wd_screen.FILL_ID, "text")
	place_widget(slot.emblem.widget, px.x(left + inset), px.y(top + (h - emblem) / 2), px.w(emblem), px.h(emblem))
	slot.name = kit.new_text({ chars = 22, width = px.w(name_w), height = px.h(name_h) })
	slot.name.place(px.x(text_x), px.y(name_y))
	slot.dist = kit.new_text({ chars = 7, width = px.w(dist_w), height = px.h(name_h), align = "right" })
	slot.dist.place(px.x(layout.right - inset - dist_w), px.y(name_y))
	slot.sub = kit.new_text({ chars = 30, width = px.w(slot.sub_w), height = px.h(sub_h) })
	slot.sub.place(px.x(text_x), px.y(name_y + name_h + s(layout.line_gap)))
	slot.name_h, slot.sub_h = name_h, sub_h
	return slot
end

local function hide_slot(slot)
	slot.active = false
	slot.box.set_visible(false)
	set_shown(slot.emblem, false)
	slot.name.set_visible(false)
	slot.dist.set_visible(false)
	slot.sub.set_visible(false)
end

local function sub_line(last)
	local faction = last.faction and get_upper(last.faction)
	local rank = last.rank and get_upper(last.rank)
	if faction and rank then
		return faction .. SEPARATOR .. rank
	end
	return faction or rank or ""
end

local function show_slot(kit, slot, last)
	slot.box.set_visible(true)
	local emblem = ii_wd_promin.emblem_id(last.comm)
	if emblem then
		kit.set_image(slot.emblem, emblem)
	end
	set_shown(slot.emblem, emblem ~= nil)
	local name = (last.name and last.name ~= "") and get_upper(last.name) or UNKNOWN
	slot.name.show(kit.fit(name, px.w(slot.name_w), px.h(slot.name_h)), "text")
	slot.dist.show(last.dist and string.format(DIST_TEXT, last.dist) or "", "meta")
	slot.sub.show(kit.fit(sub_line(last), px.w(slot.sub_w), px.h(slot.sub_h)), "meta")
end

-- One card stack for the window `wnd`, laid out for `theme` at `scale` (fixed per stack:
-- ii_wd_promin builds a new one when either changes, or when WD adds a page).
function build(wnd, theme, scale)
	local layout = LAYOUTS[theme] or LAYOUTS[d_promin_config.DEFAULT_THEME]
	local root = CUIStatic()
	root:SetAutoDelete(true)
	wnd:AttachChild(root)
	local kit = d_promin_chrome_ui.new_kit(root)
	if not kit then
		return nil
	end
	local mgr = { root = root, theme = theme, scale = scale, slots = {}, last_id = nil, inited = false }
	for index = 1, NOTIF_MAX do
		mgr.slots[index] = new_slot(kit, layout, scale, index - 1)
		hide_slot(mgr.slots[index])
	end

	local function push(last)
		-- Fill the lowest free slot; if all are full, reuse the one expiring soonest.
		local target, soonest = nil, math.huge
		for _, slot in ipairs(mgr.slots) do
			if not slot.active then
				target = slot
				break
			end
			if slot.expiry < soonest then
				soonest, target = slot.expiry, slot
			end
		end
		target.active = true
		target.expiry = time_global() + TTL_MS
		show_slot(kit, target, last)
	end

	function mgr.update(show_here)
		local current = ii_identify and ii_identify.get_last_identified_id and ii_identify.get_last_identified_id()
		if not mgr.inited then
			mgr.inited = true
			mgr.last_id = current -- no card for whatever was identified before the stack existed
		elseif current ~= mgr.last_id then
			mgr.last_id = current
			if current and show_here then
				push(ii_identify.get_last_identified())
			end
		end
		local now = time_global()
		for _, slot in ipairs(mgr.slots) do
			if slot.active and (not show_here or now >= slot.expiry) then
				hide_slot(slot)
			end
		end
	end

	function mgr.hide_all()
		for _, slot in ipairs(mgr.slots) do
			hide_slot(slot)
		end
	end

	-- Detaching an auto-delete window frees it with every widget under it.
	function mgr.destroy()
		wnd:DetachChild(root)
	end

	mgr.repaint = kit.repaint
	return mgr
end
