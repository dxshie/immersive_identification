-- Promin IDENTIFICATION page. Mirrors WD's NAVIGATION page layout: keep the chrome
-- (frame/clock/battery) and the left biomonitor, and put our content in the RIGHT panel
-- where the map normally is. Text is drawn with the glyph compositor (ii_wd_text) since the
-- CRT screen has no font; the target portrait is the NPC's character_icon.
--
-- All coordinates are design pixels in the shared 1100x600 space (d_promin_health_ui
-- .get_px()), so they map onto the 3D screen like WD's own pages. The right-panel rect
-- (VIEW) matches the map's region. NOTE: these layout constants are best-guess and will
-- likely need in-game tuning -- they're all gathered here at the top for that reason.

-- CRT-shader binder (matches how WD draws the bg/digits/map).
local binder = wd_screen.new_binder(d_promin_config.SCREEN_SHADER)

-- Our own full-screen background: a copy of WD's map-page bg (biomonitor left + empty right
-- panel) with the tab strip re-baked to show IDENTIFICATION (active) next to a dimmed
-- BIOMONITOR / NAVIGATION. So the IDENTIFICATION tab is a real baked tab, not a drawn label.
-- (Ships as ii_wd\ui\tablet_ui_main_ident.dds; does not override WD's own textures.)
local BG_TEXTURE = "ii_wd_tab_bg_ident"

local COL_TITLE = { 235, 205, 110 } -- amber (matches our description headers)
local COL_LABEL = { 110, 175, 150 } -- dim teal
local COL_VALUE = { 205, 235, 220 } -- bright readout
local NONE = "---" -- shown for a field that is locked/unavailable

-- The right-panel region (where the map draws), design px.
local VIEW = { x = 572, y = 85, w = 425, h = 450 }
-- Our dark backing inside the right panel (inset a touch from VIEW).
local PANEL = { x = 580, y = 96, w = 410, h = 430 }
-- Target portrait (top-centre of the right panel).
local PORTRAIT = { x = 712, y = 116, w = 146, h = 176 }
-- "Scanning" spinner, centred over the portrait area while a scan is in progress.
local SPINNER = { x = 737, y = 156, w = 96, h = 96 }
local SPIN_FRAMES, SPIN_STEP_MS = 12, 75 -- 12 x 75 ms = ~900 ms per rotation
-- Field rows below the portrait: label column, value column, glyph metrics.
local ROW_Y0, ROW_DY = 306, 34
local LABEL_X, VALUE_X = 590, 714
local GW, GH, ADV = 15, 20, 15

local ROWS = {
	{ label = "NAME", key = "name", vmax = 18 },
	{ label = "FACTION", key = "faction", vmax = 16 },
	{ label = "RANK", key = "rank", vmax = 14 },
	{ label = "POSITION", key = "pos", vmax = 18 },
	{ label = "DISTANCE", key = "dist", vmax = 10 },
	{ label = "WEAPON", key = "weap", vmax = 18 },
}

local function fmt_value(last, key)
	if not last then
		return NONE
	end
	if key == "pos" then
		return last.x and string.format("%d, %d, %d", last.x, last.y, last.z) or NONE
	end
	if key == "dist" then
		return last.dist and string.format("%d m", last.dist) or NONE
	end
	local v = last[key]
	return (v and v ~= "") and v or NONE
end

function build(ctx)
	local px = d_promin_health_ui.get_px()
	local page = { visible = false }

	-- Chrome (frame/clock/battery/emblem) + the left biomonitor, exactly as the NAVIGATION
	-- page composes them -- so this page keeps the familiar left half of the screen.
	page.chrome = d_promin_health_ui.build_chrome({
		init = ctx.init,
		layout = d_promin_health_ui.get_layout(),
		bg_tex = BG_TEXTURE,
	})
	page.bio = d_promin_health_ui.build_bio(ctx)

	-- Dark backing over the right panel so our text reads cleanly on any bg.
	page.panel = ctx.init_ii("ii_wd_panel")
	binder.set(page.panel, "ii_wd_panel")
	page.panel:SetWndPos(vector2():set(px.x(PANEL.x), px.y(PANEL.y)))
	page.panel:SetWndSize(vector2():set(px.w(PANEL.w), px.h(PANEL.h)))

	-- (The IDENTIFICATION tab label is baked into BG_TEXTURE now -- no runtime label needed.)

	-- Portrait (top-right panel). Generic stretch static; texture (re)bound each update.
	page.portrait = ctx.init_ii("ii_wd_glyph")
	page.portrait:SetWndPos(vector2():set(px.x(PORTRAIT.x), px.y(PORTRAIT.y)))
	page.portrait:SetWndSize(vector2():set(px.w(PORTRAIT.w), px.h(PORTRAIT.h)))
	page.portrait:Show(false)
	page.portrait_tex = nil

	-- "Scanning" spinner (frame-cycled sprite, over the portrait area while a scan runs).
	page.spinner = ctx.init_ii("ii_wd_glyph")
	page.spinner:SetWndPos(vector2():set(px.x(SPINNER.x), px.y(SPINNER.y)))
	page.spinner:SetWndSize(vector2():set(px.w(SPINNER.w), px.h(SPINNER.h)))
	page.spinner:Show(false)
	page.spinner_tex = nil

	page.labels = {}
	page.values = {}
	for i, row in ipairs(ROWS) do
		local y = ROW_Y0 + (i - 1) * ROW_DY
		page.labels[i] =
			ii_wd_text.new_field(px, ctx.init_ii, "ii_wd_glyph", #row.label, LABEL_X, y, GW, GH, ADV, COL_LABEL)
		page.values[i] =
			ii_wd_text.new_field(px, ctx.init_ii, "ii_wd_glyph", row.vmax, VALUE_X, y, GW, GH, ADV, COL_VALUE)
	end

	local function render()
		local alpha = d_promin_health_ui.get_ui_alpha()
		-- This readout is the OSD scanner's display channel: it only shows data while an OSD
		-- scanner MODULE is installed in the Promin. An AR scanner instead projects overlays
		-- onto entities (nothing here).
		local osd = ii_wd_modules and ii_wd_modules.osd_scanner_tier and ii_wd_modules.osd_scanner_tier() ~= nil
		local last = osd and ii_identify and ii_identify.get_last_identified and ii_identify.get_last_identified()
			or nil
		for i, row in ipairs(ROWS) do
			ii_wd_text.set_text(page.labels[i], row.label, alpha)
			local v = fmt_value(last, row.key)
			if not osd and row.key == "name" then
				v = "install OSD scanner" -- hint: this channel needs the OSD scanner module
			end
			ii_wd_text.set_text(page.values[i], v, alpha)
		end
		-- While a scan is in progress (OSD channel), show the animated spinner over the
		-- portrait area instead of the portrait -- the text fields keep the last result until
		-- the new scan completes.
		local scanning = osd
			and ii_identify
			and ii_identify.get_scan_progress
			and ii_identify.get_scan_progress() ~= nil
		if scanning then
			local frame = math.floor(time_global() / SPIN_STEP_MS) % SPIN_FRAMES
			page.spinner_tex = binder.bind(page.spinner, "ii_wd_spin_" .. frame, page.spinner_tex)
			page.spinner:SetTextureColor(GetARGB(alpha, 255, 255, 255))
			page.spinner:Show(true)
			page.portrait:Show(false)
		else
			page.spinner:Show(false)
			local pic = last and last.portrait or nil
			if pic then
				page.portrait_tex = binder.bind(page.portrait, pic, page.portrait_tex)
				page.portrait:SetTextureColor(GetARGB(alpha, 255, 255, 255))
				page.portrait:Show(true)
			else
				page.portrait:Show(false)
			end
		end
	end

	function page.set_visible(visible)
		page.visible = visible
		page.chrome.set_visible(visible)
		page.bio.set_visible(visible)
		page.panel:Show(visible)
		if visible then
			render()
		else
			page.portrait:Show(false)
			page.spinner:Show(false)
			for i = 1, #ROWS do
				ii_wd_text.hide_field(page.labels[i])
				ii_wd_text.hide_field(page.values[i])
			end
		end
	end

	function page.update()
		if page.visible then
			page.chrome.update()
			page.bio.update()
			render()
		end
	end

	function page.repaint()
		if page.visible then
			page.chrome.repaint()
			page.bio.repaint()
			render()
		end
	end

	page.set_visible(false)
	return page
end
