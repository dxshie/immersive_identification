-- Text compositor for the Promin identification page. The Promin CRT screen has no font;
-- WD renders numbers by swapping per-digit textures onto slot widgets. This extends that
-- to a full monospace glyph atlas (ii_wd_font.dds + ii_wd_font_textures.xml register one
-- texture id per ASCII code, ii_wd_g_<code>), so arbitrary strings can be drawn by binding
-- each character's glyph texture onto a row of slot widgets -- same mechanism as the clock.
--
-- Coordinates use the SAME normalized screen space as the biomonitor page
-- (d_promin_health_ui.get_px(), a 1100x600 design mapped onto the 3D screen), so a field
-- placed at design pixel (px,py) lands correctly on the Promin screen.

local binder = wd_screen.new_binder(d_promin_config.SCREEN_SHADER)
local scratch_pos = vector2()
local scratch_size = vector2()

local MIN_CODE, MAX_CODE, FALLBACK = 32, 126, 63 -- printable ASCII; '?' for anything else

-- Create a text FIELD: a fixed row of `max_chars` glyph-slot widgets. `init(id)` makes one
-- bare CUIStatic from the page's xml (call it repeatedly -- the same node is a template).
-- Position/size are fixed per glyph (glyph i sits at px + (i-1)*advance), set once here;
-- set_text only swaps textures + shows/hides, like WD's digit slots. All args in DESIGN
-- pixels (a px-space mapper converts them). color = {r,g,b}.
function new_field(px, init, glyph_id, max_chars, dpx, dpy, gw, gh, advance, color)
	local slots = {}
	for i = 1, max_chars do
		local w = init(glyph_id)
		w:SetWndPos(scratch_pos:set(px.x(dpx + (i - 1) * advance), px.y(dpy)))
		w:SetWndSize(scratch_size:set(px.w(gw), px.h(gh)))
		w:Show(false)
		slots[i] = { wnd = w, tex = nil }
	end
	return { slots = slots, max = max_chars, color = color or { 200, 235, 220 }, last = nil }
end

-- Bind a string onto the field (truncated to its slot count). alpha 0..255. Skips work when
-- the string and alpha are unchanged since the last call (cheap idle updates).
function set_text(field, str, alpha)
	str = tostring(str == nil and "" or str)
	if #str > field.max then
		str = str:sub(1, field.max)
	end
	alpha = alpha or 255
	local key = str .. "\0" .. alpha
	if field.last == key then
		return
	end
	field.last = key
	local col = field.color
	local argb = GetARGB(alpha, col[1], col[2], col[3])
	local n = #str
	for i = 1, field.max do
		local slot = field.slots[i]
		if i <= n then
			local code = string.byte(str, i)
			if code < MIN_CODE or code > MAX_CODE then
				code = FALLBACK
			end
			slot.tex = binder.bind(slot.wnd, "ii_wd_g_" .. code, slot.tex)
			slot.wnd:SetTextureColor(argb)
			slot.wnd:Show(true)
		else
			slot.wnd:Show(false)
		end
	end
end

function hide_field(field)
	field.last = nil
	for i = 1, field.max do
		field.slots[i].wnd:Show(false)
	end
end
