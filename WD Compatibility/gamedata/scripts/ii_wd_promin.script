-- Puts Immersive Identification on WD's Promin screen without replacing a WD file:
--   * the IDENTIFICATION page: d_promin_ui keeps its page builders in a file local with no
--     registration call, so the page is added to that table through the upvalues of
--     UIPromin.ensure_page (the only function holding it);
--   * the identification cards: driven from UIPromin's own Update and repaint;
--   * the page's number key: WD 0.10 dropped per-module pages (a tier lists all of its pages),
--     so an installed OSD scanner appends the page to d_promin.get_available_pages;
--   * a 4th header key for it: d_promin_chrome_ui.MAX_KEYS is raised to 4 and each chrome's
--     clock, battery and signal move one key left while the 4th key is shown.
-- If WD reshapes d_promin_ui, register() logs once and leaves the Promin alone.

local IDENT_PAGE = "ident"
local CARD_PAGES = {
	[d_promin_config.COMMS_PAGE] = true,
	[d_promin_config.HEALTH_PAGE] = true,
	[d_promin_config.MAP_PAGE] = true,
}

-- The card stack and what it was built for; a stale stack is rebuilt (see d_ii_promin_notify).
local cards = { stack = nil, theme = nil, scale = nil, pages = nil, failed = false }
local hooked = false

-- WD's emblem texture for a community, or nil (faction hidden, or WD has no emblem for it).
function emblem_id(comm)
	if not comm or comm == "none" or comm == "auto" then
		return nil
	end
	for _, emblem in ipairs(d_promin_config.EMBLEMS) do
		if emblem.name == comm then
			return d_promin_chrome_ui.get_emblem_id(comm)
		end
	end
	return nil
end

local function find_upvalue(fn, wanted)
	for index = 1, 255 do
		local name, value = debug.getupvalue(fn, index)
		if name == nil then
			return nil
		end
		if name == wanted then
			return value
		end
	end
	return nil
end

local function report(what, err)
	printf("! Immersive Identification: %s: %s", what, tostring(err))
end

-- WD calls the page from its own window callbacks, where a Lua error is fatal: a failing page
-- reports once and goes quiet instead.
local function build_ident(ctx)
	local ok, page = pcall(d_ii_promin_ident.build, ctx)
	if not ok then
		report("the IDENTIFICATION page failed to build", page)
		return nil
	end
	for _, name in ipairs({ "set_visible", "update", "repaint" }) do
		local fn = page[name]
		page[name] = function(...)
			local fine, err = pcall(fn, ...)
			if not fine then
				report("the IDENTIFICATION page stopped", err)
				page[name] = function() end
			end
		end
	end
	return page
end

local function count_pages(pages)
	local count = 0
	for page_id in pairs(pages) do
		if page_id ~= IDENT_PAGE then
			count = count + 1
		end
	end
	return count
end

local function update_cards(wnd)
	local theme, pages = wnd.theme, wnd.pages
	if not (theme and pages) then
		return
	end
	local scale = d_ii_promin_notify.get_scale()
	local built = count_pages(pages)
	if cards.theme ~= theme or cards.scale ~= scale or cards.pages ~= built then
		if cards.stack then
			cards.stack.destroy()
		end
		cards.stack = d_ii_promin_notify.build(wnd, theme, scale) or false
		cards.theme, cards.scale, cards.pages = theme, scale, built
	end
	if cards.stack then
		cards.stack.update(wnd.powered_state and CARD_PAGES[d_promin_ui.get_page()] == true)
	end
end

local function contains(list, value)
	for _, item in ipairs(list) do
		if item == value then
			return true
		end
	end
	return false
end

-- d_promin calls get_available_pages unqualified, which resolves through its module table, so
-- replacing the field also covers WD's own page validation and number keys.
local function hook_available_pages()
	local available = d_promin.get_available_pages
	d_promin.get_available_pages = function()
		local pages = available()
		if ii_wd_modules.osd_scanner_tier() and not contains(pages, IDENT_PAGE) then
			pages[#pages + 1] = IDENT_PAGE
		end
		return pages
	end
end

local HEADER = { keys = 4, pos = vector2() }

-- WD right-aligns the page keys against the clock with only ~18 px to spare, so a 4th key would
-- cover it. WD places the clock, battery and signal once at build and never again, so they are
-- moved here, back and forth as the 4th key comes and goes (e.g. the OSD scanner is removed).
local function new_header_shift(chrome)
	local keys = chrome.layout and chrome.layout.keys
	if not (keys and chrome.key_ids) then
		return nil
	end
	local widgets, xs = {}, {}
	local function add(widget)
		if widget then
			widgets[#widgets + 1] = widget
			xs[#xs + 1] = widget:GetWndPos().x
		end
	end
	for _, slot in ipairs(chrome.tm or {}) do
		add(slot.widget)
	end
	add(chrome.bat_icon and chrome.bat_icon.widget)
	local signal = chrome.signal
	if signal then
		for _, bar in ipairs(signal.bars or {}) do
			add(bar.widget)
		end
		add(signal.cross and signal.cross.widget)
	end
	local dx = keys.w + keys.gap
	local shifted = false
	return function()
		local want = chrome.key_ids[HEADER.keys] ~= nil
		if want == shifted then
			return
		end
		shifted = want
		local offset = want and -dx or 0
		for index, widget in ipairs(widgets) do
			widget:SetWndPos(HEADER.pos:set(xs[index] + offset, widget:GetWndPos().y))
		end
	end
end

-- Pages call d_promin_chrome_ui.build qualified and read chrome.update / set_visible after it
-- returns, so wrapping both here reaches every page's header, WD's and ours.
local function hook_chrome_build()
	local chrome_ui = d_promin_chrome_ui
	if type(chrome_ui.MAX_KEYS) ~= "number" or type(chrome_ui.build) ~= "function" then
		printf("! Immersive Identification: WD's Promin header changed, no 4th page key")
		return
	end
	chrome_ui.MAX_KEYS = math.max(chrome_ui.MAX_KEYS, HEADER.keys)
	local build = chrome_ui.build
	chrome_ui.build = function(cfg)
		local chrome = build(cfg)
		local ok, apply = pcall(new_header_shift, chrome)
		if not ok then
			report("4th page key off", apply)
			return chrome
		end
		if apply then
			local update, set_visible = chrome.update, chrome.set_visible
			chrome.update = function()
				update()
				apply()
			end
			chrome.set_visible = function(visible)
				set_visible(visible)
				apply()
			end
		end
		return chrome
	end
end

function register()
	if hooked then
		return
	end
	local cls = d_promin_ui and d_promin_ui.UIPromin
	local ensure = cls and cls.ensure_page
	local builders = type(ensure) == "function" and find_upvalue(ensure, "THEME_BUILDERS")
	if type(builders) ~= "table" then
		printf("! Immersive Identification: no page table in WD's d_promin_ui, Promin page and cards off")
		return
	end
	hooked = true
	for _, theme_builders in pairs(builders) do
		theme_builders[IDENT_PAGE] = build_ident
	end
	hook_available_pages()
	hook_chrome_build()
	local update, repaint = cls.Update, cls.repaint
	cls.Update = function(self)
		update(self)
		if cards.failed then
			return
		end
		local ok, err = pcall(update_cards, self)
		if not ok then
			cards.failed = true
			report("identification cards off", err)
		end
	end
	cls.repaint = function(self)
		repaint(self)
		if cards.stack and not cards.failed then
			pcall(cards.stack.repaint)
		end
	end
end
