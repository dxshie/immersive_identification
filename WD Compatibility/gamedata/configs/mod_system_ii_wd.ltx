; ---- AR Scanner (worn device, mounted on the bracer) ----------------------------
; Identification shown ON entities (the usual overlays). The OSD scanner is a Promin
; module instead (defined above), not a worn device.

[ii_wd_scanner_t1]:identity_immunities
GroupControlSection  = spawn_group
discovery_dependency =
$spawn          = "devices\promin"
class           = II_ATTCH
kind            = i_device
cform           = skeleton
visual          = wd\world\promin_world.ogf
inv_name        = st_ii_wd_scanner_t1
inv_name_short  = st_ii_wd_scanner_t1
description     = st_ii_wd_scanner_t1_descr
inv_weight      = 0.25
icons_texture   = ii_wd\ui\icon_ii_wd_ar_scanner
inv_grid_width  = 1
inv_grid_height = 1
inv_grid_x      = 0
inv_grid_y      = 0
cost            = 7000
use1_functor = d_ii_scanner.get_menu_text
use1_action_functor = d_ii_scanner.toggle_attach

