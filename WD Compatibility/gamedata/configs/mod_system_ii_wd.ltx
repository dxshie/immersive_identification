; Immersive Identification <-> st-wearable-devices compatibility: item sections.
;
; Loose .ltx under configs/ is auto-included by Anomaly (no #include needed), same
; convention WD itself uses (mod_system_promin.ltx). Placeholder art throughout:
; icons reuse our shipped ii_wd\ui\icon_ii_wd_null; visuals reuse WD's own meshes
; (this component is only ever installed alongside WD, so those assets are present).
;
; Two item families:
;   - Promin MODULES (antenna, process t1..t3): install into the Promin via our OWN
;     use-functors (ii_wd_modules.get_menu_text / toggle) + our own persisted state. They
;     are NOT WD bay-modules (adding Promin bays crashes WD's customize UI, which ships XML
;     for a fixed 3 bays). Install is a reversible toggle and requires the Promin worn.
;   - SCANNER (t1..t3): a worn device mounted on the bracer, toggled via our
;     d_ii_scanner device script (mirrors WD's d_bracer / d_vektor pattern).

; ---- Promin modules (install via our own action) --------------------------------

[ii_wd_module_base]:identity_immunities
GroupControlSection  = spawn_group
discovery_dependency =
$spawn          = "devices\promin"
class           = II_ATTCH
kind            = i_wearable_module
cform           = skeleton
visual          = wd\world\promin_module_world.ogf
inv_weight      = 0.08
icons_texture   = ii_wd\ui\icon_ii_wd_null
inv_grid_width  = 1
inv_grid_height = 1
inv_grid_x      = 0
inv_grid_y      = 0
cost            = 4000
; Install via WD's own Promin system (so they show + install in the bracer customize UI).
; Menu text = WD's get_module_menu_text; the antenna installs with WD's install_module,
; the process tiers use our wrapper so a new tier replaces any other (shared `side` bay).
use1_functor = d_promin.get_module_menu_text
use1_action_functor = d_promin.install_module

[ii_wd_antenna]:ii_wd_module_base
inv_name        = st_ii_wd_antenna
inv_name_short  = st_ii_wd_antenna
description     = st_ii_wd_antenna_descr
icons_texture   = ii_wd\ui\icon_ii_wd_antenna
cost            = 4500

[ii_wd_process_t1]:ii_wd_module_base
inv_name        = st_ii_wd_process_t1
inv_name_short  = st_ii_wd_process_t1
description     = st_ii_wd_process_t1_descr
icons_texture   = ii_wd\ui\icon_ii_wd_process
use1_action_functor = ii_wd_modules.install_process
cost            = 5000

[ii_wd_process_t2]:ii_wd_module_base
inv_name        = st_ii_wd_process_t2
inv_name_short  = st_ii_wd_process_t2
description     = st_ii_wd_process_t2_descr
icons_texture   = ii_wd\ui\icon_ii_wd_process
use1_action_functor = ii_wd_modules.install_process
cost            = 9000

[ii_wd_process_t3]:ii_wd_module_base
inv_name        = st_ii_wd_process_t3
inv_name_short  = st_ii_wd_process_t3
description     = st_ii_wd_process_t3_descr
icons_texture   = ii_wd\ui\icon_ii_wd_process
use1_action_functor = ii_wd_modules.install_process
cost            = 16000

; ---- Scanner (worn device, mounted on the bracer) -------------------------------

