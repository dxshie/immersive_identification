; Immersive Identification <-> st-wearable-devices compatibility: item sections.
;
; Loose .ltx under configs/ is auto-included by Anomaly (no #include needed), same
; convention WD itself uses (mod_system_promin.ltx). Placeholder art throughout:
; icons reuse our shipped ii_wd\ui\icon_ii_wd_null; visuals reuse WD's own meshes
; (this component is only ever installed alongside WD, so those assets are present).
;
; Two item families:
;   - Promin MODULES (antenna, OSD scanner t1..t3, process t1..t3): install into the Promin
;     via WD's Promin system, shown in the bracer customize UI. They repurpose WD's `conn`
;     and `side` bays (no new bays -- a 4th crashes WD's customize UI). conn holds the
;     antenna OR an OSD scanner (mutually exclusive = the AR-vs-OSD channel switch); side
;     holds a process tier. See ii_wd_modules.script.
;   - AR SCANNER (t1..t3): a worn device mounted on the bracer, toggled via our
;     d_ii_scanner device script (mirrors WD's d_bracer / d_vektor pattern).

; ---- Promin modules (install via our own action) --------------------------------

[ii_wd_module_base]:identity_immunities
GroupControlSection  = spawn_group
discovery_dependency =
$spawn          = "devices\promin"
class           = II_ATTCH
kind            = i_wearable_module
cform           = skeleton
visual          = wd\world\promin_module_world.ogf
inv_weight      = 0.08
icons_texture   = ii_wd\ui\icon_ii_wd_null
inv_grid_width  = 1
inv_grid_height = 1
inv_grid_x      = 0
inv_grid_y      = 0
cost            = 4000
; Install via WD's Promin system (so they show + install in the bracer customize UI).
; Menu text = WD's get_module_menu_text; install goes through our ii_wd_modules.install,
; which evicts any module already in the target bay first (WD's install_module appends
; without checking, so the shared conn/side bays would otherwise stack modules).
use1_functor = d_promin.get_module_menu_text
use1_action_functor = ii_wd_modules.install

[ii_wd_antenna]:ii_wd_module_base
inv_name        = st_ii_wd_antenna
inv_name_short  = st_ii_wd_antenna
description     = st_ii_wd_antenna_descr
icons_texture   = ii_wd\ui\icon_ii_wd_antenna
cost            = 4500

[ii_wd_process_t1]:ii_wd_module_base
