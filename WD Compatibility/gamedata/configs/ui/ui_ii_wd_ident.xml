<?xml version="1.0" encoding="windows-1251"?>
<w>
	<!-- Node templates for the Promin identification page. Instantiated many times by the
	     page builder via ctx.init_ii(name); position, size and texture are all set at
	     runtime (the CRT screen shader is applied through the wd_screen binder). stretch="1"
	     is mandatory so runtime SetWndSize is honoured (tmNative silently ignores it). Node
	     names avoid a colon prefix on purpose, since xmllint rejects an undeclared XML
	     namespace. -->
	<ii_wd_panel x="0" y="0" width="0.01" height="0.01" stretch="1">
		<texture>ii_wd_panel</texture>
	</ii_wd_panel>
	<ii_wd_glyph x="0" y="0" width="0.01" height="0.01" stretch="1">
		<texture>ii_wd_g_65</texture>
	</ii_wd_glyph>
</w>
