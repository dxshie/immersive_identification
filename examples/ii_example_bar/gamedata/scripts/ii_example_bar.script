-- ======================================================================
--  Example add-on: "Example Bar" UI style for Immersive Identification
-- ======================================================================
--  A minimal but complete style: one faction-coloured bar under each
--  identified target, with a thinner rank-coloured bar above it.
--
--  Demonstrates the whole shape of an add-on -- registration, the three
--  hooks, reusing the host mod's widget templates, honouring the player's
--  content toggles, and distance scaling -- in as little code as possible.
--  See MODDERS.md in the host mod's repo.
--
--  Install like any Anomaly mod. Then pick it in
--  MCM -> Immersive Identification -> UI Style -> General -> UI style.
-- ======================================================================

local BAR_W = 30 -- bar width in virtual px, before a.scale
local BAR_H = 4
local RANK_H = 2
local GAP = 2 -- between the two bars
local DROP = 10 -- how far below the anchor the first bar sits

-- One set of widgets per tag slot, made once. `tag_s2_bar` is a plain white
-- rectangle template from the host mod's ii_tags.xml -- InitStatic gives us our
-- OWN widget from it, we are not sharing the built-in styles' widgets.
-- Creation order is draw order: the rank bar is created last, so it draws on top.
local function on_create(state, ctx)
	state.bar = ctx.xml:InitStatic("tag_s2_bar", ctx.parent)
	state.rank = ctx.xml:InitStatic("tag_s2_bar", ctx.parent)
end

local function on_hide(state, ctx)
	-- Anything not hidden here stays on screen after the target is gone.
	ctx.show(state.bar, false)
	ctx.show(state.rank, false)
end

local function on_draw(state, a, ctx)
	local w, h = BAR_W * a.scale, BAR_H * a.scale
	local y = a.hy + DROP * a.scale

	-- ctx.place_kx centres on the point and aspect-corrects the WIDTH, so the bar keeps
	-- its proportions on any screen -- that correction is the single easiest thing to get
	-- wrong by hand. a.a already carries the fade-in/hold/fade-out curve.
	--
	-- relation_color gives the red/green/tan relationship colour, or the fallback when
	-- there is none to show (the player turned "Show relation" off).
	ctx.place_kx(state.bar, a.hx, y + h / 2, w, h, ctx.relation_color(a, a.fcol), a.a)

	-- a.rank is nil both when "Show rank" is off and for monsters, which have no rank.
	if a.rank then
		local rh = RANK_H * a.scale
		ctx.place_kx(state.rank, a.hx, y + h + GAP * a.scale + rh / 2, w, rh, a.rank_col, a.a)
	else
		ctx.show(state.rank, false)
	end
end

-- on_game_start, NOT the top level of this file: at top level there is no guarantee
-- ii_api.script has loaded yet. This runs after every script is loaded, and before
-- MCM builds its menu.
function on_game_start()
	-- nil when Immersive Identification is not installed -- stay inert rather than error.
	if not ii_api then
		return
	end
	local ok, err = ii_api.register_style({
		id = "ii_example_bar", -- also the string-table suffix; see st_ii_example_bar.xml
		on_create = on_create,
		on_draw = on_draw,
		on_hide = on_hide,
		dist_scale = true, -- shrink with distance like the Minimal / Simple styles
	})
	if not ok then
		printf("!![ii_example_bar] could not register: %s", tostring(err))
	end
end
