-- ======================================================================
--  Example add-on: "Example Frame" UI style for Immersive Identification
-- ======================================================================
--  A four-strip outline rectangle locked to the target's head (or full body,
--  per the player's Bodycam box-area setting), with the name and range
--  beside it.
--
--  Demonstrates the parts the simpler ii_example_bar leaves out:
--    * want_box -- getting the target's projected box extents, which drawing
--      code cannot compute itself (it has no world access),
--    * ctx.outline, the same rectangle primitive the Bodycam and Patch styles
--      draw with (corner butting and edge correction included),
--    * shipping your OWN widget XML instead of reusing the host mod's,
--    * text widgets and their drop-shadow twins,
--    * a.dist, and honouring the UI Style -> Bodycam settings that are NOT
--      pre-applied for you.
--
--  See MODDERS.md in the host mod's repo. Install like any Anomaly mod, then
--  pick it in MCM -> Immersive Identification -> UI Style -> General.
-- ======================================================================

local TEXT_PAD = 8 -- gap from the box's right edge to the text

-- Parsed once for the whole session, not per slot: CScriptXmlInit():ParseFile() is
-- expensive and the templates it yields are identical for every slot.
local xml = nil
local function templates()
	if not xml then
		xml = CScriptXmlInit()
		xml:ParseFile("ii_example_frame.xml")
	end
	return xml
end

local function on_create(state, ctx)
	local x = templates()
	-- ctx.outline takes the four edges as one table, keyed top/bottom/left/right.
	state.edges = {
		top = x:InitStatic("iiex_edge_h", ctx.parent),
		bottom = x:InitStatic("iiex_edge_h", ctx.parent),
		left = x:InitStatic("iiex_edge_v", ctx.parent),
		right = x:InitStatic("iiex_edge_v", ctx.parent),
	}
	-- Created last = drawn last = on top of the frame.
	state.label_sh = ctx.xml:InitTextWnd("tag_name_sh:text", ctx.parent)
	state.label = ctx.xml:InitTextWnd("tag_name:text", ctx.parent)
end

local function on_hide(state, ctx)
	for _, edge in pairs(state.edges) do
		ctx.show(edge, false)
	end
	ctx.show(state.label, false)
	ctx.show(state.label_sh, false)
end

local function on_draw(state, a, ctx)
	-- box_* is nil whenever the target does not project this frame (off screen, behind
	-- the camera). Always check before using any of the four.
	if not (a.box_hw and a.box_hh) then
		on_hide(state, ctx)
		return
	end

	local cfg = ctx.config

	-- A want_box style is governed by the player's UI Style -> Bodycam page. Area and
	-- padding are already applied to a.box_*, but thickness, opacity and colour source
	-- are NOT -- read them yourself or your outline ignores its own settings page.
	-- box_color_source: 1 = faction, 2 = relationship.
	local col = a.fcol
	if cfg.box_color_source == 2 then
		col = ctx.relation_color(a, a.fcol)
	end
	local alpha = math.floor(a.a * (cfg.box_opacity or 1))

	-- One call for the whole rectangle: ctx.outline butts the corners instead of
	-- overlapping them (overlap double-draws and darkens) and corrects the vertical
	-- edges' width so all four render the same on-screen thickness.
	ctx.outline(state.edges, a.box_cx, a.box_cy, a.box_hw, a.box_hh, cfg.box_thickness or 2, col, alpha)

	-- a.name is nil when the player turned "Show name" off. a.dist is metres to the
	-- target; it is rebuilt into a string only when the rounded value actually changes,
	-- since building a string every frame would allocate every frame.
	if a.name then
		local metres = math.floor(a.dist + 0.5)
		if state.metres ~= metres or state.name ~= a.name then
			state.metres, state.name = metres, a.name
			state.text = string.format("%s  %dm", a.name, metres)
		end
		ctx.set_text(state.label, state.text)
		ctx.set_text(state.label_sh, state.text)
		ctx.draw_shadowed_text(
			state.label,
			state.label_sh,
			a.box_cx + a.box_hw + TEXT_PAD,
			a.box_cy - a.box_hh,
			a.a,
			236,
			230,
			218,
			math.floor(180 * a.a / 255)
		)
	else
		ctx.show(state.label, false)
		ctx.show(state.label_sh, false)
	end
end

function on_game_start()
	if not ii_api then
		return
	end
	local ok, err = ii_api.register_style({
		id = "ii_example_frame",
		on_create = on_create,
		on_draw = on_draw,
		on_hide = on_hide,
		-- Ask for the projected box extents. Deliberately NO dist_scale: the extents
		-- already come from a world projection, so the frame shrinks with distance on
		-- its own -- scaling it again would compound.
		want_box = true,
	})
	if not ok then
		printf("!![ii_example_frame] could not register: %s", tostring(err))
	end
end
