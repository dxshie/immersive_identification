{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"runtime": {
		"version": "Lua 5.1"
	},
	"workspace": {
		"library": ["types"],
		"checkThirdParty": false,
		"ignoreDir": [".git"]
	},
	"diagnostics": {
		"globals": ["class", "super"],
		"disable": ["lowercase-global"]
	},
	"telemetry": {
		"enable": false
	},
	"files.associations": {
		"*.script": "lua"
	}
}
