{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"runtime": {
		"version": "Lua 5.1"
	},
	"workspace": {
		"library": ["types"],
		"checkThirdParty": false,
		"ignoreDir": [".git"]
	},
	"diagnostics": {
		"globals": [
			"class",
			"super",
			"ii_identify",
			"wd_config",
			"wd_worn",
			"wd_attach",
			"wd_slots",
			"wd_exo",
			"wd_core",
			"wd_trader",
			"d_promin",
			"d_promin_config",
			"d_bracer",
			"d_bracer_config",
			"d_ii_scanner",
			"d_ii_scanner_config",
			"ii_wd_modules"
		],
		"disable": ["lowercase-global"]
	},
	"telemetry": {
		"enable": false
	},
	"files.associations": {
		"*.script": "lua"
	}
}
